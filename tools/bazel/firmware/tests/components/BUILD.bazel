load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/native/bk7258:bk7258.bzl", "bk7258_firmware")
load("//tools/bazel/native/esp_idf:esp_idf.bzl", "esp_idf_firmware")
load("//tools/bazel/native/jieli:jieli.bzl", "jieli_firmware")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":fixture.bzl", "component_failure_test", "component_metadata_test", "firmware_component_receipt", "sdk_action_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "explicit/explicit.h",
    "fixture.bzl",
    "include/portable.h",
    "portable.c",
])

py_binary(
    name = "receipt_tool",
    testonly = True,
    srcs = ["receipt.py"],
    legacy_create_init = False,
    main = "receipt.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

h2_tasks(
    name = "api_tasks",
    testonly = True,
    tasks = ["fixture/startup"],
)

h2_tasks(
    name = "source_tasks",
    testonly = True,
    tasks = ["fixture/serial"],
)

filegroup(
    name = "portable_sources",
    testonly = True,
    srcs = ["portable.c"],
)

cc_library(
    name = "header_api",
    testonly = True,
    # The SDK source is deliberately also in an ordinary CcInfo target. A
    # consumer of native_deps must never build/import its archive or flags.
    srcs = [":portable_sources"],
    hdrs = ["include/portable.h"],
    copts = ["-this-library-must-only-supply-headers"],
    includes = ["include"],
    tags = ["manual"],
    deps = [":api_tasks"],
)

cc_library(
    name = "leaf",
    testonly = True,
    srcs = ["leaf.c"],
)

cc_library(
    name = "archive",
    testonly = True,
    srcs = ["archive.c"],
    hdrs = ["include/portable.h"],
    deps = [":leaf"],
)

[
    firmware_lib_component(
        name = name,
        testonly = True,
        native_deps = [
            ":header_api",
            ":source_tasks",
        ],
        native_hdrs = ["explicit/explicit.h"],
        native_include_roots = ["tools/bazel/firmware/tests/components/include"],
        native_srcs = [
            ":portable_sources",
            "portable.c",
        ],
        deps = deps,
    )
    for name, deps in [
        (
            "mixed",
            [":archive"],
        ),
        ("source_only", []),
    ]
]

firmware_lib_component(
    name = "archive_only",
    testonly = True,
    deps = [":archive"],
)

[
    firmware_native_component(
        name = name,
        testonly = True,
        deps = [":mixed"],
    )
    for name in [
        "graph_a",
        "graph_b",
    ]
]

firmware_component_receipt(
    name = "mixed_receipt",
    testonly = True,
    deps = [
        ":graph_a",
        ":graph_b",
    ],
)

firmware_component_receipt(
    name = "source_only_receipt",
    testonly = True,
    deps = [":source_only"],
)

[
    component_metadata_test(
        name = name + "_metadata_test",
        expected_archives = archives,
        has_native_sources = name != "archive_only",
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        target_under_test = ":" + name,
    )
    for name, archives in [
        ("mixed", 2),
        ("source_only", 0),
        ("archive_only", 2),
    ]
]

esp_idf_firmware(
    name = "esp_consumer",
    testonly = True,
    board = "fixture",
    graph = [
        ":graph_a",
        ":graph_b",
    ],
    partition = "partition.csv",
    project = "CMakeLists.txt",
    project_name = "fixture",
    tags = ["manual"],
    target = "esp32s3",
)

bk7258_firmware(
    name = "bk_consumer",
    testonly = True,
    ap_config = [],
    ap_gpio = "explicit/explicit.h",
    board = "fixture",
    cp_config = [],
    cp_gpio = "explicit/explicit.h",
    graph = [
        ":graph_a",
        ":graph_b",
    ],
    project = "CMakeLists.txt",
    project_name = "fixture",
    ram_regions = "partition.csv",
    tags = ["manual"],
    target = "bk7258",
)

jieli_firmware(
    name = "jieli_consumer",
    testonly = True,
    board = "fixture",
    graph = [
        ":graph_a",
        ":graph_b",
    ],
    image = "fixture",
    project_makefile = "project.mk",
    tags = ["manual"],
    target = "wl82",
)

[
    sdk_action_tests(
        name = name + "_action",
        mnemonic = mnemonic,
        source_owner = owner,
        target = ":" + name + "_consumer",
    )
    for name, mnemonic, owner in [
        ("esp", "EspIdfFirmware", "h2_firmware_lib"),
        ("bk", "Bk7258Firmware", "ap:h2_firmware_lib"),
        ("jieli", "JieliFirmware", "h2_firmware_lib"),
    ]
]

py_test(
    name = "receipt_test",
    srcs = ["test_receipt.py"],
    args = [
        "$(rootpath :mixed_receipt)",
        "$(rootpath :source_only_receipt)",
    ],
    data = [
        ":mixed_receipt",
        ":source_only_receipt",
    ],
    legacy_create_init = False,
    main = "test_receipt.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_lib_component(
    name = "other_owner",
    testonly = True,
    native_srcs = [":portable_sources"],
    tags = ["manual"],
)

firmware_lib_component(
    name = "other_component",
    testonly = True,
    component_name = "other_component",
    native_srcs = [":portable_sources"],
    tags = ["manual"],
)

firmware_lib_component(
    name = "empty_component",
    testonly = True,
    native_deps = [":header_api"],
    tags = ["manual"],
)

firmware_lib_component(
    name = "invalid_source",
    testonly = True,
    native_srcs = ["include/portable.h"],
    tags = ["manual"],
)

[
    firmware_component_receipt(
        name = name,
        testonly = True,
        tags = ["manual"],
        deps = [
            ":mixed",
            dependency,
        ],
    )
    for name, dependency in [
        ("duplicate_name", ":other_owner"),
        ("duplicate_source", ":other_component"),
    ]
]

[
    component_failure_test(
        name = name + "_test",
        expected_message = message,
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        target_under_test = ":" + name,
    )
    for name, message in [
        ("duplicate_name", "firmware component name h2_firmware_lib is owned by both"),
        ("duplicate_source", "firmware native source"),
        ("empty_component", "does not contain a static archive or native source"),
        ("invalid_source", "is not a C/C++ or assembly source"),
    ]
]
