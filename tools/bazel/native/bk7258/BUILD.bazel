load("@bk7258_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "bk7258_runner",
    srcs = [
        "bk7258_rbl.py",
        "bk7258_runner.py",
    ],
    legacy_create_init = 0,
    main = "bk7258_runner.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//tools/bazel/native:native_ccache",
        "//tools/bazel/native:native_runtime",
        requirement("cffi"),
        requirement("click"),
        requirement("click-option-group"),
        requirement("cryptography"),
        requirement("pycparser"),
        requirement("pycryptodome"),
    ],
)

py_test(
    name = "bk7258_rbl_test",
    srcs = ["tests/test_bk7258_rbl.py"],
    data = ["bk7258_rbl.py"],
    legacy_create_init = 0,
    main = "tests/test_bk7258_rbl.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "bk7258_runner_test",
    srcs = ["tests/test_bk7258_runner.py"],
    data = [
        "bk7258_rbl.py",
        "bk7258_runner.py",
    ],
    legacy_create_init = 0,
    main = "tests/test_bk7258_runner.py",
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        "//tools/bazel/native:native_ccache",
        "//tools/bazel/native:native_runtime",
        requirement("cffi"),
        requirement("click"),
        requirement("click-option-group"),
        requirement("cryptography"),
        requirement("pycparser"),
        requirement("pycryptodome"),
    ],
)

exports_files([
    "bk7258.bzl",
    "bk7258_rbl.py",
    "bk7258_requirements.txt",
    "bk7258_runner.py",
])

exports_files([
    "bk7258.bzl",
    "bk7258_rbl.py",
    "bk7258_requirements.txt",
    "bk7258_runner.py",
    "repositories.bzl",
])
