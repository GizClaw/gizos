function(h2_bazel_native_component_sources OUTPUT COMPONENT_NAME)
  if(NOT DEFINED H2_BAZEL_COMPONENT_NAMES)
    if(NOT DEFINED ENV{H2_BAZEL_COMPONENT_MANIFEST} OR
       "$ENV{H2_BAZEL_COMPONENT_MANIFEST}" STREQUAL "")
      message(FATAL_ERROR "H2_BAZEL_COMPONENT_MANIFEST is required")
    endif()
    include("$ENV{H2_BAZEL_COMPONENT_MANIFEST}")
  endif()

  set(H2_EXECUTION_UNIT "")
  if(ARGC GREATER 2 AND NOT ARGV2 STREQUAL "")
    set(H2_EXECUTION_UNIT "${ARGV2}_")
  endif()
  string(TOUPPER "${H2_EXECUTION_UNIT}${COMPONENT_NAME}" H2_COMPONENT_KEY)
  set(H2_COMPONENT_VARIABLE "H2_BAZEL_COMPONENT_SRCS_${H2_COMPONENT_KEY}")
  if(NOT DEFINED ${H2_COMPONENT_VARIABLE})
    message(FATAL_ERROR "Bazel did not declare sources for component ${COMPONENT_NAME}")
  endif()
  set(H2_INCLUDE_VARIABLE "H2_BAZEL_COMPONENT_INCLUDES_${H2_COMPONENT_KEY}")
  if(DEFINED ${H2_INCLUDE_VARIABLE} AND NOT CMAKE_SCRIPT_MODE_FILE)
    include_directories(${${H2_INCLUDE_VARIABLE}})
  endif()
  set(${OUTPUT} ${${H2_COMPONENT_VARIABLE}} PARENT_SCOPE)
endfunction()

function(h2_bazel_native_component_select_sources OUTPUT COMPONENT_NAME)
  set(H2_EXECUTION_UNIT "")
  set(H2_REQUESTED_SOURCES ${ARGN})
  if(ARGC GREATER 2 AND (ARGV2 STREQUAL "ap" OR ARGV2 STREQUAL "cp"))
    set(H2_EXECUTION_UNIT "${ARGV2}")
    list(POP_FRONT H2_REQUESTED_SOURCES)
  endif()
  h2_bazel_native_component_sources(
    H2_DECLARED_SOURCES
    "${COMPONENT_NAME}"
    "${H2_EXECUTION_UNIT}")
  set(H2_SELECTED_SOURCES)
  foreach(H2_RELATIVE_SOURCE IN LISTS H2_REQUESTED_SOURCES)
    if(IS_ABSOLUTE "${H2_RELATIVE_SOURCE}" AND DEFINED REPO_ROOT)
      file(RELATIVE_PATH H2_RELATIVE_SOURCE "${REPO_ROOT}" "${H2_RELATIVE_SOURCE}")
    endif()
    set(H2_SOURCE_SUFFIX "/${H2_RELATIVE_SOURCE}")
    string(LENGTH "${H2_SOURCE_SUFFIX}" H2_SUFFIX_LENGTH)
    set(H2_MATCHED_SOURCE "")
    foreach(H2_SOURCE IN LISTS H2_DECLARED_SOURCES)
      string(LENGTH "${H2_SOURCE}" H2_SOURCE_LENGTH)
      if(H2_SOURCE_LENGTH LESS H2_SUFFIX_LENGTH)
        continue()
      endif()
      math(EXPR H2_SUFFIX_OFFSET "${H2_SOURCE_LENGTH} - ${H2_SUFFIX_LENGTH}")
      string(SUBSTRING "${H2_SOURCE}" ${H2_SUFFIX_OFFSET} ${H2_SUFFIX_LENGTH} H2_SOURCE_END)
      if(H2_SOURCE_END STREQUAL H2_SOURCE_SUFFIX)
        if(NOT H2_MATCHED_SOURCE STREQUAL "")
          message(FATAL_ERROR
            "Bazel declared multiple ${COMPONENT_NAME} sources matching ${H2_RELATIVE_SOURCE}")
        endif()
        set(H2_MATCHED_SOURCE "${H2_SOURCE}")
      endif()
    endforeach()
    if(H2_MATCHED_SOURCE STREQUAL "")
      message(FATAL_ERROR
        "Bazel did not declare ${COMPONENT_NAME} source ${H2_RELATIVE_SOURCE}")
    endif()
    list(APPEND H2_SELECTED_SOURCES "${H2_MATCHED_SOURCE}")
  endforeach()
  set(${OUTPUT} ${H2_SELECTED_SOURCES} PARENT_SCOPE)
endfunction()
