load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "libAACdec/src/*.cpp",
        "libArithCoding/src/*.cpp",
        "libDRCdec/src/*.cpp",
        "libFDK/src/*.cpp",
        "libMpegTPDec/src/*.cpp",
        "libPCMutils/src/*.cpp",
        "libSACdec/src/*.cpp",
        "libSBRdec/src/*.cpp",
        "libSYS/src/*.cpp",
    ]),
)

cc_library(
    name = "headers",
    hdrs = glob([
        "libAACdec/include/*.h",
        "libAACdec/src/*.h",
        "libAACdec/src/arm/*.cpp",
        "libArithCoding/include/*.h",
        "libDRCdec/include/*.h",
        "libDRCdec/src/*.h",
        "libFDK/include/*.h",
        "libFDK/include/arm/*.h",
        "libFDK/include/mips/*.h",
        "libFDK/include/ppc/*.h",
        "libFDK/include/x86/*.h",
        "libFDK/src/arm/*.cpp",
        "libFDK/src/mips/*.cpp",
        "libMpegTPDec/include/*.h",
        "libMpegTPDec/src/*.h",
        "libPCMutils/include/*.h",
        "libPCMutils/src/*.h",
        "libSACdec/include/*.h",
        "libSACdec/src/*.h",
        "libSBRdec/include/*.h",
        "libSBRdec/src/*.h",
        "libSBRdec/src/arm/*.cpp",
        "libSYS/include/*.h",
    ]),
    includes = [
        "libAACdec/include",
        "libAACdec/src",
        "libArithCoding/include",
        "libArithCoding/src",
        "libDRCdec/include",
        "libDRCdec/src",
        "libFDK/include",
        "libFDK/src",
        "libMpegTPDec/include",
        "libMpegTPDec/src",
        "libPCMutils/include",
        "libPCMutils/src",
        "libSACdec/include",
        "libSACdec/src",
        "libSBRdec/include",
        "libSBRdec/src",
        "libSYS/include",
        "libSYS/src",
    ],
