load("@gizos//libs/lua:lua_app.bzl", "lua_app")
load("@gizos//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_bk7258_firmware", "h2loader_esp_idf_firmware")
load("@gizos//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("@gizos//tools/bazel:bk7258.bzl", "bk7258_firmware")
load("@gizos//tools/bazel:esp_idf.bzl", "esp_idf_firmware")
load("@gizos//tools/bazel:firmware.bzl", "firmware_version")
load("@gizos//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("@gizos//tools/bazel:native_component.bzl", "firmware_native_component")
load("@gizos//tools/bazel:target_task_policy.bzl", "bk7258_target_task_policy", "esp_target_task_policy")
load("@gizos//tools/bazel:tasks.bzl", "h2_tasks")
load("@gizos//tools/lvgl/font_conv:font_conv.bzl", "lvgl_font")
load("@gizos//tools/lvgl/ttf_subset:ttf_subset.bzl", "ttf_subset_c")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load(":consumer.bzl", "fake_firmware", "native_component_paths")

firmware_version(
    name = "abc_lua_version",
    value = "1.2.3",
)

lua_app(
    name = "abc_lua_app",
    entry = "abc.lua",
    version = ":abc_lua_version",
)

firmware_version(
    name = "xyz_lua_version",
    value = "2.0.0-rc.1",
)

lua_app(
    name = "xyz_lua_app",
    compact = True,
    data = ["xyz/tone.pcm"],
    entry = "xyz.lua",
    version = ":xyz_lua_version",
)

filegroup(
    name = "abc_lua_archive",
    srcs = [":abc_lua_app"],
    output_group = "archive",
)

filegroup(
    name = "abc_lua_manifest",
    srcs = [":abc_lua_app"],
    output_group = "manifest",
)

filegroup(
    name = "abc_lua_metadata",
    srcs = [":abc_lua_app"],
    output_group = "metadata",
)

filegroup(
    name = "xyz_lua_archive",
    srcs = [":xyz_lua_app"],
    output_group = "archive",
)

filegroup(
    name = "xyz_lua_manifest",
    srcs = [":xyz_lua_app"],
    output_group = "manifest",
)

filegroup(
    name = "xyz_lua_metadata",
    srcs = [":xyz_lua_app"],
    output_group = "metadata",
)

py_test(
    name = "lua_app_release_test",
    srcs = ["test_lua_app.py"],
    args = [
        "$(location lua_app_catalog.jsonl)",
        "$(location lua_app_release_files.jsonl)",
        "$(location lua_app_default_files.txt)",
        "$(location :abc_lua_archive)",
        "$(location :abc_lua_manifest)",
        "$(location :abc_lua_metadata)",
        "$(location :xyz_lua_archive)",
        "$(location :xyz_lua_manifest)",
        "$(location :xyz_lua_metadata)",
    ],
    data = [
        "lua_app_catalog.jsonl",
        "lua_app_release_files.jsonl",
        "lua_app_default_files.txt",
        ":abc_lua_archive",
        ":abc_lua_manifest",
        ":abc_lua_metadata",
        ":xyz_lua_archive",
        ":xyz_lua_manifest",
        ":xyz_lua_metadata",
    ],
    legacy_create_init = 0,
    main = "test_lua_app.py",
)

alias(
    name = "runtime",
    actual = "@gizos//libs/runtime",
)

lvgl_font(
    name = "downstream_font_16",
    size = 16,
    out = "downstream_font_16.c",
    font = "font.ttf",
    font_name = "downstream_font_16",
    ranges = ["0x42=>0xF002"],
    symbol_sources = ["font_symbols.txt"],
)

ttf_subset_c(
    name = "embedded_menu_font",
    font = "font.ttf",
    out_c = "embedded_menu_font.c",
    out_h = "embedded_menu_font.h",
    ranges = ["0x20-0x7E"],
    symbol = "embedded_menu_font",
    symbol_sources = ["font_symbols.txt"],
)

cc_test(
    name = "embedded_menu_font_test",
    srcs = [
        "embedded_ttf_consumer.cc",
        ":embedded_menu_font",
    ],
)

cc_library(
    name = "font_consumer",
    srcs = [
        "font_consumer.c",
        ":downstream_font_16",
    ],
    deps = ["@gizos//libs/lvgl"],
)

cc_test(
    name = "font_consumer_test",
    srcs = ["font_consumer_test.c"],
    deps = [":font_consumer"],
)

firmware_native_component(
    name = "font_native_component",
    srcs = ["font_consumer.c"],
    component_directory = ".",
    component_name = "embedded_menu_font",
    native_srcs = [
        ":downstream_font_16",
        ":embedded_menu_font",
    ],
    deps = ["@gizos//libs/lvgl:headers"],
)

native_component_paths(
    name = "native_component_paths",
    explicit = "@gizos//boards/devkit/esp32s3",
    inferred = "@gizos//native_component_src/esp-idf6.x/zlib",
    local = ":font_native_component",
)

firmware_version(
    name = "private_esp_version",
    value = "1.2.3",
)

firmware_version(
    name = "private_bk_version",
    value = "4.5.6-rc.1+consumer",
)

alias(
    name = "i18n_runtime",
    actual = "@gizos//tools/lvgl/conv_i18n_yaml:runtime",
)

alias(
    name = "bk3633_wolfcrypt_consumer",
    actual = "@gizos//libs/pal/providers/wolfssl:wolfcrypt_bk3633",
)

cc_library(
    name = "bk3633_test_support_consumer",
    testonly = True,
    srcs = ["consumer.c"],
    deps = [
        "@gizos//libs/runtime",
        "@gizos//native_component_src/bk3633/h2_pal_core:fake_trng",
        "@gizos//native_component_src/bk3633/h2_pal_core:mem_test_support",
    ],
)

firmware_native_component(
    name = "native_component",
    srcs = ["consumer.c"],
    deps = [
        "@gizos//libs/pal",
        "@gizos//tools/bazel:vendor_third_party_opus_headers",
    ],
)

h2_tasks(
    name = "private_tasks",
    tasks = ["private/consumer"],
)

esp_target_task_policy(
    name = "private_esp_task_policy",
    default_policy = "4  any  4096  psram",
    directory = "private_esp_task_policy",
    graph = [":private_tasks"],
    policies = ["private/consumer  6  0  8192  internal"],
)

bk7258_target_task_policy(
    ap_default_policy = "7  0  4096  default",
    ap_name = "private_bk_ap_task_policy",
    ap_policies = ["private/consumer  5  0  8192  psram"],
    cp_default_policy = "6  4096  default",
    cp_name = "private_bk_cp_task_policy",
    directory = "private_bk_task_policy",
    graph = [":private_tasks"],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "@gizos//libs/pal/providers/h2peer:portable_protocol_providers",
        "@gizos//libs/runtime",
    ],
)

fake_firmware(name = "fake_firmware")

exports_files([
    "CMakeLists.txt",
    "ap.defaults",
    "cp.defaults",
    "disabled_native_locator.json",
    "partition.csv",
    "ram_regions.csv",
    "sdkconfig.h2loader.defaults",
])

filegroup(
    name = "ap_gpio",
    srcs = ["ap_gpio.h"],
)

filegroup(
    name = "cp_gpio",
    srcs = ["cp_gpio.h"],
)

filegroup(
    name = "layout",
    srcs = ["layout.txt"],
)

h2loader_esp_idf_firmware(
    name = "private_esp_firmware",
    board = "private_esp_board",
    graph = [":font_native_component"],
    layout_files = {
        "partition": ":partition.csv",
        "project_support_files": [":sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "private_esp_consumer",
    target = "esp32s3",
    task_policy = ":private_esp_task_policy",
    version = ":private_esp_version",
)

h2loader_bk7258_firmware(
    name = "private_bk_firmware",
    ap_task_policy = ":private_bk_ap_task_policy",
    board = "private_bk_board",
    cp_task_policy = ":private_bk_cp_task_policy",
    layout_files = {
        "ap_config": [":ap.defaults"],
        "ap_gpio": ":ap_gpio",
        "cp_config": [":cp.defaults"],
        "cp_gpio": ":cp_gpio",
        "project_support_files": [":layout"],
        "ram_regions": ":ram_regions.csv",
    },
    project = "CMakeLists.txt",
    project_name = "private_bk_consumer",
    target = "bk7258",
    version = ":private_bk_version",
)

esp_idf_firmware(
    name = "generic_private_esp_firmware",
    board = "private_esp_board",
    graph = [":font_native_component"],
    partition = ":partition.csv",
    project = "CMakeLists.txt",
    project_name = "private_esp_consumer",
    project_support_files = [":sdkconfig.h2loader.defaults"],
    target = "esp32s3",
    task_policy = ":private_esp_task_policy",
    version = ":private_esp_version",
)

bk7258_firmware(
    name = "generic_private_bk_firmware",
    ap_config = [":ap.defaults"],
    ap_gpio = ":ap_gpio",
    ap_task_policy = ":private_bk_ap_task_policy",
    board = "private_bk_board",
    cp_config = [":cp.defaults"],
    cp_gpio = ":cp_gpio",
    cp_task_policy = ":private_bk_cp_task_policy",
    project = "CMakeLists.txt",
    project_name = "private_bk_consumer",
    project_support_files = [":layout"],
    ram_regions = ":ram_regions.csv",
    target = "bk7258",
    version = ":private_bk_version",
)

h2loader_tar_zlib(
    name = "package",
    board = "consumer_board",
    firmware = ":fake_firmware",
    image = "consumer_app",
    role = "app",
    target = "esp32s3",
)
