module(name = "gizos_downstream_consumer")

bazel_dep(name = "gizos", version = "0.0.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")

go_host_toolchains = use_extension(
    "@gizos//tools/bazel:go_host_toolchains.bzl",
    "go_host_toolchains",
)
use_repo(go_host_toolchains, "gizos_go_toolchains")

register_toolchains("@gizos_go_toolchains//:all")

toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

esp32s3_cc = use_extension(
    "@gizos//tools/bazel/toolchains/esp32s3_cc:repositories.bzl",
    "esp32s3_cc_toolchain",
)
esp32s3_cc.locators(
    sdk_locator = "//:disabled_native_locator.json",
    tools_locator = "//:disabled_native_locator.json",
)
use_repo(esp32s3_cc, "gizos_esp32s3_cc_toolchain")

register_toolchains("@gizos_esp32s3_cc_toolchain//:toolchain")

bk_repositories = use_extension(
    "@gizos//tools/bazel/native_repositories:bk_repositories.bzl",
    "bk_repositories",
)
use_repo(bk_repositories, "gizos_bk_arm_toolchain")

local_embedded_cc = use_extension(
    "@gizos//tools/bazel/toolchains/local_embedded_cc:repositories.bzl",
    "local_embedded_cc_toolchains",
)
use_repo(local_embedded_cc, "gizos_bk3633_cc_toolchain")

register_toolchains("@gizos_bk3633_cc_toolchain//:toolchain")
