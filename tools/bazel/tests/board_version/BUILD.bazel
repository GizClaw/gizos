load("//tools/bazel:app_version.bzl", "app_version")
load("//tools/bazel:board_version.bzl", "board_version")
load(":analysis_tests.bzl", "board_failure_case", "board_success_test", "firmware_failure_case", "firmware_success_case", "version_success_test")

HOST_ONLY = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

[
    app_version(
        name = name,
        testonly = True,
        value = value,
    )
    for name, value in [
        ("app", "1.2.3"),
        ("next_app", "1.2.4"),
        ("prerelease_app", "1.2.3-rc.1"),
        ("metadata_app", "1.2.3+source"),
    ]
]

alias(
    name = "app_alias",
    testonly = True,
    actual = ":app",
)

[
    board_version(
        name = name,
        testonly = True,
        build = build,
    )
    for name, build in [
        ("board", 541),
        ("next_board", 542),
        ("zero_board", 0),
    ]
]

[
    board_success_test(
        name = name + "_test",
        expected_build = build,
        target_compatible_with = HOST_ONLY,
        target_under_test = ":" + name,
    )
    for name, build in [
        ("board", 541),
        ("zero_board", 0),
    ]
]

version_success_test(
    name = "app_test",
    expected_version = "1.2.3",
    target_compatible_with = HOST_ONLY,
    target_under_test = ":app",
)

BASE = {
    "main_version": ":app",
    "build": ":board",
    "variant": "e2e",
}

[
    firmware_success_case(
        name = name,
        attributes = BASE | overrides,
        compatibility = HOST_ONLY,
        expected_version = expected,
    )
    for name, overrides, expected in [
        (
            "atomic",
            {"variant": "atomic-"},
            "1.2.3-atomic-.541",
        ),
        (
            "e2e",
            {"variant": "e2e"},
            "1.2.3-e2e.541",
        ),
        (
            "aliased_app",
            {
                "main_version": ":app_alias",
                "variant": "e2e",
            },
            "1.2.3-e2e.541",
        ),
        (
            "next_app_same_board",
            {
                "main_version": ":next_app",
                "variant": "e2e",
            },
            "1.2.4-e2e.541",
        ),
        (
            "next_build_same_app",
            {
                "build": ":next_board",
                "variant": "e2e",
            },
            "1.2.3-e2e.542",
        ),
        (
            "dev",
            {"variant": "dev"},
            "1.2.3-dev.541",
        ),
        (
            "prod",
            {"variant": "prod"},
            "1.2.3-prod.541",
        ),
        (
            "with_metadata",
            {"build_metadata": "board-v2"},
            "1.2.3-e2e.541+board-v2",
        ),
        (
            "metadata_numeric_leading_zero",
            {"build_metadata": "board.01"},
            "1.2.3-e2e.541+board.01",
        ),
        (
            "metadata_without_variant",
            {
                "variant": "",
                "build_metadata": "board-v2",
            },
            "1.2.3-541+board-v2",
        ),
        (
            "metadata_maximum_length",
            {"build_metadata": "abcdefghijklmnopq"},
            "1.2.3-e2e.541+abcdefghijklmnopq",
        ),
        (
            "empty_variant",
            {"variant": ""},
            "1.2.3-541",
        ),
        (
            "zero_board_build",
            {"build": ":zero_board"},
            "1.2.3-e2e.0",
        ),
        (
            "maximum_length",
            {"variant": "abcdefghijklmnopqrstu"},
            "1.2.3-abcdefghijklmnopqrstu.541",
        ),
    ]
]

firmware_success_case(
    name = "omitted_variant",
    attributes = {
        "main_version": ":app",
        "build": ":board",
    },
    compatibility = HOST_ONLY,
    expected_version = "1.2.3-541",
)

firmware_success_case(
    name = "legacy",
    attributes = {"value": "2.0.0-rc.1+manual"},
    compatibility = HOST_ONLY,
    expected_version = "2.0.0-rc.1+manual",
)

board_failure_case(
    name = "negative_build",
    build = -1,
    compatibility = HOST_ONLY,
    expected_message = "board build must be non-negative",
)

[
    firmware_failure_case(
        name = name,
        attributes = attributes,
        compatibility = HOST_ONLY,
        expected_message = message,
    )
    for name, attributes, message in [
        ("missing_sources", {}, "requires main_version and build, or a legacy value"),
        (
            "missing_board",
            {"main_version": ":app"},
            "requires both main_version and build",
        ),
        (
            "missing_app",
            {"build": ":board"},
            "requires both main_version and build",
        ),
        (
            "ambiguous_sources",
            BASE | {"value": "1.2.3"},
            "must use either main_version/build or a legacy value, not both",
        ),
        (
            "legacy_variant",
            {
                "value": "1.2.3",
                "variant": "dev",
            },
            "variant requires main_version and build",
        ),
        (
            "unsafe_variant",
            BASE | {"variant": "dev/"},
            "variant must contain only ASCII letters, digits, and hyphens",
        ),
        (
            "dotted_variant",
            BASE | {"variant": "prod."},
            "variant must contain only ASCII letters, digits, and hyphens",
        ),
        (
            "metadata_variant",
            BASE | {"variant": "dev+"},
            "variant must contain only ASCII letters, digits, and hyphens",
        ),
        (
            "non_ascii_variant",
            BASE | {"variant": "测试"},
            "variant must contain only ASCII letters, digits, and hyphens",
        ),
        (
            "too_long",
            BASE | {"variant": "abcdefghijklmnopqrstuv"},
            "must contain 1..31 ASCII characters",
        ),
        (
            "metadata_too_long",
            BASE | {"build_metadata": "abcdefghijklmnopqr"},
            "must contain 1..31 ASCII characters",
        ),
        (
            "metadata_unsafe_character",
            BASE | {"build_metadata": "board_v2"},
            "build metadata contains an unsafe character",
        ),
        (
            "metadata_empty_identifier",
            BASE | {"build_metadata": "board..v2"},
            "build metadata identifier must not be empty",
        ),
        (
            "metadata_leading_plus",
            BASE | {"build_metadata": "+board"},
            "multiple build metadata separators",
        ),
        (
            "metadata_non_ascii",
            BASE | {"build_metadata": "板子"},
            "build metadata contains an unsafe character",
        ),
        (
            "legacy_metadata_attribute",
            {
                "value": "1.2.3",
                "build_metadata": "board",
            },
            "build_metadata requires main_version and build",
        ),
        (
            "prerelease_base",
            BASE | {"main_version": ":prerelease_app"},
            "main_version must be MAJOR.MINOR.PATCH without a suffix",
        ),
        (
            "metadata_base",
            BASE | {"main_version": ":metadata_app"},
            "main_version must be MAJOR.MINOR.PATCH without a suffix",
        ),
        (
            "firmware_is_not_app",
            BASE | {"main_version": ":legacy"},
            "AppVersionDeclarationInfo",
        ),
        (
            "app_is_not_board",
            BASE | {"build": ":app"},
            "BoardVersionInfo",
        ),
    ]
]
