load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version_flag")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load(":npm_release.bzl", "npm_release_bundle")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "npm_release_tool",
    srcs = ["npm_release.py"],
    legacy_create_init = 0,
    main = "npm_release.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

npm_release_bundle(
    name = "npm_release_bundle",
    packages = [
        "//projects/h2loader/targets/npm_package/h2loader:release_tarball",
        "//tools/gizos:release_tarball",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "npm_release_test",
    srcs = [
        "npm_release.py",
        "tests/test_npm_release.py",
    ],
    legacy_create_init = 0,
    main = "tests/test_npm_release.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_version_flag(
    name = "release_batch",
    build_setting_default = "bazel-release-batch",
)

py_test(
    name = "release_test",
    srcs = [
        "tests/test_release.py",
        "//tools/h2loader:release_bundle.py",
    ],
    data = ["//:make_command_files"],
    legacy_create_init = 0,
    main = "tests/test_release.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "release_workflow_test",
    srcs = [
        "release_workflow.py",
        "tests/test_release_workflow.py",
    ],
    data = ["//:.github/workflows/release.yml"],
    legacy_create_init = 0,
    main = "tests/test_release_workflow.py",
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
)

exports_files([
    "npm_release.bzl",
    "npm_release.py",
    "release_inputs.bzl",
    "release_workflow.py",
])
