load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_OR_MOBILE_TOOL_COMPATIBILITY", "HOST_TOOL_COMPATIBILITY")
load(":mobile_e2e.bzl", "host_python_runtime")

package(default_visibility = ["//visibility:public"])

host_python_runtime(name = "mobile_e2e_host_python")

# Only mobile targets use this adapter; ordinary Python tools keep their
# registered target runtime. Both runtimes come from the same rules_python pin.
[
    toolchain(
        name = "mobile_e2e_python_" + platform,
        target_compatible_with = ["@platforms//os:" + platform],
        toolchain = ":mobile_e2e_host_python",
        toolchain_type = "@bazel_tools//tools/python:toolchain_type",
    )
    for platform in [
        "ios",
        "android",
    ]
]

py_library(
    name = "mobile_e2e_runtime",
    srcs = ["mobile_e2e.py"],
    target_compatible_with = HOST_OR_MOBILE_TOOL_COMPATIBILITY,
)

py_test(
    name = "mobile_e2e_runtime_test",
    srcs = ["tests/test_mobile_e2e.py"],
    legacy_create_init = False,
    main = "tests/test_mobile_e2e.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":mobile_e2e_runtime"],
)

py_binary(
    name = "mobile_package_tool",
    srcs = ["mobile_package.py"],
    legacy_create_init = 0,
    main = "mobile_package.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files([
    "mobile_app_sdk.bzl",
    "mobile_e2e.bzl",
    "mobile_e2e.py",
    "mobile_package.bzl",
    "mobile_package.py",
])
