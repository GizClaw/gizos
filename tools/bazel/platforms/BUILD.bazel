package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_bk7258",
    define_values = {"h2_firmware_target": "bk7258"},
)

config_setting(
    name = "is_bk3633",
    define_values = {"h2_firmware_target": "bk3633"},
)

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "host_linux_target_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    define_values = {"h2_host_os": "linux"},
)

config_setting(
    name = "host_macos_target_macos",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    define_values = {"h2_host_os": "macos"},
)

config_setting(
    name = "host_windows_target_windows",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    define_values = {"h2_host_os": "windows"},
)
