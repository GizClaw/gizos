    define_values = {"h2_firmware_target": "ac791n"},
)

# The JieLi toolchain only ships Linux x86_64 binaries, so native JieLi
# firmware actions are compatible only when the Linux host runs them; other
# hosts skip the targets instead of failing inside the action.
config_setting(
    name = "is_ac695n_linux_host",
    define_values = {
        "h2_firmware_target": "ac695n",
        "h2_host_os": "linux",
    },
)

config_setting(
    name = "is_ac791n_linux_host",
    define_values = {
        "h2_firmware_target": "ac791n",
        "h2_host_os": "linux",
    },
)

