{
  "name": "@gizclaw/gizloader-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Gizloader desktop application and command line tools",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "prepare:native": "node scripts/prepare-native.mjs",
    "desktop:dev": "tauri dev --config src-tauri/gizloader.generated.conf.json",
    "desktop:build": "node scripts/package.mjs",
    "test": "node --test scripts/release-index.test.mjs scripts/package-environment.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package": "node scripts/package.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@gizclaw/forge-picker": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/bun": "1.3.9",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  }
}
