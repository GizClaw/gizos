load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "WINDOWS_X86_64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "h2loader/cli/speed",
    ],
)

cc_library(
    name = "h2loader_cli_app",
    srcs = [
        "src/h2_h2loader_cli_app.c",
        "src/h2_h2loader_cli_bleikcp_speed.c",
        "src/h2_h2loader_cli_output.c",
