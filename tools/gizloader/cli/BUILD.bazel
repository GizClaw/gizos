    hdrs = [
        "include/h2_h2loader_cli_app.h",
        "include/h2_h2loader_cli_task_names.h",
        "src/h2_h2loader_cli_internal.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    deps = [
        ":tasks",
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/command",
        "//libs/h2loader/host",
        "//libs/pal",
        "//libs/runtime",
    ],
)

