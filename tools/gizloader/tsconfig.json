{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "allowJs": true, "checkJs": false,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true,
    "paths": { "@/*": ["./src/*"], "@gizclaw/h2loader": ["../../projects/h2loader/libs/web/src/h2loader_protocol.js"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
