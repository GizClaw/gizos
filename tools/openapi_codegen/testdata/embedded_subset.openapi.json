{
  "openapi": "3.0.3",
  "info": {
    "title": "Embedded Pet API",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Value"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "post": {
        "operationId": "updatePet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ID"
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "X-Device-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 36,
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pet"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated pet",
            "headers": {
              "X-Trace": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "enum": [
                    "trace-1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pet",
            "headers": {
              "X-Trace": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "enum": [
                    "trace-1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "dir",
                  "file"
                ],
                "properties": {
                  "dir": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Uploaded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ID": {
        "type": "string",
        "maxLength": 32
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "Named": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "Pet": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Named"
          },
          {
            "type": "object",
            "required": [
              "active",
              "age",
              "tags",
              "kind"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "age": {
                "type": "integer",
                "format": "int32"
              },
              "kind": {
                "type": "string",
                "maxLength": 8,
                "enum": [
                  "cat",
                  "dog"
                ]
              },
              "tags": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "maxLength": 12
                }
              }
            }
          }
        ]
      },
      "A": {
        "type": "object",
        "required": [
          "a"
        ],
        "properties": {
          "a": {
            "type": "string"
          }
        }
      },
      "B": {
        "type": "object",
        "required": [
          "b"
        ],
        "properties": {
          "b": {
            "type": "boolean"
          }
        }
      },
      "Value": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "choice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/A"
              },
              {
                "$ref": "#/components/schemas/B"
              }
            ]
          }
        }
      }
    }
  }
}
