load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "license",
    srcs = ["@h2_wakenet_license//file"],
)

py_binary(
    name = "pack",
    srcs = ["pack.py"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "pack_test",
    srcs = [
        "pack.py",
        "test_pack.py",
    ],
    main = "test_pack.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

genrule(
    name = "nihaoxiaozhi",
    srcs = [
        "@h2_wakenet_nihaoxiaozhi_info//file",
        "@h2_wakenet_nihaoxiaozhi_index//file",
        "@h2_wakenet_nihaoxiaozhi_data//file",
    ],
    outs = ["nihaoxiaozhi.bin"],
    cmd = "$(location :pack) --model-name wn9_nihaoxiaozhi_tts " +
          "--info $(location @h2_wakenet_nihaoxiaozhi_info//file) " +
          "--index $(location @h2_wakenet_nihaoxiaozhi_index//file) " +
          "--data $(location @h2_wakenet_nihaoxiaozhi_data//file) --output $@",
    tools = [":pack"],
)
