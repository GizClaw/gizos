load("@lvgl_ttf_subset_pip//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":ttf_subset.bzl", "ttf_subset_c")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "runner",
    srcs = ["ttf_subset.py"],
    legacy_create_init = 0,
    main = "ttf_subset.py",
    python_version = "PY3",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [requirement("fonttools")],
)

py_test(
    name = "ttf_subset_test",
    srcs = [
        "ttf_subset.py",
        "tests/test_ttf_subset.py",
    ],
    imports = ["."],
    legacy_create_init = 0,
    main = "tests/test_ttf_subset.py",
    python_version = "PY3",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [requirement("fonttools")],
)

ttf_subset_c(
    name = "fixture_font",
    font = "//projects/showcase:assets/fonts/NotoSansSC-Bold.ttf",
    out_c = "fixture_font.c",
    out_h = "fixture_font.h",
    ranges = ["0x20-0x7E"],
    symbol = "fixture_font",
    symbol_sources = ["tests/symbols.txt"],
)

cc_test(
    name = "fixture_font_test",
    srcs = [
        ":fixture_font",
        "tests/consumer.c",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files(["ttf_subset.bzl"])
