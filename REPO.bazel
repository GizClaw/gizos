# Keep the root CI graph independent from deprecated, generated, and
# experimental trees. Public upstream archives are Bazel external repositories
# and are not traversed from this root package graph.
ignore_directories([
    "apploader/**",
    "**/__pycache__/**",
    "**/build/**",
    "bazel-*/**",
    "build/**",
    "docs/**",
    "h2loader/**",
    "tests/**",
    "x/**",
])
