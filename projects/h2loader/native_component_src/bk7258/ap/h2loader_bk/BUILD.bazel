load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "power_test",
    srcs = [
        "src/h2_bk_h2loader_power.c",
        "tests/h2_bk_h2loader_power_test_sdk.h",
        "tests/test_h2_bk_h2loader_power.c",
    ],
    includes = ["tests"],
    local_defines = ["H2_BK_H2LOADER_POWER_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)

cc_test(
    name = "fixed_boot_test",
    srcs = [
        "src/h2_bk_fixed_boot.c",
        "tests/h2_bk_fixed_boot_test_sdk.h",
        "tests/test_h2_bk_fixed_boot.c",
    ],
    includes = ["tests"],
    local_defines = ["H2_BK_FIXED_BOOT_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/pal",
        "//projects/h2loader/native_component_src/bk7258/fixed_flash:layout",
    ],
)

py_test(
    name = "ble_advertising_contract_test",
    srcs = ["tests/test_ble_advertising_contract.py"],
    data = [
        "src/h2_bk_h2loader_app_bleikcp.c",
        "//libs/h2loader_host:src/h2_h2loader_host_discovery.c",
        "//projects/h2loader/apps/loader/app:h2loader_bleikcp.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_ble.c",
        "//native_component_src/bk7258/ap/h2_pal_core:src/h2_bk_platform_ble.c",
    ],
    legacy_create_init = 0,
    main = "tests/test_ble_advertising_contract.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_native_component(
    name = "h2loader_bk",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ) + ["//projects/h2loader/native_component_src/bk7258/fixed_flash:layout.h"],
    data = [
        "CMakeLists.txt",
    ],
    execution_unit = "ap",
    native_srcs = [
        "//projects/h2loader/apps/loader/app:task_names.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_app_client.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_ble.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_boot.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_command.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_metadata.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_mfg.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_package.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_stage.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_stage_writer.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_status.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_task_names.c",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//projects/h2loader/libs/h2loader",
    ],
)
