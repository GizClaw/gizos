load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

exports_files(["src/h2_esp_h2loader_iostreamikcp.c"])

firmware_native_component(
    name = "h2_h2loader_runtime",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ) + [
        "//projects/h2loader/apps/loader/app:app.c",
        "//projects/h2loader/apps/loader/app:task_names.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_app_client.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_boot.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_command.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_metadata.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_mfg.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_package.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_stage.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_stage_writer.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_status.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_task_names.c",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
        "//projects/h2loader/apps/loader",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//projects/h2loader/apps/loader/app:loader",
        "//projects/h2loader/libs/h2loader",
    ],
)

[
    cc_test(
        name = "device_uid_" + target + "_test",
        srcs = [
            "include/h2_esp_h2loader_device_uid.h",
            "tests/test_device_uid.c",
        ] + glob(["tests/include/**/*.h"]),
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS + ["-DCONFIG_IDF_TARGET_ESP32P4=" + p4],
        includes = ["tests/include"],
    )
    for target, p4 in [
        ("p4", "1"),
        ("s3", "0"),
    ]
]
