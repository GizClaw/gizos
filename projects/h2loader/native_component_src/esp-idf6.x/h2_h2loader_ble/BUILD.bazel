load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_h2loader_ble",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ) + [
        "//projects/h2loader/apps/loader/app:h2loader_bleikcp.c",
        "//projects/h2loader/libs/h2loader:src/h2_loader_ble.c",
    ],
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
        "//projects/h2loader/apps/loader",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/bleikcp",
        "//projects/h2loader/apps/loader/app:loader",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

cc_library(
    name = "app_commands_preflight",
    srcs = ["src/h2_esp_h2loader_app_commands_preflight.c"],
    hdrs = ["src/h2_esp_h2loader_app_commands_preflight.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    deps = ["//libs/runtime"],
)

cc_test(
    name = "app_commands_preflight_test",
    srcs = ["tests/test_h2_esp_h2loader_app_commands_preflight.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":app_commands_preflight"],
)
