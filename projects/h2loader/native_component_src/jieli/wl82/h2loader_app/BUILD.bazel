firmware_native_component(
    name = "app_ble",
    srcs = ["src/jieli_app_ble.c"],
    hdrs = ["//projects/h2loader/apps/loader/app:include/h2loader_app_task_names.h"],
    include_roots = ["projects/h2loader/apps/loader/app/include"],
    native_srcs = ["//projects/h2loader/libs/h2loader:src/h2_loader_ble.c"],
    component_name = "jieli_ac791n_devkit_app_ble",
    tags = ["manual"],
    target_compatible_with = AC791N_COMPATIBILITY,
    deps = [
        "//projects/h2loader/apps/loader/app:ble_tasks",
        ":app_support",
        ":app_ble_transport",
    ],
)
