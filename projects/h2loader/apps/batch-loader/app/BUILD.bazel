load("@h2loader_batch_loader_npm//:defs.bzl", "npm_link_all_packages")
load("@h2loader_batch_loader_npm//projects/h2loader/apps/batch-loader/app:@playwright/test/package_json.bzl", playwright_bin = "bin")
load("@h2loader_batch_loader_npm//projects/h2loader/apps/batch-loader/app:vite/package_json.bzl", vite_bin = "bin")
load("@h2loader_batch_loader_npm//projects/h2loader/apps/batch-loader/app:vitest/package_json.bzl", vitest_bin = "bin")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

npm_link_all_packages(name = "node_modules")

APP_SOURCES = glob(["src/**"]) + [
    "index.html",
    "package.json",
    "vite.config.js",
]

vite_bin.vite(
    name = "web_app",
    srcs = APP_SOURCES,
    chdir = package_name(),
    data = [":node_modules"],
    fixed_args = [
        "build",
        "--outDir",
        "dist",
    ],
    out_dirs = ["dist"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

vitest_bin.vitest_test(
    name = "unit_test",
    args = ["run"],
    chdir = package_name(),
    copy_data_to_bin = False,
    data = APP_SOURCES + glob(["tests/*.test.js"]) + [":node_modules"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

playwright_bin.playwright_test(
    name = "playwright_test",
    args = ["test"],
    chdir = package_name(),
    copy_data_to_bin = False,
    data = glob(["tests/**"]) + [
        "playwright.config.js",
        ":node_modules",
        ":node_modules/@playwright/test",
        "//projects/h2loader/targets/pkg_tar/batch-loader",
        "//projects/h2loader/targets/pkg_tar/batch-loader:serve",
    ] + select({
        "//tools/bazel/platforms:is_linux_x86_64": [
            "@h2_playwright_chromium_linux_x86_64//:chrome-linux/headless_shell",
            "@h2_playwright_chromium_linux_x86_64//:runtime",
        ],
        "//tools/bazel/platforms:is_macos_arm64": [
            "@h2_playwright_chromium_macos_arm64//:chrome-mac/headless_shell",
            "@h2_playwright_chromium_macos_arm64//:runtime",
        ],
        "//conditions:default": [],
    }),
    env = select({
        "//tools/bazel/platforms:is_linux_x86_64": {
            "CI": "1",
            "PLAYWRIGHT_CHROMIUM_EXECUTABLE": "$(rootpath @h2_playwright_chromium_linux_x86_64//:chrome-linux/headless_shell)",
            "TEST_ARCHIVE_ROOTPATH": "$(rootpath //projects/h2loader/targets/pkg_tar/batch-loader:batch-loader)",
            "TEST_SERVER_ROOTPATH": "$(rootpath //projects/h2loader/targets/pkg_tar/batch-loader:serve)",
        },
        "//tools/bazel/platforms:is_macos_arm64": {
            "CI": "1",
            "PLAYWRIGHT_CHROMIUM_EXECUTABLE": "$(rootpath @h2_playwright_chromium_macos_arm64//:chrome-mac/headless_shell)",
            "TEST_ARCHIVE_ROOTPATH": "$(rootpath //projects/h2loader/targets/pkg_tar/batch-loader:batch-loader)",
            "TEST_SERVER_ROOTPATH": "$(rootpath //projects/h2loader/targets/pkg_tar/batch-loader:serve)",
        },
        "//conditions:default": {},
    }),
    no_copy_to_bin = [
        "//projects/h2loader/targets/pkg_tar/batch-loader:batch-loader",
        "//projects/h2loader/targets/pkg_tar/batch-loader:serve",
    ],
    tags = ["no-sandbox"],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_linux_x86_64": [],
        "//tools/bazel/platforms:is_macos_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
