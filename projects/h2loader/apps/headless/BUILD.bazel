load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:app_version.bzl", "app_version")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

app_version(
    name = "version",
    value = "0.2.3",
)

exports_files([
    "src/app.c",
    "src/h2loader_bleikcp.c",
    "src/task_names.c",
])

h2_tasks(
    name = "tasks",
    tasks = [
        "h2loader/appcmd",
    ],
)

h2_tasks(
    name = "ble_tasks",
    tasks = ["h2loader/blecmd"],
)

cc_library(
    name = "loader",
    srcs = [
        "src/app.c",
        "src/h2loader_bleikcp.c",
        "src/task_names.c",
    ],
    hdrs = [
        "include/h2loader_app.h",
        "include/h2loader_app_task_names.h",
        "include/h2loader_board_extension.h",
        "src/h2loader_bleikcp_internal.h",
    ],
    includes = [
        "include",
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ble_tasks",
        ":tasks",
        "//libs/command",
        "//libs/h2loader/device",
        "//libs/net/bleikcp",
        "//libs/runtime",
        "//pal",
    ],
)

cc_test(
    name = "bleikcp_command_service_test",
    srcs = [
        "src/h2loader_bleikcp.c",
        "src/h2loader_bleikcp_internal.h",
        "tests/test_h2loader_bleikcp.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":loader"],
)

cc_test(
    name = "lifetime_test",
    srcs = ["tests/test_lifetime.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":loader"],
)
