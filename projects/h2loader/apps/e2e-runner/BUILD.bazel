load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "h2loader_e2e_runner",
    srcs = ["src/h2_h2loader_e2e_runner.c"],
    hdrs = ["include/h2_h2loader_e2e_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/h2loader_host",
        "//libs/bundle",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "h2loader_e2e_runner_test",
    size = "small",
    srcs = ["tests/test_h2_h2loader_e2e_runner.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    data = [":checksum_fixtures"],
    deps = [":h2loader_e2e_runner"],
)

genrule(
    name = "checksum_fixtures",
    srcs = ["tests/fixtures/app-a.txt", "tests/fixtures/app-b.txt"],
    outs = [
        "tests/checksum-fixtures/tar_zlib/baseline.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/unchanged.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/app-only.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/data-only.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/both-changed.update.tar.zlib",
        "tests/checksum-fixtures/zlib_tar/baseline.update.tar",
        "tests/checksum-fixtures/zlib_tar/unchanged.update.tar",
        "tests/checksum-fixtures/zlib_tar/app-only.update.tar",
        "tests/checksum-fixtures/zlib_tar/data-only.update.tar",
        "tests/checksum-fixtures/zlib_tar/both-changed.update.tar",
        "tests/checksum-fixtures/fixtures.json",
    ],
    tools = ["//projects/h2loader/tools/bazel:checksum_fixture_writer"],
    cmd = "$(location //projects/h2loader/tools/bazel:checksum_fixture_writer) " +
          "--app-a $(location tests/fixtures/app-a.txt) --app-b $(location tests/fixtures/app-b.txt) " +
          "--app-path app/esp/app.bin --board fixture --target esp32s3 " +
          "--version-a 1.0.0-a --version-b 1.0.0-b --output $(@D)/tests/checksum-fixtures",
)
