load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:app_version.bzl", "app_version")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/lvgl/font_conv:font_conv.bzl", "lvgl_font")

package(default_visibility = ["//visibility:public"])

app_version(
    name = "version",
    value = "0.1.44",
)

cc_library(
    name = "model",
    srcs = ["src/h2_mfg_model.c"],
    hdrs = [
        "include/h2_mfg_model.h",
        "include/h2_mfg_recording.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//libs/h2loader/device:api"],
)

cc_library(
    name = "session",
    srcs = [
        "src/h2_mfg.c",
        "src/h2_mfg_nfc.c",
    ],
    hdrs = [
        "include/h2_mfg.h",
        "src/h2_mfg_internal.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":model",
        "//libs/runtime",
    ],
)

h2_tasks(
    name = "camera_tasks",
    tasks = [
        "$mfg/camera",
    ],
)

lvgl_font(
    name = "factory_font",
    size = 22,
    out = "h2_mfg_factory_font.c",
    bpp = 4,
    font = "//libs/ui/fonts/noto_sans_sc:NotoSansSC-Bold.ttf",
    font_name = "h2_mfg_factory_font",
    lv_include = "lvgl.h",
    # Common spatial labels may be supplied by a profile, outside UI prose.
    ranges = [
        "0x20-0x7E",
        "0x5DE6",
        "0x53F3",
    ],
    symbol_sources = ["src/h2_mfg_ui.c"],
)

cc_library(
    name = "mfg",
    srcs = [
        "src/h2_mfg_aec.c",
        "src/h2_mfg_hardware.c",
        "src/h2_mfg_peripherals.c",
        "src/h2_mfg_ui.c",
        ":factory_font",
    ],
    hdrs = ["src/h2_mfg_font.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [
        ":session",
        "//libs/sync/atomic",
    ] + select({
        "//tools/bazel/platforms:is_bk7258": ["//libs/ui/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32c3": ["//libs/ui/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32p4": ["//libs/ui/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32s3": ["//libs/ui/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32s31": ["//libs/ui/lvgl:firmware"],
        "//conditions:default": [
            "//libs/ui/lvgl:platform",
            "//libs/ui/lvgl:upstream",
        ],
    }),
)

