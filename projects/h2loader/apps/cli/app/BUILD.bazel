load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "h2loader_cli_app",
    srcs = [
        "src/h2_h2loader_cli_app.c",
        "src/h2_h2loader_cli_bleikcp_speed.c",
        "src/h2_h2loader_cli_internal.h",
        "src/h2_h2loader_cli_output.c",
        "src/h2_h2loader_cli_package_command.c",
        "src/h2_h2loader_cli_server_command.c",
    ],
    hdrs = ["include/h2_h2loader_cli_app.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/bleikcp",
        "//libs/command",
        "//libs/h2loader_host",
        "//libs/pal",
        "//libs/runtime",
    ],
)

