load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "h2loader_bleikcp.c",
    "task_names.c",
])

h2_tasks(
    name = "tasks",
    tasks = [
        "h2loader/appcmd",
    ],
)

h2_tasks(
    name = "ble_tasks",
    tasks = ["h2loader/blecmd"],
)

cc_library(
    name = "loader",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = glob(
        ["**"],
        allow_empty = True,
        exclude = [
            "BUILD.bazel",
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ) + glob(
        [
            "examples/**",
            "test/**",
            "tests/**",
        ],
        allow_empty = True,
    ) + [
    ],
    includes = [
        "include",
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ble_tasks",
        ":tasks",
        "//libs/command",
        "//libs/h2loader/device",
        "//libs/net/bleikcp",
        "//libs/runtime",
        "//pal",
    ],
)

cc_test(
    name = "lifetime_test",
    srcs = ["tests/test_lifetime.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":loader"],
)
