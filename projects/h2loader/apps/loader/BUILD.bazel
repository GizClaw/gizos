load("//tools/bazel:app_version.bzl", "app_version")

package(default_visibility = ["//visibility:public"])

app_version(
    name = "version",
    value = "0.2.3",
)

filegroup(
    name = "loader",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "//projects/h2loader/apps/loader/app:loader",
    ],
)
