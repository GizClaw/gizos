load("//tools/bazel:app_version.bzl", "app_version")

package(default_visibility = ["//visibility:public"])

app_version(
    name = "version",
    value = "0.1.0",
)

# The DevKit atomic image has a distinct App version from the shared releases.
app_version(
    name = "version_devkit_atomic",
    value = "0.2.3-atomic-541",
)

filegroup(
    name = "loader",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "//projects/h2loader/apps/loader/app:loader",
    ],
)
