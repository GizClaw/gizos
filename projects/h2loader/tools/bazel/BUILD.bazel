load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel:app_version.bzl", "app_version")
load("//tools/bazel:firmware.bzl", "firmware_version")
load(":h2loader_tar_zlib.bzl", "h2loader_encrypted_package", "h2loader_tar_zlib")
load(":h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load(":tests/encrypted_package_analysis.bzl", "encrypted_package_analysis_tests")
load(":tests/package_rules.bzl", "bk_package_rules_firmware", "package_rules_firmware")

package(default_visibility = ["//visibility:public"])

exports_files([
    "h2loader_firmware.bzl",
    "h2loader_tar_zlib.bzl",
    "h2loader_zlib_tar.bzl",
    "checksum_matrix.bzl",
])

py_library(
    name = "firmware_artifacts",
    srcs = ["firmware_artifacts.py"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

py_test(
    name = "firmware_artifacts_test",
    srcs = [
        "tests/bk_package_fixture.py",
        "tests/test_firmware_artifacts.py",
    ],
    data = [
        "tests/fixtures/h2loader_format1.sha256",
        "tests/fixtures/h2loader_format1.tar.zlib",
        "tests/fixtures/h2loader_format2.sha256",
    ],
    legacy_create_init = 0,
    main = "tests/test_firmware_artifacts.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":firmware_artifacts",
        ":firmware_output",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "firmware_output",
    srcs = ["firmware_output.py"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":firmware_artifacts",
        "//tools/bazel:bk7258_flash_aes",
    ],
)

py_binary(
    name = "h2loader_tar_zlib_runner",
    srcs = ["h2loader_tar_zlib_runner.py"],
    legacy_create_init = 0,
    main = "h2loader_tar_zlib_runner.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":firmware_output"],
)

py_test(
    name = "h2loader_tar_zlib_runner_test",
    srcs = [
        "tests/bk_package_fixture.py",
        "tests/test_h2loader_tar_zlib_runner.py",
    ],
    data = ["h2loader_tar_zlib_runner.py"],
    legacy_create_init = 0,
    main = "tests/test_h2loader_tar_zlib_runner.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":firmware_output"],
)

py_binary(
    name = "checksum_fixture_writer",
    srcs = ["checksum_fixture_writer.py"],
    legacy_create_init = 0,
    main = "checksum_fixture_writer.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":firmware_artifacts"],
)

_HOST_PACKAGE_TEST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//tools/bazel/platforms:host_windows_target_windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

app_version(
    name = "package_rules_app_version",
    value = "1.0.0",
)

firmware_version(
    name = "package_rules_version",
    build = "//projects/h2loader/tools/bazel/tests/fixtures/boards/fixture:version",
    build_metadata = "fixture",
    main_version = ":package_rules_app_version",
    variant = "e2e",
)

package_rules_firmware(
    name = "package_rules_native",
    target_compatible_with = _HOST_PACKAGE_TEST,
    version = ":package_rules_version",
)

h2loader_tar_zlib(
    name = "package_rules_old",
    board = "fixture",
    firmware = ":package_rules_native",
    image = "app",
    role = "app",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_rules_new",
    source = ":package_rules_old",
)

py_test(
    name = "package_rules_test",
    srcs = ["tests/test_package_rules.py"],
    args = [
        "$(locations :package_rules_old)",
        "$(locations :package_rules_new)",
    ],
    data = [
        ":package_rules_new",
        ":package_rules_old",
    ],
    legacy_create_init = 0,
    main = "tests/test_package_rules.py",
    target_compatible_with = _HOST_PACKAGE_TEST,
)

# Selects the private 32-byte Flash AES key file for :encrypted_package targets.
# The empty default makes an unset key an analysis error, never plaintext.
filegroup(name = "no_encryption_key")

label_flag(
    name = "encryption_key",
    build_setting_default = ":no_encryption_key",
)

_POSIX_PACKAGE_TEST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

py_binary(
    name = "bk_package_fixture_writer",
    testonly = True,
    srcs = ["tests/bk_package_fixture.py"],
    legacy_create_init = 0,
    main = "tests/bk_package_fixture.py",
    target_compatible_with = _HOST_PACKAGE_TEST,
    deps = ["//tools/bazel:bk7258_flash_aes"],
)

bk_package_rules_firmware(
    name = "encrypted_rules_app_native",
    testonly = True,
    role = "app",
    target_compatible_with = _POSIX_PACKAGE_TEST,
    version = ":package_rules_version",
)

bk_package_rules_firmware(
    name = "encrypted_rules_loader_native",
    testonly = True,
    role = "h2loader",
    target_compatible_with = _POSIX_PACKAGE_TEST,
    version = ":package_rules_version",
)

h2loader_tar_zlib(
    name = "encrypted_rules_app_plain",
    testonly = True,
    board = "fixture",
    firmware = ":encrypted_rules_app_native",
    image = "app",
    package_data = ["tests/fixtures/encrypted_package_data/config.txt"],
    package_data_root = "projects/h2loader/tools/bazel/tests/fixtures/encrypted_package_data",
    role = "app",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "encrypted_rules_app_plain_format2",
    testonly = True,
    source = ":encrypted_rules_app_plain",
)

h2loader_tar_zlib(
    name = "encrypted_rules_loader_plain",
    testonly = True,
    board = "fixture",
    firmware = ":encrypted_rules_loader_native",
    image = "mfg",
    role = "h2loader",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "encrypted_rules_loader_plain_format2",
    testonly = True,
    source = ":encrypted_rules_loader_plain",
)

[h2loader_encrypted_package(
    name = source + "_encrypted",
    testonly = True,
    encryption_key = "tests/fixtures/flash_aes_public_test.key",
    source = ":" + source,
) for source in (
    "encrypted_rules_app_plain",
    "encrypted_rules_app_plain_format2",
    "encrypted_rules_loader_plain",
    "encrypted_rules_loader_plain_format2",
)]

filegroup(
    name = "encrypted_rules_evidence",
    testonly = True,
    srcs = [":%s_encrypted" % source for source in (
        "encrypted_rules_app_plain",
        "encrypted_rules_app_plain_format2",
        "encrypted_rules_loader_plain",
        "encrypted_rules_loader_plain_format2",
    )],
    output_group = "encryption_evidence",
)

py_test(
    name = "encrypted_package_rules_test",
    srcs = ["tests/test_encrypted_package_rules.py"],
    args = [
        "$(rootpaths :encrypted_rules_evidence)",
        "$(rootpaths :encrypted_rules_app_plain_encrypted)",
        "$(rootpaths :encrypted_rules_app_plain_format2_encrypted)",
        "$(rootpaths :encrypted_rules_loader_plain_encrypted)",
        "$(rootpaths :encrypted_rules_loader_plain_format2_encrypted)",
        "$(rootpaths :encrypted_rules_app_native)",
        "$(rootpaths :encrypted_rules_loader_native)",
    ],
    data = [
        "tests/fixtures/flash_aes_public_test.key",
        ":encrypted_rules_app_native",
        ":encrypted_rules_app_plain_encrypted",
        ":encrypted_rules_app_plain_format2_encrypted",
        ":encrypted_rules_evidence",
        ":encrypted_rules_loader_native",
        ":encrypted_rules_loader_plain_encrypted",
        ":encrypted_rules_loader_plain_format2_encrypted",
    ],
    legacy_create_init = 0,
    main = "tests/test_encrypted_package_rules.py",
    target_compatible_with = _POSIX_PACKAGE_TEST,
    deps = [
        ":firmware_artifacts",
        "//tools/bazel:bk7258_flash_aes",
    ],
)

encrypted_package_analysis_tests(
    name = "encrypted_package_analysis",
    compatibility = _POSIX_PACKAGE_TEST,
    encrypted_target = ":encrypted_rules_app_plain_encrypted",
    plain_esp_source = ":package_rules_old",
    plain_source = ":encrypted_rules_app_plain",
)
