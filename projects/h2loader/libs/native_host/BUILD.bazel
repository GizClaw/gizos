load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "api",
    hdrs = ["h2_h2loader_native.h"],
    includes = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/h2loader_host",
        "//libs/runtime",
    ],
)

cc_library(
    name = "host_path",
    srcs = select({
        "@platforms//os:windows": ["h2_h2loader_native_path_windows.c"],
        "//conditions:default": ["h2_h2loader_native_path_posix.c"],
    }),
    hdrs = ["h2_h2loader_native_path.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "native_host",
    srcs = select({
        "@platforms//os:macos": ["platform_darwin.c"],
        "@platforms//os:linux": ["platform_linux.c"],
        "@platforms//os:windows": ["platform_windows.c"],
        "//conditions:default": [],
    }),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":api",
        ":host_path",
        "//libs/pal",
    ] + select({
        "@platforms//os:macos": [
            "//libs/pal/providers/darwin/pal_core",
            "//libs/pal/providers/desktop/pal_core",
        ],
        "@platforms//os:linux": [
            "//libs/pal/providers/desktop/pal_core",
            "//libs/pal/providers/linux/pal_core",
            "//libs/pal/providers/linux/serial_host",
        ],
        "@platforms//os:windows": [
            "//libs/pal/providers/windows/pal_core",
            "//libs/pal/providers/windows/serial_host",
        ],
        "//conditions:default": [],
    }),
)
