load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "h2loader_headers",
    srcs = glob(["include/*.h"]),
)

h2_tasks(
    name = "tasks",
    tasks = [
        "$h2loader/return",
        "$h2loader/blelink",
        "$h2loader/uartcmd",
    ],
)

cc_library(
    name = "h2loader",
    srcs = [
        "src/h2_loader_app_client.c",
        "src/h2_loader_ble.c",
        "src/h2_loader_boot.c",
        "src/h2_loader_command.c",
        "src/h2_loader_metadata.c",
        "src/h2_loader_mfg.c",
        "src/h2_loader_package.c",
        "src/h2_loader_sha256.c",
        "src/h2_loader_stage.c",
        "src/h2_loader_stage_writer.c",
        "src/h2_loader_status.c",
        "src/h2_loader_task_names.c",
    ],
    hdrs = [
        "include/h2_loader_app_client.h",
        "include/h2_loader_ble.h",
        "include/h2_loader_boot.h",
        "include/h2_loader_command.h",
        "include/h2_loader_memory.h",
        "include/h2_loader_metadata.h",
        "include/h2_loader_package.h",
        "include/h2_loader_sha256.h",
        "include/h2_loader_stage.h",
        "include/h2_loader_status.h",
        "include/h2_loader_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    local_defines = select({
        "//tools/bazel/platforms:is_ac707n": ["H2_LOADER_REQUIRE_OUTPUT_CALLBACK=1"],
        "//conditions:default": [],
    }),
    deps = [
        ":tasks",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/pal",
        "//tools/bazel:vendor_third_party_zlib",
    ],
)

cc_test(
    name = "h2loader_sha256_test",
    srcs = ["tests/test_h2loader_sha256.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":h2loader"],
)

