load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "WINDOWS_X86_64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "startup_failure_fixture",
    srcs = [
        "h2_h2loader_cli_startup_failure_fixture.c",
        "h2_h2loader_cli_target.h",
        "main.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = ["//projects/h2loader/apps/cli/app:h2loader_cli_app"],
)

py_test(
    name = "native_cli_test",
    size = "small",
    srcs = ["test_h2_h2loader_cli_native.py"],
    args = [
        "$(location :h2loader)",
        "$(location :startup_failure_fixture)",
    ],
    data = [
        ":h2loader",
        ":startup_failure_fixture",
    ],
    legacy_create_init = 0,
    main = "test_h2_h2loader_cli_native.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "host_path",
    srcs = select({
        "@platforms//os:windows": ["h2_h2loader_cli_host_path_windows.c"],
        "//conditions:default": ["h2_h2loader_cli_host_path_posix.c"],
    }),
    hdrs = ["h2_h2loader_cli_host_path.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:is_macos_arm64": [],
        "//tools/bazel/platforms:is_linux_x86_64": [],
        "//tools/bazel/platforms:is_linux_arm64": [],
        "//tools/bazel/platforms:is_windows_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "host_path_test",
    srcs = ["h2_h2loader_cli_host_path_test.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":host_path"],
)

cc_test(
    name = "windows_host_path_test",
    srcs = ["h2_h2loader_cli_host_path_windows_test.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = WINDOWS_X86_64_ARTIFACT_COMPATIBILITY,
    deps = [":host_path"],
)

cc_test(
    name = "target_lifecycle_test",
    srcs = [
        "h2_h2loader_cli_target.h",
        "h2_h2loader_cli_target_test.c",
    ] + select({
        "@platforms//os:macos": ["platform_darwin.c"],
        "@platforms//os:linux": ["platform_linux.c"],
        "@platforms//os:windows": ["platform_windows.c"],
        "//conditions:default": [],
    }),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:is_macos_arm64": [],
        "//tools/bazel/platforms:is_linux_x86_64": [],
        "//tools/bazel/platforms:is_linux_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":host_path",
        "//libs/pal",
        "//projects/h2loader/apps/cli/app:h2loader_cli_app",
    ] + select({
        "@platforms//os:macos": [
            "//libs/pal/providers/darwin/pal_core",
            "//libs/pal/providers/desktop/pal_core",
        ],
        "@platforms//os:linux": [
            "//libs/pal/providers/desktop/pal_core",
            "//libs/pal/providers/linux/pal_core",
            "//libs/pal/providers/linux/serial_host",
        ],
        "@platforms//os:windows": [
            "//libs/pal/providers/windows/pal_core",
            "//libs/pal/providers/windows/serial_host",
        ],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "h2loader",
    srcs = [
        "h2_h2loader_cli_target.h",
        "main.c",
    ] + select({
        "@platforms//os:macos": ["platform_darwin.c"],
        "@platforms//os:linux": ["platform_linux.c"],
        "@platforms//os:windows": ["platform_windows.c"],
        "//conditions:default": [],
    }),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:is_macos_arm64": [],
        "//tools/bazel/platforms:is_linux_x86_64": [],
        "//tools/bazel/platforms:is_linux_arm64": [],
        "//tools/bazel/platforms:is_windows_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":host_path",
        "//libs/command",
        "//libs/pal",
        "//libs/runtime",
        "//projects/h2loader/apps/cli/app:h2loader_cli_app",
    ] + select({
        "@platforms//os:macos": [
            "//libs/pal/providers/darwin/pal_core",
            "//libs/pal/providers/desktop/pal_core",
        ],
        "@platforms//os:linux": [
            "//libs/pal/providers/desktop/pal_core",
            "//libs/pal/providers/linux/pal_core",
            "//libs/pal/providers/linux/serial_host",
        ],
        "@platforms//os:windows": [
            "//libs/pal/providers/windows/pal_core",
            "//libs/pal/providers/windows/serial_host",
        ],
        "//conditions:default": [],
    }),
)
