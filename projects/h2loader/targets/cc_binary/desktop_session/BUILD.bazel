load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "h2loader-desktop-session",
    srcs = [
        "session.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:is_macos_arm64": [],
        "//tools/bazel/platforms:is_linux_x86_64": [],
        "//tools/bazel/platforms:is_linux_arm64": [],
        "//tools/bazel/platforms:is_windows_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/bleikcp",
        "//libs/command",
        "//libs/h2loader_host",
        "//libs/pal",
        "//libs/runtime",
        "//projects/h2loader/libs/native_host",
    ] + select({
        "@platforms//os:macos": [
            "//libs/pal/providers/darwin/pal_core",
            "//libs/pal/providers/desktop/pal_core",
        ],
        "@platforms//os:linux": [
            "//libs/pal/providers/desktop/pal_core",
            "//libs/pal/providers/linux/pal_core",
            "//libs/pal/providers/linux/serial_host",
        ],
        "@platforms//os:windows": [
            "//libs/pal/providers/windows/pal_core",
            "//libs/pal/providers/windows/serial_host",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "session_source",
    textual_hdrs = ["session.c"],
)

cc_test(
    name = "desktop_session_test",
    srcs = [
        "session_test.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:is_macos_arm64": [],
        "//tools/bazel/platforms:is_linux_x86_64": [],
        "//tools/bazel/platforms:is_linux_arm64": [],
        "//tools/bazel/platforms:is_windows_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":session_source",
        "//libs/bleikcp",
        "//libs/command",
        "//libs/h2loader_host",
        "//libs/pal",
        "//libs/runtime",
        "//projects/h2loader/libs/native_host",
    ] + select({
        "@platforms//os:macos": [
            "//libs/pal/providers/darwin/pal_core",
            "//libs/pal/providers/desktop/pal_core",
        ],
        "@platforms//os:linux": [
            "//libs/pal/providers/desktop/pal_core",
            "//libs/pal/providers/linux/pal_core",
            "//libs/pal/providers/linux/serial_host",
        ],
        "@platforms//os:windows": [
            "//libs/pal/providers/windows/pal_core",
            "//libs/pal/providers/windows/serial_host",
        ],
        "//conditions:default": [],
    }),
)
