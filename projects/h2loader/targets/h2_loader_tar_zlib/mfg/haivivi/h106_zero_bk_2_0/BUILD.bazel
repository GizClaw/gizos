load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib", "h2loader_zlib_tar")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    board_name = "zero_bk_2_0",
    build = "//boards/haivivi/h106_zero_bk_2_0:version",
    main_version = "//projects/h2loader/apps/mfg:version",
    variant = "mfg",
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/h2loader"],
)

bk7258_target_task_policy(
    ap_allocator = "sram",
    ap_default_policy = "7 0 16384 psram",
    ap_policies = [
        "$bk/net/tls default",
        "$bk/net/plain-close default",
        "bk/h2loader 6 0 49152 psram",
        "zero_bk/audio/mic 6 1 4096 psram",
        "zero_bk/audio/mix 5 1 4096 psram",
        "$modem/urc default",
        "h2loader/appcmd 5 0 49152 psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$bleikcp/kcp 5 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2loader/blelink 5 0 4096 psram",
        "$h2loader/return default",
        "$h2loader/uartcmd 5 0 49152 psram",
        "$h2peer/net default",
        "$h2peer/udp default",
        "$runtime/input 5 0 4096 default",
        "$runtime/nfc 5 0 4096 default",
    ],
    cp_default_policy = "6 16384 default",
    graph = [":h2loader_launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/drivers/nfc/fm175xx",
        "//libs/net/apn",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/devices/modem/quectel:quectel_modem",
        "//projects/h2loader/apps/mfg",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h106_zero_bk_2_0:profile.c",
    ],
    hdrs = ["//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:h106_mfg_entry.h"],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h106_zero_bk_2_0/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [],
    hdrs = [],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/haivivi/h106_zero_bk_2_0/bk7258",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//projects/h2loader/apps/headless:tasks",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:h106_mfg_entry.h",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h106_zero_bk_2_0:profile.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "zero_bk_2_0",
    cp_task_policy = ":cp_task_policy",
    graph = [":h2loader_launcher"],
    layout_files = {
        "ap_config": [
            "//boards/haivivi/h106_zero_bk_2_0/bk7258:ap.defaults",
            "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:ap.defaults",
            ":mfg.defaults",
        ],
        "ap_gpio": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:ap_gpio",
        "cp_config": [
            "//boards/haivivi/h106_zero_bk_2_0/bk7258:cp.defaults",
            "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:cp.defaults",
        ],
        "cp_gpio": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:cp_gpio",
        "project_support_files": ["//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:layout"],
        "ram_regions": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:ram_regions",
        "recovery_config": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/mfg:recovery_config",
    },
    project = "CMakeLists.txt",
    project_name = "h2_h106_mfg",
    target = "bk7258",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "zero_bk_2_0",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = ":package",
)

exports_files(["profile.c"])

cc_test(
    name = "profile_test",
    srcs = [
        "profile.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:profile_test.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    local_defines = [
        "H2_EXPECTED_BOARD=zero_bk_2_0",
        "H2_EXPECT_BLE=0",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//projects/h2loader/apps/mfg:session"],
)
