load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    build = "//boards/haivivi/h106_tiga_esp_v4_2:version",
    main_version = "//projects/h2loader/apps/mfg:version",
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["h106/entry"],
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":h2loader_launcher"],
    policies = [
        "h106/entry 4 any 65536 psram",
        "h2loader/appcmd 8 0 49152 psram",
        "h2loader/blecmd 8 0 49152 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net default",
        "$h2peer/udp default",
        "$runtime/input default",
        "$runtime/nfc default",
        "$h2loader/uartcmd 5 0 49152 psram",
        "$modem/urc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/adc",
        "//libs/drivers/audio/es8311",
        "//libs/drivers/nfc/fm175xx",
        "//libs/memory/arena:mem_arena",
        "//libs/net/apn",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/devices/modem/quectel:quectel_modem",
        "//projects/h2loader/apps/mfg",
    ],
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:esp_main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h106_tiga_esp_v4_2:profile.c",
    ],
    hdrs = ["//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:h106_mfg_entry.h"],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h106_tiga_esp_v4_2/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/haivivi/h106_tiga_esp_v4_2/esp32s3",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_adc_oneshot",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_nfc_fm175xx",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:esp_main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:h106_mfg_entry.h",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h106_tiga_esp_v4_2:profile.c",
    ],
    board = "tiga_esp_v4_2",
    graph = [":h2loader_launcher"],
    layout_files = {
        "partition": "//boards/haivivi/h106_tiga_esp_v4_2/esp32s3/layouts/h2loader:partition.csv",
        "project_support_files": ["//boards/haivivi/h106_tiga_esp_v4_2/esp32s3/layouts/h2loader:sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "h2_h106_mfg",
    target = "esp32s3",
    task_policy = ":task_policy",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "tiga_esp_v4_2",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "esp32s3",
)

exports_files(["profile.c"])

cc_test(
    name = "profile_test",
    srcs = [
        "profile.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi:profile_test.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    local_defines = [
        "H2_EXPECTED_BOARD=tiga_esp_v4_2",
        "H2_EXPECT_BLE=1",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//projects/h2loader/apps/mfg:session"],
)
