load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:app_version.bzl", "app_version")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

# H202 bumps its own Loader-role MFG independently of //projects/mfg:version.
app_version(
    name = "version",
    value = "0.3.10",
)

firmware_version(
    name = "firmware_version",
    build = "//boards/haivivi/h202_bk_v3:version",
    main_version = ":version",
)

# Priority and core follow the H106 Zero BK MFG policy (lower number runs
# first): the controller on core 1 like h106/mfg, the audio loop lowest on
# core 1 like mfg-audio, so the board capture (6) and speaker (5) elements
# preempt it, and the eye/NFC/charger worker on core 0 like mfg-led.
bk7258_target_task_policy(
    ap_default_policy = "7 0 16384 psram",
    ap_policies = [
        "h202/entry  6 0 32768 psram",
        "h2loader/appcmd  5 0 49152 psram",
        "h202/mfg  5 1 16384 psram",
        "h202/mfg/audio  9 1 16384 psram",
        "h202/mfg/sensor  5 0 16384 psram",
        "h202/mfg/wifi  5 0 16384 psram",
        "h202/mfg/power  5 0 16384 psram",
        # Declared by shared modules; never created with Bluetooth disabled.
        "$bleikcp/kcp  default",
        "$bleikcp/server  default",
        "$h2loader/blelink  default",
        "$h2loader/return  default",
        "$h2loader/uartcmd  5 0 49152 psram",
        "$h2peer/net  default",
        "$h2peer/udp  default",
        "$runtime/input  5 0 16384 psram",
        "$runtime/nfc  5 0 16384 psram",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":mfg_launcher"],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["h202/entry"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//libs/h2loader/device:firmware_api"],
    native_srcs = ["//libs/h2loader/device:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/drivers/nfc/fm175xx",
        "//libs/net/iostreamikcp",
        "//libs/net/ntp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//pal:unsupported",
        "//projects/h2loader/apps/mfg/h202_bk_v3:mfg",
        "//projects/h2loader/libs/h202_loader_uart",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
        "ap/profile.c",
    ],
    hdrs = [],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/haivivi/h202_bk_v3/ap",
    component_name = "ap",
    data = [
        "ap/CMakeLists.txt",
        "//projects/h2loader/apps/mfg/h202_bk_v3:prompts",
    ],
    execution_unit = "ap",
)

firmware_native_component(
    name = "mfg_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/haivivi/h202_bk_v3/bk7258:mfg",
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_nfc_fm175xx",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/h2_pal_image",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:tasks",
        "//projects/h2loader/apps/mfg/h202_bk_v3:mfg",
    ],
)

cc_library(
    name = "launcher_test_source",
    testonly = True,
    textual_hdrs = [
        "ap/ap_main.c",
        "ap/tests/h2_h202_mfg_launcher_platform.h",
    ],
)

cc_test(
    name = "launcher_test",
    srcs = ["ap/tests/test_mfg_launcher.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    local_defines = ["H2_H202_MFG_LAUNCHER_HOST_TEST=1"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":launcher_test_source",
        "//boards/haivivi/h202_bk_v3/bk7258:loader_headers",
        "//libs/h2loader/device",
        "//libs/sync/atomic/providers/c11",
        "//projects/h2loader/apps/mfg/h202_bk_v3:mfg",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
        "ap/profile.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "h202_bk_v3",
    cp_task_policy = ":cp_task_policy",
    graph = [":mfg_launcher"],
    # Full MFG peripherals; CP/AP link for the fixed Loader execution window.
    layout_files = {
        "ap_config": [
            "//boards/haivivi/h202_bk_v3/bk7258:ap.defaults",
            "//boards/haivivi/h202_bk_v3/bk7258/layouts/mfg:ap.defaults",
        ],
        "ap_gpio": "//boards/haivivi/h202_bk_v3/bk7258/layouts/mfg:ap_gpio",
        "cp_config": [
            "//boards/haivivi/h202_bk_v3/bk7258:cp.defaults",
            "//boards/haivivi/h202_bk_v3/bk7258/layouts/mfg:cp.defaults",
        ],
        "cp_gpio": "//boards/haivivi/h202_bk_v3/bk7258/layouts/mfg:cp_gpio",
        "project_support_files": ["//boards/haivivi/h202_bk_v3/bk7258/layouts/mfg:layout"],
        "ram_regions": "//boards/haivivi/h202_bk_v3/bk7258/layouts/mfg:ram_regions.csv",
        "recovery_config": "//boards/haivivi/h202_bk_v3/bk7258/layouts/loader:bk_loader.json",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_h202_mfg",
    target = "bk7258",
    version = ":firmware_version",
)

h2loader_tar_zlib(
    name = "package",
    board = "h202_bk_v3",
    firmware = ":firmware",
    image = "h202-mfg",
    role = "h2loader",
    target = "bk7258",
)
