load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    board_name = "bk7258_v3_202405",
    build = "//boards/beken/bk7258_v3_202405:version",
    main_version = "//projects/h2loader/apps/mfg:version",
    variant = "mfg",
)

bk7258_target_task_policy(
    ap_allocator = "sram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "$bk/net/tls default",
        "$bk/net/plain-close default",
        "bk/h2loader        6        0  65536  psram",
        "h2_touch           4        0   4096  default",
        "h2loader/appcmd    5        0  49152  psram",
        "h2loader/blecmd    5        0  49152  psram",
        "$h2loader/uartcmd  5        0  49152  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    7        0  49152  psram",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":h2loader_launcher"],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/h2loader"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/h2loader/apps/mfg",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/beken/bk7258_v3_202405:profile.c",
    ],
    hdrs = [],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/beken/bk7258_v3_202405/bk7258",
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:ble_tasks",
        "//projects/h2loader/apps/headless:tasks",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/beken/bk7258_v3_202405:profile.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [
        ":h2loader_launcher",
    ],
    # Factory uses the board's complete peripheral configuration and display
    # RAM plan at the existing primary Loader Flash addresses.
    layout_files = {
        "ap_config": [
            "//boards/beken/bk7258_v3_202405/bk7258:ap.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ap.defaults",
            ":mfg.defaults",
            ":touch.defaults",
        ],
        "ap_gpio": "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ap_gpio_display",
        "cp_config": [
            "//boards/beken/bk7258_v3_202405/bk7258:cp.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:cp.defaults",
            ":mfg.defaults",
        ],
        "cp_gpio": "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:cp_gpio",
        "project_support_files": ["//boards/beken/bk7258_v3_202405/bk7258/layouts/loader:layout"],
        "ram_regions": "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ram_regions",
        "recovery_config": "//boards/beken/bk7258_v3_202405/bk7258/layouts/loader:recovery_config",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_mfg",
    target = "bk7258",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "bk7258",
)

exports_files(["profile.c"])
