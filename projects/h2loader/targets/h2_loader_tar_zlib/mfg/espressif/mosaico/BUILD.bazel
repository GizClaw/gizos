load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

package(default_visibility = ["//visibility:public"])

alias(
    name = "version",
    actual = "//projects/h2loader/apps/mfg:version",
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["mosaico/mfg"],
)

esp_target_task_policy(
    default_policy = "4 any 8192 psram",
    graph = [":h2loader_launcher"],
    policies = [
        "mosaico/mfg 4 any 65536 psram",
        "h2loader/appcmd    8        0  8192  psram",
        "h2loader/blecmd    8        0  8192  psram",
        "$h2loader/return   8        0  8192  psram",
        "$h2loader/blelink  6        0  8192  psram",
        "$bleikcp/kcp       7        0  8192  psram",
        "$bleikcp/server    5        0  8192  psram",
        "$h2peer/net        7        0  8192  psram",
        "$h2peer/udp        7        0  8192  psram",
        "$mfg/camera        5      any  8192  psram",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/uartcmd  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/h2loader/apps/mfg",
        "//projects/h2loader/apps/mfg:camera_tasks",
    ],
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [
        "main/main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/espressif/mosaico:profile.c",
    ],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/espressif/mosaico/main",
    component_name = "main",
    data = ["main/CMakeLists.txt"],
    tags = ["manual"],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/espressif/mosaico/esp32s31",
        "//libs/archive/bundle",
        "//libs/h2loader/device",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//pal",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/main.c",
        "sdkconfig.mfg.defaults",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/espressif/mosaico:profile.c",
    ],
    board = "esp_mosaico",
    cmake_definitions = {
        "H2_MOSAICO_AUDIO_AEC": "ON",
    },
    graph = [":h2loader_launcher"],
    layout_files = {
        "partition": "//boards/espressif/mosaico/esp32s31/layouts/h2loader:partition.csv",
        "project_support_files": ["//boards/espressif/mosaico/esp32s31/layouts/h2loader:sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "h2_mfg",
    target = "esp32s31",
    task_policy = ":task_policy",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "esp_mosaico",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "esp32s31",
)

exports_files(["profile.c"])
