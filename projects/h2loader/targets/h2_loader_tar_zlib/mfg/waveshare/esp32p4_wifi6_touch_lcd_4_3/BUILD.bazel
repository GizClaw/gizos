load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    build = "//boards/waveshare/esp32p4_wifi6_touch_lcd_4_3:version",
    main_version = "//projects/h2loader/apps/mfg:version",
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["mfg/entry"],
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":h2loader_launcher"],
    policies = [
        "mfg/entry 4 any 65536 psram",
        "h2loader/appcmd    8        0  4096  psram",
        "h2loader/blecmd    8        0  4096  psram",
        "$h2loader/return   8        0  4096  psram",
        "$h2loader/blelink  6        0  4096  psram",
        "$bleikcp/kcp       7        0  4096  psram",
        "$bleikcp/server    5        0  4096  psram",
        "$h2peer/net        7        0  4096  psram",
        "$h2peer/udp        7        0  4096  psram",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/uartcmd  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/h2loader/apps/mfg",
    ],
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [
        "main/main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/waveshare/esp32p4_wifi6_touch_lcd_4_3:profile.c",
    ],
    hdrs = [],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/waveshare/esp32p4_wifi6_touch_lcd_4_3/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/waveshare/esp32p4_wifi6_touch_lcd_4_3/esp32p4",
        "//libs/archive/bundle",
        "//libs/h2loader/device",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//pal",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
        "//projects/h2loader/targets/h2_loader_tar_zlib/mfg/waveshare/esp32p4_wifi6_touch_lcd_4_3:profile.c",
    ],
    board = "waveshare_esp32p4_wifi6_touch_lcd_4_3",
    graph = [
        ":h2loader_launcher",
    ],
    project = "CMakeLists.txt",
    project_name = "h2_mfg",
    target = "esp32p4",
    task_policy = ":task_policy",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "waveshare_esp32p4_wifi6_touch_lcd_4_3",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "esp32p4",
)

firmware_version(
    name = "gain_version",
    build = "//boards/waveshare/esp32p4_wifi6_touch_lcd_4_3:version",
    main_version = "//projects/h2loader/apps/mfg:version",
    variant = "gain",
)

h2_tasks(
    name = "gain_entry_tasks",
    tasks = ["mfg/gain/entry"],
)

esp_target_task_policy(
    name = "gain_task_policy",
    default_policy = "4 any 4096 psram",
    directory = "gain_task_policy",
    graph = [":gain_launcher"],
    policies = [
        "mfg/gain/entry 4 any 65536 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$h2loader/uartcmd default",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_native_component(
    name = "gain_launcher",
    srcs = ["gain/main/main.c"],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/mfg/waveshare/esp32p4_wifi6_touch_lcd_4_3/gain/main",
    component_name = "main",
    data = [
        "gain/main/CMakeLists.txt",
        "gain/main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        ":gain_entry_tasks",
        "//boards/waveshare/esp32p4_wifi6_touch_lcd_4_3/esp32p4",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "gain_firmware",
    srcs = [
        "gain/CMakeLists.txt",
        "gain/main/CMakeLists.txt",
        "gain/main/idf_component.yml",
        "gain/main/main.c",
    ],
    board = "waveshare_esp32p4_wifi6_touch_lcd_4_3",
    graph = [":gain_launcher"],
    project = "gain/CMakeLists.txt",
    project_name = "h2_mfg_gain",
    target = "esp32p4",
    task_policy = ":gain_task_policy",
    version = ":gain_version",
)

h2loader_tar_zlib(
    name = "gain_package",
    board = "waveshare_esp32p4_wifi6_touch_lcd_4_3",
    firmware = ":gain_firmware",
    image = "mfg-gain",
    role = "h2loader",
    target = "esp32p4",
)

exports_files(["profile.c"])
