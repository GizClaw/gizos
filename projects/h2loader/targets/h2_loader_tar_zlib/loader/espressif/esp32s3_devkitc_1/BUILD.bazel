load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//projects/h2loader/tools/bazel:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    build = "//boards/espressif/esp32s3_devkitc_1:version",
    main_version = "//projects/h2loader/apps/loader:version",
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":h2loader_launcher"],
    policies = [
        "h2loader/appcmd    8        0  4096  psram",
        "h2loader/blecmd    8        0  4096  psram",
        "$h2loader/return   8        0  4096  psram",
        "$h2loader/blelink  6        0  4096  psram",
        "$bleikcp/kcp       7        0  4096  psram",
        "$bleikcp/server    5        0  4096  psram",
        "$h2peer/net        7        0  4096  psram",
        "$h2peer/udp        7        0  4096  psram",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/uartcmd  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
    ],
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [
        "main/main.c",
    ],
    hdrs = [],
    component_directory = "projects/h2loader/targets/h2_loader_tar_zlib/loader/espressif/esp32s3_devkitc_1/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":firmware_lib",
        "//boards/espressif/esp32s3_devkitc_1/esp32s3",
        "//libs/archive/bundle",
        "//libs/h2loader/device",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//pal",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    console = "usb",
    graph = [
        ":h2loader_launcher",
    ],
    project = "CMakeLists.txt",
    project_name = "h2loader",
    target = "esp32s3",
    task_policy = ":task_policy",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "devkit",
    firmware = ":firmware",
    image = "loader",
    role = "h2loader",
    target = "esp32s3",
)

h2loader_esp_idf_firmware(
    name = "firmware_uart_460800",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    console = "uart",
    graph = [
        ":h2loader_launcher",
    ],
    project = "CMakeLists.txt",
    project_name = "h2loader",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package_uart_460800",
    board = "devkit",
    firmware = ":firmware_uart_460800",
    image = "loader",
    role = "h2loader",
    tags = ["no-release"],
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/h2loader/targets/h2_loader_tar_zlib/loader/espressif/esp32s3_devkitc_1:package",
    tags = ["firmware-release"],
)

h2loader_zlib_tar(
    name = "package_uart_460800_v2",
    source = "//projects/h2loader/targets/h2_loader_tar_zlib/loader/espressif/esp32s3_devkitc_1:package_uart_460800",
)
