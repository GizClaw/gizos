load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:web_archive.bzl", "web_archive_serve")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

pkg_files(
    name = "app_files",
    srcs = ["//projects/h2loader/apps/batch-loader/app:web_app"],
    renames = {
        "//projects/h2loader/apps/batch-loader/app:web_app": REMOVE_BASE_DIRECTORY,
    },
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

pkg_files(
    name = "sdk_files",
    srcs = [
        "//projects/h2loader/libs/web:h2loader.wasm",
        "//projects/h2loader/libs/web:h2loader_runtime.js",
        "//projects/h2loader/libs/web:src/h2loader.js",
    ],
    prefix = "sdk",
    renames = {
        "//projects/h2loader/libs/web:h2loader_runtime.js": "h2loader_runtime.js",
        "//projects/h2loader/libs/web:h2loader.wasm": "h2loader.wasm",
        "//projects/h2loader/libs/web:src/h2loader.js": "h2loader.js",
    },
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

pkg_tar(
    name = "batch-loader",
    srcs = [
        "_headers",
        ":app_files",
        ":sdk_files",
    ],
    out = "batch-loader.web.tar",
    mode = "0644",
    portable_mtime = True,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

web_archive_serve(
    name = "serve",
    archive = ":batch-loader",
)

py_test(
    name = "archive_test",
    size = "small",
    srcs = ["archive_test.py"],
    args = ["$(location :batch-loader)"],
    data = [":batch-loader"],
    legacy_create_init = 0,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
