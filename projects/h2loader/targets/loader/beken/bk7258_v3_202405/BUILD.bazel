load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//projects/h2loader/tools/bazel:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

exports_files(["tests/fixtures/bk7258_flash_audit.c"])

firmware_version(
    name = "version",
    build = "//boards/beken/bk7258_v3_202405:version",
    main_version = "//projects/h2loader/apps/loader:version",
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "bk/h2loader        6        0  24576  default",
        "h2loader/appcmd    5        0  49152  psram",
        "h2loader/blecmd    5        0  49152  psram",
        "$h2loader/uartcmd  5        0  49152  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    default",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":h2loader_launcher"],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/h2loader"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//libs/h2loader/device:firmware_api"],
    native_srcs = ["//libs/h2loader/device:firmware_sources"],
    deps = [
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/coremqtt",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
    ],
    hdrs = [],
    component_directory = "projects/h2loader/targets/loader/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/beken/bk7258_v3_202405/bk7258",
        "//libs/bundle",
        "//libs/command",
        "//libs/h2loader/device",
        "//libs/pal",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//projects/h2loader/apps/loader/app:ble_tasks",
        "//projects/h2loader/apps/loader/app:tasks",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [
        ":h2loader_launcher",
    ],
    layout = "loader",
    project = "CMakeLists.txt",
    project_name = "h2_bk_h2loader",
    target = "bk7258",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "loader",
    role = "h2loader",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/h2loader/targets/loader/beken/bk7258_v3_202405:package",
    tags = ["firmware-release"],
)
