load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_jieli_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//projects/h2loader/tools/bazel:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:jieli_task_policy.bzl", "jieli_target_task_policy")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    build = "//boards/jieli/jieli_ac791n_devkit:version",
    main_version = "//projects/h2loader/apps/loader:version",
)

AC791N_COMPATIBILITY = select({
    "//tools/bazel/platforms:ci_graph": [],
    "//tools/bazel/platforms:is_ac791n": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//libs/h2loader/device:firmware_api"],
    native_srcs = [
        "//libs/h2loader/device:firmware_sources",
        "//libs/bundle:src/h2_bundle_archive.c",
        "//libs/bundle:src/h2_bundle_installer.c",
        "//libs/bundle:src/h2_bundle_manifest.c",
        "//libs/bundle:src/h2_bundle_path.c",
        "//libs/bundle:src/h2_bundle_tar.c",
        "//libs/bundle:src/h2_bundle_types.c",
    ],
    deps = [
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/runtime",
    ],
)

h2_tasks(
    name = "startup_tasks",
    tasks = ["h2loader/startup"],
)

jieli_target_task_policy(
    name = "loader_task_policy",
    default_policy = "10 4096 128",
    graph = [":loader_launcher"],
    policies = [
        "h2loader/appcmd 10 12288 128",
        "h2loader/startup 10 4096 128",
        "h2loader/blecmd 10 12288 128",
        "$bleikcp/server 10 12288 128",
        "$bleikcp/kcp 10 1536 128",
        "$h2loader/blelink 10 1536 64",
        "$h2loader/return 10 4096 128",
        "$h2loader/uartcmd 10 4096 128",
        "$runtime/input 10 4096 128",
        "$runtime/nfc 10 4096 128",
    ],
    sdk_policies = [
        "app_core 15 8192 1024",
        "sys_event 29 512 0",
        "systimer 14 256 0",
        "sys_timer 9 512 128",
        "dw_update 21 512 32",
        "#C0btctrler 19 768 384",
        "#C0btstack 18 1536 384",
        "h2loader 10 4096 128",
        "h2loader_rx 12 1024 128",
        "h2console_rx 12 1024 128",
        "audio_server 16 1024 256",
        "audio_decoder 30 1024 64",
        "audio_encoder 12 384 64",
        "audio_mix 28 512 0",
    ],
)

jieli_target_task_policy(
    name = "usb_log_smoke_task_policy",
    default_policy = "10 4096 128",
    graph = [":usb_log_smoke_launcher"],
    policies = [],
    sdk_policies = [
        "app_core 15 8192 1024",
        "sys_event 29 512 0",
        "systimer 14 256 0",
        "sys_timer 9 512 128",
        "usb_log_smoke 10 256 32",
    ],
)

firmware_native_component(
    name = "loader_launcher",
    srcs = [
        "src/loader_launcher.c",
    ],
    component_name = "h2loader_ac791n_devkit_launcher",
    include_roots = [
        "projects/h2loader/apps/loader/app/include",
        "projects/h2loader/apps/loader/app",
        "libs/h2loader/device/include",
    ],
    tags = ["manual"],
    target_compatible_with = AC791N_COMPATIBILITY,
    deps = [
        ":firmware_lib",
        ":startup_tasks",
        "//boards/jieli/jieli_ac791n_devkit/ac791n/layouts/h2loader:warm_boot",
        "//libs/atomic",
        "//native_component_src/jieli/wl82/h2_pal_core",
        "//native_component_src/jieli/wl82/h2_pixa",
        "//native_component_src/jieli/wl82/zlib",
    ],
)

firmware_native_component(
    name = "usb_log_smoke_launcher",
    srcs = ["src/usb_log_smoke.c"],
    component_name = "jieli_ac791n_devkit_usb_log_smoke_launcher",
    tags = ["manual"],
    target_compatible_with = AC791N_COMPATIBILITY,
)

h2loader_jieli_firmware(
    name = "firmware",
    board = "jieli_ac791n_devkit",
    graph = [
        ":loader_launcher",
        "//boards/jieli/jieli_ac791n_devkit/ac791n",
    ],
    image = "loader",
    target = "wl82",
    task_policy = ":loader_task_policy",
    version = ":version",
)

h2loader_jieli_firmware(
    name = "usb_log_smoke_firmware",
    board = "jieli_ac791n_devkit",
    graph = [
        ":usb_log_smoke_launcher",
        "//boards/jieli/jieli_ac791n_devkit/ac791n",
    ],
    image = "usb-log-smoke",
    target = "wl82",
    task_policy = ":usb_log_smoke_task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "jieli_ac791n_devkit",
    firmware = ":firmware",
    image = "loader",
    role = "h2loader",
    target = "wl82",
)

