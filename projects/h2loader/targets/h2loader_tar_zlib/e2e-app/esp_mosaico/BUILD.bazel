load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//projects/h2loader/tools/bazel:checksum_matrix.bzl", "h2loader_checksum_matrix")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":e2e_app_launcher"],
    policies = [
        "h2loader/appcmd    8        0  4096  psram",
        "h2loader/blecmd    8        0  4096  psram",
        "$h2loader/return   8        0  4096  psram",
        "$h2loader/blelink  6        0  4096  psram",
        "$bleikcp/kcp       7        0  4096  psram",
        "$bleikcp/server    5        0  4096  psram",
        "$h2peer/net        7        0  4096  psram",
        "$h2peer/udp        7        0  4096  psram",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/uartcmd  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/audio_mixer",
        "//libs/drivers/audio/es8311",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/wifi_sta",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
        "//libs/pixa",
        "//libs/runtime",
    ],
)

firmware_native_component(
    name = "e2e_app_launcher",
    srcs = ["main/main.c"],
    hdrs = [],
    component_directory = "projects/h2loader/targets/h2loader_tar_zlib/e2e-app/esp_mosaico/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/esp_mosaico/esp32s31",
        "//boards/esp_mosaico/esp32s31:loader_usb",
        "//libs/pal",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
        "sdkconfig.h2loader-e2e.defaults",
    ],
    board = "esp_mosaico",
    graph = [":e2e_app_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2loader_mosaico_e2e",
    target = "esp32s31",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "esp_mosaico",
    firmware = ":firmware",
    image = "e2e-app",
    role = "app",
    target = "esp32s31",
)

# Controlled package identities for the existing public lifecycle/matrix runner.
firmware_version(name = "alternate_version", value = "0.7.2-e2e-mosaico-alt")

h2loader_esp_idf_firmware(
    name = "firmware_alt",
    srcs = ["CMakeLists.txt", "main/CMakeLists.txt", "main/idf_component.yml", "main/main.c", "sdkconfig.h2loader-e2e.defaults"],
    board = "esp_mosaico",
    graph = [":e2e_app_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2loader_mosaico_e2e",
    version = ":alternate_version",
    target = "esp32s31",
    task_policy = ":task_policy",
)
h2loader_tar_zlib(name = "package_alt", board = "esp_mosaico", firmware = ":firmware_alt", image = "e2e-app-alt", role = "app", target = "esp32s31")
h2loader_checksum_matrix(name = "checksum-matrix", base = ":package", alternate = ":package_alt")

h2loader_esp_idf_firmware(
    name = "firmware_crash",
    srcs = ["CMakeLists.txt", "main/CMakeLists.txt", "main/idf_component.yml", "main/main.c", "sdkconfig.h2loader-e2e.defaults"],
    board = "esp_mosaico",
    graph = [":e2e_app_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2loader_mosaico_e2e",
    cmake_definitions = {"H2_MOSAICO_E2E_CRASH_BEFORE_CONFIRM": "ON"},
    target = "esp32s31",
    task_policy = ":task_policy",
)
h2loader_tar_zlib(name = "package_crash", board = "esp_mosaico", firmware = ":firmware_crash", image = "e2e-app-crash", role = "app", target = "esp32s31")
