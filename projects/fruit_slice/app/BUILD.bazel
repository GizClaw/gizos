load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_PRIVATE_HEADERS = [
    "src/h2_fruit_slice_game.h",
    "src/h2_fruit_slice_render.h",
]

_LIBM = select({
    "@platforms//os:linux": ["-lm"],
    "//conditions:default": [],
})

cc_library(
    name = "fruit_slice",
    srcs = _PRIVATE_HEADERS + [
        "src/h2_fruit_slice.c",
        "src/h2_fruit_slice_game.c",
        "src/h2_fruit_slice_render.c",
    ],
    hdrs = ["include/h2_fruit_slice.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    linkopts = _LIBM,
    deps = ["//libs/runtime"],
)

cc_test(
    name = "game_test",
    srcs = _PRIVATE_HEADERS + ["tests/test_game.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":fruit_slice"],
)

cc_test(
    name = "render_test",
    srcs = _PRIVATE_HEADERS + ["tests/test_render.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":fruit_slice"],
)

cc_test(
    name = "app_test",
    srcs = ["tests/test_app.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":fruit_slice",
        "//libs/sync/atomic/providers/c11",
        "//pal:unsupported",
        "//pal/providers/platforms/desktop/pal_core:core",
    ],
)
