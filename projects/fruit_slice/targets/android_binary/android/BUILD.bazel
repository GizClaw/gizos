load("@rules_android//rules:rules.bzl", "android_binary", "android_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel/platforms:compatibility.bzl", "ANDROID_ARM64_ARTIFACT_COMPATIBILITY", "ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "launcher",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        "//pal/providers/platforms/android/pal_core",
        "//pal/providers/platforms/posix/atomic",
        "//projects/fruit_slice/app:fruit_slice",
        "//projects/fruit_slice/libs/native-host:native_host",
    ],
    alwayslink = True,
)

android_library(
    name = "app",
    srcs = ["src/com/gizclaw/fruitslice/MainActivity.java"],
    custom_package = "com.gizclaw.fruitslice",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
    deps = [
        ":launcher",
        "//pal/providers/platforms/android/pal_core:view",
    ],
)

android_binary(
    name = "fruit_slice",
    custom_package = "com.gizclaw.fruitslice",
    manifest = "AndroidManifest.xml",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
    deps = [":app"],
)
