load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "launcher",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":preferences",
        "//libs/sync/atomic/providers/c11",
        "//pal/providers/backends/sdl3",
        "//pal/providers/backends/sqlite",
        "//pal/providers/platforms/desktop/pal_core:core",
        "//projects/fruit_slice/app:fruit_slice",
        "//projects/fruit_slice/libs/native-host:native_host",
    ],
    alwayslink = True,
)

cc_library(
    name = "preferences",
    srcs = ["h2_fruit_slice_desktop_pref.c"],
    hdrs = ["h2_fruit_slice_desktop_pref.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = [
        "//pal/providers/backends/sqlite",
        "//projects/fruit_slice/app:fruit_slice",
    ],
)

cc_test(
    name = "preferences_test",
    srcs = ["tests/test_desktop_pref.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        ":preferences",
        "//projects/fruit_slice/app:fruit_slice",
    ],
)

cc_binary(
    name = "fruit_slice",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":launcher"],
)
