load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_NO_EXCEPTIONS_RTTI_COPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_PIXELROOT32_DEFINES = [
    "PIXELROOT32_ENABLE_AUDIO=0",
    "PIXELROOT32_ENABLE_CAMERA_EFFECTS=0",
    "PIXELROOT32_ENABLE_PARTICLES=0",
    "PIXELROOT32_ENABLE_PHYSICS=1",
    "PIXELROOT32_ENABLE_SCENE_TRANSITIONS=0",
    "PIXELROOT32_ENABLE_STATIC_TILEMAP_FB_CACHE=0",
    "PIXELROOT32_ENABLE_UI_SYSTEM=0",
    "PIXELROOT32_NO_TFT_ESPI=1",
]

cc_library(
    name = "dinotetris",
    srcs = [
        "src/dinotetris.cpp",
        "src/dinotetris_background_argb4444.inc",
        "src/dinotetris_internal.hpp",
    ],
    hdrs = [
        "include/h2_dinotetris.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_NO_EXCEPTIONS_RTTI_COPTS,
    includes = [
        "include",
    ],
    local_defines = _PIXELROOT32_DEFINES,
    deps = [
        "//libs/game_runtime",
        "//libs/game_runtime:pixelroot32",
        "//libs/pal",
        "//libs/pixa",
    ],
)

cc_test(
    name = "dinotetris_test",
    srcs = [
        "src/dinotetris_internal.hpp",
        "tests/test_dinotetris.cpp",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_NO_EXCEPTIONS_RTTI_COPTS,
    includes = [
        "src",
        "tests",
    ],
    local_defines = _PIXELROOT32_DEFINES,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":dinotetris",
        "//libs/game_runtime:game_test_support",
    ],
)
