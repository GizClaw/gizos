load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_PRIVATE_HEADERS = [
    "src/h2_garden_guard_audio.h",
    "src/h2_garden_guard_score.h",
    "src/h2_garden_guard_game.h",
    "src/h2_garden_guard_render.h",
]

_LIBM = select({
    "@platforms//os:linux": ["-lm"],
    "//conditions:default": [],
})

h2_tasks(
    name = "audio_tasks",
    tasks = ["garden-guard/audio"],
)

cc_library(
    name = "garden_guard",
    srcs = _PRIVATE_HEADERS + [
        "src/h2_garden_guard.c",
        "src/h2_garden_guard_audio.c",
        "src/h2_garden_guard_game.c",
        "src/h2_garden_guard_render.c",
        "src/h2_garden_guard_score.c",
        "src/h2_garden_guard_title.inc",
        "src/h2_garden_guard_web_labels.c",
        "src/h2_garden_guard_zh.inc",
        "src/h2_garden_guard_zombies.inc",
    ],
    hdrs = ["include/h2_garden_guard.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + select({
        "//tools/bazel/platforms:is_windows_x86_64": ["/utf-8"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkopts = _LIBM,
    deps = [
        ":audio_tasks",
        "//libs/runtime",
        "//libs/sync/atomic",
    ],
)

cc_test(
    name = "game_test",
    srcs = _PRIVATE_HEADERS + ["tests/test_game.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":garden_guard"],
)

cc_test(
    name = "render_test",
    srcs = _PRIVATE_HEADERS + ["tests/test_render.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":garden_guard"],
)

cc_test(
    name = "score_test",
    srcs = _PRIVATE_HEADERS + ["tests/test_score.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":garden_guard"],
)

cc_test(
    name = "app_test",
    srcs = _PRIVATE_HEADERS + ["tests/test_app.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":garden_guard",
        "//libs/sync/atomic/providers/c11",
        "//pal:unsupported",
        "//pal/providers/platforms/desktop/pal_core:core",
    ],
)
