load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:npm_release.bzl", "npm_release_tarball")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

npm_package(
    name = "firmware",
    srcs = [
        "README.md",
        "package.json",
        "//:LICENSE",
        "//projects/gizclaw/libs/web",
    ],
    include_runfiles = False,
    include_sources = False,
    include_srcs_packages = ["**"],
    include_transitive_sources = False,
    include_transitive_types = False,
    include_types = False,
    publishable = True,
    root_paths = [
        ".",
        "projects/gizclaw/libs/web",
        "projects/gizclaw/libs/web/types",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

npm_release_tarball(
    name = "release_tarball",
    manifest = "package.json",
    package = ":firmware",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "package_test",
    srcs = ["tests/test_package.py"],
    args = [
        "--directory",
        "$(location :release_tarball)",
        "--manifest",
        "$(location package.json)",
        "--node",
        "$(location //projects/gizclaw/libs/web:sdk_node)",
        "--compiler",
        "$(location @h2_typescript//:lib/tsc.js)",
        "--consumer",
        "$(location tests/type_consumer.ts)",
    ],
    data = [
        "package.json",
        "tests/type_consumer.ts",
        ":release_tarball",
        "//projects/gizclaw/libs/web:sdk_node",
        "@h2_typescript//:lib/tsc.js",
        "@h2_typescript//:runtime",
    ],
    legacy_create_init = 0,
    main = "tests/test_package.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
