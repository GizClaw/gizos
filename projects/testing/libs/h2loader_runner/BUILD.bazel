load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "h2loader_e2e_runner",
    srcs = ["src/h2_h2loader_e2e_runner.c"],
    hdrs = ["include/h2_h2loader_e2e_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/archive/bundle",
        "//libs/h2loader/host",
        "//libs/runtime",
        "//pal",
    ],
)

cc_test(
    name = "h2loader_e2e_runner_test",
    size = "small",
    srcs = ["tests/test_h2_h2loader_e2e_runner.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = [":checksum_fixtures"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":h2loader_e2e_runner"],
)

genrule(
    name = "checksum_fixtures",
    srcs = [
        "tests/fixtures/app-a.txt",
        "tests/fixtures/app-b.txt",
    ],
    outs = [
        "tests/checksum-fixtures/tar_zlib/baseline.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/unchanged.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/app-only.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/data-only.update.tar.zlib",
        "tests/checksum-fixtures/tar_zlib/both-changed.update.tar.zlib",
        "tests/checksum-fixtures/zlib_tar/baseline.update.tar",
        "tests/checksum-fixtures/zlib_tar/unchanged.update.tar",
        "tests/checksum-fixtures/zlib_tar/app-only.update.tar",
        "tests/checksum-fixtures/zlib_tar/data-only.update.tar",
        "tests/checksum-fixtures/zlib_tar/both-changed.update.tar",
        "tests/checksum-fixtures/fixtures.json",
    ],
    cmd = "$(location //projects/testing/tools:checksum_fixture_writer) " +
          "--app-a $(location tests/fixtures/app-a.txt) --app-b $(location tests/fixtures/app-b.txt) " +
          "--app-path app/esp/app.bin --board fixture --target esp32s3 " +
          "--version-a 1.0.0-a --version-b 1.0.0-b --output $(@D)/tests/checksum-fixtures",
    tools = ["//projects/testing/tools:checksum_fixture_writer"],
)

py_test(
    name = "h2loader_reboot_monitor_test",
    srcs = ["tests/test_h2loader_reboot_monitor.py"],
    data = [
        "tests/fixtures/serial_reboot_handoff.c",
        "//libs/h2loader/host:include/h2_h2loader_host.h",
        "//libs/h2loader/host:include/h2_h2loader_host_catalog.h",
        "//libs/h2loader/host:src/h2_h2loader_host_command.c",
        "//libs/h2loader/host:src/h2_h2loader_host_internal.h",
        "//libs/h2loader/host:src/h2_h2loader_host_serial.c",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp.h",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp_types.h",
        "//pal:pal_header_files",
        "//projects/testing/libs/h2loader_runner:src/h2_h2loader_e2e_runner.c",
    ],
    legacy_create_init = 0,
    main = "tests/test_h2loader_reboot_monitor.py",
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
)
