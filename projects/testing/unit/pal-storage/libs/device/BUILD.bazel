load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/testing:__subpackages__"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-storage/e2e/runner"],
)

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = ["include/device_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":tasks",
        "//projects/testing/unit/pal-storage/app:pal_storage_e2e",
    ],
)

py_test(
    name = "ledger_verifier_test",
    srcs = [
        "tests/test_verify_device.py",
        "verify_device.py",
    ],
    data = ["//projects/testing/unit/pal-storage/app:include/h2_pal_storage_cases.inc"],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/test_verify_device.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "bk_console_lifecycle_test",
    srcs = ["tests/test_bk_console_lifecycle.py"],
    data = [
        "//libs/h2loader/host:include/h2_h2loader_host.h",
        "//libs/h2loader/host:include/h2_h2loader_host_catalog.h",
        "//libs/h2loader/host:src/h2_h2loader_host_serial.c",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp.h",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp_types.h",
        "//libs/net/iostreamikcp:src/h2_iostreamikcp_frame.c",
        "//pal:pal_header_files",
        "//projects/testing/targets/h2_loader_tar_zlib/unit/pal-storage/beken/bk7258_v3_202405:ap/ap_main.c",
    ],
    legacy_create_init = False,
    main = "tests/test_bk_console_lifecycle.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
