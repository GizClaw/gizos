load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files(["tests/test_calibration.c"])

cc_library(
    name = "aec_calibration",
    srcs = [
        "src/h2_aec_calibration.c",
        "src/h2_aec_calibration_report.c",
    ],
    hdrs = ["include/h2_aec_calibration.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//pal"],
)

cc_test(
    name = "calibration_test",
    srcs = ["tests/test_calibration.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":aec_calibration",
        "//pal:unsupported",
    ],
)
