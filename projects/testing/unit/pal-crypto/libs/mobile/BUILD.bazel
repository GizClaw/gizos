load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel/mobile:mobile_e2e.bzl", "mobile_e2e_suite")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/testing:__subpackages__"])

cc_library(
    name = "runner",
    srcs = ["mobile_runner.c"],
    hdrs = ["mobile_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/runtime",
        "//pal:unsupported",
        "//projects/testing/unit/pal-crypto/app:pal_crypto_e2e",
    ],
)

mobile_e2e_suite(
    name = "mobile_e2e",
    case_count = 22,
    expected = {
        "version": "2.0.0",
        "contract": 1,
        "operations": 15,
        "failed": 0,
        "blocked": 0,
        "not_run": 0,
        "complete": 1,
        "qualified": 1,
        "rc": 0,
        "teardown": 0,
    },
    package = "com.haivivi.gizos.e2e.palcrypto",
    registry = "//projects/testing/unit/pal-crypto/app:include/h2_pal_crypto_cases.inc",
    registry_pattern = "H2_PAL_CRYPTO_CASE\\(\"([^\"]+)\"",
    report = "pal-crypto-result.json",
)
