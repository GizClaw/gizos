load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/testing:__subpackages__"])

cc_library(
    name = "probe",
    srcs = ["probe.c"],
    hdrs = ["probe.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    deps = [
    ] + select({
        "@platforms//os:ios": ["//pal/providers/platforms/ios/pal_core:packaged"],
        "@platforms//os:android": ["//pal/providers/platforms/android/pal_core:packaged"],
        "//conditions:default": ["//pal/providers/backends/yyjson"],
    }) + [
        "//projects/testing/unit/pal-json/app:pal_json_e2e",
    ],
)
