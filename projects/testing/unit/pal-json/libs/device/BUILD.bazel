load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/testing:__subpackages__"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-json/e2e/runner"],
)

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = ["include/device_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":tasks",
        "//pal/providers/backends/yyjson",
        "//projects/testing/unit/pal-json/app:pal_json_e2e",
        "//projects/testing/unit/pal-json/libs/provider-probe:probe",
    ],
)
