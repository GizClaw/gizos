load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "diagnostics",
    srcs = [
        "src/h2_alipay_once.c",
        "src/h2_alipay_trace.c",
    ],
    hdrs = [
        "include/h2_alipay.h",
        "include/h2_alipay_trace.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/crypto/sha256",
        "//pal",
    ],
)

cc_test(
    name = "trace_test",
    size = "small",
    srcs = ["tests/test_trace.c"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":diagnostics"],
)

cc_test(
    name = "trace_cpp_test",
    size = "small",
    srcs = ["tests/test_trace_cpp.cc"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":diagnostics"],
)
