load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "independent",
    srcs = ["src/h2_alipay_e2e_independent.c"],
    hdrs = ["include/h2_alipay_e2e_independent.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/clients/alipay",
        "//projects/testing/integration/alipay/app:api",
        "//projects/testing/integration/alipay/diagnostics",
    ],
)

cc_test(
    name = "payment_test",
    srcs = ["tests/test_payment.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":independent",
        "//libs/clients/alipay:test_binding",
        "//libs/sync/atomic/providers/c11",
        "//libs/testing:testing_pal",
        "//pal/providers/backends/wolfssl:wolfcrypt",
    ],
)
