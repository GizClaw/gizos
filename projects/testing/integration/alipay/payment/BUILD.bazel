load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nfc",
    srcs = ["src/h2_alipay_nfc.c"],
    hdrs = ["include/h2_alipay_nfc.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//pal"],
)

cc_test(
    name = "nfc_test",
    srcs = ["tests/test_nfc.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":nfc"],
)

cc_library(
    name = "payment",
    srcs = ["src/h2_alipay_payment_bridge.c"],
    hdrs = ["include/h2_alipay_payment_bridge.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/clients/alipay:api",
        "//projects/testing/integration/alipay/diagnostics",
    ],
)

cc_library(
    name = "tap_radio",
    srcs = ["src/h2_alipay_tap_radio.c"],
    hdrs = ["include/h2_alipay_tap_radio.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/sync/atomic",
        "//pal",
    ],
)

cc_test(
    name = "tap_radio_test",
    srcs = ["tests/test_tap_radio.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":tap_radio",
        "//libs/sync/atomic/providers/c11",
        "//libs/testing:testing_pal",
    ],
)
