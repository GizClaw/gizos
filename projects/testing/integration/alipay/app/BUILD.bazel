load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "alipay/e2e/runner",
        "alipay/e2e/sdk",
    ],
)

cc_library(
    name = "workflow",
    srcs = ["src/h2_alipay_e2e_workflow.c"],
    hdrs = ["include/h2_alipay_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/runtime",
        "//projects/testing/integration/alipay/diagnostics",
    ],
)

cc_library(
    name = "alipay_e2e",
    srcs = ["src/h2_alipay_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [
        ":tasks",
        ":workflow",
        "//libs/image/qrcode",
        "//libs/sync/atomic",
        "//libs/ui/lvgl",
    ],
)

cc_test(
    name = "workflow_test",
    srcs = ["tests/test_workflow.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":workflow"],
)

cc_test(
    name = "binding_workflow_test",
    srcs = ["tests/test_binding_workflow.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":workflow",
        "//libs/testing:testing_pal",
    ],
)

cc_test(
    name = "page_test",
    srcs = ["tests/test_page.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay_e2e",
        "//libs/image/qrcode",
        "//libs/sync/atomic/providers/c11",
        "//pal/providers/platforms/desktop/pal_core:core",
        "//projects/testing/libs/host_runtime",
    ],
)
