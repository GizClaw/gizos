load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "alipay/e2e/runner",
        "alipay/e2e/sdk",
    ],
)

cc_library(
    name = "api",
    hdrs = [
        "include/h2_alipay.h",
        "include/h2_alipay_payment.h",
    ],
    includes = ["include"],
    deps = [
        ":diagnostics",
        "//pal",
    ],
)

cc_library(
    name = "diagnostics",
    srcs = ["src/h2_alipay_trace.c"],
    hdrs = ["include/h2_alipay_trace.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//libs/crypto/sha256"],
)

cc_library(
    name = "independent",
    srcs = ["src/h2_alipay_e2e_independent.c"],
    hdrs = ["include/h2_alipay_e2e_independent.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":api",
        ":diagnostics",
        "//libs/clients/alipay",
    ],
)

cc_library(
    name = "nfc",
    srcs = ["src/h2_alipay_nfc.c"],
    hdrs = ["include/h2_alipay_nfc.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//pal"],
)

cc_library(
    name = "workflow",
    srcs = [
        "src/h2_alipay_e2e_workflow.c",
        "src/h2_alipay_payment_model.c",
        "src/h2_alipay_payment_model.h",
    ],
    hdrs = ["include/h2_alipay_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":api",
        "//libs/runtime",
    ],
)

cc_library(
    name = "alipay_e2e",
    srcs = [
        "src/h2_alipay_e2e.c",
        "src/h2_alipay_payment_model.h",
        "src/h2_alipay_payment_page.c",
        "src/h2_alipay_payment_page.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [
        ":tasks",
        ":workflow",
        "//libs/crypto/sha256",
        "//libs/image/qrcode",
        "//libs/sync/atomic",
        "//libs/ui/lvgl",
    ],
)

cc_test(
    name = "workflow_test",
    srcs = ["tests/test_workflow.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":workflow"],
)

cc_test(
    name = "binding_workflow_test",
    srcs = ["tests/test_binding_workflow.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":workflow",
        "//libs/testing:testing_pal",
    ],
)

cc_test(
    name = "page_test",
    srcs = ["tests/test_page.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay_e2e",
        "//libs/image/qrcode",
        "//libs/sync/atomic/providers/c11",
        "//libs/ui/lvgl",
        "//pal/providers/platforms/desktop/pal_core:core",
        "//projects/testing/libs/host_runtime",
    ],
)

cc_test(
    name = "payment_model_test",
    srcs = [
        "src/h2_alipay_payment_model.h",
        "tests/test_payment_model.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":workflow"],
)

cc_test(
    name = "payment_page_test",
    srcs = [
        "src/h2_alipay_payment_page.h",
        "tests/test_payment_page.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay_e2e",
        "//libs/image/qrcode",
        "//libs/sync/atomic/providers/c11",
        "//libs/ui/lvgl",
        "//libs/ui/lvgl:display",
        "//pal/providers/platforms/desktop/pal_core:core",
        "//projects/testing/libs/host_runtime",
    ],
)

cc_test(
    name = "public_api_cpp_test",
    srcs = ["tests/test_public_api_cpp.cc"],
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":api",
        ":diagnostics",
    ],
)

cc_test(
    name = "trace_test",
    size = "small",
    srcs = ["tests/test_trace.c"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":diagnostics"],
)

cc_test(
    name = "payment_test",
    srcs = ["tests/test_payment.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":independent",
        "//libs/clients/alipay:test_binding",
        "//libs/sync/atomic/providers/c11",
        "//libs/testing:testing_pal",
        "//pal/providers/backends/wolfssl:wolfcrypt",
    ],
)

cc_test(
    name = "nfc_test",
    srcs = ["tests/test_nfc.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":nfc"],
)
