load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "alipay_sdk",
    srcs = [
        "src/h2_alipay_binding_storage.c",
        "src/h2_alipay_binding_storage.h",
        "src/h2_alipay_storage.c",
    ],
    hdrs = [
        "include/h2_alipay_sdk.h",
        "include/h2_alipay_storage.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/crypto/sha256",
        "//pal",
        "//projects/testing/integration/alipay/diagnostics",
    ],
)

cc_library(
    name = "bind_net_sdk",
    target_compatible_with = ["//tools/bazel/platforms:target_esp32s3"],
    deps = ["@alipay_sdk//:bind_net"],
)

cc_library(
    name = "payment_sdk",
    target_compatible_with = ["//tools/bazel/platforms:target_esp32s3"],
    deps = ["@alipay_sdk//:payments"],
)

filegroup(
    name = "bind_net_sdk_archives",
    srcs = ["@alipay_sdk//:archives"],
    target_compatible_with = ["//tools/bazel/platforms:target_esp32s3"],
)

cc_library(
    name = "sdk_native_api",
    hdrs = [
        "src/h2_alipay_binding_storage.h",
        "src/h2_alipay_sdk_internal.h",
        "src/h2_alipay_sdk_socket_abi.h",
    ],
    includes = ["src"],
    visibility = ["//projects/testing/integration/alipay/vendor_sdk/esp_idf:__pkg__"],
    deps = [
        ":alipay_sdk",
        "@alipay_sdk//:headers",
    ],
)

filegroup(
    name = "binding_sources",
    srcs = [
        "src/h2_alipay_binding_storage.h",
        "src/h2_alipay_sdk.c",
        "src/h2_alipay_sdk_os.c",
        "src/h2_alipay_sdk_random.c",
        ":sdk_fd_sources",
    ],
)

filegroup(
    name = "sdk_sources",
    srcs = [
        "src/h2_alipay_sdk_payment.c",
        ":binding_sources",
    ],
)

filegroup(
    name = "sdk_fd_sources",
    srcs = ["src/h2_alipay_sdk_fd.c"],
)

cc_test(
    name = "sdk_test",
    srcs = [
        "src/h2_alipay_sdk_internal.h",
        "src/h2_alipay_sdk_socket_abi.h",
        "tests/test_sdk.c",
        ":binding_sources",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    tags = ["manual"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay_sdk",
        "//libs/testing:testing_pal",
        "@alipay_sdk//:headers",
    ],
)

cc_test(
    name = "storage_test",
    size = "small",
    srcs = ["tests/test_storage.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay_sdk",
        "//libs/testing:testing_pal",
    ],
)

cc_test(
    name = "payment_test",
    srcs = [
        "src/h2_alipay_sdk_internal.h",
        "src/h2_alipay_sdk_payment.c",
        "tests/test_payment.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    tags = ["manual"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay_sdk",
        "@alipay_sdk//:headers",
    ],
)
