load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "local_peer",
    srcs = ["src/h2_pal_ipv6_local.c"],
    hdrs = [
        "include/h2_pal_ipv6_e2e.h",
        "src/h2_pal_ipv6_local.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "src",
    ],
    deps = [
        "//libs/runtime",
        "//pal",
        "//projects/testing/integration/pal-net-tls/app:pal_net_tls_e2e",
    ],
)

cc_library(
    name = "pal_ipv6_e2e",
    srcs = ["src/h2_pal_ipv6_e2e.c"],
    hdrs = ["include/h2_pal_ipv6_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":local_peer",
        "//libs/net/dns",
        "//libs/runtime",
        "//pal",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//projects/testing/integration/pal-net-tls/app:pal_net_tls_e2e",
        "//projects/testing/unit/pal-webrtc/app:pal_webrtc_e2e",
        "//projects/testing/unit/pal-webrtc/libs/fixture:client",
    ],
)

cc_test(
    name = "local_peer_lifecycle_test",
    srcs = ["tests/test_h2_pal_ipv6_local.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":local_peer",
        "//pal/providers/platforms/desktop/pal_core:core",
    ] + select({
        "@platforms//os:linux": ["//pal/providers/platforms/linux/pal_core"],
        "@platforms//os:macos": ["//pal/providers/platforms/darwin/pal_core"],
        "//conditions:default": [],
    }),
)

exports_files([
    "include/h2_pal_ipv6_cases.inc",
    "src/h2_pal_ipv6_e2e.c",
])
