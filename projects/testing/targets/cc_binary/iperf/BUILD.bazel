load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

# Host-side peer for the device iperf matrix: `server` accepts the PAL client
# (TCP, UDP and SCTP-over-UDP) and `client` runs the same portable matrix from
# the host against any iperf3 server.
cc_binary(
    name = "h2iperf",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    tags = ["manual"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/net/iperf",
        "//libs/sync/atomic/providers/c11",
        "//pal",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/platforms/desktop/pal_core:core",
        "//projects/testing/e2e/iperf/libs/runner:iperf_e2e",
    ] + select({
        "@platforms//os:macos": ["//pal/providers/platforms/darwin/pal_core:host_os"],
        "//conditions:default": ["//pal/providers/platforms/linux/pal_core"],
    }),
)
