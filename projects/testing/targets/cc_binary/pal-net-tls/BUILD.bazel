load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "pal_net_tls",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = [
        "//pal/providers/backends/wolfssl",
        "//pal/providers/platforms/desktop/pal_core",
        "//projects/testing/integration/pal-net-tls/libs/runner",
    ] + select({
        "@platforms//os:macos": ["//pal/providers/platforms/darwin/pal_core:host_os"],
        "//conditions:default": ["//pal/providers/platforms/linux/pal_core"],
    }),
)

py_test(
    name = "desktop_pal_net_tls_test",
    srcs = ["run_desktop.py"],
    args = [
        "--binary",
        "$(location :pal_net_tls)",
    ],
    data = [":pal_net_tls"],
    legacy_create_init = 0,
    main = "run_desktop.py",
    tags = [
        "external",
        "manual",
    ],
    target_compatible_with = _HOST,
    deps = ["//projects/testing/integration/pal-net-tls/libs/fixture"],
)

py_test(
    name = "desktop_pal_net_tls_endpoint_rejection_test",
    srcs = ["run_desktop.py"],
    args = [
        "--binary",
        "$(location :pal_net_tls)",
        "--negative-endpoints",
    ],
    data = [":pal_net_tls"],
    legacy_create_init = 0,
    main = "run_desktop.py",
    tags = [
        "external",
        "manual",
    ],
    target_compatible_with = _HOST,
    deps = ["//projects/testing/integration/pal-net-tls/libs/fixture"],
)
