load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "pal_storage_e2e",
    srcs = [
        "host_config.c",
        "host_config.h",
        "main.cpp",
    ],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = _HOST,
    deps = [
        "//libs/sync/atomic/providers/c11",
        "//pal/providers/backends/sqlite",
        "//pal/providers/platforms/desktop/pal_core",
        "//projects/testing/libs/host_runtime",
        "//projects/testing/unit/pal-storage/app:pal_storage_e2e",
        "//projects/testing/unit/pal-storage/libs/device:runner",
    ] + select({
        "@platforms//os:macos": ["//pal/providers/platforms/darwin/pal_core"],
        "@platforms//os:linux": ["//pal/providers/platforms/linux/pal_core"],
        "//conditions:default": [],
    }),
)

py_test(
    name = "desktop_test",
    timeout = "long",
    srcs = ["run_desktop.py"],
    args = [
        "$(rootpath :pal_storage_e2e)",
        "$(rootpath //projects/testing/unit/pal-storage/app:include/h2_pal_storage_cases.inc)",
    ],
    data = [
        ":pal_storage_e2e",
        "//projects/testing/unit/pal-storage/app:include/h2_pal_storage_cases.inc",
    ],
    legacy_create_init = 0,
    main = "run_desktop.py",
    target_compatible_with = _HOST,
)

py_test(
    name = "cleanup_persistence_test",
    timeout = "long",
    srcs = ["test_cleanup_persistence.py"],
    args = ["$(rootpath :pal_storage_e2e)"],
    data = [":pal_storage_e2e"],
    legacy_create_init = 0,
    main = "test_cleanup_persistence.py",
    target_compatible_with = _HOST,
)

py_test(
    name = "device_lifecycle_test",
    timeout = "long",
    srcs = ["test_device_lifecycle.py"],
    args = ["$(rootpath :pal_storage_e2e)"],
    data = [":pal_storage_e2e"],
    legacy_create_init = 0,
    main = "test_device_lifecycle.py",
    target_compatible_with = _HOST,
)
