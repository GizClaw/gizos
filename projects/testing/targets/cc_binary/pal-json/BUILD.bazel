load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_DEPS = [
    "//libs/sync/atomic/providers/c11",
    "//pal/providers/platforms/desktop/pal_core:core",
    "//pal/providers/backends/yyjson:yyjson",
    "//projects/testing/unit/pal-json/app:pal_json_e2e",
    "//projects/testing/unit/pal-json/libs/provider-probe:probe",
    "//projects/testing/libs/host_runtime",
]

cc_binary(
    name = "pal_json_e2e",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = _DEPS,
)

cc_test(
    name = "desktop_test",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = _DEPS,
)
