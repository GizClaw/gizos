load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

BENCH = "//projects/testing/benchmark/display"

BOARD_BSP = "//boards/beken/bk7258_v3_202405/bk7258"

BOARD_LAYOUT = "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader"

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/display-bench"],
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "bk/display-bench 6 0 24576 default",
        "h2_touch default",
        "h2loader/appcmd 5 0 8192 psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$h2loader/uartcmd 5 0 8192 psram",
        "$bleikcp/kcp default",
        "$bleikcp/server default",
        "$h2peer/net default",
        "$h2peer/udp default",
        "$runtime/input default",
        "$runtime/nfc default",
        "$h2loader/return default",
        "$h2loader/blelink default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = [
        BENCH + ":display_bench.c",
        "//projects/h2loader/libs/device_service:firmware_sources",
    ],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/yyjson",
    ],
)

firmware_native_component(
    name = "ap_launcher",
    srcs = ["ap/main.c"],
    hdrs = [BENCH + ":display_bench.h"],
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
    tags = ["manual"],
)

firmware_native_component(
    name = "launcher",
    tags = ["manual"],
    deps = [
        ":ap_launcher",
        ":entry_tasks",
        ":firmware_lib",
        BOARD_BSP,
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:tasks",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/main.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [":launcher"],
    layout_files = {
        "ap_config": [
            BOARD_BSP + ":ap.defaults",
            BOARD_LAYOUT + ":ap.defaults",
        ],
        "ap_gpio": BOARD_LAYOUT + ":ap_gpio_display",
        "cp_config": [
            BOARD_BSP + ":cp.defaults",
            BOARD_LAYOUT + ":cp.defaults",
        ],
        "cp_gpio": BOARD_LAYOUT + ":cp_gpio",
        "project_support_files": [BOARD_LAYOUT + ":layout"],
        "ram_regions": BOARD_LAYOUT + ":ram_regions",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_display_bench",
    tags = ["manual"],
    target = "bk7258",
    version = BENCH + ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "display-bench",
    role = "app",
    tags = [
        "manual",
        "no-release",
    ],
    target = "bk7258",
)
