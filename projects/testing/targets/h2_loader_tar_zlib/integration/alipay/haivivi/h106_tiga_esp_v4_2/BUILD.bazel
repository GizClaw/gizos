    },
    project = "CMakeLists.txt",
    project_name = "h2_alipay_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "tiga_esp_v4_2",
    firmware = ":firmware",
    image = "alipay-e2e",
    role = "app",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
