cc_test(
    name = "identity_test",
    srcs = [
        "main/h2_alipay_tiga_identity.c",
        "main/h2_alipay_tiga_identity.h",
        "tests/test_identity.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/runtime",
        "//libs/sync/atomic/providers/c11",
        "//libs/testing:testing_pal",
    ],
)

