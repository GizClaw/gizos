load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib", "h2loader_zlib_tar")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    value = "0.1.0-e2e",
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "alipay/e2e/runner 4 0 65536 psram",
        "alipay/e2e/sdk 4 0 65536 psram",
        "h2loader/appcmd 8 0 49152 psram",
        "h2loader/blecmd 8 0 49152 psram",
        "$h2loader/return 8 0 32768 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd 5 0 49152 psram",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
        "$modem/urc 4 any 8192 psram",
        "$lvgl/swdraw 9 0 4096 psram",
        "$lvgl/g2ddraw default",
        "$lvgl/pxpdraw default",
        "$lvgl/nemagfx default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/clients/alipay",
        "//libs/clients/alipay:bind_net_sdk",
        "//libs/command",
        "//libs/drivers/adc",
        "//libs/drivers/audio/es8311",
        "//libs/drivers/nfc/fm175xx",
        "//libs/memory/arena:mem_arena",
        "//libs/net/apn",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/lvgl",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/devices/modem/quectel:quectel_modem",
        "//projects/testing/integration/alipay/app:alipay_e2e",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = [
        "main/h2_alipay_tiga_gateway.c",
        "main/h2_alipay_tiga_identity.c",
        "main/main.c",
        "main/tiga_config.c",
    ],
    hdrs = [
        "main/h2_alipay_e2e_target.h",
        "main/h2_alipay_tiga_gateway.h",
        "main/h2_alipay_tiga_identity.h",
        "//projects/testing/libs/fixture-wifi:h2_e2e_fixture_wifi.h",
    ],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/integration/alipay/haivivi/h106_tiga_esp_v4_2/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "//projects/testing/libs/fixture-wifi:fixture_wifi.cmake",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/haivivi/h106_tiga_esp_v4_2/esp32s3",
        "//libs/clients/alipay:bind_net_sdk",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_adc_oneshot",
        "//native_component_src/esp-idf6.x/h2_alipay",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_esp_audio_decoder",
        "//native_component_src/esp-idf6.x/h2_nfc_fm175xx",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/lvgl_port",
        "//native_component_src/esp-idf6.x/opus_port",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = ["CMakeLists.txt"],
    board = "tiga_esp_v4_2",
    cmake_definitions = {
        "H2_E2E_WIFI_SSID": "HAIVIVI-MFG",
        "H2_E2E_WIFI_PASSWORD": "!haivivi",
    },
    graph = [":launcher"],
    layout_files = {
        "partition": "//boards/haivivi/h106_tiga_esp_v4_2/esp32s3/layouts/h2loader:partition.csv",
        "project_support_files": ["//boards/haivivi/h106_tiga_esp_v4_2/esp32s3/layouts/e2e:sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "h2_alipay_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "tiga_esp_v4_2",
    firmware = ":firmware",
    image = "alipay-e2e",
    role = "app",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = ":package",
)

cc_test(
    name = "identity_test",
    srcs = [
        "main/h2_alipay_tiga_identity.c",
        "main/h2_alipay_tiga_identity.h",
        "tests/test_identity.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/runtime",
        "//libs/sync/atomic/providers/c11",
        "//libs/testing:testing_pal",
    ],
)
