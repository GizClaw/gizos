load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

copy_file(
    name = "launcher_test_source_copy",
    testonly = True,
    src = "ap/ap_main.c",
    out = "tests/zero_bk_launcher.inc",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "launcher_test_source",
    testonly = True,
    hdrs = [":launcher_test_source_copy"],
    includes = ["tests"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "launcher_test",
    srcs = ["//projects/testing/integration/gizclaw/tests/bk_launcher:test_launcher.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    local_defines = ["H2_GIZCLAW_LAUNCHER_SOURCE=zero_bk_launcher.inc"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":launcher_test_source",
        "//libs/net/ntp",
        "//pal/providers/backends/corehttp",
        "//projects/h2loader/libs/device_service:firmware_api",
        "//projects/testing/integration/gizclaw/app:execution",
        "//projects/testing/integration/gizclaw/app:fixture",
        "//projects/testing/integration/gizclaw/tests/bk_launcher:sdk",
    ],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/gizclaw-e2e"],
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "bk/gizclaw-e2e 6 any 24576 default",
        "zero_bk/audio/mic 6 1 4096 psram",
        "zero_bk/audio/mix 5 1 4096 psram",
        "$modem/urc default",
        "gizclaw/e2e/runner 7 0 65536 psram",
        "gizclaw/e2e/launcher 7 0 65536 psram",
        "gizclaw/e2e/wifi default",
        "gizclaw/e2e/job 7 0 32768 psram",
        "$gizclaw/net 7 0 65536 psram",
        "$gizclaw/audio/download 7 0 32768 psram",
        "$gizclaw/device 7 0 131072 psram",
        "$gizclaw/lua/install default",
        "$lua/worker default",
        "$lua/display default",
        "$gizclaw/data-up 7 0 16384 psram",
        "$gizclaw/data-down 7 0 16384 psram",
        "$gizclaw/audio/uplink 7 0 65536 psram",
        "$gizclaw/audio/downlink 7 0 16384 psram",
        "h2loader/appcmd 5 0 8192 psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$h2loader/uartcmd 5 0 8192 psram",
        "$bleikcp/kcp default",
        "$bleikcp/server default",
        "$h2peer/net 7 0 16384 psram",
        "$h2peer/udp 7 0 16384 psram",
        "$runtime/input default",
        "$runtime/nfc default",
        "$h2loader/return default",
        "$h2loader/blelink default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":gizclaw_e2e_launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/clients/gizclaw",
        "//libs/command",
        "//libs/drivers/nfc/fm175xx",
        "//libs/net/apn",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/ntp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/yyjson",
        "//pal/providers/devices/modem/quectel:quectel_modem",
        "//projects/testing/integration/gizclaw/app:gizclaw_e2e",
    ],
)

firmware_native_component(
    name = "gizclaw_e2e_launcher",
    srcs = ["ap/ap_main.c"],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/integration/gizclaw/haivivi/h106_zero_bk_2_0/ap",
    component_name = "ap",
    data = [
        "ap/CMakeLists.txt",
        "//projects/testing/integration/gizclaw:required_fixture",
        "//projects/testing/integration/gizclaw:voice_prompt",
    ],
    execution_unit = "ap",
    tags = ["manual"],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/haivivi/h106_zero_bk_2_0/bk7258",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_gizclaw",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/opus_port",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:tasks",
        "//projects/testing/integration/gizclaw/app:gizclaw_e2e",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
        "//projects/testing/integration/gizclaw:voice_prompt",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "zero_bk_2_0",
    cp_task_policy = ":cp_task_policy",
    graph = [":gizclaw_e2e_launcher"],
    layout_files = {
        "ap_config": [
            "//boards/haivivi/h106_zero_bk_2_0/bk7258:ap.defaults",
            "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:ap.defaults",
            "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:gizclaw-ap.defaults",
        ],
        "ap_gpio": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:ap_gpio",
        "cp_config": [
            "//boards/haivivi/h106_zero_bk_2_0/bk7258:cp.defaults",
            "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:cp.defaults",
        ],
        "cp_gpio": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:cp_gpio",
        "project_support_files": ["//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:layout"],
        "ram_regions": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/e2e:ram_regions",
        "recovery_config": "//boards/haivivi/h106_zero_bk_2_0/bk7258/layouts/h2loader:bk_loader.json",
    },
    project = "CMakeLists.txt",
    project_name = "h2_zero_bk_gizclaw_e2e",
    target = "bk7258",
)

h2loader_tar_zlib(
    name = "package",
    board = "zero_bk_2_0",
    firmware = ":firmware",
    image = "gizclaw-e2e",
    role = "app",
    target = "bk7258",
)
