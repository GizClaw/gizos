load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/h2loader:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "entry_tasks",
    tasks = ["amoled/gizclaw-e2e"],
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":gizclaw_e2e_amoled_launcher"],
    policies = [
        "amoled/gizclaw-e2e 4 any 65536 psram",
        "$gizclaw/net             20       0  65536 psram",
        "h2loader/appcmd          8        0  4096  psram",
        "h2loader/blecmd          8        0  4096  psram",
        "$h2loader/return         8        0  4096  psram",
        "$h2loader/blelink        6        0  4096  psram",
        "$bleikcp/kcp             7        0  4096  psram",
        "$bleikcp/server          5        0  4096  psram",
        "$h2peer/net              20       0  4096  psram",
        "$h2peer/udp              21       0  4096  psram",
        "$gizclaw/audio/download  default",
        "$gizclaw/device          4 any 131072 psram",
        "$gizclaw/lua/install     4 any 8192 psram",
        "$lua/worker              4 any 65536 psram",
        "$lua/display             4 any 32768 psram",
        "$gizclaw/data-up         default",
        "$gizclaw/data-down       default",
        "$gizclaw/audio/uplink    default",
        "$gizclaw/audio/downlink  default",
        "$runtime/input           default",
        "$runtime/nfc             default",
        "gizclaw/e2e/runner       4 any 131072 psram",
        "gizclaw/e2e/wifi         default",
        "gizclaw/e2e/launcher     default",
        "gizclaw/e2e/job          default",
        "$h2loader/uartcmd        default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/clients/gizclaw",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/testing/integration/gizclaw/app:gizclaw_e2e",
        "//projects/testing/integration/gizclaw/libs/device:ledger",
    ],
)

firmware_native_component(
    name = "gizclaw_e2e_amoled_launcher",
    srcs = [
        "main/h2_gizclaw_e2e_amoled_config.c",
        "main/h2_gizclaw_e2e_amoled_ota.c",
        "main/h2_gizclaw_e2e_amoled_state.c",
        "main/main.c",
    ],
    hdrs = [
        "main/h2_gizclaw_e2e_amoled_config.h",
        "main/h2_gizclaw_e2e_amoled_ota.h",
        "main/h2_gizclaw_e2e_amoled_state.h",
    ],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/integration/gizclaw/waveshare/esp32s3_touch_amoled_1_8/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/waveshare/esp32s3_touch_amoled_1_8/esp32s3",
        "//libs/clients/gizclaw",
        "//libs/encoding",
        "//libs/h2loader/device",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_gizclaw",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/opus_port",
        "//native_component_src/esp-idf6.x/zlib",
        "//pal",
        "//pal/providers/backends/corehttp",
        "//projects/testing/integration/gizclaw/app:fixture",
        "//projects/testing/integration/gizclaw/libs/device:ledger",
    ],
)

cc_test(
    name = "gizclaw_e2e_amoled_state_test",
    srcs = [
        "main/h2_gizclaw_e2e_amoled_state.c",
        "main/h2_gizclaw_e2e_amoled_state.h",
        "tests/test_h2_gizclaw_e2e_amoled_state.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//pal"],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/h2_gizclaw_e2e_amoled_config.c",
        "main/h2_gizclaw_e2e_amoled_config.h",
        "main/h2_gizclaw_e2e_amoled_ota.c",
        "main/h2_gizclaw_e2e_amoled_ota.h",
        "main/h2_gizclaw_e2e_amoled_state.c",
        "main/h2_gizclaw_e2e_amoled_state.h",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "amoled",
    cmake_variables = [
        "H2_GIZCLAW_E2E_FIRMWARE_ONLY",
        "H2_GIZCLAW_E2E_LUA_ONLY",
        "H2_GIZCLAW_E2E_LUA_EXPECT_PERSISTED",
        "H2_GIZCLAW_E2E_NET_IO_TRACE",
        "H2_GIZCLAW_E2E_DEVICE_ONLY",
        "H2_GIZCLAW_E2E_RPC_ONLY",
        "H2_GIZCLAW_E2E_VOICE_ONLY",
        "H2_GIZCLAW_E2E_RESOURCE_ONLY",
        "H2_GIZCLAW_E2E_OTA_ONLY",
        "H2_GIZCLAW_E2E_OTA_TOKEN",
    ],
    graph = [":gizclaw_e2e_amoled_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_gizclaw_e2e_amoled",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "amoled",
    firmware = ":firmware",
    image = "gizclaw-e2e",
    role = "app",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/testing/targets/h2_loader_tar_zlib/integration/gizclaw/waveshare/esp32s3_touch_amoled_1_8:package",
)
