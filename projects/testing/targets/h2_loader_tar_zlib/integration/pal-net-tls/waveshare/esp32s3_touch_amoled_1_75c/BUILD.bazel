load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/h2loader:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    visibility = ["//visibility:public"],
)

# Shared ESP launcher accepts the consuming entry's H2_PAL_NET_TLS_BOARD.
exports_files(["main/main.c"])

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "pal-net-tls/e2e/runner 4 0 65536 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/drivers/motion/qmi8658",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/testing/integration/pal-net-tls/libs/device:runner",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    hdrs = ["//projects/testing/libs/fixture-wifi:h2_e2e_fixture_wifi.h"],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/integration/pal-net-tls/waveshare/esp32s3_touch_amoled_1_75c/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "//projects/testing/libs/fixture-wifi:fixture_wifi.cmake",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/waveshare/esp32s3_touch_amoled_1_75c/esp32s3",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/opus_port",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
        "sdkconfig.pal-net-tls.defaults",
    ],
    board = "waveshare_esp32s3_touch_amoled_1_75c",
    graph = [":launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_pal_net_tls_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "waveshare_esp32s3_touch_amoled_1_75c",
    firmware = ":firmware",
    image = "pal-net-tls",
    role = "app",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/testing/targets/h2_loader_tar_zlib/integration/pal-net-tls/waveshare/esp32s3_touch_amoled_1_75c:package",
)
