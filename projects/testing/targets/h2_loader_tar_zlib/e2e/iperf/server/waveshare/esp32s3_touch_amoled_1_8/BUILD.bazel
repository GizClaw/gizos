load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "ap_startup_cleanup_test",
    srcs = [
        "main/iperf_ap.c",
        "main/iperf_ap.h",
        "tests/test_ap_cleanup.c",
    ] + glob(["tests/sdk/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "main",
        "tests/sdk",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//projects/testing/e2e/iperf/server_app:controller"],
)

# Run the same adapter lifecycle against the actual ESP provider stop entry.
cc_test(
    name = "ap_provider_stop_retry_test",
    srcs = [
        "main/iperf_ap.c",
        "main/iperf_ap.h",
        "tests/test_ap_cleanup.c",
    ] + glob(["tests/sdk/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + ["-DH2_IPERF_TEST_REAL_AP_STOP"],
    includes = [
        "main",
        "tests/sdk",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//native_component_src/esp-idf6.x/h2_pal_core:wifi_ap_stop_test_header",
        "//projects/testing/e2e/iperf/server_app:controller",
    ],
)

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "iperf-server/control 5 0 8192 psram",
        "iperf-server/ipv4 9 0 8192 psram",
        "iperf-server/ipv6 9 0 8192 psram",
        "iperf-server/ui 5 1 16384 psram",
        "$lvgl/swdraw 5 1 8192 psram",
        "$lvgl/g2ddraw default",
        "$lvgl/pxpdraw default",
        "$lvgl/nemagfx default",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/iperf",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/lvgl",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/testing/e2e/iperf/server_app:iperf_server",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = [
        "main/iperf_ap.c",
        "main/main.c",
    ],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/e2e/iperf/server/waveshare/esp32s3_touch_amoled_1_8/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/iperf_ap.h",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/waveshare/esp32s3_touch_amoled_1_8/esp32s3",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/iperf_ap.c",
        "main/iperf_ap.h",
        "main/main.c",
    ],
    board = "amoled",
    cmake_variables = ["H2_IPERF_SERVER_AUTOSTART_MODE"],
    graph = [":launcher"],
    layout_files = {
        "partition": "//boards/waveshare/esp32s3_touch_amoled_1_8/esp32s3/layouts/h2loader:partition.csv",
        "project_support_files": [
            "//boards/waveshare/esp32s3_touch_amoled_1_8/esp32s3/layouts/h2loader:sdkconfig.h2loader.defaults",
            "//boards/waveshare/esp32s3_touch_amoled_1_8/esp32s3/layouts/h2loader:sdkconfig.iperf-server.defaults",
        ],
    },
    project = "CMakeLists.txt",
    project_name = "h2_iperf_server",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "amoled",
    firmware = ":firmware",
    image = "iperf-server",
    role = "app",
    target = "esp32s3",
)
