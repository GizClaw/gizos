load("//tools/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

package(default_visibility = ["//visibility:public"])

copy_file(
    name = "launcher_test_source_copy",
    testonly = True,
    src = "ap/ap_main.c",
    out = "tests/ap_main_for_test.inc",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "launcher_test_source",
    testonly = True,
    hdrs = [":launcher_test_source_copy"],
    includes = ["tests"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "uart_handoff_test",
    srcs = [
        "tests/sdk/bk_private/bk_init.h",
        "tests/sdk/common/sys_config.h",
        "tests/sdk/driver/uart.h",
        "tests/sdk/h2_bk7258_board.h",
        "tests/sdk/h2_bk_platform_core.h",
        "tests/sdk/h2_bk_target_task_policy.h",
        "tests/sdk/os/os.h",
        "tests/sdk/test_sdk.h",
        "tests/test_uart_handoff.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/sdk"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":launcher_test_source",
        "//libs/sync/atomic/providers/c11",
        "//projects/h2loader/libs/device_service:firmware_api",
        "//projects/testing/e2e/iperf/client_app:iperf_client",
    ],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/iperf-client"],
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "bk/iperf-client 6 any 24576 default",
        "h2_touch           default",
        "iperf-client/run 7 0 32768 psram",
        "h2loader/appcmd    5        0  8192  psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$h2loader/uartcmd  5        0  8192  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    default",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":iperf_client_launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/iperf",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/yyjson",
        "//projects/testing/e2e/iperf/client_app:iperf_client",
        "//projects/testing/e2e/iperf/libs/runner:iperf_e2e",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
    ],
    hdrs = [],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/e2e/iperf/client/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)

firmware_native_component(
    name = "iperf_client_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = ["manual"],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/beken/bk7258_v3_202405/bk7258",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:tasks",
        "//projects/testing/e2e/iperf/client_app:iperf_client",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [
        ":iperf_client_launcher",
    ],
    project = "CMakeLists.txt",
    project_name = "h2_bk_iperf_client",
    target = "bk7258",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "iperf-client",
    role = "app",
    target = "bk7258",
)
