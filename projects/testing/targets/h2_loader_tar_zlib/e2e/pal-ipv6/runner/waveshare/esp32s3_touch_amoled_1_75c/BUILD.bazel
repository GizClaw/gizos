load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    visibility = ["//visibility:public"],
)

# Shared ESP launcher accepts the consuming entry's H2_PAL_IPV6_BOARD.
exports_files(["main/main.c"])

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "pal-ipv6/e2e/runner 4 0 65536 psram",
        "pal-ipv6/e2e/http-peer 4 0 8192 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 32768 psram",
        "$h2peer/udp 7 0 8192 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/drivers/motion/qmi8658",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/testing/e2e/pal-ipv6/libs/device:runner",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/e2e/pal-ipv6/runner/waveshare/esp32s3_touch_amoled_1_75c/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/waveshare/esp32s3_touch_amoled_1_75c/esp32s3",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/opus_port",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "waveshare_esp32s3_touch_amoled_1_75c",
    graph = [":launcher"],
    layout_files = {
        "partition": "//boards/waveshare/esp32s3_touch_amoled_1_75c/esp32s3/layouts/h2loader:partition.csv",
        "project_support_files": [
            "//boards/waveshare/esp32s3_touch_amoled_1_75c/esp32s3/layouts/h2loader:sdkconfig.h2loader.defaults",
            "//boards/waveshare/esp32s3_touch_amoled_1_75c/esp32s3/layouts/h2loader:sdkconfig.ipv6-client.defaults",
        ],
    },
    project = "CMakeLists.txt",
    project_name = "h2_pal_ipv6_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "waveshare_esp32s3_touch_amoled_1_75c",
    firmware = ":firmware",
    image = "pal-ipv6",
    role = "app",
    target = "esp32s3",
)
