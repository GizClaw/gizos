load("//projects/testing/tools:checksum_matrix.bzl", "h2loader_checksum_matrix")
load("//tools/bazel/firmware:app_version.bzl", "app_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "entry_tasks",
    tasks = ["devkit/h2loader-e2e"],
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":e2e_app_launcher"],
    policies = [
        "devkit/h2loader-e2e 4 any 65536 psram",
        "h2loader/appcmd    8        0  4096  psram",
        "h2loader/blecmd    8        0  4096  psram",
        "$h2loader/return   8        0  4096  psram",
        "$h2loader/blelink  6        0  4096  psram",
        "$bleikcp/kcp       7        0  4096  psram",
        "$bleikcp/server    5        0  4096  psram",
        "$h2peer/net        7        0  4096  psram",
        "$h2peer/udp        7        0  4096  psram",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/uartcmd  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
    ],
)

firmware_native_component(
    name = "e2e_app_launcher",
    srcs = ["main/main.c"],
    hdrs = [],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/e2e-app/espressif/esp32s3_devkitc_1/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/espressif/esp32s3_devkitc_1/esp32s3",
        "//libs/h2loader/device",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//pal",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware_usb",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    console = "usb",
    graph = [":e2e_app_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2loader_e2e_app",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package_usb",
    board = "devkit",
    firmware = ":firmware_usb",
    image = "e2e-app",
    role = "app",
    target = "esp32s3",
)

h2loader_esp_idf_firmware(
    name = "firmware_uart",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    console = "uart",
    graph = [":e2e_app_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2loader_e2e_app",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package_uart",
    board = "devkit",
    firmware = ":firmware_uart",
    image = "e2e-app",
    role = "app",
    target = "esp32s3",
)

# A distinct linked App identity is required to exercise App-only and both.
app_version(
    name = "alternate_version",
    value = "0.7.2-e2e-alt",
)

h2loader_esp_idf_firmware(
    name = "firmware_usb_alt",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    console = "usb",
    graph = [":e2e_app_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2loader_e2e_app",
    target = "esp32s3",
    task_policy = ":task_policy",
    version = ":alternate_version",
)

h2loader_tar_zlib(
    name = "package_usb_alt",
    board = "devkit",
    firmware = ":firmware_usb_alt",
    image = "e2e-app-alt",
    role = "app",
    target = "esp32s3",
)

h2loader_checksum_matrix(
    name = "checksum-matrix",
    alternate = ":package_usb_alt",
    base = ":package_usb",
)
