load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//projects/testing/unit/pal-mqtt/libs/device:device_test.bzl", "mqtt_device_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/ledger_console.h",
        "main/main.c",
    ],
    visibility = ["//visibility:public"],
)

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "pal-mqtt/e2e/runner 4 0 65536 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/testing/unit/pal-mqtt/app:pal_mqtt_e2e",
        "//projects/testing/unit/pal-mqtt/libs/device:runner",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    hdrs = [
        "main/ledger_console.h",
        "//projects/testing/libs/fixture-wifi:h2_e2e_fixture_wifi.h",
    ],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/pal-mqtt/espressif/esp32s3_devkitc_1/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "//projects/testing/libs/fixture-wifi:fixture_wifi.cmake",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/espressif/esp32s3_devkitc_1/esp32s3",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/ledger_console.h",
        "main/main.c",
        "sdkconfig.pal-mqtt.defaults",
    ],
    board = "devkit",
    console = "usb",
    graph = [":launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_pal_mqtt_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "devkit",
    firmware = ":firmware",
    image = "pal-mqtt",
    role = "app",
    target = "esp32s3",
)

mqtt_device_test(
    name = "device_test",
    package = ":package",
    target = "esp32s3",
)

cc_test(
    name = "ledger_console_test",
    srcs = [
        "main/ledger_console.h",
        "tests/test_ledger_console.c",
        "//projects/testing/targets/h2_loader_tar_zlib/unit/pal-mqtt/beken/bk7258_v3_202405:ap/ledger_console.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//projects/testing/unit/pal-mqtt/libs/device:runner"],
)

py_test(
    name = "ledger_admission_test",
    srcs = [
        "tests/test_ledger_admission.py",
        "//projects/testing/unit/pal-mqtt/libs/device:verify_device.py",
    ],
    args = [
        "$(location :ledger_console_test)",
        "$(location //projects/testing/unit/pal-mqtt/app:include/h2_pal_mqtt_cases.inc)",
    ],
    data = [
        ":ledger_console_test",
        "//projects/testing/unit/pal-mqtt/app:include/h2_pal_mqtt_cases.inc",
    ],
    imports = ["../../../../../../unit/pal-mqtt/libs/device"],
    legacy_create_init = 0,
    main = "tests/test_ledger_admission.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
