load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "board_sources",
    hdrs = ["h2_pal_audio_board_test_sdk.h"],
    includes = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    textual_hdrs = [
        "//projects/testing/unit/pal-audio/app:include/h2_pal_audio_e2e.h",
        "//projects/testing/unit/pal-audio/app:include/h2_pal_audio_cases.inc",
        "//projects/testing/targets/h2_loader_tar_zlib/unit/pal-audio/waveshare/esp32s3_touch_amoled_1_8:main/main.c",
        "//projects/testing/targets/h2_loader_tar_zlib/unit/pal-audio/beken/bk7258_v3_202405:ap/ap_main.c",
    ],
    deps = [
        "//libs/runtime",
        "//projects/h2loader/libs/device_service:firmware_api",
    ],
)

[cc_test(
    name = name,
    srcs = ["test_failure_recovery.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    defines = ["H2_PAL_AUDIO_BOARD_HOST_TEST"] + extra,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":board_sources"],
) for name, extra in [
    ("amoled_failure_recovery_test", []),
    (
        "bk_failure_recovery_test",
        ["H2_PAL_AUDIO_TEST_BK"],
    ),
]]

filegroup(
    name = "recovery_test_inputs",
    srcs = [
        "h2_pal_audio_board_test_sdk.h",
        "test_failure_recovery.c",
    ],
)
