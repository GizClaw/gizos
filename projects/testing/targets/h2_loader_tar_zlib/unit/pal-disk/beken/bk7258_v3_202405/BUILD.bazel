load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//projects/h2loader/tools/bazel:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load("//tools/bazel/firmware:app_version.bzl", "app_version")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

app_version(
    name = "version",
    value = "0.1.0-pal-disk",
)

py_test(
    name = "layout_test",
    srcs = ["tests/test_layout.py"],
    args = [
        "--baseline",
        "$(location //boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:partitions/bk7258/auto_partitions.csv)",
        "--diagnostic",
        "$(location //boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:partitions/bk7258/auto_partitions.csv)",
    ],
    data = [
        "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:partitions/bk7258/auto_partitions.csv",
        "//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:partitions/bk7258/auto_partitions.csv",
    ],
    legacy_create_init = False,
    main = "tests/test_layout.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

# Compile the real entry, board FS and UART implementation with SDK fixtures.
cc_library(
    name = "native_test_sources",
    testonly = True,
    includes = ["tests/sdk"],
    textual_hdrs = [
        "ap/launcher.h",
        "ap/main.c",
        "ap/management.c",
        "tests/sdk/bk_private/bk_init.h",
        "tests/sdk/common/sys_config.h",
        "tests/sdk/h2_bk_target_task_policy.h",
        "tests/sdk/os/os.h",
        "tests/sdk/sdk.h",
        "//boards/beken/bk7258_v3_202405/bk7258/ap:include/h2_bk7258_board.h",
        "//boards/beken/bk7258_v3_202405/bk7258/ap:include/h2_bk7258_board_storage.h",
        "//boards/beken/bk7258_v3_202405/bk7258/ap:src/h2_bk7258_board_private.h",
        "//boards/beken/bk7258_v3_202405/bk7258/ap:src/h2_bk7258_board_runtime.c",
        "//boards/beken/bk7258_v3_202405/bk7258/ap:tests/h2_bk7258_board_runtime_test_sdk.h",
        "//native_component_src/bk7258/ap/h2_pal_core:include/h2_bk_platform_core.h",
        "//native_component_src/bk7258/ap/h2_pal_core:src/h2_bk_platform_uart_io_stream.c",
        "//native_component_src/bk7258/ap/h2_pal_core:tests/h2_bk_uart_io_test_sdk.h",
        "//native_component_src/bk7258/ap/h2_pal_image:include/h2_bk_platform_image.h",
        "//native_component_src/bk7258/ap/h2_pal_storage:include/h2_bk_platform_storage.h",
        "//native_component_src/bk7258/ap/h2_pal_storage:tests/h2_bk_sd_fs_test_sdk.h",
    ],
    deps = [
        "//libs/runtime",
        "//pal/providers/backends/corehttp",
        "//projects/h2loader/libs/device_service:firmware_api",
        "//projects/testing/unit/pal-disk/app:pal_disk_e2e",
    ],
)

[cc_test(
    name = name,
    srcs = [source],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + [
        "-ffunction-sections",
        "-fdata-sections",
        "-Iboards/beken/bk7258_v3_202405/bk7258/ap/include",
        "-Iboards/beken/bk7258_v3_202405/bk7258/ap/src",
        "-Iboards/beken/bk7258_v3_202405/bk7258/ap/tests",
        "-Inative_component_src/bk7258/ap/h2_pal_core/include",
        "-Inative_component_src/bk7258/ap/h2_pal_core/tests",
        "-Inative_component_src/bk7258/ap/h2_pal_image/include",
        "-Inative_component_src/bk7258/ap/h2_pal_storage/include",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-dead_strip"],
        "//conditions:default": ["-Wl,--gc-sections"],
    }),
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        ":native_test_sources",
        "//libs/sync/atomic/providers/c11",
        "//pal:unsupported",
    ],
) for name, source in [
    ("ledger_test", "tests/test_ledger.c"),
    ("management_test", "tests/test_management.c"),
]]

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/yyjson",
        "//projects/testing/unit/pal-disk/app:pal_disk_e2e",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/disk.c",
        "ap/main.c",
        "ap/management.c",
    ],
    hdrs = ["ap/launcher.h"],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/pal-disk/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
    deps = [
        "//pal",
        "//projects/h2loader/libs/device_service:firmware_api",
        "//projects/testing/unit/pal-disk/app:pal_disk_e2e",
    ],
)

firmware_native_component(
    name = "pal_disk_launcher",
    deps = [
        ":ap_launcher_component",
        ":firmware_lib",
        "//boards/beken/bk7258_v3_202405/bk7258",
        "//libs/h2loader/device",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/h2_pal_image",
        "//native_component_src/bk7258/ap/h2_pal_storage",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//projects/h2loader/apps/loader/app:tasks",
        "//projects/testing/unit/pal-disk/app:tasks",
    ],
)

bk7258_target_task_policy(
    ap_allocator = "sram",
    ap_default_policy = "7 0 8192 psram",
    ap_policies = [
        "pal-disk/e2e/writer 7 0 4096 default",
        "pal-disk/e2e/reader 7 1 4096 default",
        "h2loader/appcmd 5 0 32768 psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$h2loader/uartcmd 5 0 8192 psram",
        "$h2loader/return default",
        "$h2loader/blelink default",
        "$bleikcp/kcp default",
        "$bleikcp/server default",
        "$h2peer/net default",
        "$h2peer/udp default",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":pal_disk_launcher"],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = ["CMakeLists.txt"],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [":pal_disk_launcher"],
    layout_files = {
        "ap_config": [
            "//boards/beken/bk7258_v3_202405/bk7258:ap.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ap.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:ap.defaults",
        ],
        "cp_config": [
            "//boards/beken/bk7258_v3_202405/bk7258:cp.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:cp.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:cp.defaults",
        ],
        "ap_gpio": "//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:ap_gpio",
        "cp_gpio": "//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:cp_gpio",
        "project_support_files": ["//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:layout"],
        "ram_regions": "//boards/beken/bk7258_v3_202405/bk7258/layouts/pal_disk:ram_regions",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_pal_disk",
    target = "bk7258",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "pal-disk",
    role = "app",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = ":package",
)
