load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//projects/h2loader/tools/bazel:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")
load("//projects/testing/unit/atomic/libs/device:device_test.bzl", "atomic_device_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

exports_files(
    [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    visibility = ["//visibility:public"],
)

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 internal",
    graph = [":launcher"],
    policies = [
        "atomic/e2e default",
        "atomic/e2e/runner 4 0 65536 psram",
        "atomic/e2e/core0 4 0 8192 internal",
        "atomic/e2e/core1 4 1 8192 internal",
        "atomic/flag/high 9 0 4096 internal",
        "atomic/flag/low 4 0 4096 internal",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//projects/testing/unit/atomic/app:atomic_e2e",
        "//projects/testing/unit/atomic/app:c11_comparison",
        "//projects/testing/unit/atomic/libs/device:runner",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/atomic/espressif/esp32s3_devkitc_1/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/espressif/esp32s3_devkitc_1/esp32s3",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    console = "usb",
    graph = [":launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_atomic_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "devkit",
    firmware = ":firmware",
    image = "atomic-e2e",
    role = "app",
    target = "esp32s3",
)

atomic_device_test(
    name = "device_test",
    package = ":package",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/testing/targets/h2_loader_tar_zlib/unit/atomic/espressif/esp32s3_devkitc_1:package",
)
