load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/h2loader:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["evidence/*.json"]))

copy_file(
    name = "launcher_test_source_copy",
    testonly = True,
    src = "ap/ap_main.c",
    out = "tests/ap_main_for_test.inc",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "launcher_test_source",
    testonly = True,
    hdrs = [":launcher_test_source_copy"],
    includes = ["tests"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

[cc_test(
    name = name,
    srcs = [
        "tests/sdk/bk_private/bk_init.h",
        "tests/sdk/h2_bk7258_board.h",
        "tests/sdk/h2_bk_platform_core.h",
        "tests/sdk/h2_bk_target_task_policy.h",
        "tests/sdk/os/os.h",
        "tests/test_launcher.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/sdk"],
    local_defines = extra,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":launcher_test_source",
        "//pal:unsupported",
        "//projects/h2loader/libs/device_service:firmware_api",
        "//projects/testing/unit/pal-display/libs/device:runner",
    ],
) for name, extra in [
    ("board_capture_launcher_test", []),
    (
        "transfer_capture_launcher_test",
        ["H2_TEST_DISPLAY_TRANSFER"],
    ),
]]

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/pal-display"],
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "bk/pal-display 6 any 24576 default",
        "h2_touch           default",
        "pal-display/e2e/runner 7 0 65536 psram",
        "h2loader/appcmd    5        0  8192  psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$h2loader/uartcmd  5        0  8192  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    default",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":pal_display_launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/yyjson",
        "//projects/testing/unit/pal-display/app:pal_display_e2e",
        "//projects/testing/unit/pal-display/libs/device:runner",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
    ],
    hdrs = [],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/pal-display/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)

firmware_native_component(
    name = "pal_display_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = ["manual"],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/beken/bk7258_v3_202405/bk7258",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:tasks",
        "//projects/testing/unit/pal-display/app:pal_display_e2e",
        "//projects/testing/unit/pal-display/libs/device:runner",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [
        ":pal_display_launcher",
    ],
    layout_files = {
        "ap_config": [
            "//boards/beken/bk7258_v3_202405/bk7258:ap.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ap.defaults",
        ],
        "ap_gpio": "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ap_gpio_display",
        "cp_config": [
            "//boards/beken/bk7258_v3_202405/bk7258:cp.defaults",
            "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:cp.defaults",
        ],
        "cp_gpio": "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:cp_gpio",
        "project_support_files": ["//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:layout"],
        "ram_regions": "//boards/beken/bk7258_v3_202405/bk7258/layouts/h2loader:ram_regions",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_pal_display",
    target = "bk7258",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "pal-display",
    role = "app",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/testing/targets/h2_loader_tar_zlib/unit/pal-display/beken/bk7258_v3_202405:package",
)
