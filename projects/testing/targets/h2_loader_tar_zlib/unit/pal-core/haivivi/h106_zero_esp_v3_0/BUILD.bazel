load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/h2loader:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//tools/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib", "h2loader_zlib_tar")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "entry_tasks",
    tasks = ["h106/entry"],
)

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "h106/entry 4 any 65536 psram",
        "pal-core/e2e/core default",
        "pal-core/e2e/runner 4 0 65536 psram",
        "pal-core/e2e/queue default",
        "pal-core/e2e/condition default",
        "pal-core/e2e/consumer default",
        "pal-core/e2e/producer default",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
        "$modem/urc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/command",
        "//libs/drivers/adc",
        "//libs/drivers/audio/es8311",
        "//libs/drivers/nfc/fm175xx",
        "//libs/memory/arena:mem_arena",
        "//libs/net/apn",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/devices/modem/quectel:quectel_modem",
        "//projects/testing/unit/pal-core/app:pal_core_e2e",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/pal-core/haivivi/h106_zero_esp_v3_0/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":entry_tasks",
        ":firmware_lib",
        "//boards/haivivi/h106_zero_esp_v3_0/esp32s3",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/esp-idf6.x/h2_adc_oneshot",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_nfc_fm175xx",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
        "sdkconfig.pal-core.defaults",
    ],
    board = "zero_esp_v3_0",
    graph = [":launcher"],
    layout_files = {
        "partition": "//boards/haivivi/h106_zero_esp_v3_0/esp32s3/layouts/h2loader:partition.csv",
        "project_support_files": ["//boards/haivivi/h106_zero_esp_v3_0/esp32s3/layouts/h2loader:sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "h2_zero_esp_pal_core",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "zero_esp_v3_0",
    firmware = ":firmware",
    image = "pal-core",
    role = "app",
    target = "esp32s3",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = ":package",
)
