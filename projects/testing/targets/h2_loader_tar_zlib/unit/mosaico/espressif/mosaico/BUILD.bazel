    name = "mqtt_device_test",
    package = "//projects/testing/targets/h2_loader_tar_zlib/unit/mosaico/espressif/mosaico:package",
    target = "esp32s31",
)

genrule(
    name = "suite_source",
    srcs = ["main/main.c"],
    outs = ["selected_main.c"],
    cmd = select({
        ":core": "echo '#define H2_MOSAICO_SUITE_CORE 1' > $@; cat $(location main/main.c) >> $@",
        ":json": "echo '#define H2_MOSAICO_SUITE_JSON 1' > $@; cat $(location main/main.c) >> $@",
        ":crypto": "echo '#define H2_MOSAICO_SUITE_CRYPTO 1' > $@; cat $(location main/main.c) >> $@",
        ":audio_decoder": "echo '#define H2_MOSAICO_SUITE_AUDIO_DECODER 1' > $@; cat $(location main/main.c) >> $@",
        ":net_tls": "echo '#define H2_MOSAICO_SUITE_NET_TLS 1' > $@; cat $(location main/main.c) >> $@",
        ":http": "echo '#define H2_MOSAICO_SUITE_HTTP 1' > $@; cat $(location main/main.c) >> $@",
        ":webrtc": "echo '#define H2_MOSAICO_SUITE_WEBRTC 1' > $@; cat $(location main/main.c) >> $@",
