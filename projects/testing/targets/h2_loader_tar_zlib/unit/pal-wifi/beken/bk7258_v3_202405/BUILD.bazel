load("//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/h2loader:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//tools/bazel/h2loader:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel/h2loader:h2loader_zlib_tar.bzl", "h2loader_zlib_tar")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/pal-wifi"],
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "$bk/net/tls default",
        "$bk/net/plain-close default",
        "bk/pal-wifi 6 any 24576 default",
        "h2_touch           default",
        "pal-wifi/e2e/runner 7 0 65536 psram",
        "pal-wifi/e2e/dhcpdiag 6 0 8192 default",
        "h2loader/appcmd    5        0  8192  psram",
        "h2loader/blecmd 5 0 49152 psram",
        "$h2loader/uartcmd  5        0  8192  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    default",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":pal_wifi_launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    native_deps = ["//projects/h2loader/libs/device_service:firmware_api"],
    native_srcs = ["//projects/h2loader/libs/device_service:firmware_sources"],
    deps = [
        "//libs/archive/bundle",
        "//libs/audio/mixer:audio_mixer",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/net/wifi_sta",
        "//libs/runtime",
        "//libs/ui/pixa",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/yyjson",
        "//projects/testing/unit/pal-wifi/libs/device:runner",
    ],
)

h2_tasks(
    name = "diag_tasks",
    tasks = ["pal-wifi/e2e/dhcpdiag"],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
    ],
    hdrs = [],
    component_directory = "projects/testing/targets/h2_loader_tar_zlib/unit/pal-wifi/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = [
        "ap/CMakeLists.txt",
        "//native_component_src/bk7258/shared:h2_bk_dhcp_ring.h",
    ],
    execution_unit = "ap",
    deps = [
        ":diag_tasks",
        ":entry_tasks",
    ],
)

firmware_native_component(
    name = "pal_wifi_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = ["manual"],
    deps = [
        ":ap_launcher_component",
        ":firmware_lib",
        "//boards/beken/bk7258_v3_202405/bk7258",
        "//libs/h2loader/device",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//native_component_src/bk7258/cp/h2_startup",
        "//pal",
        "//projects/h2loader/apps/headless:tasks",
        "//projects/testing/unit/pal-wifi/libs/device:runner",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [
        ":pal_wifi_launcher",
    ],
    project = "CMakeLists.txt",
    project_name = "h2_bk_pal_wifi",
    target = "bk7258",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "pal-wifi",
    role = "app",
    target = "bk7258",
)

h2loader_zlib_tar(
    name = "package_v2",
    source = "//projects/testing/targets/h2_loader_tar_zlib/unit/pal-wifi/beken/bk7258_v3_202405:package",
)
