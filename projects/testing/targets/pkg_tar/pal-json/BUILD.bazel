load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/web:web_archive.bzl", "web_archive_browser_test", "web_archive_serve")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "_wasm/index",
    srcs = ["main.c"],
    additional_linker_inputs = ["shell.html"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    features = ["-output_format_js"],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
        "-sPROXY_TO_PTHREAD=1",
        "-sPTHREAD_POOL_SIZE=16",
        "--shell-file",
        "$(location shell.html)",
        "--oformat=html",
    ],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/runtime",
        "//libs/sync/atomic/providers/c11",
        "//pal:unsupported",
        "//pal/providers/backends/yyjson",
        "//pal/providers/platforms/web/pal_core",
        "//projects/testing/libs/host_runtime",
        "//projects/testing/unit/pal-json/app:pal_json_e2e",
        "//projects/testing/unit/pal-json/libs/provider-probe:probe",
    ],
)

wasm_cc_binary(
    name = "pal_json_wasm",
    cc_target = ":_wasm/index",
    exit_runtime = True,
    outputs = [
        "index.html",
        "index.js",
        "index.wasm",
    ],
    target_compatible_with = _HOST,
    threads = "emscripten",
)

pkg_tar(
    name = "pal_json",
    srcs = [
        "_headers",
        ":pal_json_wasm",
    ],
    out = "pal-json.web.tar",
    mode = "0644",
    portable_mtime = True,
    strip_prefix = ".",
    target_compatible_with = _HOST,
)

py_test(
    name = "browser_test",
    srcs = ["run_browser.py"],
    args = [
        "$(rootpath :pal_json)",
        "$(rootpath //projects/testing/unit/pal-json/app:include/h2_pal_json_cases.inc)",
    ],
    data = [
        ":pal_json",
        "//projects/testing/unit/pal-json/app:include/h2_pal_json_cases.inc",
        "//tools/bazel/web:web_archive_browser_test.py",
        "//tools/bazel/web:web_archive_server.py",
    ] + select({
        "//tools/bazel/platforms:host_linux_target_linux": ["@h2_playwright_chromium_linux_x86_64//:runtime"],
        "//tools/bazel/platforms:host_macos_target_macos": ["@h2_playwright_chromium_macos_arm64//:runtime"],
        "//conditions:default": [],
    }),
    legacy_create_init = 0,
    main = "run_browser.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
