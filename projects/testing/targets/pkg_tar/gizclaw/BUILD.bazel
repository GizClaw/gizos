load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "_wasm/index",
    srcs = ["main.c"],
    additional_linker_inputs = ["shell.html"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    features = ["-output_format_js"],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
        "-sPROXY_TO_PTHREAD=1",
        "-sPTHREAD_POOL_SIZE=8",
        "-sFORCE_FILESYSTEM=1",
        "-sSTACK_SIZE=131072",
        "--shell-file",
        "$(location shell.html)",
        "--oformat=html",
    ],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/sync/atomic/providers/c11",
        "//pal:unsupported",
        "//pal/providers/platforms/web/pal_core",
        "//projects/testing/integration/gizclaw/libs/mobile:runner",
    ],
)

wasm_cc_binary(
    name = "wasm",
    cc_target = ":_wasm/index",
    exit_runtime = True,
    outputs = [
        "index.html",
        "index.js",
        "index.wasm",
    ],
    target_compatible_with = _HOST,
    threads = "emscripten",
)

pkg_tar(
    name = "gizclaw",
    srcs = [
        "_headers",
        ":wasm",
    ],
    out = "gizclaw.web.tar",
    mode = "0644",
    portable_mtime = True,
    strip_prefix = ".",
    target_compatible_with = _HOST,
)

py_test(
    name = "gizclaw_wasm_live_test",
    size = "enormous",
    srcs = ["run_browser.py"],
    args = [
        "--archive",
        "$(rootpath :gizclaw)",
        "--pcm",
        "$(rootpath //projects/testing/integration/gizclaw:voice_prompt)",
        "--fixture",
        "$(rootpath //projects/testing/integration/gizclaw:app_config_fixture_contract)",
    ],
    data = [
        ":gizclaw",
        "//projects/testing/integration/gizclaw:api_coverage.py",
        "//projects/testing/integration/gizclaw:app_config_fixture_contract",
        "//projects/testing/integration/gizclaw:voice_prompt",
        "//projects/testing/integration/gizclaw/libs/mobile:suite.py",
        "//tools/bazel/web:web_archive_browser_test.py",
        "//tools/bazel/web:web_archive_server.py",
    ] + select({
        "//tools/bazel/platforms:host_linux_target_linux": ["@h2_playwright_chromium_linux_x86_64//:runtime"],
        "//tools/bazel/platforms:host_macos_target_macos": ["@h2_playwright_chromium_macos_arm64//:runtime"],
        "//conditions:default": [],
    }),
    env_inherit = [
        "H2_GIZCLAW_E2E_ENDPOINT",
        "H2_GIZCLAW_E2E_REGISTRATION_TOKEN",
        "H2_GIZCLAW_E2E_DEVICE_API_URL",
        "H2_GIZCLAW_E2E_AUDIO_URL",
    ],
    legacy_create_init = False,
    main = "run_browser.py",
    tags = [
        "external",
        "manual",
    ],
    target_compatible_with = _HOST,
)
