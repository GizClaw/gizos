genrule(
    name = "wall_atlas_generated",
    srcs = ["//projects/example/apps/lua-qi-duel:assets/generated/wall-lights.h2lf"],
    outs = ["wall_atlas_generated.h", "wall_atlas_generated.c"],
    tools = ["//libs/lua:embed_resource"],
    cmd = "$(location //libs/lua:embed_resource) --source $(SRCS) " +
          "--header $(location wall_atlas_generated.h) " +
          "--implementation $(location wall_atlas_generated.c) --symbol qi_duel_wall_atlas",
)

