genrule(
    name = "packed_vector_components",
    srcs = [
        "//projects/example/apps/lua-qi-duel:assets/vector/components/components.h2vp",
        "//projects/example/apps/lua-qi-duel:data/skills/qi-duel/scripts/component_paths.lua",
    ],
    outs = ["components-packed.h2vp", "component_paths_packed.lua"],
    tools = ["//projects/example/apps/lua-qi-duel/tools:pack_vector_components"],
    cmd = "$(location //projects/example/apps/lua-qi-duel/tools:pack_vector_components) " +
          "--bank $(location //projects/example/apps/lua-qi-duel:assets/vector/components/components.h2vp) " +
          "--directory $(location //projects/example/apps/lua-qi-duel:data/skills/qi-duel/scripts/component_paths.lua) " +
          "--output-bank $(location components-packed.h2vp) " +
          "--output-directory $(location component_paths_packed.lua) --screen " + select({
              ":screen_amoled": "amoled",
              ":screen_h106": "h106",
              "//conditions:default": "all",
          }),
)

qi_duel_art(name = "vector_components", src = ":components-packed.h2vp", symbol = "qi_duel_vector_components")
