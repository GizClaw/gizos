cc_library(
    name = "lua_qi_duel",
    local_defines = select({":vectors": ["H2_QI_DUEL_DESKTOP_VECTORS"], "//conditions:default": []}) + select({":vector_only": ["H2_QI_DUEL_VECTOR_ONLY"], "//conditions:default": []}),
    srcs = [
        "src/h2_lua_qi_duel.c",
        "src/qi_duel_link.c",
        "src/qi_duel_link.h",
    ],
    hdrs = [
        "include/h2_lua_qi_duel.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    tags = ["h2-ci-native-package"],
    deps = [
        ":qi_duel_script",
        ":qi_duel_retro_audio",
        ":qi_duel_retro_score",
        ":qi_duel_rules",
        ":qi_duel_link_protocol",
        "//libs/lua",
        "//libs/runtime",
        "//projects/example/apps/lua-bloomspeaker/app:controller",
        "//projects/example/apps/lua-bloomspeaker/app:engine",
        "//libs/bleikcp",
        "//tools/bazel:vendor_third_party_lua",
    ] + select({":vector_only": [], "//conditions:default": [":countdown_rgba", ":impact_labels_rgba", ":wall_atlas", ":arena_atlas", ":opponent_rgba", ":left_rgba", ":right_rgba", ":hud_rgba", ":carousel_rgba", ":charge_rgba", ":skill_styles", ":skill_colors", ":action_opponent", ":action_hands", ":beam_clash_h106", ":beam_clash_amoled", ":beam_clash_fade_h106", ":beam_clash_fade_amoled", ":result_words", ":result_streaks"]}) + select({":vectors": [":vector_components", ":qi_duel_component_paths", ":qi_duel_component_renderer", ":vector_right", ":vector_left", ":qi_duel_procedural", ":vector_opponent", ":vector_charge", ":vector_wave", ":vector_absorb", ":vector_guard"], "//conditions:default": []}),
)

