load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "bleikcp-speed/kcp",
        "bleikcp-speed/server",
        "bleikcp-speed/ui",
        "bleikcp-speed/tx",
    ],
)

cc_library(
    name = "protocol",
    srcs = ["src/protocol.c"],
    hdrs = ["src/internal.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    deps = ["//libs/pal"],
)

cc_library(
    name = "bleikcp_speed",
    srcs = [
        "src/app.c",
        "src/task_names.c",
    ],
    hdrs = [
        "include/h2_bleikcp_speed.h",
        "include/h2_bleikcp_speed_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    deps = [
        ":tasks",
        ":protocol",
        "//libs/bleikcp",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "bleikcp_speed_test",
    srcs = ["tests/test_bleikcp_speed.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    linkopts = ["-lm"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":protocol"],
)
