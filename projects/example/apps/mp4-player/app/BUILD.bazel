load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "task_names",
    srcs = ["src/task_names.c"],
    hdrs = ["include/h2_smoke_mp4_player_task_names.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
)

cc_library(
    name = "mp4_player",
    srcs = ["src/app.c"],
    hdrs = ["include/h2_smoke_mp4_player.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    local_defines = select({
        "//tools/bazel/platforms:is_pi32v2": [
            "H2_MP4_PLAYER_DECODER_TASK_STACK_BYTES=131072",
            "H2_MP4_PLAYER_PROGRESS_LOG_INTERVAL=15",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":task_names",
        "//libs/mp4_decoder",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "mp4_player_large_audio_block_test",
    srcs = ["tests/test_mp4_player.c"],
    args = [
        "$(location //libs/mp4_decoder:tests/fixtures/high_bframes_aac.mp4)",
        "large-audio-block",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = ["//libs/mp4_decoder:tests/fixtures/high_bframes_aac.mp4"],
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":mp4_player"],
)

cc_test(
    name = "mp4_player_test",
    srcs = ["tests/test_mp4_player.c"],
    args = ["$(location //libs/mp4_decoder:tests/fixtures/high_bframes_aac.mp4)"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = ["//libs/mp4_decoder:tests/fixtures/high_bframes_aac.mp4"],
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":mp4_player"],
)
