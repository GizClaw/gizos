load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "button_smoke",
    srcs = ["src/h2_button_smoke.c"],
    hdrs = ["include/h2_button_smoke.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_linux_armv7_gnueabihf": [],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/lvgl",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "button_smoke_test",
    srcs = ["tests/test_h2_button_smoke.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":button_smoke",
        "//libs/atomic/providers/c11",
        "//libs/pal/providers/desktop/pal_core",
        "//libs/runtime",
        "//projects/example/libs/host_runtime",
    ],
)
