load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libs/lua:lua_resource.bzl", "h2_lua_resource")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "h106_viewport",
    hdrs = ["include/h2_fishing_h106_viewport.h"],
    includes = ["include"],
    deps = ["//libs/pal"],
)
h2_lua_resource(
    name = "fishing_game_script",
    src = "//projects/example/apps/lua-fishing-game:data/main.lua",
    symbol = "fishing_game_script",
)
cc_library(
    name = "lua_fishing_game",
    srcs = ["src/h2_lua_fishing_game.c", "src/h2_lua_fishing_math.c", "src/h2_lua_fishing_math.h"],
    hdrs = ["include/h2_lua_fishing_game.h"],
    includes = ["include"],
    conlyopts = H2_C11_OPTS,
    # Speed-prioritize the native physics kernels, without fast-math reassociation.
    copts = H2_WARNING_COPTS + h2_gnu_only_copts(["-O3"]),
    deps = [":fishing_game_script", "//libs/lua", "//libs/runtime", "//tools/bazel:vendor_third_party_lua"],
)
