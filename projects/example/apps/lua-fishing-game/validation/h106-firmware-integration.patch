--- /dev/null
+++ b/projects/h106/targets/h2loader_tar_zlib/lua-fishing-game/tiga_esp_v4_2/main/main.cpp
@@ -0,0 +1,94 @@
+#include "h2_esp_board.h"
+#include "h2_esp_board_config.h"
+#include "h2_esp_target_task_policy.h"
+#include "h2_esp_platform_core.h"
+#include "h2_esp_h2loader_ble.h"
+#include "h2_esp_h2loader_runtime.h"
+#include "h2_lua_fishing_game.h"
+#include "h2_fishing_h106_viewport.h"
+#include "esp_heap_caps.h"
+#include "esp_rom_sys.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include <cstdio>
+#include <new>
+#include <cstring>
+
+static const h2_pal_log_api_t *board_log;
+static int game_log(void *,h2_pal_log_level_t level,const char *scope,const char *message) {
+ if(!message)return H2_PAL_ERR_INVALID_ARG;
+ if(scope && (!std::strcmp(scope,"lua") || !std::strcmp(scope,"lua-fishing-game"))) {
+  std::printf("FISHING_LOG %s %s\n",scope,message);return H2_PAL_OK;
+ }
+ return h2_pal_log_write(board_log,level,scope,message);
+}
+static const h2_pal_log_vtable_t log_vtable={game_log};
+static const h2_pal_log_api_t log_api={nullptr,&log_vtable};
+static void allocation_failed(size_t bytes,uint32_t caps,const char *function) {
+ esp_rom_printf("FISHING_ALLOC_FAIL bytes=%u caps=%u function=%s\n",unsigned(bytes),unsigned(caps),function);
+}
+
+static const h2_runtime_component_mapping_entry_t mappings[] = {
+ {H2_LUA_FISHING_GAME_COMPONENT_VOL_UP,H2_TIGA_ESP_BUTTON_VOL_INC_ID},
+ {H2_LUA_FISHING_GAME_COMPONENT_VOL_DOWN,H2_TIGA_ESP_BUTTON_VOL_DEC_ID},
+ {H2_LUA_FISHING_GAME_COMPONENT_RECORD,H2_TIGA_ESP_BUTTON_RECORD_ID},
+ {H2_LUA_FISHING_GAME_COMPONENT_LEFT,H2_TIGA_ESP_BUTTON_LEFT_ID},
+ {H2_LUA_FISHING_GAME_COMPONENT_RIGHT,H2_TIGA_ESP_BUTTON_RIGHT_ID},
+};
+static h2_pal_result_t list(void *,h2_runtime_component_t filter,h2_runtime_component_mapping_cb_t cb,void *u) {
+ if(!cb)return H2_PAL_ERR_INVALID_ARG;
+ if(filter!=H2_RUNTIME_COMPONENT_NONE && filter!=H2_RUNTIME_COMPONENT_BUTTON)return H2_PAL_OK;
+ for(const auto &m:mappings){auto rc=cb(u,&m);if(rc!=H2_PAL_OK)return rc;}
+ return H2_PAL_OK;
+}
+static h2_pal_result_t get(void *,h2_runtime_component_id_t id,h2_pal_periph_id_t *out) {
+ if(!out)return H2_PAL_ERR_INVALID_ARG;
+ for(const auto &m:mappings)if(m.component_id==id){*out=m.periph_id;return H2_PAL_OK;}
+ return H2_PAL_ERR_NOT_FOUND;
+}
+static const h2_runtime_component_mapper_vtable_t mapper_vtable={list,get};
+static const h2_runtime_component_mapper_t mapper={nullptr,&mapper_vtable};
+static int never_stop(void *) {return 0;}
+static h2_pal_result_t ready(void *u) {
+ auto *runtime=static_cast<h2_runtime_t *>(u);
+ int rc=h2_esp_platform_confirm_running_app();
+ if(rc==H2_PAL_OK)rc=h2_esp_h2loader_app_confirm(runtime);
+ std::printf("FISHING_H106_READY rc=%d physical=240x240 canvas=240x240 resampling=none controls=buttons psram_free=%u internal_free=%u\n",rc,
+   unsigned(heap_caps_get_free_size(MALLOC_CAP_SPIRAM)),unsigned(heap_caps_get_free_size(MALLOC_CAP_INTERNAL)));
+ return static_cast<h2_pal_result_t>(rc);
+}
+static void image_entry(void *) {
+ h2_runtime_config_t config={};
+ h2_runtime_t *runtime=nullptr;
+ int rc=h2_esp_target_task_policy_install();
+ if(rc==H2_PAL_OK)rc=h2_esp_board_runtime_config(&config);
+ if(rc==H2_PAL_OK){board_log=config.log;config.log=&log_api;}
+ if(rc==H2_PAL_OK)rc=h2_esp_h2loader_app_commands_prepare_serial(&config,"lua-fishing-game",1u,3u);
+ if(rc==H2_PAL_OK){
+  config.component_mapper=&mapper;
+  rc=h2_runtime_init(&config,&runtime);
+ }
+ if(rc==H2_PAL_OK)rc=h2_esp_h2loader_app_commands_start(runtime,"lua-fishing-game",1u,3u);
+ if(rc==H2_PAL_OK){
+  h2_runtime_input_poll_config_t input={};input.button_poll_interval_ms=10;
+  rc=h2_runtime_input_start(runtime,&input);
+ }
+ if(rc==H2_PAL_OK){
+  h2_lua_fishing_game_config_t game={};
+  game.profile="amoled";game.layout="h106";game.controls="buttons";game.scene="idle";
+  game.vm_memory_limit_bytes=4u*1024u*1024u;
+  game.should_stop=never_stop;game.on_ready=ready;game.on_ready_user=runtime;
+#if FISHING_H106_INPUT_TEST
+  game.input_test=1;
+#endif
+  rc=h2_lua_fishing_game_run(runtime,&game);
+ }
+ std::printf("FISHING_H106_EXIT rc=%d recovery=app_command\n",rc);
+ // Keep the command service and its borrowed Runtime/providers alive for recovery.
+ for(;;)vTaskDelay(pdMS_TO_TICKS(1000));
+}
+extern "C" void app_main(void) {
+ heap_caps_register_failed_alloc_callback(allocation_failed);
+ auto rc=h2_esp_board_start_entry_task("h106/lua-fishing-game",image_entry,nullptr);
+ if(rc!=H2_PAL_OK)std::printf("FISHING_H106_BOOT_FAIL rc=%d\n",rc);
+}
