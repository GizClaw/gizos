load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "touch_smoke",
    srcs = ["src/h2_touch_smoke.c"],
    hdrs = ["include/h2_touch_smoke.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    # KickPi K4B hardware and the Browser Web target.
    target_compatible_with = select({
        "//tools/bazel/platforms:is_linux_armv7_gnueabihf": [],
        "@platforms//cpu:wasm32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/lvgl",
        "//libs/pal",
        "//libs/runtime",
    ],
)
