load("@rules_android//rules:rules.bzl", "android_binary", "android_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load(
    "//tools/bazel/platforms:compatibility.bzl",
    "ANDROID_ARM64_ARTIFACT_COMPATIBILITY",
    "ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY",
    "LINUX_HOST_TOOL_COMPATIBILITY",
)

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "launcher",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/pal/providers/android/pal_core",
        "//projects/example/libs/host_runtime",
        "//projects/example/libs/mobile/tap-reset:app",
    ],
)

android_library(
    name = "app",
    srcs = ["src/com/haivivi/firmwares/smokeapps/tapreset/MainActivity.java"],
    custom_package = "com.haivivi.firmwares.smokeapps.tapreset",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
    deps = [":launcher"],
)

android_binary(
    name = "tap_reset_app",
    custom_package = "com.haivivi.firmwares.smokeapps.tapreset",
    manifest = "AndroidManifest.xml",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
    deps = [":app"],
)

sh_test(
    name = "package_validation_test",
    srcs = ["validate_package.sh"],
    args = ["$(rootpath :tap_reset_app.apk)"],
    data = [":tap_reset_app.apk"],
    env_inherit = [
        "ANDROID_BUILD_TOOLS_VERSION",
        "ANDROID_HOME",
        "JAVA_HOME",
    ],
    target_compatible_with = LINUX_HOST_TOOL_COMPATIBILITY,
)
