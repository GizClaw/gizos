load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:cc_options.bzl", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

objc_library(
    name = "launcher",
    srcs = ["main.m"],
    copts = [
        "-fobjc-arc",
    ] + H2_WARNING_COPTS + [
        "-Wno-objc-missing-super-calls",
    ],
    sdk_frameworks = [
        "Foundation",
        "UIKit",
    ],
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/pal/providers/ios/pal_core",
        "//projects/example/libs/host_runtime",
        "//projects/example/libs/mobile/tap-reset:app",
    ],
)

ios_application(
    name = "tap_reset_app",
    bundle_id = "com.haivivi.firmwares.smokeapps.tapreset",
    bundle_name = "FirmwaresTapReset",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [":launcher"],
)

sh_test(
    name = "package_validation_test",
    srcs = ["validate_package.sh"],
    args = ["$(rootpath :tap_reset_app.ipa)"],
    data = [":tap_reset_app.ipa"],
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
)
