load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//projects/example/libs/web/app_host:web_app.bzl", "h2_web_app")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

# The LVGL App runs in a Web task until the host stops it; the browser test
# taps its button and requires a clean LVGL, Runtime and platform teardown.
h2_web_app(
    name = "tap-reset",
    srcs = ["main.c"],
    app_name = "tap-reset",
    canvas_min = 1000,
    taps = [[
        "H2_WEB_APP name=tap-reset stage=running",
        180,
        470,
    ]],
    deps = [
        "//projects/example/apps/tap-reset/app:tap_reset_web",
        "//projects/example/libs/web/tap-reset:tap_reset_web",
    ],
)

cc_binary(
    name = "_wasm/web_pal_test",
    testonly = True,
    srcs = ["//libs/pal/providers/web/pal_core:wasm_test_sources"],
    additional_linker_inputs = [
        "//libs/pal/providers/web/pal_core:tests/web_serial_fake.js",
    ],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
        "-sASYNCIFY=1",
        "--pre-js",
        "$(location //libs/pal/providers/web/pal_core:tests/web_serial_fake.js)",
    ],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = ["//libs/pal/providers/web/pal_core"],
)

wasm_cc_binary(
    name = "web_pal_test_wasm",
    testonly = True,
    cc_target = ":_wasm/web_pal_test",
    exit_runtime = True,
    outputs = [
        "web_pal_test.js",
        "web_pal_test.wasm",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

js_test(
    name = "web_pal_test",
    chdir = package_name(),
    copy_data_to_bin = select({
        "//tools/bazel/platforms:is_windows_x86_64": True,
        "//conditions:default": False,
    }),
    data = [":web_pal_test_wasm"],
    entry_point = "web_pal_test.js",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

py_test(
    name = "archive_test",
    size = "small",
    srcs = ["archive_test.py"],
    args = ["$(location :tap-reset)"],
    data = [":tap-reset"],
    legacy_create_init = 0,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
