load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libs/lua/web:lua_web_app.bzl", "h2_lua_web_app")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "smoke_extension",
    srcs = ["smoke_extension.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = ["//libs/lua/web:lua_app_extension"],
)

# Extension hooks: the script needs the smoke.echo capability registered by
# register_host; exit_requested rejects the first Escape release, so the job
# keeps running until the second Escape, and only then does the App pass.
h2_lua_web_app(
    name = "lua-script-extension",
    buttons = {
        "left": "ArrowLeft",
        "ok": "Enter",
        "back": "Escape",
    },
    canvas_min = 300,
    exit_button = "back",
    layout = "//projects/example/targets/pkg_tar/lua-script:layout.html",
    extension = ":smoke_extension",
    passes = [
        "H2_WEB_APP name=lua-script-extension stage=ready",
        "H2_WEB_LUA_APP_SMOKE exit=rejected",
        "H2_WEB_LUA_APP_SMOKE exit=accepted",
        "H2_WEB_APP name=lua-script-extension result=PASS rc=0 fs=0 destroy=0",
    ],
    presses = [
        [
            "H2_WEB_APP name=lua-script-extension stage=ready",
            "Escape",
        ],
        [
            "H2_WEB_LUA_APP_SMOKE exit=rejected",
            "Escape",
        ],
    ],
    script = "smoke.lua",
)
