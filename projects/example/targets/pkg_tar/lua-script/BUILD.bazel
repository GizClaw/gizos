load("@rules_cc//cc:defs.bzl", "cc_library")
load("//projects/example/libs/web/app_host:lua_web_app.bzl", "h2_lua_web_app")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "smoke_extension",
    srcs = ["smoke_extension.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = ["//projects/example/libs/web/app_host:lua_app_extension"],
)

# The script asserts its Button args and the extension capability, then
# animates; the browser test presses Escape, the exit Button, to end it.
h2_lua_web_app(
    name = "lua-script",
    buttons = {
        "left": "ArrowLeft",
        "ok": "Enter",
        "back": "Escape",
    },
    canvas_min = 300,
    exit_button = "back",
    extension = ":smoke_extension",
    passes = [
        "H2_WEB_APP name=lua-script stage=ready",
        "H2_WEB_APP name=lua-script result=PASS rc=0 fs=0 destroy=0",
    ],
    presses = [[
        "H2_WEB_APP name=lua-script stage=ready",
        "Escape",
    ]],
    script = "smoke.lua",
)
