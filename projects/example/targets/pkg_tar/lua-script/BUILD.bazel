load("//libs/lua/web:lua_web_app.bzl", "h2_lua_web_app")

package(default_visibility = ["//visibility:public"])

exports_files(["smoke.lua"])

# Default exit policy plus a page panel: clicking the panel's OK element (a
# non-exit Button) must reach the script's OK callback; then one Escape (the
# exit Button key) release cancels the job and the App passes.
h2_lua_web_app(
    name = "lua-script",
    buttons = {
        "left": "ArrowLeft",
        "ok": "Enter",
        "back": "Escape",
    },
    canvas_min = 300,
    clicks = [[
        "H2_WEB_APP name=lua-script stage=ready",
        "[data-h2-button=ok]",
    ]],
    panel = "panel.html",
    exit_button = "back",
    passes = [
        "H2_WEB_APP name=lua-script stage=ready",
        "H2_WEB_LUA_APP_SMOKE ok=up",
        "H2_WEB_APP name=lua-script result=PASS rc=0 fs=0 destroy=0",
    ],
    presses = [[
        "H2_WEB_LUA_APP_SMOKE ok=up",
        "Escape",
    ]],
    script = "smoke.lua",
)
