load("//libs/lua/web:lua_web_app.bzl", "h2_lua_web_app")

package(default_visibility = ["//visibility:public"])

# //boards/kickpi_k4b/web in the browser: the page gets the board's display size,
# its "device" skin places the canvas, and clicking a skin Button reaches
# the script before the page Stop button ends it.
h2_lua_web_app(
    name = "web-board-kickpi-k4b",
    board = "//boards/kickpi_k4b/web",
    canvas_min = 1000,
    clicks = [
        [
            "H2_WEB_APP name=web-board-kickpi-k4b stage=ready",
            "[data-h2-button=action_button]",
        ],
        [
            "H2_WEB_BOARD_CHECK button=action_button",
            "#stop",
        ],
    ],
    passes = [
        "H2_WEB_BOARD_CHECK size=1024x600",
        "H2_WEB_APP name=web-board-kickpi-k4b stage=ready",
        "H2_WEB_BOARD_CHECK button=action_button",
        "H2_WEB_APP name=web-board-kickpi-k4b result=PASS rc=0 fs=0 destroy=0",
    ],
    script = "//projects/example/targets/pkg_tar/lua-script:board_check.lua",
)
