load("//tools/bazel:web_archive.bzl", "web_archive_browser_test")
load("//tools/bazel/web:web_app.bzl", "h2_web_app")

package(default_visibility = ["//visibility:public"])

# The entry acquires its own filesystem and Button peripheral, then releases
# them after both edges. Failure modes assert partial cleanup and retention.
h2_web_app(
    name = "web-hardware",
    srcs = ["main.c"],
    app_name = "web-hardware",
    passes = [
        "H2_WEB_HARDWARE prepared=1 configured=1 board=web-hardware",
        "H2_WEB_HARDWARE edges=2 accepted=2",
        "H2_WEB_HARDWARE release=1 rc=0",
        "H2_WEB_APP name=web-hardware result=PASS rc=0 fs=0 destroy=0",
    ],
    presses = [[
        "H2_WEB_APP name=web-hardware stage=ready",
        "Enter",
    ]],
    deps = ["//projects/example/libs/host_runtime"],
)

[web_archive_browser_test(
    name = name,
    archive = ":web-hardware",
    passes = ["H2_WEB_HARDWARE checks=PASS"],
    query = "mode=%d" % mode,
    timeout_s = 30,
) for name, mode in [
    ("configure_failure_test", 1),
    ("release_failure_test", 2),
]]
