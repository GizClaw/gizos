load("//libs/pal/providers/web/application_host:web_app.bzl", "h2_web_app")
load("//tools/bazel:web_archive.bzl", "web_archive_browser_test")

package(default_visibility = ["//visibility:public"])

# Board hardware hooks. The browser test presses Enter: the App must see that
# prepare and configure_runtime ran and get both the Down and the Up edge
# through the button hook onto the target's own Button peripheral.
h2_web_app(
    name = "web-hardware",
    srcs = ["main.c"],
    app_name = "web-hardware",
    passes = [
        "H2_WEB_HARDWARE prepared=1 configured=1 board=web-hardware",
        "H2_WEB_HARDWARE edges=2 accepted=2",
        "H2_WEB_HARDWARE release=1 rc=0",
        "H2_WEB_APP name=web-hardware result=PASS rc=0 fs=0 destroy=0",
    ],
    presses = [[
        "H2_WEB_APP name=web-hardware stage=ready",
        "Enter",
    ]],
    deps = [],
)

[web_archive_browser_test(
    name = name,
    archive = ":web-hardware",
    passes = ["H2_WEB_HARDWARE checks=PASS"],
    query = "mode=%d" % mode,
    timeout_s = 30,
) for name, mode in [
    ("configure_failure_test", 1),
    ("release_failure_test", 2),
    ("button_bind_failure_test", 3),
    ("button_unbind_failure_test", 4),
]]
