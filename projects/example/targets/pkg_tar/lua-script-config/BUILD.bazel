load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("//libs/lua/web:lua_web_app.bzl", "h2_lua_web_app")

package(default_visibility = ["//visibility:public"])

# Exercise a real source above the old cap without committing generated bytes.
expand_template(
    name = "script",
    out = "configured.lua",
    substitutions = {"-- SOURCE_PADDING": "--[[" + "p" * 131072 + "]]"},
    template = "check.lua",
)

h2_lua_web_app(
    name = "lua-script-config",
    board = "//projects/example/libs/web/demo_board",
    canvas_min = 1000,
    clicks = [["H2_WEB_APP name=lua-script-config stage=ready", "#stop"]],
    exit_button = "back",
    passes = [
        "LUA_CONFIG args=PASS allocation=786432",
        "H2_WEB_APP name=lua-script-config stage=ready",
        "H2_WEB_APP name=lua-script-config result=PASS rc=0 fs=0 destroy=0",
    ],
    script = ":script",
    script_args = {
        "empty": "",
        "escaped": 'quote=" slash=\\',
        "profile": "procedural",
        "trigraph": "??/",
    },
    source_limit_bytes = 262144,
    vm_memory_limit_bytes = 4194304,
)
