load("//libs/lua/web:lua_web_app.bzl", "h2_lua_web_app")

package(default_visibility = ["//visibility:public"])

# //boards/waveshare_esp32p4_wifi6_touch_lcd_4_3/web in the browser: the page gets the board's display size,
# its "device" skin places the canvas, and clicking a skin Button reaches
# the script before the page Stop button ends it.
h2_lua_web_app(
    name = "web-board-p4-lcd43",
    board = "//boards/waveshare_esp32p4_wifi6_touch_lcd_4_3/web",
    canvas_min = 1000,
    clicks = [
        [
            "H2_WEB_APP name=web-board-p4-lcd43 stage=ready",
            "[data-h2-button=boot]",
        ],
        [
            "H2_WEB_BOARD_CHECK button=boot",
            "#stop",
        ],
    ],
    passes = [
        "H2_WEB_BOARD_CHECK size=480x800",
        "H2_WEB_APP name=web-board-p4-lcd43 stage=ready",
        "H2_WEB_BOARD_CHECK button=boot",
        "H2_WEB_APP name=web-board-p4-lcd43 result=PASS rc=0 fs=0 destroy=0",
    ],
    script = "//projects/example/targets/pkg_tar/lua-script:board_check.lua",
)
