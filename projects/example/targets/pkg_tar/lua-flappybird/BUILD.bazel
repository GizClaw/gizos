load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//libs/pal/providers/web/application_host:web_app.bzl", "h2_web_app")
load("//libs/pal/providers/web/application_host:web_board.bzl", "h2_web_board")

package(default_visibility = ["//visibility:public"])

h2_web_board(
    name = "board",
    buttons = {"back": "Escape"},
    default_skin = "flappybird",
    display_height = 448,
    display_width = 368,
    skins = {"flappybird": "layout.html"},
)

h2_web_app(
    name = "lua-flappybird",
    srcs = ["main.c"],
    app_name = "lua-flappybird",
    board = ":board",
    canvas_min = 1000,
    passes = ["H2_WEB_APP name=lua-flappybird result=PASS rc=0 fs=0 destroy=0"],
    presses = [[
        "stage=ready",
        "Escape",
    ]],
    taps = [[
        "stage=ready",
        184,
        224,
    ]],
    test_start = False,
    deps = ["//projects/example/apps/lua-flappybird/app:lua_flappybird"],
)

alias(
    name = "lua_flappybird_wasm",
    actual = ":lua-flappybird_wasm",
)

js_test(
    name = "lua_flappybird_wasm_test",
    chdir = package_name(),
    copy_data_to_bin = select({
        "//tools/bazel/platforms:is_windows_x86_64": True,
        "//conditions:default": False,
    }),
    data = [":lua_flappybird_wasm"],
    entry_point = "index.js",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Preserve the existing packaging check label. Functional acceptance executes
# the compiled C/WASM program and browser interactions separately.
py_test(
    name = "archive_test",
    size = "small",
    srcs = ["archive_test.py"],
    args = ["$(location :lua-flappybird)"],
    data = [":lua-flappybird"],
    legacy_create_init = 0,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
