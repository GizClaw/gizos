load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_jieli_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:jieli_task_policy.bzl", "jieli_target_task_policy")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")

package(default_visibility = ["//visibility:public"])

AC791N_COMPATIBILITY = select({
    "//tools/bazel/platforms:ci_graph": [],
    "//tools/bazel/platforms:is_ac791n": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

jieli_target_task_policy(
    name = "mp4_player_small_task_policy",
    default_policy = "10 4096 128",
    graph = [":mp4_player_small_launcher"],
    policies = [
        "h2loader/appcmd 10 12288 128",
        "$h2loader/return 10 4096 128",
        "$h2loader/uartcmd 10 4096 128",
        "$h2loader/blelink 10 1536 64",
        "#C0h2mp4/runtime 10 32768 128",
        "#C0$mp4-player/audio 10 2048 128",
        "$mp4-player/decoder 10 8192 128",
        "$runtime/input 10 4096 128",
        "$runtime/nfc 10 4096 128",
    ],
    sdk_policies = [
        "app_core 15 8192 1024",
        "sys_event 29 512 0",
        "systimer 14 256 0",
        "sys_timer 9 512 128",
        "dw_update 21 512 32",
        "h2app_rx 12 4096 128",
        "#C0audio_server 16 1024 256",
        "#C0audio_decoder 30 1024 64",
        "audio_encoder 12 384 64",
        "audio_mix 28 512 0",
        "#C0btctrler 19 768 384",
        "#C0btstack 18 1536 384",
        # SDK Wi-Fi driver tasks: SDK task_create() fails for names missing from task_info_table.
        # RtmpMlmeTask overflowed 700 words on scan completion after a rejected cached-BSSID association (2026-09-17 bench).
        "tcpip_thread 16 800 0",
        "tasklet 10 1400 0",
        "RtmpMlmeTask 17 1400 0",
        "RtmpCmdQTask 17 300 0",
        "wl_rx_irq_thread 5 256 0",
    ],
)

firmware_lib_component(
    name = "mp4_player_libs",
    component_name = "jieli_ac791n_devkit_mp4_player_libs",
    deps = [
        "//libs/mp4_decoder",
        "//libs/pal/providers/linux/fdk_aac_decoder",
        "//libs/pal/providers/tinyh264",
        "//libs/runtime",
        "//projects/example/apps/mp4-player/app:mp4_player",
    ],
)

h2_tasks(
    name = "mp4_player_launcher_tasks",
    tasks = ["h2mp4/runtime"],
)

firmware_native_component(
    name = "mp4_player_small_launcher",
    srcs = ["src/mp4_player_small_pal.c"],
    component_name = "jieli_ac791n_devkit_mp4_player_small_launcher",
    tags = ["manual"],
    target_compatible_with = AC791N_COMPATIBILITY,
    deps = [
        ":mp4_player_launcher_tasks",
        "//projects/h2loader/native_component_src/jieli/wl82/h2loader_app:app_transport",
        "//projects/h2loader/native_component_src/jieli/wl82/h2loader_app:h2loader_app_client",
        ":mp4_player_libs",
        "//boards/ac791n_chip/ac791n",
        "//boards/jieli_ac791n_devkit/ac791n",
    ],
)

firmware_native_component(
    name = "mp4_player_small_direct_mode",
    srcs = ["src/mp4_player_small_direct_mode.c"],
    component_name = "jieli_ac791n_devkit_mp4_player_small_direct_mode",
    tags = ["manual"],
    target_compatible_with = AC791N_COMPATIBILITY,
)

h2loader_jieli_firmware(
    name = "mp4_player_small_firmware",
    board = "jieli_ac791n_devkit",
    graph = [
        ":mp4_player_small_launcher",
        "//boards/jieli_ac791n_devkit/ac791n",
    ],
    image = "mp4-player-small",
    target = "wl82",
    task_policy = ":mp4_player_small_task_policy",
)

h2loader_jieli_firmware(
    name = "mp4_player_small_direct_firmware",
    board = "jieli_ac791n_devkit",
    graph = [
        ":mp4_player_small_launcher",
        ":mp4_player_small_direct_mode",
        "//boards/jieli_ac791n_devkit/ac791n",
    ],
    image = "mp4-player-small-direct",
    target = "wl82",
    task_policy = ":mp4_player_small_task_policy",
)

h2loader_tar_zlib(
    name = "mp4_player_small_package",
    board = "jieli_ac791n_devkit",
    firmware = ":mp4_player_small_firmware",
    image = "mp4-player-small",
    package_data = ["//projects/example/apps/mp4-player:small_media"],
    package_data_root = "projects/example/apps/mp4-player/data/small",
    role = "app",
    target = "wl82",
)

h2loader_tar_zlib(
    name = "mp4_player_large_package",
    board = "jieli_ac791n_devkit",
    firmware = ":mp4_player_small_firmware",
    image = "mp4-player-large",
    package_data = ["//projects/example/apps/mp4-player:jieli_ac791n_showcase_media"],
    package_data_root = "projects/example/apps/mp4-player/data/profiles/jieli_ac791n",
    role = "app",
    target = "wl82",
)

