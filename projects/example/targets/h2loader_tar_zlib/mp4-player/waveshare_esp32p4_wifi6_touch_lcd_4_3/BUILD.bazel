load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

esp_target_task_policy(
    task_name_deps = [
        "//libs/bleikcp:task_names",
        "//libs/pal/providers/h2peer:task_names",
        "//projects/h2loader/libs/h2loader:task_names",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/mp4_decoder",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
        "//libs/pal/providers/tinyh264",
        "//libs/pixa",
        "//libs/runtime",
    ],
)

firmware_native_component(
    name = "mp4_player_launcher",
    srcs = [
        "main/main.c",
    ],
    hdrs = [],
    component_directory = "projects/example/targets/h2loader_tar_zlib/mp4-player/waveshare_esp32p4_wifi6_touch_lcd_4_3/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    native_srcs = [
        "//projects/example/apps/mp4-player/app:src/app.c",
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":firmware_lib",
        "//boards/waveshare_esp32p4_wifi6_touch_lcd_4_3/esp32p4",
        "//libs/mp4_decoder",
        "//libs/pal",
        "//libs/pal/providers/tinyh264",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system",
        "//native_component_src/esp-idf6.x/h2_esp_audio_decoder",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/opus_port",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "waveshare_esp32p4_wifi6_touch_lcd_4_3",
    graph = [
        ":mp4_player_launcher",
    ],
    project = "CMakeLists.txt",
    project_name = "h2_smoke_mp4_player",
    target = "esp32p4",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "waveshare_esp32p4_wifi6_touch_lcd_4_3",
    firmware = ":firmware",
    image = "mp4-player",
    package_data = ["//projects/example/apps/mp4-player:esp32p4_showcase_media"],
    package_data_root = "projects/example/apps/mp4-player/data/profiles/esp32p4",
    role = "app",
    target = "esp32p4",
)
