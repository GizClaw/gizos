load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_jieli_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:jieli_task_policy.bzl", "jieli_target_task_policy")

package(default_visibility = ["//visibility:public"])

LAUNCHER = "//projects/example/native_component_src/jieli/wl82/devkit_app"

jieli_target_task_policy(
    name = "color_bar_task_policy",
    default_policy = "10 4096 128",
    graph = [":color_bar_launcher"],
    policies = [
        "h2color/runtime 10 2048 128",
        "h2loader/appcmd 10 12288 128",
        "h2loader/blecmd 10 12288 128",
        # The App command loop runs synchronously on the session task.
        "$bleikcp/server 10 12288 128",
        "$bleikcp/kcp 10 1536 128",
        "$h2loader/blelink 10 1536 64",
        "$h2loader/return 10 4096 128",
        "$h2loader/uartcmd 10 4096 128",
    ],
    sdk_policies = [
        "app_core 15 8192 1024",
        "sys_event 29 512 0",
        "systimer 14 256 0",
        "sys_timer 9 512 128",
        "dw_update 21 512 32",
        "h2app_rx 12 4096 128",
        "audio_server 16 1024 256",
        "audio_decoder 30 1024 64",
        "audio_encoder 12 384 64",
        "audio_mix 28 512 0",
        "#C0btctrler 19 768 384",
        "#C0btstack 18 1536 384",
    ],
)

# The color-bar image is the shared launcher with no application hook. The
# crash-before-confirm image reuses this alias and the task policy above.
alias(
    name = "color_bar_launcher",
    actual = LAUNCHER + ":launcher",
    tags = ["manual"],
)

h2loader_jieli_firmware(
    name = "firmware",
    board = "jieli_ac791n_devkit",
    graph = [
        ":color_bar_launcher",
        "//boards/jieli_ac791n_devkit/ac791n",
    ],
    image = "color-bar",
    target = "wl82",
    task_policy = ":color_bar_task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "jieli_ac791n_devkit",
    firmware = ":firmware",
    image = "color-bar",
    role = "app",
    target = "wl82",
)
