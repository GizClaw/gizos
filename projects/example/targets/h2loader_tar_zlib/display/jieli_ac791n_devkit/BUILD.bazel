# Keep the crash-persistence probe independent from display initialization and
# small enough that transport failures cannot be confused with the behavior
# under test.  The USB smoke launcher supplies app_main; coredump_smoke only
# overrides the board boot probe to record a deterministic crash and reboot.
h2loader_jieli_firmware(
    name = "coredump_minimal_firmware",
    board = "jieli_ac791n_devkit",
    graph = [
        ":coredump_smoke",
        "//boards/jieli_ac791n_devkit/ac791n",
        "//projects/h2loader/targets/h2loader_tar_zlib/loader/jieli_ac791n_devkit:usb_log_smoke_launcher",
