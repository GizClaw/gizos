load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "app",
    srcs = ["src/h2_mobile_app.c"],
    hdrs = ["include/h2_mobile_app.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:is_ios_sim_arm64": ["@platforms//os:ios"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal",
        "//libs/runtime",
        "//projects/example/apps/tap-reset/app:tap_reset_api",
        "//projects/example/apps/tap-reset/app:tap_reset_mobile",
    ],
)

cc_test(
    name = "app_test",
    srcs = ["tests/test_h2_mobile_app.c"],
    conlyopts = H2_C11_OPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":app"],
)
