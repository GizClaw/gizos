load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

# Shared Start/Stop shell for Web App targets built on app_host, and the
# generic Lua App entry compiled by h2_lua_web_app().
exports_files([
    "shell.html",
    "src/h2_web_lua_app.c",
])

cc_library(
    name = "app_host",
    srcs = ["src/h2_web_app_host.c"],
    hdrs = ["include/h2_web_app_host.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/lvgl:platform_web",
        "//libs/pal",
        "//libs/pal:unsupported",
        "//libs/pal/providers/web/pal_core",
        "//libs/runtime",
    ],
)

# Hook contract for h2_lua_web_app(extension = ...) libraries.
cc_library(
    name = "lua_app_extension",
    hdrs = ["include/h2_web_lua_app.h"],
    includes = ["include"],
    deps = [
        "//libs/lua",
        "//libs/runtime",
    ],
)
