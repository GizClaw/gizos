load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "pal_ipv6",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = [
        "//libs/atomic/providers/c11",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/desktop/pal_core",
        "//libs/pal/providers/wolfssl",
        "//projects/e2e/libs/pal-ipv6-runner:runner",
        "//projects/e2e/libs/pal-net-tls-runner:runner",
    ] + select({
        "@platforms//os:macos": ["//libs/pal/providers/darwin/pal_core:host_os"],
        "//conditions:default": ["//libs/pal/providers/linux/pal_core"],
    }),
)

py_test(
    name = "desktop_pal_ipv6_test",
    srcs = ["run_desktop.py"],
    args = [
        "--binary",
        "$(location :pal_ipv6)",
        "--server",
        "$(location //tools/webrtc-test-server:webrtc_test_server)",
    ],
    data = [
        ":pal_ipv6",
        "//tools/webrtc-test-server:webrtc_test_server",
    ],
    legacy_create_init = 0,
    main = "run_desktop.py",
    target_compatible_with = _HOST,
    deps = ["//projects/e2e/libs/pal-ipv6-fixture:fixture"],
)
