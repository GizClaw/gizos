load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_DEPS = [
    "//libs/atomic/providers/c11",
    "//libs/pal/providers/desktop/pal_core:core",
    "//libs/pal/providers/wolfssl:wolfssl",
    "//projects/example/libs/host_runtime",
    "//projects/e2e/apps/pal-crypto/app:pal_crypto_e2e",
] + select({
    "@platforms//os:macos": ["//libs/pal/providers/darwin/pal_core:host_os"],
    "@platforms//os:linux": ["//libs/pal/providers/linux/pal_core:pal_core"],
    "//conditions:default": [],
})

cc_binary(
    name = "pal_crypto_e2e",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = _DEPS,
)

cc_test(
    name = "desktop_test",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = _DEPS,
)
