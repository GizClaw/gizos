load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

# Host-side peer for the device iperf matrix: `server` accepts the PAL client
# (TCP, UDP and SCTP-over-UDP) and `client` runs the same portable matrix from
# the host against any iperf3 server.
cc_binary(
    name = "h2iperf",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    tags = ["manual"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/iperf",
        "//libs/pal",
        "//libs/pal/providers/desktop/pal_core:core",
        "//libs/pal/providers/h2sctp",
        "//projects/e2e/apps/iperf/app:iperf_e2e",
    ] + select({
        "@platforms//os:macos": ["//libs/pal/providers/darwin/pal_core:host_os"],
        "//conditions:default": ["//libs/pal/providers/linux/pal_core"],
    }),
)
