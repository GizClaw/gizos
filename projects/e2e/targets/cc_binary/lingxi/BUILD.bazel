load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST_NETWORK = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_DEPS = [
    "//libs/pal/providers/corehttp",
    "//libs/pal/providers/desktop/pal_core",
    "//libs/pal/providers/wolfssl",
    "//libs/pal/providers/yyjson",
    "//projects/e2e/apps/lingxi/app:lingxi_e2e",
] + select({
    "@platforms//os:macos": ["//libs/pal/providers/darwin/pal_core:host_os"],
    "//conditions:default": ["//libs/pal/providers/linux/pal_core"],
})

cc_binary(
    name = "lingxi",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST_NETWORK,
    deps = _DEPS,
)

cc_test(
    name = "live_test",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    local_defines = ["H2_LINGXI_E2E_LIVE=1"],
    tags = [
        "external",
        "manual",
    ],
    target_compatible_with = _HOST_NETWORK,
    deps = _DEPS,
)

py_test(
    name = "wire_test",
    srcs = ["test_wire.py"],
    args = [
        "$(location :lingxi)",
        "$(location :live_test)",
    ],
    data = [
        ":lingxi",
        ":live_test",
    ],
    legacy_create_init = 0,
    main = "test_wire.py",
    target_compatible_with = _HOST_NETWORK,
)
