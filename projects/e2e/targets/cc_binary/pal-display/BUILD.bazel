load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["evidence/*.json"]))

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_DEPS = [
    "//libs/atomic/providers/c11",
    "//libs/pal/providers/desktop/pal_core:core",
    "//libs/pal/providers/sdl3",
    "//projects/e2e/apps/pal-display/app:pal_display_e2e",
    "//projects/example/libs/host_runtime",
]

cc_binary(
    name = "pal_display_e2e",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = _DEPS,
)

cc_test(
    name = "desktop_test",
    env = select({
        "//tools/bazel/platforms:host_linux_target_linux": {"SDL_VIDEODRIVER": "dummy", "SDL_RENDER_DRIVER": "software"},
        "//conditions:default": {},
    }),
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = _HOST,
    deps = _DEPS,
)

cc_test(
    name = "no_op_guard_test",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    defines = ["H2_DISPLAY_EXPECT_NOOP_REJECTION=1"],
    env = select({
        "//tools/bazel/platforms:host_linux_target_linux": {"SDL_VIDEODRIVER": "dummy", "SDL_RENDER_DRIVER": "software"},
        "//conditions:default": {},
    }),
    target_compatible_with = _HOST,
    deps = _DEPS,
)
