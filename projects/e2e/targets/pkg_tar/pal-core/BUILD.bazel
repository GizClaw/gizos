load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:web_archive.bzl", "web_archive_browser_test", "web_archive_serve")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "_wasm/index",
    srcs = ["main.c"],
    additional_linker_inputs = ["shell.html"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    features = ["-output_format_js"],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
        "-sPROXY_TO_PTHREAD=1",
        "-sPTHREAD_POOL_SIZE=16",
        "--shell-file",
        "$(location shell.html)",
        "--oformat=html",
    ],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/atomic/providers/c11",
        "//libs/pal:unsupported",
        "//libs/pal/providers/web/pal_core",
        "//libs/runtime",
        "//projects/e2e/apps/pal-core/app:pal_core_e2e",
        "//projects/example/libs/host_runtime",
    ],
)

wasm_cc_binary(
    name = "pal_core_wasm",
    cc_target = ":_wasm/index",
    exit_runtime = True,
    outputs = [
        "index.html",
        "index.js",
        "index.wasm",
    ],
    target_compatible_with = _HOST,
    threads = "emscripten",
)

pkg_tar(
    name = "pal_core",
    srcs = [
        "_headers",
        ":pal_core_wasm",
    ],
    out = "pal-core.web.tar",
    mode = "0644",
    portable_mtime = True,
    strip_prefix = ".",
    target_compatible_with = _HOST,
)

web_archive_serve(
    name = "serve",
    archive = ":pal_core",
)

# Qualification requires every Core case and real Worker/shared-memory evidence.
web_archive_browser_test(
    name = "browser_test",
    archive = ":pal_core",
    fails = [
        "H2_WEB_CORE_RUNNER_ERROR",
        "status=FAIL",
        "status=BLOCKED",
        "status=NOT_RUN",
        "qualified=0",
        "retained_bytes=[1-9]",
        "H2_WEB_CORE_TEARDOWN destroy=-",
    ],
    passes = [
        "H2_WEB_CORE_REPORT contract=2 passed=41 failed=0 blocked=0 not_run=0 complete=1 qualified=1 cleanup=0",
        "H2_WEB_CORE_BOOT execution=pthread main_worker=1 isolated=1 shared_memory=1",
        "H2_WEB_CORE_PARALLEL passed=1 distinct_workers=1 no_yield=1",
        "H2_WEB_CORE_TASK_PROBE .*complete=1",
        "H2_WEB_CORE_EVENT_PROBE .*complete=1",
        "H2_WEB_CORE_UI_UNSUBSCRIBE complete=1 main_responsive=1 quiescent=1",
        "H2_WEB_CORE_TEARDOWN destroy=0",
        "H2_WEB_CORE_PROBE_COMPLETE",
    ],
    start = False,
    timeout_s = 90,
)

alias(
    name = "browser_probe_test",
    actual = ":browser_test",
)
