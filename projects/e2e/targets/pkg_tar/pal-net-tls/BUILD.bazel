load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "_wasm/index",
    srcs = ["main.c"],
    additional_linker_inputs = ["shell.html"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    features = ["-output_format_js"],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
        "-sPROXY_TO_PTHREAD=1",
        "-sPTHREAD_POOL_SIZE=16",
        "--shell-file",
        "$(location shell.html)",
        "--oformat=html",
    ],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/atomic/providers/c11",
        "//libs/pal:unsupported",
        "//libs/pal/providers/web/application_host",
        "//libs/pal/providers/web/pal_core",
        "//libs/runtime",
    ],
)

wasm_cc_binary(
    name = "pal_net_tls_wasm",
    cc_target = ":_wasm/index",
    exit_runtime = True,
    outputs = [
        "index.html",
        "index.js",
        "index.wasm",
    ],
    target_compatible_with = _HOST,
    threads = "emscripten",
)

pkg_files(
    name = "pal_net_tls_web_files",
    srcs = [
        "_headers",
        ":pal_net_tls_wasm",
    ],
    attributes = pkg_attributes(mode = "0644"),
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = _HOST,
)

pkg_tar(
    name = "pal_net_tls",
    srcs = [":pal_net_tls_web_files"],
    out = "pal-net-tls.web.tar",
    mode = "0644",
    portable_mtime = True,
    target_compatible_with = _HOST,
)

_HOST_RECEIPT_SOURCES = [
    "libs/pal/include/h2/pal/application/h2_pal_application_host.h",
    "libs/pal/include/h2_pal.h",
    "libs/pal/application/host/BUILD.bazel",
    "libs/pal/application/host/include/h2_application_host.h",
    "libs/pal/application/host/src/h2_application_host.c",
    "libs/pal/providers/web/application_host/BUILD.bazel",
    "libs/pal/providers/web/application_host/include/h2_web_application_host.h",
    "libs/pal/providers/web/application_host/src/h2_web_application_host.c",
    "libs/runtime/include/h2_runtime.h",
    "libs/runtime/src/h2_runtime.c",
    "projects/e2e/targets/pkg_tar/pal-net-tls/BUILD.bazel",
    "projects/e2e/targets/pkg_tar/pal-net-tls/main.c",
    "projects/e2e/targets/pkg_tar/pal-net-tls/shell.html",
    "projects/e2e/targets/pkg_tar/pal-net-tls/run_browser.py",
    "projects/e2e/targets/pkg_tar/pal-net-tls/run_application_host_browser.py",
]

_HOST_RECEIPT_LABELS = {
    "libs/pal/include/h2/pal/application/h2_pal_application_host.h": "//libs/pal:include/h2/pal/application/h2_pal_application_host.h",
    "libs/pal/include/h2_pal.h": "//libs/pal:include/h2_pal.h",
    "libs/pal/application/host/BUILD.bazel": "//libs/pal/application/host:BUILD.bazel",
    "libs/pal/application/host/include/h2_application_host.h": "//libs/pal/application/host:include/h2_application_host.h",
    "libs/pal/application/host/src/h2_application_host.c": "//libs/pal/application/host:src/h2_application_host.c",
    "libs/pal/providers/web/application_host/BUILD.bazel": "//libs/pal/providers/web/application_host:BUILD.bazel",
    "libs/pal/providers/web/application_host/include/h2_web_application_host.h": "//libs/pal/providers/web/application_host:include/h2_web_application_host.h",
    "libs/pal/providers/web/application_host/src/h2_web_application_host.c": "//libs/pal/providers/web/application_host:src/h2_web_application_host.c",
    "libs/runtime/include/h2_runtime.h": "//libs/runtime:include/h2_runtime.h",
    "libs/runtime/src/h2_runtime.c": "//libs/runtime:src/h2_runtime.c",
    "projects/e2e/targets/pkg_tar/pal-net-tls/BUILD.bazel": "//projects/e2e/targets/pkg_tar/pal-net-tls:BUILD.bazel",
    "projects/e2e/targets/pkg_tar/pal-net-tls/main.c": "//projects/e2e/targets/pkg_tar/pal-net-tls:main.c",
    "projects/e2e/targets/pkg_tar/pal-net-tls/shell.html": "//projects/e2e/targets/pkg_tar/pal-net-tls:shell.html",
    "projects/e2e/targets/pkg_tar/pal-net-tls/run_browser.py": "//projects/e2e/targets/pkg_tar/pal-net-tls:run_browser.py",
    "projects/e2e/targets/pkg_tar/pal-net-tls/run_application_host_browser.py": "//projects/e2e/targets/pkg_tar/pal-net-tls:run_application_host_browser.py",
}

py_test(
    name = "wasm_pal_net_tls_boundary_test",
    srcs = ["run_application_host_browser.py"],
    args = [
        "$(rootpath :pal_net_tls)",
        "$(rootpath run_browser.py)",
    ] + [name + "=$(rootpath " + _HOST_RECEIPT_LABELS[name] + ")" for name in _HOST_RECEIPT_SOURCES],
    data = list(_HOST_RECEIPT_LABELS.values()) + [
        ":pal_net_tls",
        "//tools/bazel:web_archive_browser_test.py",
        "//tools/bazel:web_archive_server.py",
    ] + select({
        "//tools/bazel/platforms:host_linux_target_linux": ["@h2_playwright_chromium_linux_x86_64//:runtime"],
        "//tools/bazel/platforms:host_macos_target_macos": ["@h2_playwright_chromium_macos_arm64//:runtime"],
        "//conditions:default": [],
    }),
    legacy_create_init = 0,
    main = "run_application_host_browser.py",
    tags = [
        "external",
        "manual",
    ],
    target_compatible_with = _HOST,
)
