load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "WEB_WASM32_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

_HOST = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_binary(
    name = "_wasm/index",
    srcs = ["main.c"],
    additional_linker_inputs = ["shell.html"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    features = ["-output_format_js"],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
        "-sPROXY_TO_PTHREAD=1",
        "-sPTHREAD_POOL_SIZE=4",
        "--shell-file",
        "$(location shell.html)",
        "--oformat=html",
    ],
    target_compatible_with = WEB_WASM32_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/atomic/providers/c11",
        "//libs/pal:unsupported",
        "//libs/pal/providers/web/pal_core",
        "//projects/e2e/apps/pal-webrtc/app:pal_webrtc_e2e",
    ],
)

wasm_cc_binary(
    name = "wasm",
    cc_target = ":_wasm/index",
    exit_runtime = True,
    outputs = [
        "index.html",
        "index.js",
        "index.wasm",
    ],
    target_compatible_with = _HOST,
    threads = "emscripten",
)

pkg_tar(
    name = "pal_ipv6",
    srcs = [
        "_headers",
        ":wasm",
    ],
    out = "pal-ipv6.web.tar",
    mode = "0644",
    portable_mtime = True,
    strip_prefix = ".",
    target_compatible_with = _HOST,
)

py_test(
    name = "wasm_pal_ipv6_test",
    srcs = ["run_browser.py"],
    args = [
        "--archive",
        "$(location :pal_ipv6)",
        "--server",
        "$(location //tools/webrtc-test-server:webrtc_test_server)",
        "--cases",
        "$(location //projects/e2e/apps/pal-webrtc/app:include/h2_pal_webrtc_cases.inc)",
    ],
    data = [
        ":pal_ipv6",
        "//libs/pal/providers/web/pal_core:tests/run_webrtc_browser.py",
        "//projects/e2e/apps/pal-webrtc/app:include/h2_pal_webrtc_cases.inc",
        "//tools/bazel:web_archive_browser_test.py",
        "//tools/bazel:web_archive_server.py",
        "//tools/webrtc-test-server:webrtc_test_server",
    ] + select({
        "//tools/bazel/platforms:host_linux_target_linux": ["@h2_playwright_chromium_linux_x86_64//:runtime"],
        "//tools/bazel/platforms:host_macos_target_macos": ["@h2_playwright_chromium_macos_arm64//:runtime"],
        "//conditions:default": [],
    }),
    legacy_create_init = 0,
    main = "run_browser.py",
    tags = [
        "external",
        "manual",
    ],
    target_compatible_with = _HOST,
    deps = ["//projects/e2e/libs/pal-ipv6-fixture:fixture"],
)
