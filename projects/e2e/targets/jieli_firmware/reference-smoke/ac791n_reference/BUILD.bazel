load("//boards/ac791n_chip/ac791n/layouts/compile_only:defs.bzl", "ac791n_compile_only_firmware")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

AC791N_COMPATIBILITY = select({
    "//tools/bazel/platforms:ci_graph": [],
    "//tools/bazel/platforms:is_ac791n": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

firmware_lib_component(
    name = "firmware_lib",
    target_compatible_with = AC791N_COMPATIBILITY,
    deps = ["//projects/e2e/libs/reference_smoke"],
)

firmware_native_component(
    name = "reference_launcher",
    srcs = ["src/reference_launcher.c"],
    component_name = "reference_launcher",
    tags = ["manual"],
    target_compatible_with = AC791N_COMPATIBILITY,
    deps = [
        ":firmware_lib",
        "//boards/ac791n_chip/ac791n",
        "//projects/e2e/libs/reference_smoke",
    ],
)

ac791n_compile_only_firmware(
    name = "firmware",
    board = "ac791n_chip",
    graph = [":reference_launcher"],
    image = "reference-smoke",
)
