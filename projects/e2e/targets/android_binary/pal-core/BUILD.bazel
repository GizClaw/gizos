load("@rules_android//rules:rules.bzl", "android_binary", "android_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:mobile_app_sdk.bzl", "mobile_app_sdk")
load("//tools/bazel:mobile_e2e.bzl", "mobile_e2e_test")
load("//tools/bazel/platforms:compatibility.bzl", "ANDROID_ARM64_ARTIFACT_COMPATIBILITY", "ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "launcher",
    srcs = ["main.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/app_host:android_packaged",
        "//projects/e2e/libs/pal-core-mobile:runner",
    ],
)

android_library(
    name = "app",
    srcs = ["src/com/haivivi/gizos/e2e/palcore/MainActivity.java"],
    custom_package = "com.haivivi.gizos.e2e.palcore",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
    deps = [":launcher"],
)

android_binary(
    name = "pal_core_e2e",
    custom_package = "com.haivivi.gizos.e2e.palcore",
    manifest = "AndroidManifest.xml",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
    deps = [":app"],
)

mobile_e2e_test(
    name = "android_pal_core_simulator_test",
    timeout = "moderate",
    args = [
        "android",
        "$(rootpath :pal_core_e2e.apk)",
        "$(rootpath :app_sdk)",
        "$(rootpath //projects/e2e/apps/pal-core/app:include/h2_pal_core_cases.inc)",
    ],
    data = [
        ":app_sdk",
        ":pal_core_e2e.apk",
        "//projects/e2e/apps/pal-core/app:include/h2_pal_core_cases.inc",
    ],
    env_inherit = [
        "H2_IOS_SIMULATOR_UDID",
        "H2_ANDROID_SERIAL",
        "ANDROID_HOME",
        "DEVELOPER_DIR",
    ],
    runner = "//projects/e2e/libs/pal-core-mobile:run_mobile.py",
    target_compatible_with = ANDROID_ARM64_PACKAGE_ARTIFACT_COMPATIBILITY,
)

mobile_app_sdk(
    name = "app_sdk",
    app = ":pal_core_e2e",
)
