load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

copy_file(
    name = "launcher_test_source_copy",
    testonly = True,
    src = "ap/ap_main.c",
    out = "tests/ap_main_for_test.inc",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "launcher_test_source",
    testonly = True,
    hdrs = [":launcher_test_source_copy"],
    includes = ["tests"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "launcher_test",
    srcs = [
        "tests/sdk/bk_private/bk_init.h",
        "tests/sdk/h2_bk7258_board.h",
        "tests/sdk/h2_bk_platform_core.h",
        "tests/sdk/h2_bk_target_task_policy.h",
        "tests/sdk/os/os.h",
        "tests/test_launcher.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/sdk"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":launcher_test_source",
        "//libs/h2loader/device:firmware_api",
        "//projects/e2e/libs/pal-ipv6-device:runner",
    ],
)

# Final firmware entries supply their Board, layout, libraries and task policy.
firmware_native_component(
    name = "ap_launcher_component",
    srcs = ["ap/ap_main.c"],
    component_directory = "projects/e2e/targets/pal-ipv6/beken/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)
