load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

# Shared ESP launcher accepts the consuming entry's H2_PAL_IPV6_BOARD.
exports_files(["main/main.c"])

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "pal-ipv6/e2e/runner 4 0 65536 psram",
        "pal-ipv6/e2e/http-peer 4 0 8192 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 32768 psram",
        "$h2peer/udp 7 0 8192 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/e2e/libs/pal-ipv6-device:runner",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    component_directory = "projects/e2e/targets/h2loader_tar_zlib/pal-ipv6/devkit/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/devkit/esp32s3",
        "//libs/atomic",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    layout_files = {
        "partition": "//boards/devkit/esp32s3/layouts/h2loader:partition.csv",
        "project_support_files": [
            "//boards/devkit/esp32s3/layouts/h2loader:sdkconfig.h2loader.defaults",
            "//boards/devkit/esp32s3/layouts/h2loader:sdkconfig.ipv6-client.defaults",
        ],
        "support_files": ["//boards/devkit/esp32s3/layouts/h2loader:loader_usb.defaults"],
    },
    cmake_definitions = {"H2_ESP_CONSOLE_DEFAULTS": "loader_usb.defaults"},
    graph = [":launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_pal_ipv6_e2e",
    target = "esp32s3",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "devkit",
    firmware = ":firmware",
    image = "pal-ipv6",
    role = "app",
    target = "esp32s3",
)
