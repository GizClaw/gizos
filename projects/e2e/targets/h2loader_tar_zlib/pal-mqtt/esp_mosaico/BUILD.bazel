load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//projects/e2e/libs/pal-mqtt-device:device_test.bzl", "mqtt_device_test")
load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "pal-mqtt/e2e/runner 4 0 65536 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$h2loader/uartcmd default",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/audio_mixer",
        "//libs/drivers/audio/es8311",
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/coremqtt",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/e2e/apps/pal-mqtt/app:pal_mqtt_e2e",
        "//projects/e2e/libs/pal-mqtt-device:runner",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    hdrs = ["main/ledger_console.h"],
    component_directory = "projects/e2e/targets/h2loader_tar_zlib/pal-mqtt/esp_mosaico/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/esp_mosaico/esp32s31",
        "//libs/atomic",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
        "main/ledger_console.h",
        "sdkconfig.pal-mqtt.defaults",
    ],
    board = "esp_mosaico",
    graph = [":launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_pal_mqtt_e2e",
    target = "esp32s31",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "esp_mosaico",
    firmware = ":firmware",
    image = "pal-mqtt",
    role = "app",
    target = "esp32s31",
)

mqtt_device_test(name = "device_test", package = ":package", target = "esp32s31")

cc_test(
    name = "ledger_console_test",
    srcs = [
        "main/ledger_console.h",
        "tests/test_ledger_console.c",
        "//projects/e2e/targets/h2loader_tar_zlib/pal-mqtt/bk7258_v3_202405:ap/ledger_console.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//projects/e2e/libs/pal-mqtt-device:runner"],
)

py_test(
    name = "ledger_admission_test",
    srcs = [
        "tests/test_ledger_admission.py",
        "//projects/e2e/libs/pal-mqtt-device:verify_device.py",
    ],
    args = [
        "$(location :ledger_console_test)",
        "$(location //projects/e2e/apps/pal-mqtt/app:include/h2_pal_mqtt_cases.inc)",
    ],
    data = [
        ":ledger_console_test",
        "//projects/e2e/apps/pal-mqtt/app:include/h2_pal_mqtt_cases.inc",
    ],
    imports = ["../../../../libs/pal-mqtt-device"],
    legacy_create_init = 0,
    main = "tests/test_ledger_admission.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
