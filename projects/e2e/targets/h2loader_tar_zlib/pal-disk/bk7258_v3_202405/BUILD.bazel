load("@rules_python//python:defs.bzl", "py_test")
load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:app_version.bzl", "app_version")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files([
    "CMakeLists.txt",
    "tests/test_layout.py",
])

app_version(
    name = "version",
    value = "0.1.0-pal-disk",
)

py_test(
    name = "layout_test",
    srcs = ["tests/test_layout.py"],
    args = [
        "--baseline",
        "$(location //boards/bk7258_v3_202405/bk7258/layouts/h2loader:partitions/bk7258/auto_partitions.csv)",
        "--diagnostic",
        "$(location //boards/bk7258_v3_202405/bk7258/layouts/pal_disk:partitions/bk7258/auto_partitions.csv)",
    ],
    data = [
        "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:partitions/bk7258/auto_partitions.csv",
        "//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:partitions/bk7258/auto_partitions.csv",
    ],
    legacy_create_init = False,
    main = "tests/test_layout.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/drivers/nfc/fm175xx",
        "//libs/iostreamikcp",
        "//libs/lvgl",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/coremqtt",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/modem/quectel:quectel_modem",
        "//libs/runtime",
        "//libs/utils",
        "//libs/wifi_sta",
        "//projects/e2e/apps/pal-disk/app:pal_disk_e2e",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/disk.c",
        "ap/main.c",
        "ap/management.c",
    ],
    hdrs = ["ap/launcher.h"],
    component_directory = "projects/e2e/targets/h2loader_tar_zlib/pal-disk/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
)

firmware_native_component(
    name = "pal_disk_launcher",
    deps = [
        ":ap_launcher_component",
        ":firmware_lib",
        "//boards/bk7258_v3_202405/bk7258",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//projects/e2e/apps/pal-disk/app:tasks",
        "//projects/h2loader/apps/loader/app:tasks",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/bk7258/ap/h2loader_bk",
        "//projects/h2loader/native_component_src/bk7258/cp/h2loader_cp_launcher",
    ],
)

bk7258_target_task_policy(
    ap_allocator = "sram",
    ap_default_policy = "7 0 8192 psram",
    ap_policies = [
        "pal-disk/e2e/writer 7 0 4096 default",
        "pal-disk/e2e/reader 7 1 4096 default",
        "h2loader/appcmd 5 0 32768 psram",
        "$h2loader/uartcmd 5 0 8192 psram",
        "$h2loader/return default",
        "$h2loader/blelink default",
        "$bleikcp/kcp default",
        "$bleikcp/server default",
        "$h2peer/net default",
        "$h2peer/udp default",
        "$modem/urc default",
        "$runtime/input default",
        "$runtime/nfc default",
        "$lvgl/g2ddraw default",
        "$lvgl/nemagfx default",
        "$lvgl/pxpdraw default",
        "$lvgl/swdraw default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":pal_disk_launcher"],
)

h2loader_bk7258_firmware(
    name = "firmware",
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [":pal_disk_launcher"],
    layout_files = {
        "ap_config": [
            "//boards/bk7258_v3_202405/bk7258:ap.defaults",
            "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:ap.defaults",
            "//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:ap.defaults",
        ],
        "cp_config": [
            "//boards/bk7258_v3_202405/bk7258:cp.defaults",
            "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:cp.defaults",
            "//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:cp.defaults",
        ],
        "ap_gpio": "//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:ap_gpio",
        "cp_gpio": "//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:cp_gpio",
        "project_support_files": ["//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:layout"],
        "ram_regions": "//boards/bk7258_v3_202405/bk7258/layouts/pal_disk:ram_regions",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_pal_disk",
    target = "bk7258",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "pal-disk",
    role = "app",
    target = "bk7258",
)
