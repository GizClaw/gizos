load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")

package(default_visibility = ["//visibility:public"])

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "pal-audio/e2e/runner 4 0 32768 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 32768 psram",
        "$h2peer/udp 7 0 8192 psram",
        "$h2loader/uartcmd default",
        "$runtime/input default",
        "$runtime/nfc default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//projects/e2e/libs/mosaico-screen:screen",
        "//libs/atomic",
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/libco",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/e2e/apps/pal-audio/app:pal_audio_e2e",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c", "main/audible.c"],
    hdrs = ["main/audible.h"],
    component_directory = "projects/e2e/targets/h2loader_tar_zlib/pal-audio/esp_mosaico/main",
    component_name = "main",
    data = ["main/CMakeLists.txt", "main/idf_component.yml"],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/esp_mosaico/esp32s31",
        "//boards/esp_mosaico/esp32s31:loader_usb",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = ["CMakeLists.txt", "main/CMakeLists.txt", "main/idf_component.yml",
            "main/main.c", "main/audible.c", "main/audible.h"],
    board = "esp_mosaico",
    graph = [":launcher"],
    layout_files = {
        "partition": "//boards/esp_mosaico/esp32s31/layouts/h2loader:partition.csv",
        "project_support_files": [
            "//boards/esp_mosaico/esp32s31/layouts/h2loader:sdkconfig.h2loader.defaults",
            "//boards/esp_mosaico/esp32s31/layouts/h2loader:sdkconfig.log-e2e.defaults",
        ],
    },
    project = "CMakeLists.txt",
    project_name = "h2_pal_audio_e2e",
    target = "esp32s31",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "esp_mosaico",
    firmware = ":firmware",
    image = "pal-audio",
    role = "app",
    target = "esp32s31",
)

cc_test(
    name = "audible_test",
    srcs = ["main/audible.c", "main/audible.h", "tests/test_audible.c"],
    includes = ["main"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)
