load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_jieli_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:jieli_task_policy.bzl", "jieli_target_task_policy")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "launcher",
    srcs = ["src/coredump_smoke.c"],
    component_name = "jieli_ac791n_devkit_coredump_smoke",
    tags = ["manual"],
    target_compatible_with = select({
        "//tools/bazel/platforms:ci_graph": [],
        "//tools/bazel/platforms:is_ac791n": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

jieli_target_task_policy(
    name = "task_policy",
    default_policy = "10 4096 128",
    graph = [":launcher"],
    policies = [],
    sdk_policies = [
        "app_core 15 4096 256",
        "sys_event 29 512 0",
        "systimer 14 256 0",
        "sys_timer 9 512 64",
        "dw_update 21 512 32",
        "#C0btctrler 19 768 384",
        "#C0btstack 18 1536 384",
        "audio_server 16 1024 256",
        "audio_decoder 30 1024 64",
        "audio_encoder 12 384 64",
        "audio_mix 28 512 0",
    ],
)

[
    h2loader_jieli_firmware(
        name = name + "_firmware",
        board = "jieli_ac791n_devkit",
        graph = [":launcher", "//boards/jieli_ac791n_devkit/ac791n"],
        image = image,
        target = "wl82",
        task_policy = ":task_policy",
    )
    for name, image in [("smoke", "coredump-smoke"), ("minimal", "coredump-minimal")]
]

[
    h2loader_tar_zlib(
        name = name + "_package",
        board = "jieli_ac791n_devkit",
        firmware = ":" + name + "_firmware",
        image = image,
        role = "app",
        tags = ["no-release"],
        target = "wl82",
    )
    for name, image in [("smoke", "coredump-smoke"), ("minimal", "coredump-minimal")]
]
