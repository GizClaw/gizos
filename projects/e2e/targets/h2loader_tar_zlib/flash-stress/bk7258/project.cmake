set(H2_BK_H2LOADER_ENABLE_FATFS OFF)
include($ENV{ARMINO_TOOLS_PATH}/build_tools/cmake/project.cmake)
include("$ENV{H2_BAZEL_COMPONENT_MANIFEST}")
if("${ARMINO_SOC}" STREQUAL "bk7258_ap")
  set(FLASH_STRESS_COMPONENTS ${H2_BAZEL_AP_COMPONENT_DIRS})
elseif("${ARMINO_SOC}" STREQUAL "bk7258")
  set(FLASH_STRESS_COMPONENTS ${H2_BAZEL_CP_COMPONENT_DIRS})
else()
  message(FATAL_ERROR "Unexpected execution unit: ${ARMINO_SOC}")
endif()
foreach(COMPONENT IN LISTS FLASH_STRESS_COMPONENTS)
  armino_build_component("${COMPONENT}")
endforeach()
