# Artifact-only panic evidence in the reserved managed coredump partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_STACK_SIZE=4096

# Match the existing PSRAM-backed reference-board network allocation policy.
# Keep DMA-only radio allocations internal; do not lower workload or gates.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Keep ordinary small malloc allocations out of the scarce internal DMA heap.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Match reference-board placement of eligible network/Bluetooth static BSS.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
