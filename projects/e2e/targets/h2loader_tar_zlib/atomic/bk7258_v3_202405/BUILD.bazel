package(default_visibility = ["//visibility:public"])

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "atomic/e2e/runner 7 0 65536 psram",
        "atomic/e2e 7 0 8192 psram",
        "atomic/e2e/core0 7 0 8192 psram",
        "atomic/e2e/core1 7 1 8192 psram",
        "atomic/flag/low 6 0 4096 psram",
        "atomic/flag/high 9 0 4096 psram",
        "h2loader/appcmd    5        0  8192  psram",
        "$h2loader/uartcmd  5        0  8192  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    default",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":atomic_launcher"],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
