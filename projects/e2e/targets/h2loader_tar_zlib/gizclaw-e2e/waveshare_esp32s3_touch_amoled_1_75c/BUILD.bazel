        "//libs/gizclaw",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/e2e/apps/gizclaw/app:gizclaw_e2e",
        "//projects/e2e/libs/gizclaw-device:ledger",
    ],
)

firmware_native_component(
    name = "gizclaw_e2e_amoled_launcher",
    srcs = [
        "main/h2_gizclaw_e2e_ws175c_config.c",
        "main/h2_gizclaw_e2e_ws175c_ota.c",
        "main/h2_gizclaw_e2e_ws175c_state.c",
        "main/main.c",
