    hdrs = [
        "main/h2_gizclaw_e2e_ws175c_config.h",
        "main/h2_gizclaw_e2e_ws175c_ota.h",
        "main/h2_gizclaw_e2e_ws175c_state.h",
    ],
    component_directory = "projects/e2e/targets/h2loader_tar_zlib/gizclaw-e2e/waveshare_esp32s3_touch_amoled_1_75c/main",
    component_name = "main",
