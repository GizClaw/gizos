load("@rules_cc//cc:defs.bzl", "cc_test")
load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/gizclaw",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
        "//libs/pixa",
        "//libs/runtime",
        "//projects/e2e/apps/gizclaw/app:gizclaw_e2e",
    ],
)

firmware_native_component(
    name = "gizclaw_e2e_devkit_launcher",
    srcs = [
        "main/h2_gizclaw_e2e_devkit_config.c",
        "main/h2_gizclaw_e2e_devkit_state.c",
        "main/main.c",
    ],
    hdrs = [
        "main/h2_gizclaw_e2e_devkit_config.h",
        "main/h2_gizclaw_e2e_devkit_state.h",
    ],
    component_directory = "projects/e2e/targets/h2loader_tar_zlib/gizclaw-e2e/devkit/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/devkit/esp32s3",
        "//libs/gizclaw",
        "//libs/pal",
        "//native_component_src/esp-idf6.x/h2_gizclaw",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/opus_port",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

cc_test(
    name = "gizclaw_e2e_devkit_state_test",
    srcs = [
        "main/h2_gizclaw_e2e_devkit_state.c",
        "main/h2_gizclaw_e2e_devkit_state.h",
        "tests/test_h2_gizclaw_e2e_devkit_state.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/h2_gizclaw_e2e_devkit_config.c",
        "main/h2_gizclaw_e2e_devkit_config.h",
        "main/h2_gizclaw_e2e_devkit_state.c",
        "main/h2_gizclaw_e2e_devkit_state.h",
        "main/idf_component.yml",
        "main/main.c",
    ],
    board = "devkit",
    graph = [":gizclaw_e2e_devkit_launcher"],
    project = "CMakeLists.txt",
    project_name = "h2_gizclaw_e2e_devkit",
    target = "esp32s3",
)

h2loader_tar_zlib(
    name = "package",
    board = "devkit",
    firmware = ":firmware",
    image = "gizclaw-e2e",
    role = "app",
    target = "esp32s3",
)
