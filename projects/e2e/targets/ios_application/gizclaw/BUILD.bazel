load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//tools/bazel:cc_options.bzl", "H2_WARNING_COPTS")
load("//tools/bazel:mobile_app_sdk.bzl", "mobile_app_sdk")
load("//tools/bazel/platforms:compatibility.bzl", "IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

objc_library(
    name = "launcher",
    srcs = ["main.m"],
    copts = H2_WARNING_COPTS + ["-fobjc-arc"],
    sdk_frameworks = [
        "UIKit",
        "Foundation",
    ],
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/app_host:ios_packaged",
        "//projects/e2e/libs/gizclaw-mobile:runner",
    ],
)

ios_application(
    name = "gizclaw_e2e",
    bundle_id = "com.haivivi.gizos.e2e.gizclaw",
    bundle_name = "GizOSGizClawE2E",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [":launcher"],
)

mobile_app_sdk(
    name = "app_sdk",
    app = ":gizclaw_e2e",
)

sh_test(
    name = "ios_gizclaw_simulator_test",
    size = "enormous",
    srcs = ["run_simulator.sh"],
    args = ["ios", "--app", "$(rootpath :gizclaw_e2e.ipa)", "--sdk", "$(rootpath :app_sdk)",
            "--pcm", "$(rootpath //projects/e2e/apps/gizclaw:voice_prompt)", "--profile", "default"],
    data = [":gizclaw_e2e.ipa", ":app_sdk",
            "//projects/e2e/apps/gizclaw:voice_prompt", "//projects/e2e/apps/gizclaw:api_coverage.py",
            "//projects/e2e/libs/gizclaw-mobile:run_mobile.py"],
    env_inherit = ["H2_IOS_SIMULATOR_UDID", "H2_ANDROID_SERIAL", "ANDROID_HOME", "DEVELOPER_DIR",
        "H2_GIZCLAW_E2E_ENDPOINT", "H2_GIZCLAW_E2E_REGISTRATION_TOKEN",
        "H2_GIZCLAW_E2E_DEVICE_API_URL", "H2_GIZCLAW_E2E_AUDIO_URL"],
    tags = ["manual"],
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
)
