load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//tools/bazel:cc_options.bzl", "H2_WARNING_COPTS")
load("//tools/bazel:mobile_app_sdk.bzl", "mobile_app_sdk")
load("//tools/bazel:mobile_e2e.bzl", "mobile_e2e_test")
load("//tools/bazel/platforms:compatibility.bzl", "IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

objc_library(
    name = "launcher",
    srcs = ["main.m"],
    copts = H2_WARNING_COPTS + ["-fobjc-arc"],
    sdk_frameworks = [
        "UIKit",
        "Foundation",
    ],
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/app_host:ios_packaged",
        "//projects/e2e/libs/pal-webrtc-mobile:runner",
    ],
)

ios_application(
    name = "pal_webrtc_e2e",
    bundle_id = "com.haivivi.gizos.e2e.palwebrtc",
    bundle_name = "GizOSPALWEBRTCE2E",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info.plist"],
    minimum_os_version = "16.0",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [":launcher"],
)

mobile_e2e_test(
    name = "ios_pal_webrtc_simulator_test",
    timeout = "moderate",
    args = [
        "ios",
        "$(rootpath :pal_webrtc_e2e.ipa)",
        "$(rootpath :app_sdk)",
        "$(rootpath //projects/e2e/apps/pal-webrtc/app:include/h2_pal_webrtc_cases.inc)",
        "$(rootpath //projects/e2e/libs/pal-webrtc-fixture:server)",
    ],
    data = [
        ":app_sdk",
        ":pal_webrtc_e2e.ipa",
        "//projects/e2e/apps/pal-webrtc/app:include/h2_pal_webrtc_cases.inc",
        "//projects/e2e/libs/pal-webrtc-fixture:server",
    ],
    env_inherit = [
        "H2_IOS_SIMULATOR_UDID",
        "H2_ANDROID_SERIAL",
        "H2_WEBRTC_FIXTURE_IP",
        "ANDROID_HOME",
        "DEVELOPER_DIR",
    ],
    runner = "//projects/e2e/libs/pal-webrtc-mobile:run_mobile.py",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = ["//projects/e2e/libs/pal-webrtc-fixture:fixture"],
)

mobile_app_sdk(
    name = "app_sdk",
    app = ":pal_webrtc_e2e",
)
