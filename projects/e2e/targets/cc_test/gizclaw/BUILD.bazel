load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load(":e2e_test.bzl", "gizclaw_e2e_desktop_deps", "gizclaw_e2e_desktop_live_test")

package(default_visibility = ["//visibility:public"])

gizclaw_e2e_desktop_live_test(
    name = "gizclaw_h2peer_live_test",
    suite = "all",
)

gizclaw_e2e_desktop_live_test(
    name = "gizclaw_pion_live_test",
    backend = "pion",
    suite = "firmware-voice",
)

cc_library(
    name = "gizclaw_e2e_desktop_support",
    testonly = True,
    srcs = [
        "h2_gizclaw_e2e_desktop.cpp",
        "h2_gizclaw_pal_e2e_access_point.c",
    ],
    hdrs = [
        "h2_gizclaw_e2e_desktop.h",
        "h2_gizclaw_pal_e2e_access_point.h",
    ],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    local_defines = ["H2_GIZCLAW_E2E_DESKTOP_NO_MAIN=1"],
    visibility = ["//projects/e2e/targets/cc_binary/gizclaw:__pkg__"],
    deps = gizclaw_e2e_desktop_deps(),
)

cc_test(
    name = "gizclaw_pal_access_point_test",
    srcs = [
        "h2_gizclaw_pal_e2e_access_point.c",
        "h2_gizclaw_pal_e2e_access_point.h",
        "test_h2_gizclaw_pal_access_point.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//libs/pal"],
)

cc_test(
    name = "gizclaw_e2e_desktop_test",
    srcs = [
        "h2_gizclaw_e2e_desktop.cpp",
        "h2_gizclaw_e2e_desktop.h",
        "h2_gizclaw_pal_e2e_access_point.c",
        "h2_gizclaw_pal_e2e_access_point.h",
        "test_h2_gizclaw_e2e_desktop.cpp",
    ],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    local_defines = ["H2_GIZCLAW_E2E_DESKTOP_NO_MAIN=1"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = gizclaw_e2e_desktop_deps(),
)
