load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "webrtc_performance",
    srcs = ["src/h2_webrtc_performance.c"],
    hdrs = ["include/h2_webrtc_performance.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "webrtc_performance_test",
    srcs = ["tests/test_h2_webrtc_performance.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":webrtc_performance",
        "//libs/pal",
        "//libs/runtime",
    ],
)
