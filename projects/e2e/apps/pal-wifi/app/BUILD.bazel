load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pal_wifi_e2e",
    srcs = ["src/h2_pal_wifi_e2e.c", "src/h2_pal_wifi_host.c"],
    hdrs = ["include/h2_pal_wifi_e2e.h", "include/h2_pal_wifi_cases.inc"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//libs/runtime"],
)

py_test(
    name = "interface_coverage_test",
    srcs = ["tests/test_inventory.py"],
    main = "tests/test_inventory.py",
    legacy_create_init = 0,
    data = [
        "api_coverage.json",
        "include/h2_pal_wifi_cases.inc",
        "src/h2_pal_wifi_e2e.c",
        "//libs/pal:pal_header_files",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files(["include/h2_pal_wifi_cases.inc"])

cc_test(
    name = "restoration_test",
    srcs = ["tests/test_restoration.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":pal_wifi_e2e", "//libs/pal:unsupported", "//libs/atomic/providers/c11"],
)
