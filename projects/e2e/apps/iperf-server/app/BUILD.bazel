load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "iperf-server/control",
        "iperf-server/ipv4",
        "iperf-server/ipv6",
        "iperf-server/ui",
    ],
)

cc_library(
    name = "controller",
    srcs = [
        "src/h2_iperf_server_app.c",
        "src/h2_iperf_server_app_internal.h",
    ],
    hdrs = ["include/h2_iperf_server_app.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/atomic",
        "//libs/iperf",
        "//libs/runtime",
    ],
)

cc_library(
    name = "iperf_server",
    srcs = [
        "src/h2_iperf_server_app_internal.h",
        "src/h2_iperf_server_ui.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [
        ":controller",
        "//libs/atomic",
        "//libs/lvgl",
    ],
)

cc_test(
    name = "controller_test",
    srcs = ["tests/test_controller.c"],
    args = ["$(rootpath @h2_vendor_iperf//:iperf3)"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = ["@h2_vendor_iperf//:iperf3"],
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":controller",
        "//libs/atomic/providers/c11",
        "//libs/iperf:test_support",
        "//libs/pal/providers/desktop/pal_core:core",
    ],
)

cc_test(
    name = "ui_test",
    srcs = ["tests/test_ui.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":iperf_server",
        "//libs/atomic/providers/c11",
        "//libs/iperf:test_support",
        "//libs/lvgl",
        "//libs/pal/providers/desktop/pal_core:core",
    ],
)
