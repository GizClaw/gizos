load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_HOST_TEST_COMPATIBILITY = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "iperf_e2e",
    srcs = ["src/h2_iperf_e2e.c"],
    hdrs = ["include/h2_iperf_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/iperf",
        "//libs/pal",
    ],
)

cc_test(
    name = "iperf_e2e_test",
    timeout = "moderate",
    srcs = ["tests/test_h2_iperf_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    tags = ["exclusive"],
    target_compatible_with = _HOST_TEST_COMPATIBILITY,
    deps = [
        ":iperf_e2e",
        "//libs/iperf",
        "//libs/iperf:test_support",
        "//libs/pal",
    ],
)
