load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "PI32V2_UNSUPPORTED_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gizclaw_e2e",
    srcs = [
        "src/h2_gizclaw_e2e.c",
        "src/h2_gizclaw_e2e_concurrency.c",
        "src/h2_gizclaw_e2e_concurrency.h",
        "src/h2_gizclaw_e2e_firmware.c",
        "src/h2_gizclaw_e2e_firmware.h",
        "src/h2_gizclaw_e2e_fixture.c",
        "src/h2_gizclaw_e2e_internal.h",
        "src/h2_gizclaw_e2e_report.c",
        "src/h2_gizclaw_e2e_report.h",
        "src/h2_gizclaw_e2e_rpc.c",
        "src/h2_gizclaw_e2e_rpc.h",
        "src/h2_gizclaw_e2e_service.c",
        "src/h2_gizclaw_e2e_service.h",
        "src/h2_gizclaw_e2e_voice.c",
        "src/h2_gizclaw_e2e_voice.h",
    ],
    hdrs = ["include/h2_gizclaw_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "src",
    ],
    # The opus vendor build crashes the JieLi pi32v2 clang 4.0.1 backend.
    target_compatible_with = PI32V2_UNSUPPORTED_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/gizclaw",
        "//libs/pal",
        "//libs/runtime",
    ] + select({
        "//tools/bazel/platforms:is_bk3633": [
            "//tools/bazel:vendor_third_party_gizclaw_firmware",
            "@h2_vendor_opus//:headers",
        ],
        "//tools/bazel/platforms:is_bk7258": [
            "//tools/bazel:vendor_third_party_gizclaw_firmware",
            "@h2_vendor_opus//:headers",
        ],
        "//tools/bazel/platforms:is_esp32p4": [
            "//tools/bazel:vendor_third_party_gizclaw_firmware",
            "@h2_vendor_opus//:headers",
        ],
        "//tools/bazel/platforms:is_esp32s3": [
            "//tools/bazel:vendor_third_party_gizclaw_firmware",
            "@h2_vendor_opus//:headers",
        ],
        "//conditions:default": [
            "//tools/bazel:vendor_third_party_gizclaw",
            "//tools/bazel:vendor_third_party_opus",
        ],
    }),
)

cc_test(
    name = "gizclaw_e2e_test",
    srcs = ["tests/test_h2_gizclaw_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":gizclaw_e2e"],
)

