load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "task_names",
    srcs = ["src/h2_lua_runtime_e2e_task_names.c"],
    hdrs = ["include/h2_lua_runtime_e2e_task_names.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
)

cc_library(
    name = "lua_runtime_e2e",
    srcs = ["src/h2_lua_runtime_e2e.c"],
    hdrs = ["include/h2_lua_runtime_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    tags = ["h2-ci-native-package"],
    deps = [
        ":task_names",
        "//libs/lua",
        "//libs/runtime",
    ],
)

cc_test(
    name = "lua_runtime_e2e_test",
    srcs = ["tests/test_h2_lua_runtime_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":lua_runtime_e2e",
        "//libs/pal:unsupported",
        "//libs/pal/providers/desktop/pal_core",
        "//libs/runtime",
        "//projects/example/libs/host_runtime",
    ],
)
