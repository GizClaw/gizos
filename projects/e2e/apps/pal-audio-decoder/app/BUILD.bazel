load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pal_audio_decoder_e2e",
    srcs = [
        "fixtures/h2_aac_vectors.c",
        "src/h2_pal_audio_decoder_e2e.c",
    ],
    hdrs = [
        "fixtures/h2_aac_vectors.h",
        "include/h2_pal_audio_decoder_cases.inc",
        "include/h2_pal_audio_decoder_e2e.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "fixtures",
        "include",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lm"],
        "//conditions:default": [],
    }),
    deps = ["//libs/pal"],
)

cc_test(
    name = "reject_missing_test",
    srcs = ["tests/test_reject_missing.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":pal_audio_decoder_e2e"],
)
