load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "task_names",
    srcs = ["src/h2_pal_e2e_task_names.c"],
    hdrs = ["include/h2_pal_e2e_task_names.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
)

cc_library(
    name = "pal_e2e",
    srcs = [
        "src/h2_pal_e2e.c",
        "src/h2_pal_pref_e2e.c",
        "src/h2_pal_pref_e2e.h",
    ],
    hdrs = ["include/h2_pal_e2e.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":task_names",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "pref_e2e_test",
    srcs = ["tests/test_h2_pal_pref_e2e.c"],
    conlyopts = H2_C11_OPTS + h2_gnu_only_copts([
        "-D_POSIX_C_SOURCE=200809L",
    ]),
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":pal_e2e",
        "//libs/pal/providers/sqlite",
    ],
)

cc_test(
    name = "pal_e2e_test",
    srcs = ["tests/test_h2_pal_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":pal_e2e"],
)
