load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-audio/e2e/runner"],
)

cc_library(
    name = "pal_audio_e2e",
    srcs = ["src/h2_pal_audio_e2e.c"],
    hdrs = ["include/h2_pal_audio_e2e.h", "include/h2_pal_audio_cases.inc"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [":tasks", "//libs/pal"],
)

cc_test(
    name = "reject_missing_test",
    srcs = ["tests/test_reject_missing.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":pal_audio_e2e"],
)

cc_test(
    name = "cleanup_once_test",
    srcs = ["tests/test_cleanup_once.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":pal_audio_e2e"],
)

exports_files(["include/h2_pal_audio_cases.inc"])

py_test(
    name = "interface_coverage_test",
    srcs = ["tests/test_interface_coverage.py"],
    data = [
        "api_coverage.json",
        "include/h2_pal_audio_cases.inc",
        "src/h2_pal_audio_e2e.c",
        "//libs/pal:pal_header_files",
    ],
    legacy_create_init = 0,
    main = "tests/test_interface_coverage.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
