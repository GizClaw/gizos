load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pal_net_tls_e2e",
    srcs = ["src/h2_pal_net_tls_e2e.c"],
    hdrs = [
        "include/h2_pal_net_tls_cases.inc",
        "include/h2_pal_net_tls_e2e.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "rejection_test",
    srcs = ["tests/test_rejection.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":pal_net_tls_e2e"],
)

exports_files([
    "api_coverage.json",
    "include/h2_pal_net_tls_cases.inc",
    "include/h2_pal_net_tls_e2e.h",
])
