load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "qualification_evidence_test",
    srcs = ["check_qualification.py"],
    data = [
        "qualification.json",
        "//libs/pal:pal_header_files",
        "//projects/e2e/apps/pal-net-tls/app:include/h2_pal_net_tls_cases.inc",
    ] + glob(
        ["evidence/**/*.json"],
        allow_empty = True,
    ),
    legacy_create_init = 0,
    main = "check_qualification.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files([
    "check_qualification.py",
    "qualification.json",
])

py_test(
    name = "evidence_rejection_test",
    srcs = [
        "check_qualification.py",
        "tests/test_evidence_rejection.py",
    ],
    data = [
        "evidence/macos/qualified.json",
        "//libs/pal:pal_header_files",
        "//projects/e2e/apps/pal-net-tls/app:include/h2_pal_net_tls_cases.inc",
    ],
    legacy_create_init = 0,
    main = "tests/test_evidence_rejection.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
