load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_OR_MOBILE_TOOL_COMPATIBILITY", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "evidence_validator",
    srcs = ["check_qualification.py"],
    data = ["//libs/pal:pal_header_files"],
    imports = ["."],
    target_compatible_with = HOST_OR_MOBILE_TOOL_COMPATIBILITY,
)

exports_files([
    "check_qualification.py",
    "qualification.json",
])

# Archived records describe their original source version, not current acceptance.
filegroup(
    name = "historical_qualification",
    srcs = ["qualification.json"] + glob(
        ["evidence/**/*"],
        allow_empty = True,
    ),
)
