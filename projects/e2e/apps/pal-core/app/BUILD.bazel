load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

# This App owns its task namespace independently of the existing PAL E2E App.
h2_tasks(
    name = "tasks",
    tasks = [
        "pal-core/e2e/core",
        "pal-core/e2e/runner",
        "pal-core/e2e/queue",
        "pal-core/e2e/condition",
        "pal-core/e2e/consumer",
        "pal-core/e2e/producer",
    ],
)

cc_library(
    name = "baseline",
    srcs = [
        "src/h2_pal_core_baseline.c",
        "src/h2_pal_core_e2e_task_names.c",
    ],
    hdrs = [
        "include/h2_pal_core_baseline.h",
        "include/h2_pal_core_e2e_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_library(
    name = "pal_core_e2e",
    srcs = [
        "src/h2_pal_core_e2e.c",
        "src/h2_pal_core_extended.c",
        "src/h2_pal_core_extended.h",
    ],
    hdrs = [
        "include/h2_pal_core_cases.inc",
        "include/h2_pal_core_e2e.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":baseline",
        "//libs/pal",
        "//libs/runtime",
    ],
)

py_test(
    name = "interface_coverage_test",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    srcs = ["tests/test_interface_coverage.py"],
    data = [
        "api_coverage.json",
        "include/h2_pal_core_cases.inc",
        "include/h2_pal_core_e2e.h",
        "src/h2_pal_core_baseline.c",
        "src/h2_pal_core_e2e.c",
        "src/h2_pal_core_extended.c",
        "//libs/pal:pal_header_files",
    ],
    legacy_create_init = 0,
    main = "tests/test_interface_coverage.py",
)

exports_files(["include/h2_pal_core_cases.inc"])
