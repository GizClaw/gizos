load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "report_lib",
    srcs = ["aec_calibration_report.py"],
    imports = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_binary(
    name = "report",
    srcs = ["aec_calibration_report.py"],
    main = "aec_calibration_report.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "report_test",
    srcs = ["test_report.py"],
    main = "test_report.py",
    data = ["//projects/e2e/apps/aec-calibration/app:calibration_test"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":report_lib", "@rules_python//python/runfiles"],
)
