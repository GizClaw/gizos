load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = ["iperf-client/run"],
)

cc_library(
    name = "iperf_client",
    srcs = [
        "src/h2_iperf_client_app.c",
        "src/h2_iperf_client_network.c",
    ],
    hdrs = ["include/h2_iperf_client_app.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/runtime",
        "//projects/e2e/apps/iperf/app:iperf_e2e",
    ],
)

cc_test(
    name = "client_test",
    srcs = ["tests/test_client.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":iperf_client",
        "//libs/iperf:test_support",
    ],
)

cc_test(
    name = "network_test",
    srcs = ["tests/test_network.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":iperf_client"],
)
