load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "lingxi_e2e",
    srcs = ["src/h2_lingxi_e2e.c"],
    hdrs = [
        "include/h2_lingxi_cases.inc",
        "include/h2_lingxi_e2e.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//libs/china_mobile/lingxi"],
)

cc_test(
    name = "app_test",
    srcs = ["tests/test_lingxi_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":lingxi_e2e",
        "//libs/pal/providers/yyjson",
    ],
)
