load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "pal-disk/e2e/reader",
        "pal-disk/e2e/writer",
    ],
)

cc_library(
    name = "pal_disk_e2e",
    srcs = ["src/h2_pal_disk_e2e.c"],
    hdrs = [
        "include/h2_pal_disk_cases.inc",
        "include/h2_pal_disk_e2e.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/atomic",
        "//libs/pal",
    ],
)

cc_test(
    name = "pal_disk_e2e_test",
    srcs = ["tests/test_pal_disk_e2e.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":pal_disk_e2e",
        "//libs/atomic/providers/c11",
        "//libs/pal",
    ],
)
