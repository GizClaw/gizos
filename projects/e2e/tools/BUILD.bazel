load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files(["checksum_matrix.bzl"])

py_library(
    name = "inventory",
    srcs = ["list_apps.py"],
    imports = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_binary(
    name = "list_apps",
    srcs = ["list_apps.py"],
    legacy_create_init = 0,
    main = "list_apps.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "inventory_test",
    srcs = ["test_inventory.py"],
    legacy_create_init = 0,
    main = "test_inventory.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":inventory"],
)

py_binary(
    name = "checksum_fixture_writer",
    srcs = ["checksum_fixture_writer.py"],
    legacy_create_init = 0,
    main = "checksum_fixture_writer.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//projects/h2loader/tools/bazel:firmware_artifacts"],
)
