load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "firmware.bzl",
    "CMakeLists.txt",
    "main/CMakeLists.txt",
    "main/idf_component.yml",
    "result_console.h",
])

cc_library(
    name = "result_console",
    hdrs = ["result_console.h"],
    includes = ["."],
    deps = [
        "//libs/atomic",
        "//libs/pal",
    ],
)

cc_test(
    name = "result_console_test",
    srcs = ["tests/test_result_console.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":result_console",
        "//libs/atomic/providers/c11",
    ] + select({
        "//tools/bazel/platforms:host_windows_target_windows": ["//libs/pal/providers/windows/pal_core"],
        "//conditions:default": ["//libs/pal/providers/desktop/pal_core:core"],
    }),
)
