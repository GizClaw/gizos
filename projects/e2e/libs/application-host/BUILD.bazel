load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files([
    "e2e_application_host.bzl",
    "src/h2_pal_e2e_application_host.c",
    "include/h2_pal_e2e_application_host.h",
])

cc_library(
    name = "headers",
    hdrs = ["include/h2_pal_e2e_application_host.h"],
    includes = ["include"],
    deps = [
        "//libs/pal/application/host",
        "//projects/h2loader/libs/h2loader",
    ],
)

cc_library(
    name = "test_sdk",
    hdrs = glob(["tests/sdk/*.h"]) + [
        "//native_component_src/bk7258/ap/h2_board_application_host:include/h2_bk_board_application_host.h",
        "//native_component_src/esp-idf6.x/h2_board_application_host:include/h2_esp_board_application_host.h",
    ],
    includes = ["tests/sdk"],
    deps = [
        ":headers",
        "//native_component_src/bk7258/ap/h2_application_host:headers",
        "//native_component_src/bk7258/ap/h2_board_application_host:headers",
        "//native_component_src/esp-idf6.x/h2_application_host:headers",
        "//native_component_src/esp-idf6.x/h2_board_application_host:headers",
    ],
)

[
    cc_test(
        name = sdk + "_" + mode.replace("-", "_") + "_test",
        srcs = [
            "src/h2_pal_e2e_application_host.c",
            "tests/test_e2e_board_host.cpp",
            "//native_component_src/" + ("esp-idf6.x" if sdk == "esp" else "bk7258/ap") + "/h2_board_application_host:src/h2_" + ("esp" if sdk == "esp" else "bk") + "_board_application_host.c",
        ],
        args = [mode],
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS,
        cxxopts = H2_CXX17_OPTS,
        defines = ["H2_PAL_E2E_HOST_TEST=1"] + (["H2_PAL_E2E_ESP=1"] if sdk == "esp" else []),
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        deps = [
            ":test_sdk",
            "//libs/pal/providers/desktop/app_support",
        ],
    )
    for sdk in [
        "esp",
        "bk",
    ]
    for mode in [
        "normal",
        "no-service",
        "custom",
        "prepare",
        "configure",
        "runtime",
        "validate",
        "entry",
        "control-start",
        "app-start",
        "stop-fault",
        "suite-error",
        "release-fault",
    ]
]

cc_library(
    name = "native_shutdown_test_headers",
    hdrs = glob(["tests/native_sdk/**/*.h"]) + [
        "//native_component_src/bk7258/ap/h2_pal_core:include/h2_bk_platform_core.h",
        "//native_component_src/esp-idf6.x/h2_pal_core:include/h2_esp_platform_core.h",
        "//native_component_src/esp-idf6.x/h2_pal_core:include/h2_esp_platform_wifi_activity.h",
        "//projects/h2loader/apps/loader/app:h2loader_bleikcp_internal.h",
        "//projects/h2loader/apps/loader/app:include/h2loader_app.h",
        "//projects/h2loader/apps/loader/app:include/h2loader_app_task_names.h",
        "//projects/h2loader/native_component_src/bk7258/ap/h2loader_bk:include/h2_bk_h2loader.h",
        "//projects/h2loader/native_component_src/bk7258/ap/h2loader_bk:src/h2_bk_h2loader_internal.h",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble:include/h2_esp_h2loader_ble.h",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime:include/h2_esp_h2loader_iostreamikcp.h",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime:include/h2_esp_h2loader_runtime.h",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime:src/h2_esp_h2loader_iostreamikcp_internal.h",
    ],
    includes = [
        "../../../../native_component_src/bk7258/ap/h2_pal_core/include",
        "../../../../native_component_src/esp-idf6.x/h2_pal_core/include",
        "../../../h2loader/apps/loader/app",
        "../../../h2loader/apps/loader/app/include",
        "../../../h2loader/native_component_src/bk7258/ap/h2loader_bk/include",
        "../../../h2loader/native_component_src/bk7258/ap/h2loader_bk/src",
        "../../../h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble/include",
        "../../../h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime/include",
        "../../../h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime/src",
        "tests/native_sdk",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    textual_hdrs = [
        "//projects/h2loader/native_component_src/bk7258/ap/h2loader_bk:src/h2_bk_h2loader_app_bleikcp.c",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble:src/h2_esp_h2loader_ble.c",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime:src/h2_esp_h2loader_iostreamikcp.c",
    ],
    deps = [
        "//libs/runtime",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble:app_commands_preflight",
    ],
)

[
    cc_test(
        name = name,
        srcs = [source],
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS + [
            "-ffunction-sections",
            "-fdata-sections",
        ],
        defines = defines,
        linkopts = select({
            "@platforms//os:macos": ["-Wl,-dead_strip"],
            "@platforms//os:linux": ["-Wl,--gc-sections"],
            "//conditions:default": [],
        }),
        target_compatible_with = select({
            "//tools/bazel/platforms:host_macos_target_macos": [],
            "//tools/bazel/platforms:host_linux_target_linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            ":native_shutdown_test_headers",
            "//libs/atomic/providers/c11",
            "//libs/iostreamikcp",
        ],
    )
    for name, source, defines in [
        (
            "esp_serial_shutdown_test",
            "tests/test_esp_serial_shutdown.c",
            ["CONFIG_ESP_CONSOLE_UART=1"],
        ),
        (
            "esp_command_shutdown_test",
            "tests/test_native_command_shutdown.c",
            ["H2_PAL_E2E_ESP=1"],
        ),
        ("bk_command_shutdown_test", "tests/test_native_command_shutdown.c", []),
    ]
]
