load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load(":fixture_config.bzl", "webrtc_fixture_config")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-webrtc/e2e/runner"],
)

webrtc_fixture_config(name = "fixture_config")

cc_library(
    name = "runner",
    srcs = ["src/h2_pal_webrtc_device.c"],
    hdrs = [
        "include/h2_pal_webrtc_device.h",
        ":fixture_config",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/pal/providers/corehttp",
        "//projects/e2e/libs/pal-webrtc-fixture:client",
        "//projects/e2e/apps/pal-webrtc/app:pal_webrtc_e2e",
    ],
)
