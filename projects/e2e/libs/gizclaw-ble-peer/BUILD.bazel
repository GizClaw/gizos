load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":config.bzl", "ble_peer_config")

package(default_visibility = ["//visibility:public"])

ble_peer_config(name = "config")

h2_tasks(
    name = "tasks",
    tasks = ["gizclaw-ble-peer/e2e/runner"],
)

cc_library(
    name = "protocol",
    srcs = ["src/protocol.c"],
    hdrs = ["include/h2_gizclaw_ble_peer_protocol.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//libs/pal"],
)

cc_library(
    name = "runner",
    srcs = ["src/peer.c"],
    hdrs = ["include/h2_gizclaw_ble_peer.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":protocol",
        ":tasks",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "protocol_test",
    srcs = ["src/test_protocol.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":protocol"],
)
