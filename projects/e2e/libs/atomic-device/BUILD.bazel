load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:mobile_e2e.bzl", "host_python_runtime")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//projects/e2e:__subpackages__"])

h2_tasks(
    name = "tasks",
    tasks = ["atomic/e2e/runner"],
)

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = ["include/device_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/runtime",
        "//projects/e2e/apps/atomic/app:atomic_e2e",
    ],
)

exports_files([
    "run_device.py",
    "device_test.bzl",
])

# Board targets contain host test code; resolve its pinned interpreter in exec
# configuration. Select explicitly for a direct --config=esp32s3/bk7258 test.
host_python_runtime(name = "host_python")

toolchain(
    name = "host_python_toolchain",
    toolchain = ":host_python",
    toolchain_type = "@bazel_tools//tools/python:toolchain_type",
)

py_test(
    name = "boot_ledger_test",
    srcs = [
        "run_device.py",
        "test_run_device.py",
    ],
    imports = ["."],
    legacy_create_init = False,
    main = "test_run_device.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
