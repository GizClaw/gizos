load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":fixture_config.bzl", "net_tls_fixture_config")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-net-tls/e2e/runner"],
)

net_tls_fixture_config(name = "fixture_config")

cc_library(
    name = "runner",
    srcs = [
        "src/device.c",
        "src/network.c",
    ],
    hdrs = [
        "include/h2_pal_net_tls_device.h",
        ":fixture_config",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//projects/e2e/libs/pal-net-tls-runner:fixture_client",
    ],
)

py_test(
    name = "udp_source_bind_fault_test",
    srcs = ["tests/test_udp_bound.py"],
    data = [
        "//libs/pal:pal_header_files",
        "//native_component_src/bk7258/ap/h2_pal_core:src/h2_bk_platform_net.c",
        "//native_component_src/esp-idf6.x/h2_pal_core:src/h2_esp_platform_net.c",
    ],
    legacy_create_init = 0,
    main = "tests/test_udp_bound.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

py_test(
    name = "fresh_boot_rejection_test",
    srcs = [
        "tests/test_boot_rejection.py",
        "verify_device.py",
    ],
    data = ["//projects/e2e/apps/pal-net-tls/app:include/h2_pal_net_tls_cases.inc"],
    legacy_create_init = 0,
    main = "tests/test_boot_rejection.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files(["verify_device.py"])

py_test(
    name = "board_tls_certificate_time_test",
    srcs = ["tests/test_board_tls_certificate_time.py"],
    data = [
        "//native_component_src/bk7258/ap/h2_pal_core:src/h2_bk_platform_net.c",
        "//native_component_src/esp-idf6.x/h2_pal_core:src/h2_esp_platform_net.c",
    ],
    legacy_create_init = 0,
    main = "tests/test_board_tls_certificate_time.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "bk_tcp_recv_timeout_test",
    srcs = ["tests/test_bk_tcp_recv_timeout.py"],
    data = [
        "//libs/pal:pal_header_files",
        "//native_component_src/bk7258/ap/h2_pal_core:src/h2_bk_platform_net.c",
    ],
    legacy_create_init = 0,
    main = "tests/test_bk_tcp_recv_timeout.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files(["assemble_board.py"])
