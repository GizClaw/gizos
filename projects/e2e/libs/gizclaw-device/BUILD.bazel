load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//projects/e2e:__subpackages__"])

cc_library(
    name = "ledger",
    srcs = ["ledger.c"],
    hdrs = ["ledger.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    deps = ["//libs/pal"],
)

cc_test(
    name = "ledger_test",
    srcs = ["test_ledger.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":ledger"],
)

py_binary(
    name = "verify_device",
    srcs = ["verify_device.py"],
    main = "verify_device.py",
    legacy_create_init = 0,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//projects/e2e/apps/gizclaw:coverage_library"],
)

py_binary(
    name = "tone_fixture",
    srcs = ["tone_fixture.py"],
    main = "tone_fixture.py",
    args = ["--file", "$(rootpath //projects/e2e/apps/gizclaw:playback_tone)"],
    data = ["//projects/e2e/apps/gizclaw:playback_tone"],
    legacy_create_init = 0,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "tone_fixture_test",
    srcs = ["tone_fixture.py", "test_tone_fixture.py"],
    main = "test_tone_fixture.py",
    imports = ["."],
    legacy_create_init = 0,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "verify_device_test",
    srcs = ["test_verify_device.py", "verify_device.py"],
    main = "test_verify_device.py",
    legacy_create_init = 0,
    imports = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
