load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "MACOS_ARM64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//projects/e2e:__subpackages__"])

cc_library(
    name = "ble_peer_receipt",
    hdrs = ["ble_peer_receipt.h"],
)

cc_test(
    name = "ble_peer_receipt_test",
    srcs = ["test_ble_peer_receipt.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":ble_peer_receipt"],
)

cc_library(
    name = "ble_peer_transfer",
    srcs = ["ble_peer_transfer.c"],
    hdrs = ["ble_peer_transfer.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [
        "//libs/crypto/sha256",
        "//libs/gizclaw",
        "//libs/pal",
    ],
)

cc_binary(
    name = "ble_peer",
    srcs = ["ble_peer.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = MACOS_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        ":ble_peer_receipt",
        ":ble_peer_transfer",
        "//libs/atomic/providers/c11",
        "//libs/gizclaw",
        "//libs/pal/providers/darwin/pal_core:corebluetooth",
    ],
)

cc_test(
    name = "ble_peer_transfer_test",
    srcs = ["test_ble_peer_transfer.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":ble_peer_transfer",
        "//libs/atomic/providers/c11",
        "//libs/crypto/sha256",
        "//libs/gizclaw",
    ],
)

cc_library(
    name = "ledger",
    srcs = ["ledger.c"],
    hdrs = ["ledger.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    deps = ["//libs/pal"],
)

cc_test(
    name = "ledger_test",
    srcs = ["test_ledger.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":ledger"],
)

py_binary(
    name = "verify_device",
    srcs = ["verify_device.py"],
    legacy_create_init = 0,
    main = "verify_device.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//projects/e2e/apps/gizclaw:coverage_library"],
)

py_test(
    name = "verify_device_test",
    srcs = [
        "test_verify_device.py",
        "verify_device.py",
    ],
    args = [
        "$(location :ble_peer_receipt_test)",
        "$(location :verify_device)",
    ],
    data = [
        ":ble_peer_receipt_test",
        ":verify_device",
    ],
    imports = ["."],
    legacy_create_init = 0,
    main = "test_verify_device.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//projects/e2e/apps/gizclaw:coverage_library"],
)
