load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_OR_MOBILE_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "fixture",
    srcs = ["fixture_ipv6.py"],
    imports = ["."],
    target_compatible_with = HOST_OR_MOBILE_TOOL_COMPATIBILITY,
    deps = ["//projects/e2e/libs/pal-net-tls-fixture:fixture"],
)

py_test(
    name = "dns_publication_test",
    srcs = ["tests/test_dns_publication.py"],
    legacy_create_init = 0,
    main = "tests/test_dns_publication.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":fixture"],
)

py_binary(
    name = "serve",
    srcs = ["serve.py"],
    args = [
        "--server",
        "$(location //projects/e2e/libs/pal-webrtc-fixture:server)",
    ],
    data = ["//projects/e2e/libs/pal-webrtc-fixture:server"],
    main = "serve.py",
    target_compatible_with = HOST_OR_MOBILE_TOOL_COMPATIBILITY,
    deps = [":fixture"],
)
