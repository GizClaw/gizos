load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "carrier_device",
    srcs = ["src/h2_carrier_device_inputs.c"],
    hdrs = ["include/h2_carrier_device_inputs.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/china_mobile/lingxi",
        "//libs/china_mobile/onenet",
    ],
)

cc_test(
    name = "inputs_test",
    srcs = ["tests/test_inputs.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":carrier_device",
        "//libs/pal/providers/yyjson",
    ],
)
