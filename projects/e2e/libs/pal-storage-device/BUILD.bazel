load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//projects/e2e:__subpackages__"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-storage/e2e/runner"],
)

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = ["include/device_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//projects/e2e/apps/pal-storage/app:pal_storage_e2e",
    ],
)

py_test(
    name = "ledger_verifier_test",
    srcs = [
        "tests/test_verify_device.py",
        "verify_device.py",
    ],
    data = ["//projects/e2e/apps/pal-storage/app:include/h2_pal_storage_cases.inc"],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/test_verify_device.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
