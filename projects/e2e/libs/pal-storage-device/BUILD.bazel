load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//projects/e2e:__subpackages__"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-storage/e2e/runner"],
)

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = ["include/device_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//projects/e2e/apps/pal-storage/app:pal_storage_e2e",
    ],
)

py_test(
    name = "ledger_verifier_test",
    srcs = [
        "tests/test_verify_device.py",
        "verify_device.py",
    ],
    data = ["//projects/e2e/apps/pal-storage/app:include/h2_pal_storage_cases.inc"],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/test_verify_device.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "bk_console_test_sources",
    hdrs = ["tests/h2_pal_storage_board_test_sdk.h"],
    includes = ["tests"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    textual_hdrs = ["//projects/e2e/targets/h2loader_tar_zlib/pal-storage/bk7258_v3_202405:ap/ap_main.c"],
    deps = [
        ":runner",
        "//libs/pal:unsupported",
        "//projects/e2e/libs/application-host:headers",
    ],
)

[
    cc_test(
        name = "bk_console_" + mode + "_test",
        srcs = ["tests/test_bk_console_lifecycle.c"],
        args = [str(scenario)],
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS,
        defines = [
            "H2_PAL_STORAGE_BOARD_HOST_TEST=1",
        ],
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        deps = [":bk_console_test_sources"],
    )
    for scenario, mode in enumerate([
        "normal",
        "suite_error",
        "stop_error",
        "restart_error",
        "confirm_error",
    ])
]
