load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:mobile_e2e.bzl", "mobile_e2e_suite")

package(default_visibility = ["//projects/e2e:__subpackages__"])

cc_library(
    name = "runner",
    srcs = ["mobile_runner.c"],
    hdrs = ["mobile_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/runtime",
        "//projects/e2e/apps/pal-mqtt/app:pal_mqtt_e2e",
    ] + select({
        "@platforms//os:ios": ["//libs/pal/providers/ios/pal_core:packaged"],
        "@platforms//os:android": ["//libs/pal/providers/android/pal_core:packaged"],
        "//conditions:default": [],
    }),
)

exports_files(["run_mobile.py"])

mobile_e2e_suite(
    name = "mobile_e2e",
    android_sdk = {
        "required_header": "prefab/modules/h2_pal_core/include/h2_android_mqtt.h",
        "public_symbols": [
            "h2_android_mqtt_create",
            "h2_android_mqtt_api",
            "h2_android_mqtt_destroy",
        ],
    },
    case_count = 36,
    case_result = "detail",
    expected = {
        "version": "2.0.0",
        "contract": 1,
        "operations": 8,
        "selected": 36,
        "failed": 0,
        "blocked": 0,
        "retained_allocations": 0,
        "invalid_frees": 0,
        "owner_failure_verified": 2,
        "owner_destroy": 0,
        "rc": 0,
        "teardown": 0,
    },
    hook = "run_mobile.py",
    ios_sdk = {
        "executable": "GizOSPALMQTTE2E",
        "provider_symbols": [
            "_h2_ios_mqtt_create",
            "_h2_ios_mqtt_api",
            "_h2_ios_mqtt_destroy",
        ],
        "portable_symbol": "_h2_pal_mqtt_e2e_run",
        "header_member": "H2PALCore.xcframework/ios-arm64-simulator/H2PALCore.framework/Headers/h2_ios_mqtt.h",
    },
    options = {"advertised": {
        "ios": "127.0.0.1",
        "android": "10.0.2.2",
    }},
    package = "com.haivivi.gizos.e2e.palmqtt",
    registry = "//projects/e2e/apps/pal-mqtt/app:include/h2_pal_mqtt_cases.inc",
    registry_pattern = "H2_PAL_MQTT_CASE\\(\\w+, \"([^\"]+)\"\\)",
    report = "pal-mqtt-result.json",
    resource_balance = True,
    timeout_seconds = 180,
    deps = ["//projects/e2e/libs/pal-mqtt-fixture:fixture"],
)
