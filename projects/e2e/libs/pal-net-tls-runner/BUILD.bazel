load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fixture_client",
    srcs = ["runner.c"],
    hdrs = ["runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    deps = ["//projects/e2e/apps/pal-net-tls/app:pal_net_tls_e2e"],
)

# FILE/stdout reporting belongs only to host/mobile launchers. Firmware borrows
# fixture_client and emits its ledger through Runtime PAL Log instead.
cc_library(
    name = "runner",
    srcs = ["report.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [":fixture_client"],
)
