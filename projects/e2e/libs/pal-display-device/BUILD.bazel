load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//projects/e2e:__subpackages__"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-display/e2e/runner"],
)

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = [
        "include/device_runner.h",
        "include/h2_display_esp_capture.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//projects/e2e/apps/pal-display/app:pal_display_e2e",
    ],
)

exports_files(["esp_main.c"])
