load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":fixture_config.bzl", "mqtt_fixture_config")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = ["pal-mqtt/e2e/runner"],
)

mqtt_fixture_config(name = "fixture_config")

cc_library(
    name = "runner",
    srcs = ["src/device_runner.c"],
    hdrs = [
        "include/device_runner.h",
        ":fixture_config",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/pal/providers/wolfssl",
        "//projects/e2e/apps/pal-mqtt/app:pal_mqtt_e2e",
    ],
)

exports_files([
    "verify_device.py",
    "device_test.bzl",
])

py_test(
    name = "verifier_test",
    srcs = [
        "tests/test_verifier.py",
        "verify_device.py",
    ],
    data = ["//projects/e2e/apps/pal-mqtt/app:include/h2_pal_mqtt_cases.inc"],
    imports = ["."],
    legacy_create_init = 0,
    main = "tests/test_verifier.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
