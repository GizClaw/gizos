    registry = "//projects/e2e/apps/pal-net-tls/app:include/h2_pal_net_tls_cases.inc",
    registry_pattern = "H2_NET_TLS_CASE\\(\\w+, \"([^\"]+)\", [01]\\)",
    report = "pal-net-tls-result.json",
    timeout_seconds = 180,
    deps = [
        "//projects/e2e/apps/pal-net-tls:evidence_validator",
        "//projects/e2e/libs/pal-net-tls-fixture:fixture",
    ],
