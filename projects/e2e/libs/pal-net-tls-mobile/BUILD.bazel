        "public_symbols": [
            "h2_android_net_create",
            "h2_android_net_api",
            "h2_android_net_destroy",
        ],
    },
    case_count = 39,
    case_result = "detail",
    expected = {
        "profile": "net-tls-core",
        "operations": 21,
        "core_qualified": True,
        "full_net_qualified": False,
        "mandatory_passed": 37,
        "failed": 0,
        "blocked": 0,
        "not_assessed": 0,
        "retained_allocations": 0,
        "retained_sockets": 0,
        "retained_resolvers": 0,
        "rc": 0,
        "teardown": 0,
    },
    hook = "run_mobile.py",
    ios_sdk = {
        "executable": "GizOSPALNetTLSE2E",
        "provider_symbols": [
            "_h2_ios_net_create",
            "_h2_ios_net_api",
            "_h2_ios_net_destroy",
        ],
        "portable_symbol": "_h2_pal_net_tls_e2e_run",
        "header_member": "H2PALCore.xcframework/ios-arm64-simulator/H2PALCore.framework/Headers/h2_ios_net.h",
    },
    optional_cases = [
        "multicast-membership",
