load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:mobile_e2e.bzl", "mobile_e2e_suite")

package(default_visibility = ["//projects/e2e:__subpackages__"])

cc_library(
    name = "runner",
    srcs = ["mobile_runner.c"],
    hdrs = ["mobile_runner.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal:unsupported",
        "//libs/runtime",
        "//projects/e2e/apps/pal-json/app:pal_json_e2e",
        "//projects/e2e/libs/pal-json-provider-probe:probe",
    ] + select({
        "@platforms//os:ios": ["//libs/pal/providers/ios/pal_core:packaged"],
        "@platforms//os:android": ["//libs/pal/providers/android/pal_core:packaged"],
        "//conditions:default": [],
    }),
)

mobile_e2e_suite(
    name = "mobile_e2e",
    android_sdk = {
        "required_header": "prefab/modules/h2_pal_core/include/h2_yyjson_json.h",
        "public_symbols": [
            "h2_android_json_provider_create",
            "h2_android_json_provider_destroy",
            "h2_yyjson_json_create",
            "h2_yyjson_json_api",
            "h2_yyjson_json_destroy",
        ],
    },
    expected = {
        "version": "2.0.0",
        "contract": 1,
        "operations": 24,
        "failed": 0,
        "blocked": 0,
        "not_run": 0,
        "complete": 1,
        "qualified": 1,
        "rc": 0,
        "teardown": 0,
    },
    ios_sdk = {
        "executable": "GizOSPALJsonE2E",
        "provider_symbols": [
            "_h2_yyjson_json_create",
            "_h2_yyjson_json_api",
            "_h2_yyjson_json_destroy",
        ],
        "portable_symbol": "_h2_pal_json_e2e_run",
        "header_member": "H2PALCore.xcframework/ios-arm64-simulator/H2PALCore.framework/Headers/h2_yyjson_json.h",
    },
    package = "com.haivivi.gizos.e2e.paljson",
    registry = "//projects/e2e/apps/pal-json/app:include/h2_pal_json_cases.inc",
    registry_pattern = "H2_PAL_JSON_CASE\\(\"([^\"]+)\"",
    report = "pal-json-result.json",
)
