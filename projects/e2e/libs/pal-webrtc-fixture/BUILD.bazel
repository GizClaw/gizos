load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/e2e:__subpackages__"])

cc_library(
    name = "client",
    srcs = ["client.c"],
    hdrs = ["client.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    deps = ["//libs/pal"],
)

# Fixtures execute on the build host even when the App targets a simulator.
genrule(
    name = "server",
    outs = ["pion_fixture"],
    cmd = "cp $(location //tools/webrtc-test-server:webrtc_test_server) $@",
    executable = True,
    tools = ["//tools/webrtc-test-server:webrtc_test_server"],
)

exports_files(["fixture.py"])

py_library(
    name = "fixture",
    srcs = ["fixture.py"],
    imports = ["."],
)
