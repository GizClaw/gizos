load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/lvgl/font_conv:font_conv.bzl", "lvgl_font")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "model",
    srcs = ["src/h2_mfg_model.c"],
    hdrs = ["include/h2_mfg_model.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = ["//projects/h2loader/libs/h2loader:api"],
)

cc_library(
    name = "session",
    srcs = ["src/h2_mfg.c"],
    hdrs = [
        "include/h2_mfg.h",
        "src/h2_mfg_internal.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":model",
        "//libs/runtime",
    ],
)

h2_tasks(
    name = "monitor_tasks",
    tasks = [
        "$mfg/monitor",
        "$mfg/camera",
    ],
)

lvgl_font(
    name = "factory_font",
    size = 22,
    out = "h2_mfg_factory_font.c",
    bpp = 4,
    font = "//projects/showcase:assets/fonts/NotoSansSC-Bold.ttf",
    font_name = "h2_mfg_factory_font",
    lv_include = "lvgl.h",
    # Common spatial labels may be supplied by a profile, outside UI prose.
    ranges = [
        "0x20-0x7E",
        "0x5DE6",
        "0x53F3",
    ],
    symbol_sources = ["src/h2_mfg_ui.c"],
)

cc_library(
    name = "mfg",
    srcs = [
        "src/h2_mfg_aec.c",
        "src/h2_mfg_hardware.c",
        "src/h2_mfg_peripherals.c",
        "src/h2_mfg_ui.c",
        ":factory_font",
    ],
    hdrs = ["src/h2_mfg_font.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [
        ":session",
        "//libs/atomic",
    ] + select({
        "//tools/bazel/platforms:is_bk7258": ["//libs/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32p4": ["//libs/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32s3": ["//libs/lvgl:firmware"],
        "//tools/bazel/platforms:is_esp32s31": ["//libs/lvgl:firmware"],
        "//conditions:default": [
            "//libs/lvgl:platform",
            "//libs/lvgl:upstream",
        ],
    }),
)

