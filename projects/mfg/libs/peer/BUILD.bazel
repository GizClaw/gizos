load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load(":config.bzl", "mfg_peer_config")

package(default_visibility = ["//visibility:public"])

mfg_peer_config(name = "config")

cc_library(
    name = "scan_protocol",
    hdrs = ["src/h2_mfg_peer_scan.h"],
    includes = ["src"],
    deps = ["//libs/pal"],
)

cc_test(
    name = "scan_test",
    srcs = ["tests/test_scan.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    deps = [":scan_protocol"],
)

h2_tasks(
    name = "tasks",
    tasks = ["mfg/peer"],
)

cc_library(
    name = "peer",
    srcs = ["src/h2_mfg_peer.c"],
    hdrs = ["include/h2_mfg_peer.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":config",
        ":scan_protocol",
        ":tasks",
        "//libs/h2loader_host:ble_client",
        "//libs/runtime",
    ],
)
