load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:app_version.bzl", "app_version")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

# H202 bumps its own App-role MFG independently of //projects/mfg:version.
app_version(
    name = "version",
    value = "0.2.0",
)

firmware_version(
    name = "firmware_version",
    build = "//boards/h202:version",
    main_version = ":version",
)

# Embedded as generated C arrays by ap/CMakeLists.txt; the package carries no
# prompt data and MFG opens no prompt path.
filegroup(
    name = "prompts",
    srcs = [
        "prompts/zh/aging.pcm",
        "prompts/zh/aging_failed.pcm",
        "prompts/zh/cellular_failed.pcm",
        "prompts/zh/cellular_passed.pcm",
        "prompts/zh/charge_failed.pcm",
        "prompts/zh/charge_insert.pcm",
        "prompts/zh/charge_passed.pcm",
        "prompts/zh/charge_remove.pcm",
        "prompts/zh/incomplete.pcm",
        "prompts/zh/listen.pcm",
        "prompts/zh/mic_failed.pcm",
        "prompts/zh/mic_left.pcm",
        "prompts/zh/mic_right.pcm",
        "prompts/zh/minus.pcm",
        "prompts/zh/nfc.pcm",
        "prompts/zh/nfc_failed.pcm",
        "prompts/zh/nfc_passed.pcm",
        "prompts/zh/plus.pcm",
        "prompts/zh/power.pcm",
        "prompts/zh/poweroff_failed.pcm",
        "prompts/zh/unsaved.pcm",
        "prompts/zh/waiting.pcm",
        "prompts/zh/wifi_failed.pcm",
        "prompts/zh/wifi_passed.pcm",
    ],
)

bk7258_target_task_policy(
    ap_default_policy = "7 0 16384 psram",
    ap_policies = [
        "h202/entry  6 0 32768 psram",
        "h2loader/appcmd  5 0 49152 psram",
        "h202/mfg  5 1 16384 psram",
        "h202/mfg/audio  5 1 16384 psram",
        "h202/mfg/sensor  5 1 16384 psram",
        "h202/mfg/wifi  5 0 16384 psram",
        "h202/mfg/cellular  5 0 16384 psram",
        "h202/mfg/power  5 0 16384 psram",
        "h202/ppp-rx  5 0 8192 psram",
        "$modem/urc  default",
        "$bleikcp/kcp  5 0 4096 psram",
        "$bleikcp/server  5 0 4096 psram",
        "$h2loader/blelink  5 0 4096 psram",
        "$h2loader/return  default",
        "$h2loader/uartcmd  5 0 49152 psram",
        "$h2peer/net  default",
        "$h2peer/udp  default",
        "$runtime/input  default",
        "$runtime/nfc  default",
    ],
    cp_default_policy = "6 16384 default",
    graph = [":mfg_launcher"],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["h202/entry"],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/drivers/nfc/fm175xx",
        "//libs/iostreamikcp",
        "//libs/ntp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/modem/quectel:quectel_modem",
        "//libs/runtime",
        "//libs/utils",
        "//libs/wifi_sta",
        "//projects/mfg/apps/h202/app:mfg",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "ap/ap_main.c",
        "ap/profile.c",
    ],
    hdrs = [],
    component_directory = "projects/mfg/apps/h202/ap",
    component_name = "ap",
    data = [
        "ap/CMakeLists.txt",
        ":prompts",
    ],
    execution_unit = "ap",
)

firmware_native_component(
    name = "mfg_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/h202/bk7258:mfg",
        "//libs/bundle",
        "//libs/command",
        "//libs/pal",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_nfc_fm175xx",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//projects/h2loader/apps/loader/app:tasks",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/bk7258/ap/h2loader_bk",
        "//projects/h2loader/native_component_src/bk7258/cp/h2loader_cp_launcher",
        "//projects/mfg/apps/h202/app:mfg",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "ap/ap_main.c",
        "ap/profile.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "h202",
    cp_task_policy = ":cp_task_policy",
    graph = [":mfg_launcher"],
    # Full MFG peripherals; CP/AP link at the App-window XIP addresses.
    layout_files = {
        "ap_config": [
            "//boards/h202/bk7258:ap.defaults",
            "//boards/h202/bk7258/layouts/mfg:ap.defaults",
        ],
        "ap_gpio": "//boards/h202/bk7258/layouts/mfg:ap_gpio",
        "cp_config": [
            "//boards/h202/bk7258:cp.defaults",
            "//boards/h202/bk7258/layouts/mfg:cp.defaults",
        ],
        "cp_gpio": "//boards/h202/bk7258/layouts/mfg:cp_gpio",
        "project_support_files": ["//boards/h202/bk7258/layouts/mfg:layout"],
        "ram_regions": "//boards/h202/bk7258/layouts/mfg:ram_regions.csv",
        "recovery_config": "//boards/h202/bk7258/layouts/loader:bk_loader.json",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_h202_mfg",
    target = "bk7258",
    version = ":firmware_version",
)

h2loader_tar_zlib(
    name = "package",
    board = "h202",
    firmware = ":firmware",
    image = "h202-mfg",
    role = "app",
    target = "bk7258",
)
