load("@rules_cc//cc:defs.bzl", "cc_test")
load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    build = "//boards/ai_passport:version",
    main_version = "//projects/mfg:version",
)

esp_target_task_policy(
    default_policy = "4 0 4096 internal",
    graph = [":h2loader_launcher"],
    policies = [
        "h2loader/appcmd   8 0  8192 internal",
        "h2loader/blecmd   8 0  8192 internal",
        "$h2loader/return  8 0  8192 internal",
        "$h2loader/blelink 6 0  4096 internal",
        "$bleikcp/kcp      7 0  4096 internal",
        "$bleikcp/server   5 0  4096 internal",
        "$h2peer/net       7 0  4096 internal",
        "$h2peer/udp       7 0  4096 internal",
        "$runtime/input    default",
        "$runtime/nfc      default",
        "$h2loader/uartcmd  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    target_compatible_with = ["//tools/bazel/platforms:target_esp32c3"],
    deps = [
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/drivers/battery/cw2017",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/mfg/libs/mfg",
    ],
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [
        "main/main.c",
        "main/profile.c",
        "main/recording.c",
        "main/resources.c",
    ],
    hdrs = ["main/recording.h", "main/resources.h"],
    component_directory = "projects/mfg/apps/ai_passport/main",
    component_name = "main",
    data = ["main/CMakeLists.txt"],
    deps = [
        ":firmware_lib",
        "//boards/ai_passport/esp32c3",
        "//libs/bundle",
        "//libs/pal",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/main.c",
        "main/profile.c",
        "main/recording.c",
        "main/recording.h",
        "main/resources.c",
        "main/resources.h",
        "sdkconfig.mfg.defaults",
    ],
    board = "ai_passport",
    cmake_definitions = {
        "H2_ESP_SAFE_IO_SCRATCH_CAPACITY": "4096",
        "H2_LOADER_SERIAL_RX_BUFFER": "1024",
        "H2_LOADER_STREAM_RX_BUFFER": "1024",
        "H2_LOADER_TRANSPORT_RECEIVE_WINDOW": "8",
        "H2_ESP_BLE_MAX_GATT_SERVICES": "1",
        "H2_ESP_BLE_MAX_GATT_CHARACTERISTICS_PER_SERVICE": "2",
    },
    graph = [":h2loader_launcher"],
    layout_files = {
        "partition": "//boards/ai_passport/esp32c3/layouts/h2loader:partition.csv",
        "project_support_files": ["//boards/ai_passport/esp32c3/layouts/h2loader:sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "h2_mfg",
    target = "esp32c3",
    task_policy = ":task_policy",
    version = ":version",
)

cc_test(
    name = "resources_test",
    srcs = [
        "main/recording.h",
        "main/resources.c",
        "main/resources.h",
        "tests/resources_sdk.h",
        "tests/resources_test.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main", "tests"],
    local_defines = ["H2_PASSPORT_RESOURCES_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/atomic/providers/c11",
        "//libs/pal/providers/desktop/pal_core",
        "//projects/h2loader/apps/loader/app:loader",
        "//projects/mfg/libs/mfg:model",
    ],
)

h2loader_tar_zlib(
    name = "package",
    board = "ai_passport",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "esp32c3",
)

cc_test(
    name = "recording_test",
    size = "small",
    srcs = [
        "main/recording.c",
        "main/recording.h",
        "tests/recording_sdk.h",
        "tests/recording_test.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["main", "tests"],
    local_defines = ["H2_PASSPORT_RECORDING_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/pal",
        "//libs/pal/providers/wolfssl:wolfcrypt",
        "//libs/runtime",
        "//projects/h2loader/libs/h2loader:api",
        "//projects/mfg/libs/mfg:model",
    ],
)
