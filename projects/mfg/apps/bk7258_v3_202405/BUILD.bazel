load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_bk7258_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "bk7258_target_task_policy")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "version",
    build = "//boards/bk7258_v3_202405:version",
    main_version = "//projects/mfg:version",
)

bk7258_target_task_policy(
    ap_allocator = "psram",
    ap_default_policy = "7 0 4096 default",
    ap_policies = [
        "bk/h2loader        6        0  24576  default",
        "h2loader/appcmd    5        0  49152  psram",
        "h2loader/blecmd    5        0  49152  psram",
        "$h2loader/uartcmd  5        0  49152  psram",
        "$bleikcp/kcp       default",
        "$bleikcp/server    default",
        "$h2peer/net        default",
        "$h2peer/udp        default",
        "$runtime/input     default",
        "$runtime/nfc       default",
        "$h2loader/return   default",
        "$h2loader/blelink  default",
    ],
    cp_default_policy = "6 4096 default",
    graph = [":h2loader_launcher"],
)

h2_tasks(
    name = "entry_tasks",
    tasks = ["bk/h2loader"],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/coremqtt",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/mfg/libs/mfg",
    ],
)

firmware_native_component(
    name = "ap_launcher_component",
    srcs = [
        "main.c",
        "profile.c",
    ],
    hdrs = [],
    component_directory = "projects/mfg/apps/bk7258_v3_202405/ap",
    component_name = "ap",
    data = ["ap/CMakeLists.txt"],
    execution_unit = "ap",
    native_srcs = [
        "//projects/h2loader/targets/h2loader_tar_zlib/loader/bk7258_v3_202405:ap/ap_main.c",
        "//projects/h2loader/apps/loader/app:h2loader_bleikcp.c",
    ],
)

firmware_native_component(
    name = "h2loader_launcher",
    srcs = [],
    hdrs = [],
    data = [
    ],
    tags = [
        "manual",
    ],
    deps = [
        ":ap_launcher_component",
        ":entry_tasks",
        ":firmware_lib",
        "//boards/bk7258_v3_202405/bk7258",
        "//libs/bundle",
        "//libs/command",
        "//libs/pal",
        "//libs/runtime",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/zlib",
        "//native_component_src/bk7258/cp/h2_pal_core",
        "//projects/h2loader/apps/loader/app:ble_tasks",
        "//projects/h2loader/apps/loader/app:tasks",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/bk7258/ap/h2loader_bk",
        "//projects/h2loader/native_component_src/bk7258/cp/h2loader_cp_launcher",
    ],
)

h2loader_bk7258_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "ap/CMakeLists.txt",
        "main.c",
        "profile.c",
    ],
    ap_task_policy = ":ap_task_policy",
    board = "bk7258_v3_202405",
    cp_task_policy = ":cp_task_policy",
    graph = [
        ":h2loader_launcher",
    ],
    # Factory uses the board's complete peripheral configuration and display
    # RAM plan at the existing primary Loader Flash addresses.
    layout_files = {
        "ap_config": [
            "//boards/bk7258_v3_202405/bk7258:ap.defaults",
            "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:ap.defaults",
        ],
        "ap_gpio": "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:ap_gpio_display",
        "cp_config": [
            "//boards/bk7258_v3_202405/bk7258:cp.defaults",
            "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:cp.defaults",
        ],
        "cp_gpio": "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:cp_gpio",
        "project_support_files": ["//boards/bk7258_v3_202405/bk7258/layouts/loader:layout"],
        "ram_regions": "//boards/bk7258_v3_202405/bk7258/layouts/h2loader:ram_regions",
        "recovery_config": "//boards/bk7258_v3_202405/bk7258/layouts/loader:recovery_config",
    },
    project = "CMakeLists.txt",
    project_name = "h2_bk_mfg",
    target = "bk7258",
    version = ":version",
)

h2loader_tar_zlib(
    name = "package",
    board = "bk7258_v3_202405",
    firmware = ":firmware",
    image = "mfg",
    role = "h2loader",
    target = "bk7258",
)
