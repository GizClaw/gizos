load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:app_version.bzl", "app_version")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/lvgl/ttf_subset:ttf_subset.bzl", "ttf_subset_c")

package(default_visibility = ["//projects/g99:__subpackages__"])

app_version(
    name = "version",
    value = "0.1.0",
)

# The Loader screen runs on the ESP32-S31 Loader image and on the desktop
# hosts for its render test. It holds no SDK handles.
_COMPATIBILITY = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//tools/bazel/platforms:is_esp32s31": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Status text is ASCII only.
ttf_subset_c(
    name = "font_subset",
    font = "//projects/g99/assets/fonts:noto_sans_sc_bold",
    out_c = "h2_g99_loader_font.c",
    out_h = "h2_g99_loader_font.h",
    ranges = ["0x20-0x7E"],
    symbol = "h2_g99_loader_font",
)

# Screen state and status text: pure C.
cc_library(
    name = "state",
    srcs = ["src/h2_g99_loader_state.c"],
    hdrs = ["include/h2_g99_loader_state.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = _COMPATIBILITY,
    deps = ["//libs/h2loader/device:api"],
)

cc_library(
    name = "ui",
    srcs = [
        "src/h2_g99_loader_ui.c",
        ":font_subset",
    ],
    hdrs = ["include/h2_g99_loader_ui.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = _COMPATIBILITY,
    deps = [
        ":state",
        "//libs/runtime",
        "//libs/ui/lvgl",
        "//pal",
        "//projects/g99/libs/art",
    ],
)

cc_test(
    name = "state_test",
    size = "small",
    srcs = ["tests/test_h2_g99_loader_state.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":state"],
)

h2_tasks(
    name = "controller_tasks",
    tasks = ["g99/loader/ui"],
)

cc_library(
    name = "controller",
    srcs = ["src/h2_g99_loader_controller.c"],
    hdrs = ["include/h2_g99_loader_controller.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = _COMPATIBILITY,
    deps = [
        ":controller_tasks",
        ":ui",
        "//libs/runtime",
        "//pal",
    ],
)

cc_test(
    name = "controller_test",
    srcs = ["tests/test_h2_g99_loader_controller.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":controller",
        "//libs/sync/atomic/providers/c11",
        "//pal/providers/platforms/desktop/pal_core",
    ],
)

# Renders every state at 480 x 480 and 320 x 240 into a memory display,
# checks the frames and keeps them as <W>x<H>-<state>.bmp in the test's
# undeclared outputs (bazel-testlogs/.../test.outputs/outputs.zip).
cc_test(
    name = "render_test",
    size = "small",
    srcs = ["tests/test_h2_g99_loader_render.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":ui",
        "//libs/runtime",
        "//libs/sync/atomic/providers/c11",
        "//pal",
        "//pal/providers/platforms/desktop/pal_core",
        "//projects/g99/libs/art",
    ],
)
