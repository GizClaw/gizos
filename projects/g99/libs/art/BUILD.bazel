load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/g99:__subpackages__"])

# GizPocket artwork and the brand screen layout shared by Main and the Loader.
# Pure C: no LVGL, no Runtime and no SDK handles.
_COMPATIBILITY = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//tools/bazel/platforms:is_esp32s31": [],
    "@platforms//cpu:wasm32": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "art",
    srcs = [
        "src/h2_g99_art.c",
        "src/h2_g99_brand.c",
    ],
    hdrs = [
        "include/h2_g99_art.h",
        "include/h2_g99_brand.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = _COMPATIBILITY,
)

cc_test(
    name = "art_test",
    size = "small",
    srcs = ["tests/test_h2_g99_art.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":art"],
)

cc_test(
    name = "brand_test",
    size = "small",
    srcs = ["tests/test_h2_g99_brand.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":art"],
)
