load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//projects/g99:__subpackages__"])

# G99 input adaptation for its Mosaico Main and E2E entries.
_COMPATIBILITY = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//tools/bazel/platforms:is_esp32s31": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Logical keys for the app images; it names Main's logical components.
cc_library(
    name = "input",
    srcs = ["src/h2_g99_mosaico_input.c"],
    hdrs = ["include/h2_g99_mosaico_input.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = _COMPATIBILITY,
    deps = [
        "//libs/runtime",
        "//pal",
        "//projects/g99/apps/main",
    ],
)

cc_test(
    name = "input_test",
    size = "small",
    srcs = ["tests/test_h2_g99_mosaico_input.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":input",
        "//libs/sync/atomic/providers/c11",
    ],
)
