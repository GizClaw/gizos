load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "showcase/gizclaw",
        "showcase/audio",
    ],
)

cc_library(
    name = "showcase",
    srcs = [
        "src/h2_showcase.c",
        "src/h2_showcase_state.c",
        "src/h2_showcase_state.h",
        "src/h2_showcase_task_names.c",
    ],
    hdrs = [
        "include/h2_showcase.h",
        "include/h2_showcase_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//tools/bazel/platforms:is_linux_armv7_gnueabihf": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":tasks",
        "//libs/gizclaw",
        "//libs/lvgl",
        "//libs/mp4_decoder",
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "showcase_state_test",
    srcs = [
        "src/h2_showcase_state.c",
        "src/h2_showcase_state.h",
        "tests/test_h2_showcase_state.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
