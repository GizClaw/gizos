load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/desktop_layout:desktop_layout.bzl", "h2_desktop_layout_config")

package(default_visibility = ["//visibility:public"])

h2_desktop_layout_config(
    name = "layout_generated",
    src = "layout.json",
    app_name = "showcase",
)

cc_library(
    name = "layout_config",
    hdrs = [":layout_generated"],
    strip_include_prefix = "layout_generated",
    deps = [
        "//libs/pal/providers/desktop/app_support",
        "//libs/pal/providers/desktop/pal_core",
    ],
)

cc_binary(
    name = "showcase",
    srcs = ["main.cpp"],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    data = [
        "layout.json",
        "//projects/showcase:assets/fonts/NotoSansSC-Bold.ttf",
        "//projects/showcase:assets/media/big_buck_bunny_showcase.mp4",
        "//projects/showcase:assets/media/big_buck_bunny_showcase_s16le_16k_mono.pcm",
    ],
    deps = [
        ":layout_config",
        "//libs/pal",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/desktop/app_support",
        "//libs/pal/providers/desktop/app_support:bundle_rpath",
        "//libs/pal/providers/desktop/pal_core",
        "//libs/pal/providers/ffmpeg",
        "//libs/pal/providers/portaudio",
        "//libs/pal/providers/sqlite",
        "//libs/runtime",
        "//projects/showcase/apps/showcase",
    ],
)
