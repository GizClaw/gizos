load("//projects/h2loader/tools/bazel:h2loader_firmware.bzl", "h2loader_esp_idf_firmware")
load("//projects/h2loader/tools/bazel:h2loader_tar_zlib.bzl", "h2loader_tar_zlib")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:target_task_policy.bzl", "esp_target_task_policy")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = ["gfx/runner"],
)

esp_target_task_policy(
    default_policy = "4 any 4096 psram",
    graph = [":launcher"],
    policies = [
        "gfx/runner 4 0 65536 psram",
        "gfx/touch 5 1 4096 psram",
        "h2loader/appcmd 8 0 4096 psram",
        "h2loader/blecmd 8 0 4096 psram",
        "$h2loader/return 8 0 4096 psram",
        "$h2loader/blelink 6 0 4096 psram",
        "$bleikcp/kcp 7 0 4096 psram",
        "$bleikcp/server 5 0 4096 psram",
        "$h2peer/net 7 0 4096 psram",
        "$h2peer/udp 7 0 4096 psram",
        "$runtime/input default",
        "$runtime/nfc default",
        "$h2loader/uartcmd default",
    ],
)

# The board and Loader native components use this first-party library closure.
firmware_lib_component(
    name = "firmware_lib",
    deps = [
        ":tasks",
        "//libs/audio_mixer",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/drivers/audio/es8311",
        "//libs/iostreamikcp",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pixa",
        "//libs/runtime",
        "//libs/wifi_sta",
        "//projects/gfx_bench/app",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    component_directory = "projects/gfx_bench/targets/h2loader_tar_zlib/gfx_bench/esp_mosaico/main",
    component_name = "main",
    data = ["main/CMakeLists.txt"],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//boards/esp_mosaico/esp32s31",
        "//libs/bundle",
        "//libs/pal",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/zlib",
        "//projects/h2loader/libs/h2loader",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_ble",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_mosaico_usb",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime",
    ],
)

h2loader_esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/main.c",
        "sdkconfig.gfx_bench.defaults",
    ],
    board = "esp_mosaico",
    graph = [":launcher"],
    layout_files = {
        "partition": "//boards/esp_mosaico/esp32s31/layouts/h2loader:partition.csv",
        "project_support_files": ["//boards/esp_mosaico/esp32s31/layouts/h2loader:sdkconfig.h2loader.defaults"],
    },
    project = "CMakeLists.txt",
    project_name = "h2_gfx_bench",
    target = "esp32s31",
    task_policy = ":task_policy",
)

h2loader_tar_zlib(
    name = "package",
    board = "esp_mosaico",
    firmware = ":firmware",
    image = "gfx-bench",
    role = "app",
    target = "esp32s31",
)
