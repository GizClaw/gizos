load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

cc_library(
    name = "tinyh264",
    srcs = [
        "src/native/h264bsd_byte_stream.c",
        "src/native/h264bsd_cavlc.c",
        "src/native/h264bsd_conceal.c",
        "src/native/h264bsd_deblocking.c",
        "src/native/h264bsd_decoder.c",
        "src/native/h264bsd_dpb.c",
        "src/native/h264bsd_image.c",
        "src/native/h264bsd_inter_prediction.c",
        "src/native/h264bsd_intra_prediction.c",
        "src/native/h264bsd_macroblock_layer.c",
        "src/native/h264bsd_nal_unit.c",
        "src/native/h264bsd_neighbour.c",
        "src/native/h264bsd_pic_order_cnt.c",
        "src/native/h264bsd_pic_param_set.c",
        "src/native/h264bsd_reconstruct.c",
        "src/native/h264bsd_sei.c",
        "src/native/h264bsd_seq_param_set.c",
        "src/native/h264bsd_slice_data.c",
        "src/native/h264bsd_slice_group_map.c",
        "src/native/h264bsd_slice_header.c",
        "src/native/h264bsd_storage.c",
        "src/native/h264bsd_stream.c",
        "src/native/h264bsd_transform.c",
        "src/native/h264bsd_util.c",
        "src/native/h264bsd_vlc.c",
        "src/native/h264bsd_vui.c",
    ],
    hdrs = [
        "src/native/basetype.h",
        "src/native/h264bsd_byte_stream.h",
        "src/native/h264bsd_cavlc.h",
        "src/native/h264bsd_cfg.h",
        "src/native/h264bsd_conceal.h",
        "src/native/h264bsd_container.h",
        "src/native/h264bsd_deblocking.h",
        "src/native/h264bsd_decoder.h",
        "src/native/h264bsd_dpb.h",
        "src/native/h264bsd_image.h",
        "src/native/h264bsd_inter_prediction.h",
        "src/native/h264bsd_intra_prediction.h",
        "src/native/h264bsd_macroblock_layer.h",
        "src/native/h264bsd_nal_unit.h",
        "src/native/h264bsd_neighbour.h",
        "src/native/h264bsd_pic_order_cnt.h",
        "src/native/h264bsd_pic_param_set.h",
        "src/native/h264bsd_reconstruct.h",
        "src/native/h264bsd_sei.h",
        "src/native/h264bsd_seq_param_set.h",
        "src/native/h264bsd_slice_data.h",
        "src/native/h264bsd_slice_group_map.h",
        "src/native/h264bsd_slice_header.h",
        "src/native/h264bsd_storage.h",
        "src/native/h264bsd_stream.h",
        "src/native/h264bsd_transform.h",
        "src/native/h264bsd_util.h",
        "src/native/h264bsd_vlc.h",
        "src/native/h264bsd_vui.h",
    ],
    conlyopts = select({
        ":is_windows_x86_64": [
            "/experimental:c11atomics",
            "/std:c11",
        ],
        "//conditions:default": ["-std=c11"],
    }),
    copts = select({
        ":is_windows_x86_64": ["/W4"],
        "//conditions:default": [
            "-Wall",
            "-Wextra",
            "-fno-sanitize=undefined",
        ],
    }),
    includes = ["src/native"],
    local_defines = [
        "free=h2_tinyh264_free",
        "malloc=h2_tinyh264_malloc",
    ],
)
