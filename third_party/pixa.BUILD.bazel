load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

exports_files([
    "src/pkgs/c/tests/test_pixa_blit.c",
    "src/pkgs/c/tests/test_pixa_decode.c",
    "src/pkgs/c/tests/test_pixa_dir.c",
    "src/pkgs/c/tests/test_public_headers.c",
])

cc_library(
    name = "pixa",
    srcs = [
        "src/pkgs/c/src/pixa_blit.c",
        "src/pkgs/c/src/pixa_decode.c",
        "src/pkgs/c/src/pixa_dir.c",
        "src/pkgs/c/src/pixa_extract.c",
        "src/pkgs/c/src/pixa_pack.c",
        "src/pkgs/c/src/pixa_reader.c",
        "src/pkgs/c/src/pixa_types.c",
    ],
    hdrs = [
        "src/pkgs/c/include/pixa.h",
        "src/pkgs/c/include/pixa_blit.h",
        "src/pkgs/c/include/pixa_decode.h",
        "src/pkgs/c/include/pixa_dir.h",
        "src/pkgs/c/include/pixa_extract.h",
        "src/pkgs/c/include/pixa_osal.h",
        "src/pkgs/c/include/pixa_pack.h",
        "src/pkgs/c/include/pixa_reader.h",
        "src/pkgs/c/include/pixa_types.h",
    ],
    conlyopts = select({
        ":is_windows_x86_64": [
            "/experimental:c11atomics",
            "/std:c11",
        ],
        "//conditions:default": ["-std=c11"],
    }),
    copts = select({
        ":is_windows_x86_64": [
            "/W4",
            "/WX",
        ],
        "//conditions:default": [
            "-Wall",
            "-Wextra",
            "-Werror",
            "-Wno-unused-function",
        ],
    }),
    includes = ["src/pkgs/c/include"],
)
