load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "embedded",
    constraint_values = ["@platforms//os:none"],
)

cc_library(
    name = "yyjson",
    srcs = ["src/src/yyjson.c"],
    hdrs = ["src/src/yyjson.h"],
    conlyopts = select({
        ":is_windows_x86_64": [
            "/experimental:c11atomics",
            "/std:c11",
        ],
        "//conditions:default": ["-std=c11"],
    }),
    # Embedded images favor ROM size over floating-point conversion throughput.
    # Calibration reads raw integer tokens and never needs fast FP tables.
    defines = select({
        ":embedded": ["YYJSON_DISABLE_FAST_FP_CONV=1"],
        "//conditions:default": [],
    }),
    includes = ["src/src"],
)
