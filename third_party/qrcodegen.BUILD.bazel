load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

cc_library(
    name = "qrcodegen",
    srcs = ["src/c/qrcodegen.c"],
    hdrs = ["src/c/qrcodegen.h"],
    conlyopts = select({
        ":is_windows_x86_64": ["/std:c11"],
        "//conditions:default": ["-std=c11"],
    }),
    copts = select({
        ":is_windows_x86_64": ["/W4"],
        "//conditions:default": [
            "-Wall",
            "-Wextra",
        ],
    }),
    includes = ["src/c"],
)
