idf_component_get_property(H2_NAND_DIR espressif__spi_nand_flash COMPONENT_DIR)
idf_component_get_property(H2_NAND_LIB espressif__spi_nand_flash COMPONENT_LIB)
set(H2_NAND_SOURCE "${H2_NAND_DIR}/src/dhara_glue.c")
file(SHA256 "${H2_NAND_SOURCE}" H2_NAND_SOURCE_HASH)
if(NOT H2_NAND_SOURCE_HASH STREQUAL
   "d528d949eb76e22bb61cd2da5fbf9ac0709517bf40c84ccc876eda6f9bc324dc")
  message(FATAL_ERROR "SPI NAND usage extension requires unmodified spi_nand_flash 1.4.4")
endif()

file(READ "${H2_NAND_SOURCE}" H2_NAND_ORIGINAL)
file(READ "${CMAKE_CURRENT_LIST_DIR}/usage.c.inc" H2_NAND_USAGE)
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/h2_spi_nand_flash")
set(H2_NAND_PATCHED "${CMAKE_BINARY_DIR}/h2_spi_nand_flash/dhara_glue.c")
file(WRITE "${H2_NAND_PATCHED}" "${H2_NAND_ORIGINAL}\n${H2_NAND_USAGE}")
get_target_property(H2_NAND_SOURCES "${H2_NAND_LIB}" SOURCES)
set(H2_NAND_REPLACEMENTS 0)
set(H2_NAND_RESULT)
foreach(H2_NAND_INPUT IN LISTS H2_NAND_SOURCES)
  get_filename_component(H2_NAND_INPUT_NAME "${H2_NAND_INPUT}" NAME)
  if(H2_NAND_INPUT_NAME STREQUAL "dhara_glue.c")
    list(APPEND H2_NAND_RESULT "${H2_NAND_PATCHED}")
    math(EXPR H2_NAND_REPLACEMENTS "${H2_NAND_REPLACEMENTS} + 1")
  else()
    list(APPEND H2_NAND_RESULT "${H2_NAND_INPUT}")
  endif()
endforeach()
if(NOT H2_NAND_REPLACEMENTS EQUAL 1)
  message(FATAL_ERROR "SPI NAND usage extension must replace exactly one Dhara source")
endif()
set_property(TARGET "${H2_NAND_LIB}" PROPERTY SOURCES "${H2_NAND_RESULT}")
target_include_directories("${H2_NAND_LIB}" PRIVATE "${CMAKE_CURRENT_LIST_DIR}/include")
target_include_directories("${COMPONENT_LIB}" PRIVATE "${CMAKE_CURRENT_LIST_DIR}/include")
