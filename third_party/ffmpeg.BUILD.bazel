load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

package(default_visibility = ["//visibility:public"])

exports_files(["ffmpeg_configure.sh"])

config_setting(
    name = "host_macos_target_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    define_values = {"h2_host_os": "macos"},
)

config_setting(
    name = "is_linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "all_sources",
    srcs = glob(["src/**"]),
)

configure_make(
    name = "ffmpeg_foreign",
    args = ["-j4"],
    build_data = [":ffmpeg_configure.sh"],
    configure_options = select({
        ":host_macos_target_linux_x86_64": [
            "--arch=x86_64",
            "--target-os=linux",
            "--enable-cross-compile",
            "--disable-x86asm",
            "--disable-everything",
            "--disable-programs",
            "--disable-doc",
            "--disable-debug",
            "--disable-autodetect",
            "--disable-network",
            "--disable-static",
            "--enable-shared",
            "--disable-avdevice",
            "--disable-avfilter",
            "--disable-avformat",
            "--disable-swresample",
            "--enable-avcodec",
            "--enable-avutil",
            "--enable-swscale",
            "--enable-decoder=h264,aac",
            "--enable-parser=h264,aac",
        ],
        ":is_linux_x86_64": [
            "--arch=x86_64",
            "--target-os=linux",
            "--enable-cross-compile",
            "--disable-everything",
            "--disable-programs",
            "--disable-doc",
            "--disable-debug",
            "--disable-autodetect",
            "--disable-network",
            "--disable-static",
            "--enable-shared",
            "--disable-avdevice",
            "--disable-avfilter",
            "--disable-avformat",
            "--disable-swresample",
            "--enable-avcodec",
            "--enable-avutil",
            "--enable-swscale",
            "--enable-decoder=h264,aac",
            "--enable-parser=h264,aac",
        ],
        ":is_linux_arm64": [
            "--arch=aarch64",
            "--target-os=linux",
            "--enable-cross-compile",
            "--disable-everything",
            "--disable-programs",
            "--disable-doc",
            "--disable-debug",
            "--disable-autodetect",
            "--disable-network",
            "--disable-static",
            "--enable-shared",
            "--disable-avdevice",
            "--disable-avfilter",
            "--disable-avformat",
            "--disable-swresample",
            "--enable-avcodec",
            "--enable-avutil",
            "--enable-swscale",
            "--enable-decoder=h264,aac",
            "--enable-parser=h264,aac",
        ],
        "@platforms//os:macos": [
            "--arch=arm64",
            "--target-os=darwin",
            "--disable-everything",
            "--disable-programs",
            "--disable-doc",
            "--disable-debug",
            "--disable-autodetect",
            "--disable-network",
            "--disable-static",
            "--enable-shared",
            "--disable-avdevice",
            "--disable-avfilter",
            "--disable-avformat",
            "--disable-swresample",
            "--enable-avcodec",
            "--enable-avutil",
            "--enable-swscale",
            "--enable-decoder=h264,aac",
            "--enable-parser=h264,aac",
            "--install-name-dir=@rpath",
        ],
        "//conditions:default": [],
    }),
    configure_prefix = "$(execpath :ffmpeg_configure.sh)",
    env = select({
        "@platforms//os:linux": {"H2_FFMPEG_CONFIG_TARGET": "linux"},
        "@platforms//os:macos": {"MACOSX_DEPLOYMENT_TARGET": "13.0"},
        "//conditions:default": {},
    }),
    lib_source = ":all_sources",
    out_bin_dir = "lib",
    out_binaries = select({
        "@platforms//os:linux": [
            "libavcodec.so.62",
            "libavutil.so.60",
            "libswscale.so.9",
        ],
        "//conditions:default": [],
    }),
    out_shared_libs = select({
        "@platforms//os:linux": [
            "libavcodec.so",
            "libavutil.so",
            "libswscale.so",
        ],
        "@platforms//os:macos": [
            "libavcodec.62.dylib",
            "libavutil.60.dylib",
            "libswscale.9.dylib",
        ],
        "//conditions:default": [],
    }),
    postfix_script = select({
        "@platforms//os:linux": (
            "cp -L $$INSTALLDIR/lib/libavcodec.so.62 " +
            "$$INSTALLDIR/lib/libavcodec.so.62.h2-real && " +
            "mv -f $$INSTALLDIR/lib/libavcodec.so.62.h2-real " +
            "$$INSTALLDIR/lib/libavcodec.so.62 && " +
            "cp -L $$INSTALLDIR/lib/libavutil.so.60 " +
            "$$INSTALLDIR/lib/libavutil.so.60.h2-real && " +
            "mv -f $$INSTALLDIR/lib/libavutil.so.60.h2-real " +
            "$$INSTALLDIR/lib/libavutil.so.60 && " +
            "cp -L $$INSTALLDIR/lib/libswscale.so.9 " +
            "$$INSTALLDIR/lib/libswscale.so.9.h2-real && " +
            "mv -f $$INSTALLDIR/lib/libswscale.so.9.h2-real " +
            "$$INSTALLDIR/lib/libswscale.so.9 && " +
            "rm -f $$INSTALLDIR/lib/libavcodec.so " +
            "$$INSTALLDIR/lib/libavutil.so " +
            "$$INSTALLDIR/lib/libswscale.so && " +
            "cp -p $$INSTALLDIR/lib/libavcodec.so.62 " +
            "$$INSTALLDIR/lib/libavcodec.so && " +
            "cp -p $$INSTALLDIR/lib/libavutil.so.60 " +
            "$$INSTALLDIR/lib/libavutil.so && " +
            "cp -p $$INSTALLDIR/lib/libswscale.so.9 " +
            "$$INSTALLDIR/lib/libswscale.so"
        ),
        "//conditions:default": "",
    }),
    target_compatible_with = select({
        "@platforms//os:linux": ["@platforms//cpu:x86_64"],
        "@platforms//os:macos": ["@platforms//cpu:arm64"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    targets = ["install"],
)

filegroup(
    name = "avcodec_runtime",
    srcs = [":ffmpeg_foreign"],
    output_group = select({
        "@platforms//os:linux": "libavcodec.so.62",
        "@platforms//os:macos": "libavcodec.62.dylib",
        "//conditions:default": "",
    }),
)

filegroup(
    name = "avutil_runtime",
    srcs = [":ffmpeg_foreign"],
    output_group = select({
        "@platforms//os:linux": "libavutil.so.60",
        "@platforms//os:macos": "libavutil.60.dylib",
        "//conditions:default": "",
    }),
)

filegroup(
    name = "swscale_runtime",
    srcs = [":ffmpeg_foreign"],
    output_group = select({
        "@platforms//os:linux": "libswscale.so.9",
        "@platforms//os:macos": "libswscale.9.dylib",
        "//conditions:default": "",
    }),
)

filegroup(
    name = "avcodec_link",
    srcs = [":ffmpeg_foreign"],
    output_group = "libavcodec.so",
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "avutil_link",
    srcs = [":ffmpeg_foreign"],
    output_group = "libavutil.so",
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "swscale_link",
    srcs = [":ffmpeg_foreign"],
    output_group = "libswscale.so",
    target_compatible_with = ["@platforms//os:linux"],
)

# Pair each unversioned linker input with its versioned runtime object so Bazel
# places the canonical SONAME in _solib and emits the matching runtime path.
cc_import(
    name = "avcodec_import",
    interface_library = ":avcodec_link",
    shared_library = ":avcodec_runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_import(
    name = "avutil_import",
    interface_library = ":avutil_link",
    shared_library = ":avutil_runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_import(
    name = "swscale_import",
    interface_library = ":swscale_link",
    shared_library = ":swscale_runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "ffmpeg",
    deps = select({
        "@platforms//os:linux": [
            ":avcodec_import",
            ":avutil_import",
            ":ffmpeg_foreign",
            ":swscale_import",
        ],
        "@platforms//os:macos": [":ffmpeg_foreign"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "runtime_files",
    srcs = [
        ":avcodec_runtime",
        ":avutil_runtime",
        ":swscale_runtime",
    ],
)
