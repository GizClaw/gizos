filegroup(
    name = "sources",
    srcs = ["src/" + path for path in WOLFCRYPT_UPSTREAM_SOURCES],
)

filegroup(
    name = "bk3633_arm_lto_sources",
    srcs = ["src/" + path for path in WOLFCRYPT_BK3633_ARM_LTO_SOURCES],
)

filegroup(
    name = "bk3633_thumb_lto_sources",
    srcs = ["src/" + path for path in WOLFCRYPT_BK3633_THUMB_LTO_SOURCES],
)

filegroup(
    name = "bk3633_thumb_non_lto_sources",
    srcs = ["src/" + path for path in WOLFCRYPT_BK3633_THUMB_NON_LTO_SOURCES],
)

filegroup(
    name = "desktop_sources",
    srcs = ["src/" + path for path in DESKTOP_WOLFSSL_UPSTREAM_SOURCES],
)

cc_library(
    name = "wolfcrypt_header_group",
    hdrs = ["src/" + path for path in WOLFCRYPT_UPSTREAM_HEADERS],
    includes = ["src"],
    textual_hdrs = ["src/wolfcrypt/src/misc.c"],
)

cc_library(
    name = "desktop_headers",
    hdrs = glob(["src/wolfssl/**/*.h"]),
    includes = ["src"],
    textual_hdrs = [
        "src/src/bio.c",
        "src/src/conf.c",
        "src/src/pk.c",
        "src/src/pk_ec.c",
        "src/src/pk_rsa.c",
        "src/src/ssl_api_cert.c",
        "src/src/ssl_api_crl_ocsp.c",
        "src/src/ssl_api_pk.c",
        "src/src/ssl_asn1.c",
        "src/src/ssl_bn.c",
        "src/src/ssl_certman.c",
        "src/src/ssl_crypto.c",
        "src/src/ssl_ech.c",
        "src/src/ssl_load.c",
        "src/src/ssl_misc.c",
        "src/src/ssl_p7p12.c",
        "src/src/ssl_sess.c",
        "src/src/ssl_sk.c",
        "src/src/x509.c",
        "src/src/x509_str.c",
        "src/wolfcrypt/src/asn_orig.c",
        "src/wolfcrypt/src/evp.c",
        "src/wolfcrypt/src/evp_pk.c",
        "src/wolfcrypt/src/misc.c",
    ],
)

filegroup(
    name = "all_sources",
    srcs = [
        ":desktop_headers",
        ":desktop_sources",
        ":sources",
        ":wolfcrypt_header_group",
    ],
)
