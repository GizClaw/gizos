    "wolfcrypt/src/chacha20_poly1305.c",
    "wolfcrypt/src/curve25519.c",
    "wolfcrypt/src/ecc.c",
    "wolfcrypt/src/fe_operations.c",
    "wolfcrypt/src/hash.c",
    "wolfcrypt/src/hmac.c",
    "wolfcrypt/src/memory.c",
    "wolfcrypt/src/md5.c",
    "wolfcrypt/src/poly1305.c",
    "wolfcrypt/src/random.c",
    "wolfcrypt/src/sha256.c",
    "wolfcrypt/src/sha.c",
    "wolfcrypt/src/sp_c32.c",
    "wolfcrypt/src/sp_int.c",
    "wolfcrypt/src/wolfmath.c",
]

WOLFCRYPT_BK3633_THUMB_NON_LTO_SOURCES = [
    "wolfcrypt/src/hmac.c",
]

WOLFCRYPT_BK3633_THUMB_LTO_SOURCES = [
    "wolfcrypt/src/ecc.c",
    "wolfcrypt/src/sp_int.c",
]

WOLFCRYPT_BK3633_ARM_LTO_SOURCES = [
    source
    for source in WOLFCRYPT_UPSTREAM_SOURCES
    if source not in WOLFCRYPT_BK3633_THUMB_NON_LTO_SOURCES
    if source not in WOLFCRYPT_BK3633_THUMB_LTO_SOURCES
]

