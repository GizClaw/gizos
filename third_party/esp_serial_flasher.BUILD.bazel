load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

cc_library(
    name = "esp_serial_flasher",
    srcs = [
        "src/src/esp_loader.c",
        "src/src/esp_stubs.c",
        "src/src/esp_targets.c",
        "src/src/md5_hash.c",
        "src/src/protocol_serial.c",
        "src/src/protocol_uart.c",
        "src/src/slip.c",
    ],
    hdrs = [
        "src/include/esp_loader.h",
        "src/include/esp_loader_io.h",
        "src/include/serial_io.h",
        "src/private_include/esp_stubs.h",
        "src/private_include/esp_targets.h",
        "src/private_include/md5_hash.h",
        "src/private_include/protocol.h",
        "src/private_include/protocol_prv.h",
        "src/private_include/sip.h",
        "src/private_include/slip.h",
    ],
    conlyopts = select({
        ":is_windows_x86_64": [
            "/experimental:c11atomics",
            "/std:c11",
        ],
        "//conditions:default": ["-std=c11"],
    }),
    copts = select({
        ":is_windows_x86_64": [
            "/W4",
            "/WX",
            "/wd4244",
            "/wd4245",
            "/wd4267",
            "/wd4389",
            "/wd4702",
        ],
        "//conditions:default": [
            "-Wall",
            "-Wextra",
            "-Werror",
            "-Wno-sign-compare",
        ],
    }),
    defines = [
        "MD5_ENABLED=1",
        "SERIAL_FLASHER_BOOT_HOLD_TIME_MS=50",
        "SERIAL_FLASHER_DEBUG_TRACE=false",
        "SERIAL_FLASHER_INTERFACE_UART",
        "SERIAL_FLASHER_RESET_HOLD_TIME_MS=100",
        "SERIAL_FLASHER_WRITE_BLOCK_RETRIES=3",
    ],
    includes = [
        "src/include",
        "src/private_include",
    ],
)
