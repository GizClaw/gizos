load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "host_macos_target_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    define_values = {"h2_host_os": "macos"},
)

filegroup(
    name = "all_sources",
    srcs = glob(["src/**"]),
)

cc_library(
    name = "headers",
    hdrs = glob(["src/include/**/*.h"]),
    includes = ["src/include"],
)

cmake(
    name = "sdl3_foreign",
    cache_entries = select({
        ":host_macos_target_linux_x86_64": {
            "CMAKE_BUILD_TYPE": "Release",
            "SDL_ALSA": "OFF",
            "SDL_AUDIO": "OFF",
            "SDL_CAMERA": "OFF",
            "SDL_DBUS": "OFF",
            "SDL_DIALOG": "OFF",
            "SDL_EXAMPLES": "OFF",
            "SDL_GPU": "OFF",
            "SDL_HAPTIC": "OFF",
            "SDL_HIDAPI": "OFF",
            "SDL_IBUS": "OFF",
            "SDL_INSTALL": "ON",
            "SDL_JOYSTICK": "OFF",
            "SDL_KMSDRM": "OFF",
            "SDL_LIBURING": "OFF",
            "SDL_OPENGL": "OFF",
            "SDL_OPENGLES": "OFF",
            "SDL_PIPEWIRE": "OFF",
            "SDL_PULSEAUDIO": "OFF",
            "SDL_RENDER_VULKAN": "OFF",
            "SDL_SENSOR": "OFF",
            "SDL_SHARED": "ON",
            "SDL_STATIC": "OFF",
            "SDL_TESTS": "OFF",
            "SDL_TEST_LIBRARY": "OFF",
            "SDL_TRAY": "OFF",
            "SDL_UNIX_CONSOLE_BUILD": "ON",
            "SDL_VULKAN": "OFF",
            "SDL_WAYLAND": "OFF",
            "SDL_X11": "OFF",
        },
        "@platforms//os:linux": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_C_FLAGS": "-idirafter /usr/include",
            "CMAKE_LIBRARY_PATH": "/usr/lib/x86_64-linux-gnu",
            "SDL_ALSA": "OFF",
            "SDL_AUDIO": "OFF",
            "SDL_CAMERA": "OFF",
            "SDL_DBUS": "OFF",
            "SDL_DIALOG": "OFF",
            "SDL_EXAMPLES": "OFF",
            "SDL_GPU": "OFF",
            "SDL_HAPTIC": "OFF",
            "SDL_HIDAPI": "OFF",
            "SDL_IBUS": "OFF",
            "SDL_INSTALL": "ON",
            "SDL_JOYSTICK": "OFF",
            "SDL_KMSDRM": "OFF",
            "SDL_LIBURING": "OFF",
            "SDL_OPENGL": "OFF",
            "SDL_OPENGLES": "OFF",
            "SDL_PIPEWIRE": "OFF",
            "SDL_PULSEAUDIO": "OFF",
            "SDL_RENDER_VULKAN": "OFF",
            "SDL_SENSOR": "OFF",
            "SDL_SHARED": "ON",
            "SDL_STATIC": "OFF",
            "SDL_TESTS": "OFF",
            "SDL_TEST_LIBRARY": "OFF",
            "SDL_TRAY": "OFF",
            "SDL_VULKAN": "OFF",
            "SDL_WAYLAND": "OFF",
            "SDL_X11": "ON",
            "SDL_X11_XCURSOR": "OFF",
            "SDL_X11_XDBE": "OFF",
            "SDL_X11_XFIXES": "OFF",
            "SDL_X11_XINPUT": "ON",
            "SDL_X11_XRANDR": "ON",
            "SDL_X11_XSCRNSAVER": "OFF",
            "SDL_X11_XTEST": "OFF",
        },
        "@platforms//os:macos": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_OSX_ARCHITECTURES": "arm64",
            "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
            "SDL_EXAMPLES": "OFF",
            "SDL_INSTALL": "ON",
            "SDL_SHARED": "ON",
            "SDL_STATIC": "OFF",
            "SDL_TESTS": "OFF",
            "SDL_TEST_LIBRARY": "OFF",
        },
        "//conditions:default": {},
    }),
    lib_source = ":all_sources",
    out_bin_dir = "lib",
    out_binaries = select({
        "@platforms//os:linux": ["libSDL3.so.0"],
        "//conditions:default": [],
    }),
    out_shared_libs = select({
        "@platforms//os:linux": ["libSDL3.so"],
        "@platforms//os:macos": ["libSDL3.0.dylib"],
        "//conditions:default": [],
    }),
    postfix_script = select({
        "@platforms//os:linux": (
            "cp -L $$INSTALLDIR/lib/libSDL3.so.0 " +
            "$$INSTALLDIR/lib/libSDL3.so.0.h2-real && " +
            "mv -f $$INSTALLDIR/lib/libSDL3.so.0.h2-real " +
            "$$INSTALLDIR/lib/libSDL3.so.0 && " +
            "rm -f $$INSTALLDIR/lib/libSDL3.so && " +
            "cp -p $$INSTALLDIR/lib/libSDL3.so.0 " +
            "$$INSTALLDIR/lib/libSDL3.so"
        ),
        "//conditions:default": "",
    }),
    target_compatible_with = select({
        "@platforms//os:linux": ["@platforms//cpu:x86_64"],
        "@platforms//os:macos": ["@platforms//cpu:arm64"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "shared_library",
    srcs = [":sdl3_foreign"],
    output_group = select({
        "@platforms//os:linux": "libSDL3.so.0",
        "@platforms//os:macos": "libSDL3.0.dylib",
        "//conditions:default": "",
    }),
)

filegroup(
    name = "link_library",
    srcs = [":sdl3_foreign"],
    output_group = "libSDL3.so",
    target_compatible_with = ["@platforms//os:linux"],
)

# Pair the unversioned linker input with the versioned runtime object so Bazel
# places the canonical SONAME in _solib and emits the matching runtime path.
cc_import(
    name = "runtime_import",
    interface_library = ":link_library",
    shared_library = ":shared_library",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "sdl3",
    deps = select({
        "@platforms//os:linux": [
            ":runtime_import",
            ":sdl3_foreign",
        ],
        "@platforms//os:macos": [":sdl3_foreign"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "runtime_files",
    srcs = [":shared_library"],
)
