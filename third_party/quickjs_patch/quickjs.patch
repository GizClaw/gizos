 /* convert global variable accesses to local variables or closure
    variables when necessary */
+static int reserve_compile_output(JSContext *ctx, JSFunctionDef *s, DynBuf *output)
+{
+    size_t entries = (size_t)s->var_count + s->arg_count + s->global_var_count;
+    size_t extra;
+    size_t capacity;
+    if (entries > SIZE_MAX / 16 - 8)
+        goto fail;
+    extra = (entries + 8) * 16;
+    if (s->byte_code.size > (SIZE_MAX - extra) / 4)
+        goto fail;
+    capacity = s->byte_code.size * 4 + extra;
+    if (dbuf_realloc(output, capacity) == 0)
+        return 0;
+ fail:
+    dbuf_free(output);
+    JS_ThrowOutOfMemory(ctx);
+    return -1;
+}
