load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

exports_files(["src/main.cpp"])

cc_library(
    name = "mklittlefs",
    srcs = [
        "src/littlefs/lfs.c",
        "src/littlefs/lfs_util.c",
    ],
    hdrs = [
        "src/littlefs/lfs.h",
        "src/littlefs/lfs_util.h",
        "src/tclap/Arg.h",
        "src/tclap/ArgException.h",
        "src/tclap/ArgTraits.h",
        "src/tclap/CmdLine.h",
        "src/tclap/CmdLineInterface.h",
        "src/tclap/CmdLineOutput.h",
        "src/tclap/Constraint.h",
        "src/tclap/DocBookOutput.h",
        "src/tclap/HelpVisitor.h",
        "src/tclap/IgnoreRestVisitor.h",
        "src/tclap/MultiArg.h",
        "src/tclap/MultiSwitchArg.h",
        "src/tclap/OptionalUnlabeledTracker.h",
        "src/tclap/StandardTraits.h",
        "src/tclap/StdOutput.h",
        "src/tclap/SwitchArg.h",
        "src/tclap/UnlabeledMultiArg.h",
        "src/tclap/UnlabeledValueArg.h",
        "src/tclap/ValueArg.h",
        "src/tclap/ValuesConstraint.h",
        "src/tclap/VersionVisitor.h",
        "src/tclap/Visitor.h",
        "src/tclap/XorHandler.h",
        "src/tclap/ZshCompletionOutput.h",
    ],
    conlyopts = select({
        ":is_windows_x86_64": ["/std:c11"],
        "//conditions:default": ["-std=gnu99"],
    }),
    copts = select({
        ":is_windows_x86_64": ["/W4"],
        "//conditions:default": [
            "-Os",
            "-Wall",
        ],
    }),
    cxxopts = select({
        ":is_windows_x86_64": ["/std:c++14"],
        "//conditions:default": ["-std=gnu++11"],
    }),
    includes = [
        "src",
        "src/include",
        "src/littlefs",
        "src/tclap",
    ],
    local_defines = [
        "BUILD_CONFIG=\\\"\\\"",
        "BUILD_CONFIG_NAME=\\\"-generic\\\"",
        "LFS_NAME_MAX=32",
        "LITTLEFS_VERSION=\\\"v2.5.1\\\"",
        "VERSION=\\\"3.1.0\\\"",
        "__NO_INLINE__",
    ],
)
