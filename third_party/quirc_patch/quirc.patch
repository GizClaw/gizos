diff --git src/lib/quirc.c src/lib/quirc.c
--- src/lib/quirc.c
+++ src/lib/quirc.c
@@ -23,26 +23,58 @@
 	return "1.0";
 }
 
-struct quirc *quirc_new(void)
+static void *default_alloc(void *user, size_t size)
 {
-	struct quirc *q = malloc(sizeof(*q));
+	(void)user;
+	return malloc(size);
+}
 
+static void default_free(void *user, void *pointer)
+{
+	(void)user;
+	free(pointer);
+}
+
+struct quirc *quirc_new_with_allocator(const struct quirc_allocator *allocator)
+{
+	struct quirc *q;
+
+	if (!allocator || !allocator->alloc || !allocator->free)
+		return NULL;
+	q = allocator->alloc(allocator->user, sizeof(*q));
 	if (!q)
 		return NULL;
 
 	memset(q, 0, sizeof(*q));
+	q->allocator = *allocator;
 	return q;
 }
 
+struct quirc *quirc_new(void)
+{
+	const struct quirc_allocator allocator = {
+		NULL, default_alloc, default_free
+	};
+	return quirc_new_with_allocator(&allocator);
+}
+
+static void *alloc_zero(struct quirc *q, size_t size)
+{
+	void *pointer = q->allocator.alloc(q->allocator.user, size);
+	if (pointer)
+		memset(pointer, 0, size);
+	return pointer;
+}
+
 void quirc_destroy(struct quirc *q)
 {
-	free(q->image);
