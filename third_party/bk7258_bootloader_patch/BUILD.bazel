load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files(["contract.h"])

# A declared recipe consumed by the first-party native build owner. It does
# not import first-party build rules or read the developer's SDK by itself.
filegroup(
    name = "mapped_ab_v1",
    srcs = [
        "CMakeLists.txt",
        "apply.py",
        "contract.h",
        "manifest.json",
        "mapped_ab.S",
        "mapped_ab.c",
        "mapped_ab.ld",
    ],
)

cc_library(
    name = "contract",
    hdrs = ["contract.h"],
    includes = ["."],
)

cc_test(
    name = "mapped_ab_test",
    srcs = [
        "mapped_ab.c",
        "tests/test_mapped_ab.c",
    ],
    conlyopts = H2_C11_OPTS,
    local_defines = ["BK_MAPPED_AB_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":contract"],
)

py_test(
    name = "apply_test",
    srcs = [
        "apply.py",
        "tests/test_apply.py",
    ],
    data = [
        "manifest.json",
        "mapped_ab.c",
        "mapped_ab.ld",
    ],
    legacy_create_init = 0,
    main = "tests/test_apply.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
