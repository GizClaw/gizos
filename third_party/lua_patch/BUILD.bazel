load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["h2_lua_embedded_stdio.h"])

cc_library(
    name = "lua_patch",
    srcs = [
        "h2_lua_embedded_stdio.h",
        "lua_portability.c",
    ] + select({
        "//tools/bazel/platforms:is_esp32p4": ["lua_esp_libc_compat.c"],
        "//tools/bazel/platforms:is_esp32s3": ["lua_esp_libc_compat.c"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
