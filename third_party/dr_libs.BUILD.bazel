load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

# dr_mp3 (public domain or MIT-0), built for its low-level frame decoder:
# Layer III only, no stdio, and the portable C path on every target so host
# tests decode the way firmware does. The decoder keeps its 16 KiB scratch
# inside the caller-owned drmp3dec rather than on the stack.
cc_library(
    name = "dr_mp3",
    srcs = ["src/dr_mp3_impl.c"],
    hdrs = ["src/dr_mp3.h"],
    copts = select({
        ":is_windows_x86_64": [],
        "//conditions:default": ["-w"],
    }),
    defines = [
        "DR_MP3_NO_SIMD",
        "DR_MP3_NO_STDIO",
        "DR_MP3_ONLY_MP3",
    ],
    includes = ["src"],
)
