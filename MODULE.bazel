        "//third_party/libco_patch:backends/esp32s3/h2_esp_libco_xtensa.S": "src/backends/esp32s3/h2_esp_libco_xtensa.S",
        "//third_party/libco_patch:backends/esp32s3/h2_esp_libco_xtensa.c": "src/backends/esp32s3/h2_esp_libco_xtensa.c",
        "//third_party/libco_patch:backends/esp32s3/h2_esp_libco_xtensa_internal.h": "src/backends/esp32s3/h2_esp_libco_xtensa_internal.h",
        "//third_party/libco_patch:backends/riscv32/h2_libco_riscv32.S": "src/backends/riscv32/h2_libco_riscv32.S",
        "//third_party/libco_patch:backends/riscv32/h2_libco_riscv32.c": "src/backends/riscv32/h2_libco_riscv32.c",
        "//third_party/libco_patch:backends/riscv32/h2_libco_riscv32_internal.h": "src/backends/riscv32/h2_libco_riscv32_internal.h",
    },
    path = "third_party/libco",
