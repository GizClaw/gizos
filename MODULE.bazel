vendor_repositories.repository(
    name = "h2_vendor_sdl3",
    build_file = "//third_party:sdl3.BUILD.bazel",
    path = "third_party/sdl3",
)
vendor_repositories.repository(
    name = "h2_vendor_speexdsp",
    build_file = "//third_party:speexdsp.BUILD.bazel",
    overlay_files = {
        "//third_party/speexdsp_patch:speexdsp_config_types.h": "src/include/speex/speexdsp_config_types.h",
    },
    path = "third_party/speexdsp",
)
vendor_repositories.repository(
    name = "h2_vendor_sqlite",
    build_file = "//third_party:sqlite.BUILD.bazel",
    path = "third_party/sqlite",
    source_is_gitlink = False,
)
vendor_repositories.repository(
    name = "h2_vendor_tinyh264",
    build_file = "//third_party:tinyh264.BUILD.bazel",
    patches = ["//tools/bazel/vendor:patches/tinyh264_msvc_inline.patch"],
    path = "third_party/tinyh264",
)
vendor_repositories.repository(
    name = "h2_vendor_wolfssl",
    build_file = "//third_party:wolfssl.BUILD.bazel",
    path = "third_party/wolfssl",
)
vendor_repositories.repository(
    name = "h2_vendor_zlib",
    build_file = "//third_party:zlib.BUILD.bazel",
    path = "third_party/zlib",
)
use_repo(
    vendor_repositories,
    "h2_fdk_aac",
    "h2_k4b_cedarx_sdk",
    "h2_vendor_corehttp",
    "h2_vendor_coremqtt",
    "h2_vendor_esp_serial_flasher",
    "h2_vendor_ffmpeg",
    "h2_vendor_gizclaw",
    "h2_vendor_ikcp",
    "h2_vendor_libco",
    "h2_vendor_libsrtp",
    "h2_vendor_lua",
    "h2_vendor_lvgl",
    "h2_vendor_mklittlefs",
    "h2_vendor_opus",
    "h2_vendor_pixa",
    "h2_vendor_pixelroot32",
    "h2_vendor_portaudio",
    "h2_vendor_sdl3",
    "h2_vendor_speexdsp",
    "h2_vendor_sqlite",
    "h2_vendor_tinyh264",
    "h2_vendor_wolfssl",
    "h2_vendor_yyjson",
    "h2_vendor_zlib",
)

esp_repositories = use_extension(
    "//tools/bazel/native_repositories:esp_repositories.bzl",
    "esp_repositories",
)
use_repo(esp_repositories, "gizos_esp_idf_sdk", "gizos_esp_idf_tools")

esp32s3_cc = use_extension(
    "//tools/bazel/toolchains/esp32s3_cc:repositories.bzl",
    "esp32s3_cc_toolchain",
)
use_repo(esp32s3_cc, "gizos_esp32s3_cc_toolchain")

register_toolchains("@gizos_esp32s3_cc_toolchain//:toolchain")
