node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    name = "h2_node_24",
    node_version = "24.11.1",
)
use_repo(node, "h2_node_24_toolchains")

register_toolchains("@h2_node_24_toolchains//:all")

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# Playwright 1.52.0 uses Chromium headless shell revision 1169. Keep the two
# supported host archives as lazy repositories so module resolution remains
# portable on Windows and cross-target CI workers.
http_archive(
    name = "h2_playwright_chromium_linux_x86_64",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "runtime", srcs = glob(["**"]))
""",
    sha256 = "92ec712a49a451eb74b6829ae4bc7ee2f36420d2849c245dbbb37108b41de920",
    urls = [
        "https://playwright.azureedge.net/builds/chromium/1169/chromium-headless-shell-linux.zip",
        "https://playwright-akamai.azureedge.net/builds/chromium/1169/chromium-headless-shell-linux.zip",
        "https://playwright-verizon.azureedge.net/builds/chromium/1169/chromium-headless-shell-linux.zip",
    ],
)

http_archive(
    name = "h2_playwright_chromium_macos_arm64",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "runtime", srcs = glob(["**"]))
""",
    sha256 = "96caa1a9dd1ec7f4aa5e9adf7aed2a39be6b9a4702b33d6a24649f7b5e86bf8b",
    urls = [
        "https://playwright.azureedge.net/builds/chromium/1169/chromium-headless-shell-mac-arm64.zip",
        "https://playwright-akamai.azureedge.net/builds/chromium/1169/chromium-headless-shell-mac-arm64.zip",
        "https://playwright-verizon.azureedge.net/builds/chromium/1169/chromium-headless-shell-mac-arm64.zip",
    ],
)

# Toolchain registrations from dependency modules are not applied to the root
# module, so mirror emsdk's official host registrations here.
register_toolchains(
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_linux",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_linux_arm64",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_mac",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_mac_arm64",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_win",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "h2loader_batch_loader_npm",
    data = ["//projects/h2loader/apps/batch-loader/app:pnpm-workspace.yaml"],
    pnpm_lock = "//projects/h2loader/apps/batch-loader/app:pnpm-lock.yaml",
    run_lifecycle_hooks = False,
)
use_repo(npm, "h2loader_batch_loader_npm")

http_file(
    name = "haivivi_next_openapi",
    downloaded_file_path = "openapi.json",
    sha256 = "cd0dda64d35532233cc23f98a8242a746082f9cfbbee1aef7fb9fd5b601e3d53",
    urls = ["https://api.haivivi.cn/openapi-json"],
