vendor_repositories.repository(
    name = "h2_vendor_pixelroot32",
    build_file = "//third_party:pixelroot32.BUILD.bazel",
    patches = [
        "//tools/bazel/vendor:patches/pixelroot32_msvc_display_guard.patch",
        "//tools/bazel/vendor:patches/pixelroot32_msvc_shadow.patch",
        "//tools/bazel/vendor:patches/pixelroot32_portable_popcount.patch",
    ],
    path = "third_party/pixelroot32",
)
vendor_repositories.repository(
    name = "h2_vendor_portaudio",
    build_file = "//third_party:portaudio.BUILD.bazel",
    path = "third_party/portaudio",
