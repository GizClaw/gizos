module(
    name = "gizos",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "apple_support", version = "2.2.0")
bazel_dep(name = "rules_apple", version = "4.5.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

vendor_repositories = use_extension(
    "//tools/bazel/vendor:repositories.bzl",
    "vendor_repositories",
)
vendor_repositories.repository(
    name = "h2_vendor_esp_serial_flasher",
    build_file = "//third_party:esp_serial_flasher.BUILD.bazel",
    patches = [
        "//tools/bazel/vendor:patches/esp_serial_flasher_msvc_packing.patch",
        "//tools/bazel/vendor:patches/esp_serial_flasher_msvc_weak.patch",
    ],
    path = "third_party/esp-serial-flasher",
)
vendor_repositories.repository(
    name = "h2_vendor_ffmpeg",
    build_file = "//third_party:ffmpeg.BUILD.bazel",
    ffmpeg_configure_adapter = True,
    path = "third_party/ffmpeg",
)
vendor_repositories.repository(
    name = "h2_vendor_gizclaw",
    build_file = "//third_party:gizclaw.BUILD.bazel",
    patches = [
        "//tools/bazel/vendor:patches/gizclaw_ascii_ctype.patch",
        "//tools/bazel/vendor:patches/gizclaw_json_ascii_ctype.patch",
    ],
    path = "third_party/gizclaw",
)
vendor_repositories.repository(
    name = "h2_vendor_ikcp",
    build_file = "//third_party:ikcp.BUILD.bazel",
    path = "third_party/ikcp",
)
vendor_repositories.repository(
