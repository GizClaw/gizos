module(
    name = "gizos",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_rules_js", version = "3.2.3")
bazel_dep(name = "apple_support", version = "2.2.0")
bazel_dep(name = "emsdk", version = "6.0.3")
bazel_dep(name = "rules_apple", version = "4.5.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "gazelle", version = "0.51.3")
