    build_file = "//third_party:lua.BUILD.bazel",
    path = "third_party/lua",
)
vendor_repositories.repository(
    name = "h2_vendor_lvgl",
    build_file = "//third_party:lvgl.BUILD.bazel",
    overlay_files = {
        "//third_party/lvgl_patch:config/bk7258/lv_conf.h": "config/bk7258/lv_conf.h",
        "//third_party/lvgl_patch:config/esp_idf6_x/lv_conf.h": "config/esp_idf6_x/lv_conf.h",
    },
    path = "third_party/lvgl",
