module(
    name = "gizos",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "apple_support", version = "2.2.0")
bazel_dep(name = "rules_apple", version = "4.5.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

vendor_repositories = use_extension(
    "//tools/bazel/vendor:repositories.bzl",
    "vendor_repositories",
)
vendor_repositories.repository(
    name = "h2_vendor_ikcp",
    build_file = "//third_party:ikcp.BUILD.bazel",
    path = "third_party/ikcp",
)
vendor_repositories.repository(
    name = "h2_vendor_yyjson",
    build_file = "//third_party:yyjson.BUILD.bazel",
    path = "third_party/yyjson",
)
vendor_repositories.repository(
    name = "h2_vendor_corehttp",
    build_file = "//third_party:corehttp.BUILD.bazel",
    path = "third_party/corehttp",
)
vendor_repositories.repository(
    name = "h2_vendor_coremqtt",
    build_file = "//third_party:coremqtt.BUILD.bazel",
    path = "third_party/coremqtt",
)
vendor_repositories.repository(
    name = "h2_vendor_libsrtp",
    build_file = "//third_party:libsrtp.BUILD.bazel",
    path = "third_party/libsrtp",
)
vendor_repositories.repository(
    name = "h2_vendor_libco",
    build_file = "//third_party:libco.BUILD.bazel",
    overlay_files = {
        "//third_party/libco_patch:libco.c": "src/libco.c",
        "//third_party/libco_patch:backends/arm.c": "src/arm.c",
        "//third_party/libco_patch:backends/cortex_m.c": "src/backends/cortex_m.c",
        "//third_party/libco_patch:backends/emscripten/h2_libco_emscripten.c": "src/backends/emscripten/h2_libco_emscripten.c",
        "//third_party/libco_patch:backends/esp32s3/h2_esp_libco_xtensa.S": "src/backends/esp32s3/h2_esp_libco_xtensa.S",
        "//third_party/libco_patch:backends/esp32s3/h2_esp_libco_xtensa.c": "src/backends/esp32s3/h2_esp_libco_xtensa.c",
        "//third_party/libco_patch:backends/esp32s3/h2_esp_libco_xtensa_internal.h": "src/backends/esp32s3/h2_esp_libco_xtensa_internal.h",
        "//third_party/libco_patch:backends/riscv32/h2_libco_riscv32.S": "src/backends/riscv32/h2_libco_riscv32.S",
        "//third_party/libco_patch:backends/riscv32/h2_libco_riscv32.c": "src/backends/riscv32/h2_libco_riscv32.c",
        "//third_party/libco_patch:backends/riscv32/h2_libco_riscv32_internal.h": "src/backends/riscv32/h2_libco_riscv32_internal.h",
    },
    path = "third_party/libco",
)
vendor_repositories.repository(
    name = "h2_vendor_sdl3",
    build_file = "//third_party:sdl3.BUILD.bazel",
    path = "third_party/sdl3",
)
vendor_repositories.repository(
    name = "h2_vendor_tinyh264",
    build_file = "//third_party:tinyh264.BUILD.bazel",
    patches = ["//tools/bazel/vendor:patches/tinyh264_msvc_inline.patch"],
    path = "third_party/tinyh264",
)
vendor_repositories.repository(
    name = "h2_vendor_wolfssl",
    build_file = "//third_party:wolfssl.BUILD.bazel",
    path = "third_party/wolfssl",
)
use_repo(
    vendor_repositories,
    "h2_vendor_corehttp",
    "h2_vendor_coremqtt",
    "h2_vendor_ikcp",
    "h2_vendor_libco",
    "h2_vendor_libsrtp",
    "h2_vendor_sdl3",
    "h2_vendor_tinyh264",
    "h2_vendor_wolfssl",
    "h2_vendor_yyjson",
)

esp_repositories = use_extension(
    "//tools/bazel/native_repositories:esp_repositories.bzl",
    "esp_repositories",
)
use_repo(esp_repositories, "gizos_esp_idf_sdk", "gizos_esp_idf_tools")

esp32s3_cc = use_extension(
    "//tools/bazel/toolchains/esp32s3_cc:repositories.bzl",
    "esp32s3_cc_toolchain",
)
use_repo(esp32s3_cc, "gizos_esp32s3_cc_toolchain")

register_toolchains("@gizos_esp32s3_cc_toolchain//:toolchain")
