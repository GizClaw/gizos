CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BT_NIMBLE_EXT_ADV=n

# Wi-Fi/lwIP throughput profile for H2Loader-managed images. DevKit keeps
# Wi-Fi buffers in internal RAM (no CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP),
# so the ESP-IDF default pool sizes stay: 32 dynamic RX buffers above the
# 16-entry UDP mailbox from the board defaults. lwIP delivers frames
# zero-copy, so the UDP mailbox must always stay below the dynamic RX
# count or an unread socket starves the whole radio. A wider RX Block Ack
# window and lwIP in IRAM are the only additions.
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_IRAM_OPTIMIZATION=y
