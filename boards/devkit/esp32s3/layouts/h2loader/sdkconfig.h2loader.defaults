CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BT_NIMBLE_EXT_ADV=n

# Wi-Fi/lwIP throughput profile for H2Loader-managed images, identical to
# the AMOLED layout. Wi-Fi/lwIP memory prefers PSRAM so the dynamic RX
# buffers and the TX cache do not consume internal RAM; that option forces
# the static TX buffer type. lwIP delivers frames zero-copy, so every
# datagram parked in a socket mailbox keeps one dynamic RX buffer: the
# dynamic RX count must stay well above the UDP mailbox size or a socket
# that stops reading starves the whole radio.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# TCP buffers are lwIP pbufs and follow the Wi-Fi/lwIP PSRAM preference, so a
# 64 KiB window costs no internal RAM; measured TCP 5.3 -> 7.1 Mbit/s on AMOLED.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
