# BK7258 v3 Loader layout AP configuration.
CONFIG_SHELL_TASK_STACK_SIZE=32768
# CONFIG_LCD_QSPI_ST77903_H0165Y008T is not set
# CONFIG_OTA_UPDATE_DEFAULT_PARTITION is not set
CONFIG_UART_PRINT_PORT=1

CONFIG_SYS_PRINT_DEV_UART=y
# CONFIG_SYS_PRINT_DEV_MAILBOX is not set
CONFIG_UART_PRINT_BAUD_RATE=460800
CONFIG_DUMP_UART_PRINT_PORT=1

# Loader keeps update/recovery and BLE; business services belong to App.
# CONFIG_MEDIA_DISPLAY_SERVICE is not set
# CONFIG_AUDIO_PLAY is not set
# CONFIG_AUDIO_RECORD is not set
# CONFIG_LCD is not set
# CONFIG_LCD_QSPI is not set
# CONFIG_LCD_SPI is not set
# CONFIG_JPEGDEC_HW is not set
# CONFIG_DMA2D is not set
# CONFIG_HW_SCALE is not set
# CONFIG_HW_ROTATE_PFC is not set
