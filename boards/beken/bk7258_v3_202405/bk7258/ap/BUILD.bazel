cc_test(
    name = "runtime_recovery_test",
    srcs = [
        "include/h2_bk7258_board.h",
        "include/h2_bk7258_board_storage.h",
        "src/h2_bk7258_board_private.h",
        "src/h2_bk7258_board_runtime.c",
        "tests/h2_bk7258_board_runtime_test_sdk.h",
        "tests/test_runtime_recovery.c",
        "//native_component_src/bk7258/ap/h2_pal_core:include/h2_bk_platform_core.h",
        "//native_component_src/bk7258/ap/h2_pal_image:include/h2_bk_platform_image.h",
        "//native_component_src/bk7258/ap/h2_pal_storage:include/h2_bk_platform_storage.h",
        "//native_component_src/bk7258/ap/h2_pal_storage:src/h2_bk_platform_sd_fs.c",
        "//native_component_src/bk7258/ap/h2_pal_storage:tests/h2_bk_sd_fs_test_sdk.h",
    ],
    additional_compiler_inputs = ["//native_component_src/bk7258/ap/h2_pal_storage:tests/test_h2_bk_platform_sd_fs.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + [
        "-Inative_component_src/bk7258/ap/h2_pal_core/include",
        "-Inative_component_src/bk7258/ap/h2_pal_image/include",
        "-Inative_component_src/bk7258/ap/h2_pal_storage/include",
        "-Inative_component_src/bk7258/ap/h2_pal_storage/tests",
    ],
    includes = [
        "include",
        "src",
        "tests",
    ],
    local_defines = [
        "H2_BK7258_BOARD_RUNTIME_HOST_TEST=1",
        "H2_BK_SD_FS_HOST_TEST=1",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/runtime",
    ],
)

