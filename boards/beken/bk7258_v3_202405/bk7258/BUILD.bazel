load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

exports_files([
    "ap.defaults",
    "cp.defaults",
    "cp/usr_gpio_cfg.h",
])

h2_tasks(
    name = "touch_tasks",
    tasks = ["h2_touch"],
)

firmware_native_component(
    name = "bk7258",
    hdrs = ["//boards/beken/bk7258_v3_202405/bk7258/ap:native_headers"],
    component_directory = "boards/beken/bk7258_v3_202405/bk7258/ap",
    component_name = "h2_bk7258_board",
    # AP firmware files are dependency-graph inputs only. They must remain in
    # data and must never be compiled by this native host cc_library.
    data = [
        "//boards/beken/bk7258_v3_202405/bk7258/ap:firmware_sources",
    ],
    execution_unit = "ap",
    native_srcs = ["//boards/beken/bk7258_v3_202405/bk7258/ap:native_sources"],
    tags = [
        "manual",
    ],
    deps = [
        ":touch_tasks",
        "//libs/runtime",
        "//libs/sync/atomic",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/h2_pal_image",
        "//native_component_src/bk7258/ap/h2_pal_storage",
        "//pal",
    ],
)
