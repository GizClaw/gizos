+int h2_jieli_wl82_exception_log_clear(void)
+{
+    u8 erased = 0;
+    if (!exception_log_pending || !exception_log_flash_addr) {
+        return 0;
+    }
+    sdfile_reserve_zone_erase(
+        exception_log_flash_addr, SDFILE_SECTOR_SIZE, 0);
+    if (sdfile_reserve_zone_read(
+            &erased, exception_log_flash_addr, sizeof(erased), 0) !=
+            sizeof(erased) || erased != 0xff) {
+        return -1;
+    }
+    exception_log_pending = 0;
+    return 0;
+}
