+extern void h2_jieli_wl82_assert_reset_hook(void *caller) __attribute__((weak));
+
+struct h2_jieli_wl82_boot_marker {
+    unsigned int magic0;
+    unsigned int magic1;
+    unsigned int stage;
+    int result;
+};
+
+volatile struct h2_jieli_wl82_boot_marker h2_jieli_wl82_ram_marker
+    sec(.h2_retained);
+
+extern void h2_jieli_wl82_boot_probe(unsigned int stage)
+    __attribute__((weak));
+
+static void h2_jieli_wl82_probe(unsigned int stage)
+{
+    /* C startup does not clear this section. ROM DL uploads its helper at
+     * 0x1c02000, away from this linker-owned symbol, so memread can recover
+     * the last completed stage without USB, UART, scheduler, or flash I/O. */
+    h2_jieli_wl82_ram_marker.magic0 = 0x504d3248; /* H2MP */
+    h2_jieli_wl82_ram_marker.magic1 = 0x47424434; /* 4DBG */
+    h2_jieli_wl82_ram_marker.result = 0;
+    h2_jieli_wl82_ram_marker.stage = stage;
+    if (stage >= 100 && h2_jieli_wl82_boot_probe) {
+        h2_jieli_wl82_boot_probe(stage);
+    }
+}
