load("//libs/app_host:web_board.bzl", "h2_web_board")

package(default_visibility = ["//visibility:public"])

# Web board: the browser counterpart of this board for h2_web_app() pages.
# SH8601 368×448 AMOLED (portrait), FT3168 touch; BOOT (GPIO0) and PWR (AXP2101 key).
h2_web_board(
    name = "web",
    buttons = {
        "boot": "Escape",
        "power": "p",
    },
    default_skin = "device",
    display_height = 448,
    display_width = 368,
    skins = {"device": "device.html"},
)
