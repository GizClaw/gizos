CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi/lwIP throughput profile for H2Loader-managed images. The board
# defaults keep the minimum-memory shape; this layout moves to a bounded
# middle ground between the ESP-IDF "minimum" and "default" ranks so UDP,
# SCTP and H2Peer traffic is not throttled by two in-flight TX frames or a
# four-frame Block Ack window. Dynamic RX buffers and the TX cache live in
# PSRAM through CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP; the static RX buffers
# cost about 1.6 KiB of internal DMA memory each.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_IRAM_OPTIMIZATION=y
