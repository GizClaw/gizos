 void putbyte(char c)
 {
+    extern void h2_jieli_wl82_log_byte(char value) __attribute__((weak));
+    extern int h2_jieli_usb_debug_is_draining(void) __attribute__((weak));
+    if (h2_jieli_wl82_log_byte) {
+        h2_jieli_wl82_log_byte(c);
+    }
+    /* cdc_write_data() can log a USB endpoint timeout through putbyte().
+     * Never enqueue that diagnostic back into the same USB ring while its
+     * drain task owns the CDC writer, otherwise one timeout becomes a
+     * self-sustaining "g_write ot" feedback loop that starves iKCP. */
+    if (h2_jieli_usb_debug_is_draining &&
+        h2_jieli_usb_debug_is_draining()) {
+        return;
+    }
+
 #if defined CONFIG_NETWORK_DEBUG_ENABLE
