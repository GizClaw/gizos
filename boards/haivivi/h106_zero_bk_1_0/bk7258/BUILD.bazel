load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "display_test",
    srcs = [
        "ap/include/h2_zero_bk_display_capture.h",
        "ap/src/h2_bk7258_board_display.c",
        "ap/src/h2_zero_bk_lcd.c",
        "ap/src/h2_zero_bk_lcd.h",
        "ap/src/h2_zero_bk_spi.c",
        "ap/src/h2_zero_bk_spi.h",
        "tests/h2_zero_bk_display_test_sdk.h",
        "tests/h2_zero_bk_spi_test_sdk.h",
        "tests/test_display.c",
    ],
    conlyopts = H2_C11_OPTS,
    includes = [
        "ap/include",
        "ap/src",
        "tests",
    ],
    local_defines = [
        "H2_ZERO_BK_DISPLAY_HOST_TEST=1",
        "H2_ZERO_BK_SPI_HOST_TEST=1",
        "CONFIG_SPI_DMA=1",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//projects/e2e/apps/pal-display/app:pal_display_e2e"],
)

cc_test(
    name = "spi_dma_test",
    srcs = [
        "ap/src/h2_zero_bk_spi.c",
        "ap/src/h2_zero_bk_spi.h",
        "tests/h2_zero_bk_spi_test_sdk.h",
        "tests/test_spi_dma.cc",
    ],
    includes = [
        "ap/src",
        "tests",
    ],
    # do not sort
    local_defines = [
        "H2_ZERO_BK_SPI_HOST_TEST=1",
        "CONFIG_SPI_DMA=1",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "power_test_source",
    testonly = True,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    textual_hdrs = ["ap/src/h2_bk7258_board_power.c"],
)

cc_test(
    name = "power_test",
    srcs = [
        "include/h2_zero_bk_1_0_board_config.h",
        "tests/h2_zero_bk_power_test_sdk.h",
        "tests/test_power.c",
    ],
    includes = [
        "include",
        "tests",
    ],
    local_defines = ["H2_ZERO_BK_POWER_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":power_test_source",
        "//libs/pal",
    ],
)

exports_files([
    "ap/usr_gpio_cfg.h",
    "ap.defaults",
    "cp.defaults",
    "cp/usr_gpio_cfg.h",
])

h2_tasks(
    name = "tasks",
    tasks = [
        "zero_bk/audio/mic",
        "zero_bk/audio/mix",
    ],
)

firmware_native_component(
    name = "bk7258",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    component_directory = "boards/haivivi/h106_zero_bk_1_0/bk7258/ap",
    component_name = "h2_bk7258_board",
    data = [
        "ap/CMakeLists.txt",
    ],
    execution_unit = "ap",
    tags = [
        "manual",
    ],
    deps = [
        ":tasks",
        "//libs/audio_mixer",
        "//libs/pal/providers/modem/quectel:quectel_modem",
        "//libs/runtime",
        "//libs/utils",
        "//native_component_src/bk7258/ap/h2_nfc_fm175xx",
        "//native_component_src/bk7258/ap/h2_pal_core",
        "//native_component_src/bk7258/ap/h2_pal_image",
        "//native_component_src/bk7258/ap/h2_pal_storage",
    ],
)
