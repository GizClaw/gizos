CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# IDF dumps exceed 64 KiB and omit PSRAM stacks; reserve flash for the E2E stall report.
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set

# Preserve the board's full Internal reserve for Wi-Fi, Bluetooth, DMA
# metadata, and input polling. Product and E2E allocations use PSRAM.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=196608
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
