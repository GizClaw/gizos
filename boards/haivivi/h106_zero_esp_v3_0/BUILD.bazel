load("//tools/bazel/firmware:board_version.bzl", "board_version")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "h106_zero_esp_v3_0",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "//boards/haivivi/h106_zero_esp_v3_0/esp32s3",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:ci_graph": [],
        "//tools/bazel/platforms:is_esp32s3": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

board_version(
    name = "version",
    build = 2,
)
