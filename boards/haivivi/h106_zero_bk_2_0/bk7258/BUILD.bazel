cc_library(
    name = "modem_test_source",
    testonly = True,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    textual_hdrs = ["ap/src/h2_bk7258_board_modem.c"],
)

cc_test(
    name = "modem_lifecycle_test",
    srcs = [
        "tests/h2_zero_bk_modem_test_sdk.h",
        "tests/test_modem.c",
    ],
    conlyopts = H2_C11_OPTS,
    includes = ["tests"],
    local_defines = ["H2_ZERO_BK_MODEM_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":modem_test_source",
        "//pal/providers/devices/modem/quectel:quectel_modem",
    ],
)

cc_library(
