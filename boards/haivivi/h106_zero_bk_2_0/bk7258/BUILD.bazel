)

cc_test(
    name = "audio_pcm_test",
    srcs = [
        "ap/src/h2_zero_bk_audio_pcm.h",
        "tests/test_audio_pcm.c",
    ],
    conlyopts = H2_C11_OPTS,
    includes = ["ap/src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

[
    cc_test(
        name = "task_" + mode + "_test",
        srcs = [
            "ap/src/h2_bk7258_board_task.c",
            "tests/h2_bk7258_board_task_test_sdk.h",
            "tests/test_task.c",
        ],
        conlyopts = H2_C11_OPTS,
        includes = ["tests"],
        local_defines = [
            "H2_BK7258_BOARD_TASK_HOST_TEST=1",
            "CONFIG_SOC_SMP=" + smp,
            "CONFIG_CPU_CNT=2",
        ],
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        deps = ["//pal"],
    )
    for mode, smp in [
        ("smp", "1"),
        ("single", "0"),
    ]
]

cc_test(
    name = "display_test",
    srcs = [
        "ap/include/h2_zero_bk_display_capture.h",
        "ap/src/h2_bk7258_board_display.c",
        "ap/src/h2_bk7258_board_led.c",
        "ap/src/h2_zero_bk_lcd.c",
        "ap/src/h2_zero_bk_lcd.h",
        "ap/src/h2_zero_bk_spi.c",
        "ap/src/h2_zero_bk_spi.h",
        "include/h2_zero_bk_board_common_config.h",
        "include/h2_zero_bk_board_config.h",
        "tests/h2_zero_bk_display_test_sdk.h",
        "tests/h2_zero_bk_led_test_sdk.h",
        "tests/h2_zero_bk_spi_test_sdk.h",
        "tests/test_display.c",
    ],
    conlyopts = H2_C11_OPTS,
    includes = [
        "ap/include",
        "ap/src",
        "include",
        "tests",
    ],
    local_defines = [
        "H2_ZERO_BK_DISPLAY_HOST_TEST=1",
        "H2_ZERO_BK_SPI_HOST_TEST=1",
        "H2_ZERO_BK_LED_HOST_TEST=1",
        "CONFIG_SPI_DMA=1",
