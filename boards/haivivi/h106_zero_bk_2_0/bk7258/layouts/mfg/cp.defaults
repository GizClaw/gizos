# MFG does not start a Bluetooth host or controller.
# CONFIG_PM_LV_WDT_PROTECTION is not set
CONFIG_INT_WDT_PERIOD_MS=8000
CONFIG_TASK_WDT_PERIOD_MS=180000
# CONFIG_AON_WDT is not set
CONFIG_BLUETOOTH=n
CONFIG_BT=n
CONFIG_BLE=n
CONFIG_BTDM_5_2=n
CONFIG_BTDM_CONTROLLER_ONLY=n
CONFIG_BLUETOOTH_SUPPORT_IPC=n
