# MFG management uses UART iKCP; Wi-Fi remains available for provisioning.
CONFIG_AUDIO_PLAY=y
CONFIG_AUDIO_RECORD=y
CONFIG_SHELL_TASK_STACK_SIZE=12288
CONFIG_LCD_QSPI_ST77903_H0165Y008T=y
CONFIG_H106_LVGL_PORT=y
CONFIG_H106_OPUS_PORT=y
CONFIG_BLUETOOTH=n
CONFIG_BLUETOOTH_AP=n
CONFIG_BT=n
CONFIG_BLE=n
CONFIG_BLUETOOTH_HOST_ONLY=n
CONFIG_BLUETOOTH_SUPPORT_IPC=n
