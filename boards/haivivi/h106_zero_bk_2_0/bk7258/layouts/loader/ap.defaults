# Zero BK 2.0 Loader layout AP configuration.
CONFIG_SHELL_TASK_STACK_SIZE=32768
# CONFIG_LCD_QSPI_ST77903_H0165Y008T is not set

# Loader keeps update/recovery and BLE; business services belong to App.
# CONFIG_BT is not set
CONFIG_BLE=y
