load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":partitions.bzl", "zero_bk_partition_tables")

package(default_visibility = ["//visibility:public"])

zero_bk_partition_tables()

py_test(
    name = "fixed_xip_test",
    srcs = ["tests/test_fixed_xip.py"],
    args = [
        "$(location :p1_partitions)",
        "$(location :p2_partitions)",
    ],
    data = [
        ":p1_partitions",
        ":p2_partitions",
    ],
    legacy_create_init = False,
    main = "tests/test_fixed_xip.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files([
    "ap.defaults",
    "ap.e2e.defaults",
    "ap.ipv6.defaults",
    "ap.loader.defaults",
    "ap.mfg.defaults",
    "ap/h2loader/usr_gpio_cfg.h",
    "bk_loader.json",
    "cp.defaults",
    "cp.e2e.defaults",
    "cp.ipv6.defaults",
    "cp.loader.defaults",
    "cp.mfg.defaults",
    "partitions/bk7258/ab_position_independent.csv",
    "partitions/bk7258/ota_rbl.config",
    "pj_config.mk",
    "ram_regions.csv",
])

filegroup(
    name = "ap_gpio",
    srcs = ["ap/h2loader/usr_gpio_cfg.h"],
)

filegroup(
    name = "cp_gpio",
    srcs = ["//boards/haivivi/h106_zero_bk_2_0/bk7258:cp/usr_gpio_cfg.h"],
)

alias(
    name = "ram_regions",
    actual = "ram_regions.csv",
)

filegroup(
    name = "project_support",
    srcs = [
        "partitions/bk7258/ab_position_independent.csv",
        "partitions/bk7258/ota_rbl.config",
        "pj_config.mk",
    ],
)

filegroup(
    name = "layout",
    srcs = [
        ":p2_partitions",
        ":project_support",
    ],
)
