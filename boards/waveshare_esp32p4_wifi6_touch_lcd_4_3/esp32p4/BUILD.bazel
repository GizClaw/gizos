load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "esp32p4",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    component_directory = "boards/waveshare_esp32p4_wifi6_touch_lcd_4_3/esp32p4",
    component_name = "h2_esp_board",
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
        "sdkconfig.defaults",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "camera_test",
    srcs = [
        "src/h2_esp_board_camera_csi.c",
        "src/h2_esp_board_private.h",
        "src/h2_esp_p4_board_internal.h",
        "tests/test_camera.c",
    ] + glob(["tests/include/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + [
        "-Dopen=h2_p4_test_open",
        "-Dclose=h2_p4_test_close",
        "-Dioctl=h2_p4_test_ioctl",
    ],
    includes = ["tests/include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)

cc_test(
    name = "touch_test",
    srcs = [
        "src/h2_esp_board_private.h",
        "src/h2_esp_board_touch_gt911.c",
        "src/h2_esp_p4_board_internal.h",
        "tests/test_touch.c",
    ] + glob(["tests/include/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)

cc_test(
    name = "i2c_test",
    srcs = [
        "src/h2_esp_board_i2c.c",
        "src/h2_esp_p4_board_internal.h",
        "tests/test_i2c.c",
    ] + glob(["tests/include/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)

cc_test(
    name = "input_test",
    srcs = [
        "src/h2_esp_board_input.c",
        "src/h2_esp_board_private.h",
        "tests/test_input.c",
    ] + glob(["tests/include/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)
