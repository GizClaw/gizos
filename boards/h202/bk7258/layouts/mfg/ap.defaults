CONFIG_WIFI_VNET_CONTROLLER=y
CONFIG_LWIP=y
CONFIG_LWIP_V2_1=y
# CONFIG_LWIP_PPP_SUPPORT is not set
CONFIG_AUDIO=y
CONFIG_AUDIO_ADC=y
CONFIG_AUDIO_DAC=y
CONFIG_AUDIO_DMIC=y
CONFIG_AUDIO_RING_BUFF=y
CONFIG_FREERTOS_USE_QUEUE_SETS=y
CONFIG_ADK=y
CONFIG_ADK_USE_PSRAM=y
CONFIG_ADK_ONBOARD_DUAL_DMIC_MIC_STREAM=y
CONFIG_ADK_ONBOARD_SPEAKER_STREAM=y
CONFIG_DMA=y
CONFIG_DMA1=y
CONFIG_SPI=y
CONFIG_I2C=y
CONFIG_SHELL_TASK_STACK_SIZE=32768
# CONFIG_LCD is not set
# CONFIG_LVGL is not set
# CONFIG_MEDIA_DISPLAY_SERVICE is not set
# CONFIG_PM_LV_WDT_PROTECTION is not set
CONFIG_INT_WDT_PERIOD_MS=8000
CONFIG_TASK_WDT_PERIOD_MS=180000

# MFG replaces the Loader: UART-only management like the H106 MFG, so the
# Bluetooth host and iperf stay out of the fixed Loader AP window.
CONFIG_BLUETOOTH=n
CONFIG_BLUETOOTH_AP=n
CONFIG_BT=n
CONFIG_BLE=n
CONFIG_BLUETOOTH_HOST_ONLY=n
CONFIG_BLUETOOTH_SUPPORT_IPC=n
# CONFIG_DEMOS_IPERF is not set
# CONFIG_IPERF_TEST is not set
