CONFIG_WIFI_ENABLE=y
CONFIG_WIFI_VNET_CONTROLLER=y
CONFIG_LWIP=y
CONFIG_LWIP_V2_1=y
# CONFIG_OTA_HTTP is not set
# CONFIG_PM_LV_WDT_PROTECTION is not set
CONFIG_INT_WDT_PERIOD_MS=8000
CONFIG_TASK_WDT_PERIOD_MS=180000

# UART-only MFG: no Bluetooth controller on the CP either.
CONFIG_BLUETOOTH=n
CONFIG_BT=n
CONFIG_BLE=n
CONFIG_BTDM_5_2=n
CONFIG_BTDM_CONTROLLER_ONLY=n
CONFIG_BLUETOOTH_SUPPORT_IPC=n
