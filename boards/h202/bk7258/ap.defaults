CONFIG_SOC_BK7258=y
CONFIG_CPU_CNT=2
CONFIG_SOC_STR="bk7258_ap"
CONFIG_SOC_SMP=y
CONFIG_FREERTOS_SMP=y
CONFIG_PSRAM=y
CONFIG_PSRAM_AS_SYS_MEMORY=y
# CONFIG_PSRAM_AUTO_DETECT is not set
CONFIG_GPIO_DEFAULT_SET_SUPPORT=y
CONFIG_USR_GPIO_CFG_EN=y
CONFIG_LDO3V3_CTRL_GPIO=54
CONFIG_UART_PRINT_PORT=1
CONFIG_UART_PRINT_BAUD_RATE=460800
CONFIG_DUMP_ENABLE=y
# CONFIG_MEMDUMP_ALL is not set
CONFIG_DUMP_UART_PRINT_PORT=1
CONFIG_SYS_PRINT_DEV_UART=y
# CONFIG_SYS_PRINT_DEV_MAILBOX is not set
CONFIG_BLUETOOTH_AP=y
CONFIG_BLUETOOTH_HOST_ONLY=y
CONFIG_BT=y
CONFIG_BLE=y
CONFIG_BLUETOOTH_SUPPORT_IPC=y
CONFIG_VFS=y
CONFIG_QSPI=y
CONFIG_LITTLEFS=y
CONFIG_LITTLEFS_NO_CONFIG_PARTITION=y
# CONFIG_FATFS_QSPI_0_FLASH is not set
CONFIG_FLASHDB=y
CONFIG_FLASHDB_USING_KVDB=y
CONFIG_FLASHDB_KVDB_START_ADDR=0x780000
CONFIG_FLASHDB_KVDB_SIZE=0x6000
# CONFIG_AON_WDT is not set
CONFIG_APP_MAIN_TASK_STACK_SIZE=32768
CONFIG_QSPI_MST_FLASH=y
CONFIG_QSPI_LINE_MODE=4
# CONFIG_QSPI_FLASH_GD is not set
CONFIG_HTTP_AB_PARTITION=y
CONFIG_OTA_FUNCTION=y
CONFIG_OTA_HASH_FUNCTION=y
CONFIG_OTA_POSITION_INDEPENDENT_AB=y
# CONFIG_OTA_UPDATE_DEFAULT_PARTITION is not set
# CONFIG_OTA_HTTP is not set
CONFIG_TRNG_SUPPORT=y
