load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "esp32c3",
    srcs = [
        "src/h2_esp_board.c",
        "src/h2_esp_board_display.c",
        "src/h2_esp_board_peripherals.c",
    ],
    hdrs = [
        "include/h2_esp_board.h",
        "src/h2_esp_board_private.h",
    ],
    component_directory = "boards/ai_passport/esp32c3",
    component_name = "h2_esp_board",
    data = [
        "CMakeLists.txt",
        "sdkconfig.defaults",
    ],
    deps = [
        "//libs/drivers/battery/cw2017",
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_adc_oneshot",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
        "//native_component_src/esp-idf6.x/h2_pal_core",
    ],
)

cc_test(
    name = "display_test",
    srcs = [
        "include/h2_esp_board.h",
        "src/h2_esp_board_display.c",
        "src/h2_esp_board_private.h",
        "tests/test_display.c",
    ] + glob(["tests/display_sdk/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "src",
        "tests/display_sdk",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)
