load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "esp32s3",
    srcs = [
        "src/h2_esp_board.c",
        "src/h2_esp_board_audio_es8311_es7210.c",
        "src/h2_esp_board_display_buffer.c",
        "src/h2_esp_board_display_co5300.c",
        "src/h2_esp_board_fs_mount.c",
        "src/h2_esp_board_i2c.c",
        "src/h2_esp_board_input.c",
        "src/h2_esp_board_power.c",
        "src/h2_esp_board_runtime.c",
        "src/h2_esp_board_task.c",
        "src/h2_esp_board_touch_cst9217.c",
    ],
    hdrs = [
        "include/h2_esp_board.h",
        "include/h2_esp_board_config.h",
        "include/h2_ws175c_audio_diagnostics.h",
        "include/h2_ws175c_display_capture.h",
        "src/h2_esp_board_display_buffer.h",
        "src/h2_esp_board_internal.h",
        "src/h2_esp_board_private.h",
    ],
    component_directory = "boards/waveshare/esp32s3_touch_amoled_1_75c/esp32s3",
    component_name = "h2_esp_board",
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
        "sdkconfig.defaults",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/drivers/motion/qmi8658",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//pal",
    ],
)

cc_test(
    name = "display_buffer_test",
    srcs = [
        "include/h2_esp_board_config.h",
        "src/h2_esp_board_display_buffer.c",
        "src/h2_esp_board_display_buffer.h",
        "tests/test_display_buffer.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "src",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//pal"],
)
