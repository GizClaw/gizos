load("//tools/bazel/firmware:board_version.bzl", "board_version")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "esp32p4_wifi6_touch_lcd_4_3",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "//boards/waveshare/esp32p4_wifi6_touch_lcd_4_3/esp32p4",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:ci_graph": [],
        "//tools/bazel/platforms:is_esp32p4": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

board_version(
    name = "version",
    build = 1,
)
