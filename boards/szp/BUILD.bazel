load("//tools/bazel:board_version.bzl", "board_version")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "szp",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ) + [
        "//boards/szp/esp32s3",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:ci_graph": [],
        "//tools/bazel/platforms:is_esp32s3": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

board_version(
    name = "version",
    build = 1,
)
