load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

load("//tools/bazel/platforms:compatibility.bzl", "LINUX_ARMV7_GNUEABIHF_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "t113_s3",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = glob(
        ["**"],
        allow_empty = True,
        exclude = [
            "BUILD.bazel",
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    includes = ["include"],
    tags = [
        "manual",
    ],
    target_compatible_with = LINUX_ARMV7_GNUEABIHF_ARTIFACT_COMPATIBILITY,
    deps = [
        "//libs/pal",
        "//libs/pal/providers/linux/pal_core",
        "//libs/runtime",
    ],
)

cc_binary(
    name = "button_runtime_smoke",
    srcs = ["tests/test_button_runtime.c"],
    tags = ["manual"],
    target_compatible_with = LINUX_ARMV7_GNUEABIHF_ARTIFACT_COMPATIBILITY,
    deps = [
        ":t113_s3",
        "//libs/pal",
        "//libs/pal:unsupported",
        "//libs/runtime",
    ],
)
