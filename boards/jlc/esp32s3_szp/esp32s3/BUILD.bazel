load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "esp32s3",
    srcs = [
        "src/h2_esp_board.c",
        "src/h2_esp_board_audio_es8311_es7210.c",
        "src/h2_esp_board_camera_gc0308.c",
        "src/h2_esp_board_display_st7789.c",
        "src/h2_esp_board_fs_mount.c",
        "src/h2_esp_board_input.c",
        "src/h2_esp_board_power.c",
        "src/h2_esp_board_runtime.c",
        "src/h2_esp_board_task.c",
        "src/h2_esp_board_touch_ft6336.c",
    ],
    hdrs = [
        "include/h2_esp_board.h",
        "include/h2_esp_board_config.h",
        "src/h2_esp_board_private.h",
        "src/h2_esp_szp_board_internal.h",
    ],
    component_directory = "boards/jlc/esp32s3_szp/esp32s3",
    component_name = "h2_esp_board",
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
        "sdkconfig.defaults",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//pal",
    ],
)

cc_test(
    name = "touch_test",
    srcs = [
        "src/h2_esp_board_private.h",
        "src/h2_esp_board_touch_ft6336.c",
        "src/h2_esp_szp_board_internal.h",
        "tests/test_touch.c",
    ] + glob(["tests/include/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)

cc_test(
    name = "camera_test",
    srcs = [
        "src/h2_esp_board_camera_gc0308.c",
        "src/h2_esp_board_private.h",
        "src/h2_esp_szp_board_internal.h",
        "tests/test_camera.c",
    ] + glob(["tests/camera_include/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/camera_include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)
