# Separate CDC interfaces for diagnostics and reliable commands.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_TINYUSB_CDC_RX_BUFSIZE=8192
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048

# Empty selects the pinned esp_tinyusb eFuse base-MAC serial, unique per board.
CONFIG_TINYUSB_DESC_SERIAL_STRING=""
