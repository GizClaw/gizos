load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files(["sdkconfig.defaults"])

firmware_native_component(
    name = "bsp",
    srcs = ["@h2_vendor_esp_mosaico_bsp//:bsp_sources"],
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:bsp_headers"],
    component_name = "esp_mosaico_bsp",
    data = ["@h2_vendor_esp_mosaico_bsp//:bsp_metadata"],
)

firmware_native_component(
    name = "module_mgr",
    srcs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_mgr_sources"],
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_mgr_headers"],
    component_name = "mosaico_module_mgr",
    data = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_mgr_metadata"],
    deps = [":bsp"],
)

firmware_native_component(
    name = "module_camera",
    srcs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_camera_sources"],
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_camera_headers"],
    component_directory = "boards/esp_mosaico/esp32s31/src/mosaico_module_camera",
    component_name = "mosaico_module_camera",
    data = [
        "src/mosaico_module_camera/CMakeLists.txt",
        "src/mosaico_module_camera/idf_component.yml",
        "@h2_vendor_esp_mosaico_bsp//:mosaico_module_camera_metadata",
    ],
    deps = [
        ":bsp",
        ":module_mgr",
    ],
)

firmware_native_component(
    name = "esp32s31",
    srcs = glob(
        ["src/*.c"],
        exclude = [
            "src/h2_mosaico_usb_*.c",
        ],
    ),
    hdrs = glob([
        "include/*.h",
        "src/*.h",
    ]),
    component_name = "h2_esp_board",
    data = [
        "CMakeLists.txt",
        "sdkconfig.defaults",
    ],
    deps = [
        ":bsp",
        ":module_camera",
        ":usb",
        "//libs/drivers/audio/es8311",
        "//libs/pal",
        "//libs/runtime",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
    ],
)

cc_test(
    name = "surface_test",
    srcs = [
        "src/h2_mosaico_surface.c",
        "src/h2_mosaico_surface.h",
        "tests/test_surface.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)

cc_test(
    name = "audio_volume_test",
    srcs = [
        "src/h2_mosaico_audio_config.h",
        "tests/test_audio_volume.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/drivers/audio/es8311"],
)

cc_test(
    name = "mag_test",
    srcs = [
        "src/h2_mosaico_mag.h",
        "tests/test_mag.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)

cc_test(
    name = "camera_test",
    srcs = [
        "include/h2_mosaico_camera.h",
        "src/h2_mosaico_camera.c",
        "tests/camera_fakes/mosaico_module_camera.h",
        "tests/test_camera.c",
        "tests/test_camera_cpp.cpp",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
        "tests/camera_fakes",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)

cc_test(
    name = "fs_mount_test",
    srcs = [
        "src/h2_esp_board_fs_mount.c",
        "src/h2_esp_board_private.h",
        "tests/fs_fakes/h2_esp_platform_core.h",
        "tests/test_fs_mount.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "src",
        "tests/fs_fakes",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)

[
    cc_test(
        name = driver + "_driver_test",
        srcs = [
            "src/h2_mosaico_mag.h",
            "src/h2_mosaico_peripherals.c",
            "src/h2_mosaico_peripherals.h",
            "tests/periph_fakes/bsp/esp_mosaico.h",
            "tests/periph_fakes/freertos/FreeRTOS.h",
            "tests/periph_fakes/freertos/semphr.h",
            "tests/test_board_drivers.c",
        ],
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS,
        includes = [
            "src",
            "tests/periph_fakes",
        ],
        local_defines = ["H2_MOSAICO_TEST_DRIVER_" + driver.upper() + "=1"],
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        deps = ["//libs/pal"],
    )
    for driver in [
        "button",
        "imu",
        "battery",
        "lifecycle",
    ]
]

[
    cc_test(
        name = name,
        srcs = [
            "include/h2_chip_board.h",
            "src/h2_mosaico_audio.c",
            "src/h2_mosaico_audio.h",
            "src/h2_mosaico_audio_config.h",
            "tests/audio_fakes/bsp/esp_mosaico.h",
            "tests/audio_fakes/h2_esp_es8311_audio_system.h",
            "tests/audio_fakes/h2_esp_platform_core.h",
            "tests/test_audio_lifecycle.c",
        ],
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS,
        includes = [
            "include",
            "src",
            "tests/audio_fakes",
        ],
        local_defines = defines,
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        deps = [
            "//libs/drivers/audio/es8311",
            "//libs/pal:unsupported",
        ],
    )
    for name, defines in [
        ("audio_lifecycle_test", []),
        (
            "audio_mfg_clock_test",
            ["H2_MOSAICO_MFG_DAC_OSR20=1"],
        ),
    ]
]

firmware_native_component(
    name = "usb",
    srcs = glob(["src/h2_mosaico_usb_*.c"]),
    hdrs = glob([
        "include/h2_mosaico_usb_*.h",
        "include/h2_mosaico_usb_transport.h",
    ]),
    component_directory = "boards/esp_mosaico/esp32s31/src/usb",
    component_name = "h2_mosaico_usb",
    data = [
        "src/usb/CMakeLists.txt",
        "src/usb/idf_component.yml",
    ],
    deps = ["//libs/pal"],
)

cc_test(
    name = "runtime_lifecycle_test",
    srcs = [
        "include/h2_chip_board.h",
        "include/h2_esp_board.h",
        "include/h2_esp_board_config.h",
        "include/h2_mosaico_camera.h",
        "src/h2_esp_board_private.h",
        "src/h2_esp_board_runtime.c",
        "src/h2_mosaico_audio.h",
        "src/h2_mosaico_display.h",
        "src/h2_mosaico_peripherals.h",
        "tests/runtime_fakes/bsp/esp_mosaico.h",
        "tests/runtime_fakes/h2_esp_platform_core.h",
        "tests/test_runtime_lifecycle.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "src",
        "tests/runtime_fakes",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/runtime",
    ],
)

cc_test(
    name = "usb_test",
    srcs = [
        "include/h2_mosaico_usb_console.h",
        "include/h2_mosaico_usb_transport.h",
        "src/h2_mosaico_usb_common.c",
        "src/h2_mosaico_usb_console.c",
        "tests/test_usb.c",
        "tests/usb_fakes/h2_mosaico_usb_test_sdk.h",
    ],
    conlyopts = H2_C11_OPTS,
    includes = [
        "include",
        "src",
        "tests/usb_fakes",
    ],
    local_defines = ["H2_MOSAICO_USB_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)

cc_test(
    name = "entry_task_test",
    srcs = [
        "include/h2_esp_board.h",
        "src/h2_esp_board_task.c",
        "tests/h2_esp_board_task_test_sdk.h",
        "tests/test_h2_esp_board_task.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + ["-UNDEBUG"],
    includes = [
        "include",
        "tests",
    ],
    local_defines = ["H2_ESP_BOARD_TASK_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/runtime"],
)
