load("@rules_python//python:defs.bzl", "py_test")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files(["sdkconfig.defaults", "camera/sdk_setup.cmake"])

firmware_native_component(
    name = "revision",
    srcs = ["src/h2_chip_board.c", "src/h2_mosaico_revision.c"],
    hdrs = ["include/h2_chip_board.h", "include/h2_mosaico_revision.h"],
    component_directory = "boards/esp_mosaico/esp32s31/revision",
    component_name = "h2_chip_board",
    data = ["revision/CMakeLists.txt", "sdkconfig.defaults"],
)

cc_test(
    name = "revision_test",
    srcs = ["src/h2_mosaico_revision.c", "tests/test_revision.c", "include/h2_mosaico_revision.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

# First-party ownership of the upstream native component graph. The external
# overlay exposes files only and never depends back on GizOS.
firmware_native_component(
    name = "boot_splash",
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:boot_splash_headers"],
    component_name = "mosaico_boot_splash",
    data = ["@h2_vendor_esp_mosaico_bsp//:boot_splash_metadata"],
)

firmware_native_component(
    name = "bsp",
    srcs = ["@h2_vendor_esp_mosaico_bsp//:bsp_sources"],
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:bsp_headers"],
    component_name = "esp_mosaico_bsp",
    data = ["@h2_vendor_esp_mosaico_bsp//:bsp_metadata"],
    deps = [":boot_splash"],
)

firmware_native_component(
    name = "esp32s31",
    srcs = [
        "src/h2_esp_board.c",
        "src/h2_esp_board_fs_mount.c",
        "src/h2_esp_board_runtime.c",
        "src/h2_mosaico_peripherals.c",
        "src/h2_mosaico_display.c",
        "src/h2_mosaico_surface.c",
        "src/h2_mosaico_audio.c",
    ],
    hdrs = [
        "include/h2_esp_board.h",
        "include/h2_esp_board_config.h",
        "include/h2_mosaico_display_capture.h",
        "src/h2_esp_board_private.h",
        "src/h2_mosaico_peripherals.h",
        "src/h2_mosaico_mag.h",
        "src/h2_mosaico_display.h",
        "src/h2_mosaico_surface.h",
        "src/h2_mosaico_audio.h",
        "src/h2_mosaico_audio_config.h",
    ],
    component_name = "h2_esp_board",
    data = ["CMakeLists.txt", "sdkconfig.defaults"],
    deps = [
        ":revision",
        ":bsp",
        "//libs/runtime",
        "//libs/pal/providers/corehttp",
        "//native_component_src/esp-idf6.x/h2_pal_core",
        "//native_component_src/esp-idf6.x/h2_libco_stack_guard",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system",
    ],
)

firmware_native_component(
    name = "usb_console",
    srcs = ["usb_console/console.c"],
    hdrs = ["include/h2_mosaico_usb_console.h"],
    component_directory = "boards/esp_mosaico/esp32s31/usb_console",
    component_name = "h2_mosaico_usb_console",
    data = ["usb_console/CMakeLists.txt", "usb_console/idf_component.yml"],
)

cc_test(
    name = "surface_test",
    srcs = ["src/h2_mosaico_surface.c", "src/h2_mosaico_surface.h", "tests/test_surface.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    deps = ["//libs/pal"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "audio_volume_test",
    srcs = ["src/h2_mosaico_audio_config.h", "tests/test_audio_volume.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    deps = ["//libs/drivers/audio/es8311"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "mag_test",
    srcs = ["src/h2_mosaico_mag.h", "tests/test_mag.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    deps = ["//libs/pal"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_native_component(
    name = "mosaico_module_mgr",
    srcs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_mgr_sources"],
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_mgr_headers"],
    component_name = "mosaico_module_mgr",
    component_directory = "boards/esp_mosaico/esp32s31/mosaico_module_mgr",
    data = ["mosaico_module_mgr/CMakeLists.txt", "@h2_vendor_esp_mosaico_bsp//:mosaico_module_mgr_metadata"],
    deps = [':bsp'],
)

firmware_native_component(
    name = "mosaico_module_camera",
    srcs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_camera_sources"],
    hdrs = ["@h2_vendor_esp_mosaico_bsp//:mosaico_module_camera_headers"],
    component_name = "mosaico_module_camera",
    component_directory = "boards/esp_mosaico/esp32s31/mosaico_module_camera",
    data = ["mosaico_module_camera/CMakeLists.txt", "mosaico_module_camera/idf_component.yml", "@h2_vendor_esp_mosaico_bsp//:mosaico_module_camera_metadata"],
    deps = [':mosaico_module_mgr', ':bsp'],
)

firmware_native_component(
    name = "camera",
    srcs = ["camera/h2_mosaico_camera.c"],
    hdrs = ["include/h2_mosaico_camera.h"],
    component_directory = "boards/esp_mosaico/esp32s31/camera",
    component_name = "h2_mosaico_camera",
    data = ["camera/CMakeLists.txt", "camera/sdk_setup.cmake"],
    deps = [":mosaico_module_camera", "//libs/pal"],
)

cc_test(
    name = "camera_test",
    srcs = ["camera/h2_mosaico_camera.c", "include/h2_mosaico_camera.h", "tests/test_camera.c", "tests/test_camera_cpp.cpp", "tests/camera_fakes/mosaico_module_camera.h"],
    conlyopts = H2_C11_OPTS,
    cxxopts = H2_CXX17_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include", "tests/camera_fakes"],
    deps = ["//libs/pal"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "fs_mount_test",
    srcs = ["src/h2_esp_board_fs_mount.c", "src/h2_esp_board_private.h", "tests/test_fs_mount.c", "tests/fs_fakes/h2_esp_platform_core.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src", "tests/fs_fakes"],
    deps = ["//libs/runtime"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_native_component(
    name = "loader_usb",
    srcs = ["loader_usb/transport.c"],
    hdrs = ["include/h2_mosaico_loader_usb.h"],
    component_directory = "boards/esp_mosaico/esp32s31/loader_usb",
    component_name = "h2_mosaico_loader_usb",
    data = ["loader_usb/CMakeLists.txt", "loader_usb/sdkconfig.defaults"],
    deps = [":usb_console", "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime"],
)

py_test(
    name = "loader_usb_test",
    srcs = ["tests/test_loader_usb.py"],
    data = [
        "loader_usb/transport.c",
        "//projects/h2loader/native_component_src/esp-idf6.x/h2_h2loader_runtime:src/h2_esp_h2loader_iostreamikcp.c",
        "//libs/pal:pal_header_files",
        "//libs/iostreamikcp:include/h2_iostreamikcp_types.h",
    ],
    main = "tests/test_loader_usb.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
