# BK7258 v3 Wi-Fi CSI CP layout configuration.
CONFIG_PM_LV_WDT_PROTECTION=y
# CONFIG_MEM_DEBUG is not set
CONFIG_MEM_DEBUG_FUNC_NAME=y
CONFIG_MEM_DEBUG_FUNC_NAME_LEN=16
CONFIG_MEM_DEBUG_TASK_NAME=y
CONFIG_MEM_DEBUG_TASK_NAME_LEN=8
CONFIG_WIFI_PS_DISABLE=y
CONFIG_WIFI_CSI_EN=y
# CONFIG_WIFI_SCAN_COUNTRY_CODE is not set
CONFIG_INT_WDT_PERIOD_MS=8000
CONFIG_TASK_WDT_PERIOD_MS=16000
CONFIG_AON_WDT=y
