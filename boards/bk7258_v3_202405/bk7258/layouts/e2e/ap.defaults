# Display E2E uses SD/FATFS data and H2Loader's CP Flash proxy path.
CONFIG_FLASH_QUAD_ENABLE=y
# CONFIG_FLASH_CP_AP_DIRECT_ACCESS is not set
CONFIG_MBEDTLS_USE_PSRAM=y
CONFIG_AUDIO_PLAY=y
CONFIG_AUDIO_RECORD=y
CONFIG_SHELL_TASK_STACK_SIZE=12288
CONFIG_LCD_QSPI_ST77903_H0165Y008T=y
# CONFIG_OTA_UPDATE_DEFAULT_PARTITION is not set
CONFIG_UART_PRINT_PORT=1
CONFIG_SYS_PRINT_DEV_UART=y
# CONFIG_SYS_PRINT_DEV_MAILBOX is not set
CONFIG_UART_PRINT_BAUD_RATE=460800
CONFIG_DUMP_UART_PRINT_PORT=1
# SDK printf reports at INFO; retain canonical E2E records.
CONFIG_LOG_LEVEL=3
# SDK SDIO_HOST_CLK_13M: use the 26 MHz crystal / 2 for the SD card.
CONFIG_SDCARD_DEFAULT_CLOCK_FREQ=0
# CONFIG_CLI is not set
# CONFIG_BK_OS_TIMER_DEBUG is not set
# CONFIG_MEDIA_DEBUG_TIMER_ENABLE is not set
# CONFIG_HAL_DEBUG_SYS is not set
# CONFIG_IPERF_TEST is not set
# CONFIG_DEMOS_IPERF is not set
# CONFIG_VFS_TEST is not set
# CONFIG_INTERRUPT_TEST is not set
# CONFIG_AON_PMU_TEST is not set
# CONFIG_SARADC_TEST is not set
# CONFIG_FLASH_TEST is not set
# CONFIG_PARTITION_TEST is not set
# CONFIG_PM_CLI_ENABLE is not set
# CONFIG_MEM_DEBUG is not set
