load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files(["usr_gpio_cfg.h"])

filegroup(
    name = "firmware_sources",
    srcs = [
        "CMakeLists.txt",
        "src/h2_bk7258_board.c",
        "src/h2_bk7258_board_audio.c",
        "src/h2_bk7258_board_display.c",
        "src/h2_bk7258_board_input.c",
        "src/h2_bk7258_board_platform.c",
        "src/h2_bk7258_board_private.h",
        "src/h2_bk7258_board_runtime.c",
        "src/h2_bk7258_board_task.c",
        "src/h2_bk7258_board_touch.c",
    ],
)

filegroup(
    name = "native_sources",
    srcs = [
        "src/h2_bk7258_board.c",
        "src/h2_bk7258_board_audio.c",
        "src/h2_bk7258_board_display.c",
        "src/h2_bk7258_board_input.c",
        "src/h2_bk7258_board_platform.c",
        "src/h2_bk7258_board_runtime.c",
        "src/h2_bk7258_board_task.c",
        "src/h2_bk7258_board_touch.c",
    ],
)

filegroup(
    name = "native_headers",
    srcs = [
        "include/h2_bk7258_board.h",
        "src/h2_bk7258_board_private.h",
    ],
)

cc_test(
    name = "board_task_host_test",
    srcs = [
        "include/h2_bk7258_board.h",
        "src/h2_bk7258_board_task.c",
        "tests/h2_bk7258_board_task_test_sdk.h",
        "tests/test_h2_bk7258_board_task.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = [":firmware_sources"],
    includes = [
        "include",
        "tests",
    ],
    local_defines = ["H2_BK7258_BOARD_TASK_HOST_TEST=1"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal",
        "//libs/runtime",
    ],
)

cc_test(
    name = "board_touch_host_test",
    srcs = [
        "src/h2_bk7258_board_private.h",
        "src/h2_bk7258_board_touch.c",
        "tests/test_h2_bk7258_board_touch.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal",
        "//libs/pal:unsupported",
        "//libs/runtime",
    ],
)
