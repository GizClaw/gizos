load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_es8311_audio_system",
    srcs = [
        "src/h2_esp_es8311_audio_system.c",
        "src/h2_esp_es8311_gain.c",
        "src/h2_esp_es8311_platform_audio.c",
        "src/h2_esp_es8311_sr.c",
    ],
    hdrs = [
        "include/h2_esp_es8311_audio_system.h",
        "src/h2_esp_es8311_gain.h",
    ],
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/drivers/audio/es8311",
    ],
)

cc_test(
    name = "config_test",
    srcs = [
        "src/h2_esp_es8311_audio_system.c",
        "src/h2_esp_es8311_gain.c",
        "src/h2_esp_es8311_gain.h",
        "tests/system_include/h2_esp_es8311_audio_system.h",
        "tests/test_h2_esp_es8311_audio_system_config.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/system_include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/audio/pcm",
        "//libs/drivers/audio/es8311",
    ],
)

cc_test(
    name = "gain_test",
    srcs = [
        "src/h2_esp_es8311_gain.c",
        "src/h2_esp_es8311_gain.h",
        "tests/test_h2_esp_es8311_gain.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

# The test includes this implementation to exercise lazy open and idle teardown.
cc_library(
    name = "platform_test_source",
    testonly = True,
    textual_hdrs = ["src/h2_esp_es8311_platform_audio.c"],
)

cc_test(
    name = "power_down_test",
    srcs = [
        "include/h2_esp_es8311_audio_system.h",
        "src/h2_esp_es8311_audio_system.c",
        "src/h2_esp_es8311_gain.c",
        "src/h2_esp_es8311_gain.h",
        "tests/e2e_include/esp_private/esp_clk.h",
        "tests/e2e_include/esp_timer.h",
        "tests/sr_include/esp_aec.h",
        "tests/sr_include/esp_heap_caps.h",
        "tests/test_power_down.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/e2e_include",
        "tests/sr_include",
    ],
    linkopts = select({
        "//tools/bazel/platforms:is_windows_x86_64": [],
        "//conditions:default": ["-lm"],
    }),
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":platform_test_source",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/drivers/audio/es8311",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system/tests/e2e:test_source",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system:test_sdk",
        "//pal",
    ],
)

cc_test(
    name = "sr_test",
    srcs = [
        "include/h2_esp_es8311_audio_system.h",
        "src/h2_esp_es8311_sr.c",
        "tests/sr_include/esp_aec.h",
        "tests/sr_include/esp_heap_caps.h",
        "tests/test_sr.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/sr_include",
    ],
    local_defines = ["CONFIG_IDF_TARGET_ESP32C3=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/audio/mixer:audio_mixer",
        "//libs/drivers/audio/es8311",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system:test_sdk",
        "//pal",
    ],
)

# Existing ESP32-S3 policy must retain PSRAM stacks and FD AEC.
cc_test(
    name = "power_down_psram_test",
    srcs = [
        "include/h2_esp_es8311_audio_system.h",
        "src/h2_esp_es8311_audio_system.c",
        "src/h2_esp_es8311_gain.c",
        "src/h2_esp_es8311_gain.h",
        "tests/e2e_include/esp_private/esp_clk.h",
        "tests/e2e_include/esp_timer.h",
        "tests/sr_include/esp_aec.h",
        "tests/sr_include/esp_heap_caps.h",
        "tests/test_power_down.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/e2e_include",
        "tests/sr_include",
    ],
    linkopts = select({
        "//tools/bazel/platforms:is_windows_x86_64": [],
        "//conditions:default": ["-lm"],
    }),
    local_defines = ["CONFIG_SPIRAM=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":platform_test_source",
        "//libs/audio/mixer:audio_mixer",
        "//libs/audio/pcm",
        "//libs/drivers/audio/es8311",
        "//native_component_src/esp-idf6.x/h2_es8311_audio_system/tests/e2e:test_source",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system:test_sdk",
        "//pal",
    ],
)

cc_test(
    name = "sr_psram_test",
    srcs = [
        "include/h2_esp_es8311_audio_system.h",
        "src/h2_esp_es8311_sr.c",
        "tests/sr_include/esp_aec.h",
        "tests/sr_include/esp_heap_caps.h",
        "tests/test_sr.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/sr_include",
    ],
    local_defines = [
        "CONFIG_IDF_TARGET_ESP32S3=1",
        "CONFIG_SPIRAM=1",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/audio/mixer:audio_mixer",
        "//libs/drivers/audio/es8311",
        "//native_component_src/esp-idf6.x/h2_es8311_es7210_audio_system:test_sdk",
        "//pal",
    ],
)
