load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_es8311_audio_system",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
    ],
    tags = [
        "manual",
    ],
    deps = [
        "//libs/audio_mixer",
    ],
)

cc_test(
    name = "config_test",
    srcs = glob(["tests/system_include/*.h"]) + [
        "src/h2_esp_es8311_audio_system.c",
        "tests/test_h2_esp_es8311_audio_system_config.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests/system_include"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "gain_test",
    srcs = [
        "src/h2_esp_es8311_gain.c",
        "src/h2_esp_es8311_gain.h",
        "tests/test_h2_esp_es8311_gain.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
