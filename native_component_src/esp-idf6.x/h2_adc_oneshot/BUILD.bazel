load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "radio_button_stabilizer",
    srcs = ["src/h2_esp_adc_radio_button.c"],
    hdrs = ["include/h2_esp_adc_stabilizer.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
)

cc_test(
    name = "stabilizer_test",
    srcs = [
        "include/h2_esp_adc_stabilizer.h",
        "src/h2_esp_adc_radio_button.c",
        "src/h2_esp_adc_stabilizer.c",
        "src/h2_esp_adc_stabilizer_internal.h",
        "tests/test_h2_esp_adc_stabilizer.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + ["-Werror=type-limits"],
    includes = [
        "include",
        "src",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_test(
    name = "stabilizer_short_enum_test",
    srcs = [
        "include/h2_esp_adc_stabilizer.h",
        "src/h2_esp_adc_radio_button.c",
        "src/h2_esp_adc_stabilizer.c",
        "src/h2_esp_adc_stabilizer_internal.h",
        "tests/test_h2_esp_adc_stabilizer.c",
    ],
    conlyopts = H2_C11_OPTS + ["-fshort-enums"],
    copts = H2_WARNING_COPTS + ["-Werror=type-limits"],
    includes = [
        "include",
        "src",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

firmware_native_component(
    name = "h2_adc_oneshot",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
    ],
    tags = [
        "manual",
    ],
)
