load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_wakenet",
    srcs = ["src/h2_esp_wakenet.c"],
    hdrs = ["include/h2_esp_wakenet.h"],
    component_name = "h2_wakenet",
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
    ],
    tags = ["manual"],
    deps = ["//libs/pal"],
)

cc_test(
    name = "wakenet_test",
    srcs = [
        "include/h2_esp_wakenet.h",
        "src/h2_esp_wakenet.c",
        "tests/sdk/esp_wn_models.h",
        "tests/sdk/model_path.h",
        "tests/test_wakenet.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/sdk",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/pal"],
)
