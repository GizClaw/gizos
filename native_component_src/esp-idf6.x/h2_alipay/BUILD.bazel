load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_alipay",
    srcs = [
        "src/h2_esp_alipay.c",
        "src/h2_esp_alipay_socket.c",
    ],
    hdrs = ["include/h2_esp_alipay.h"],
    component_directory = "native_component_src/esp-idf6.x/h2_alipay",
    component_name = "h2_alipay",
    data = ["CMakeLists.txt"],
    native_srcs = ["//libs/clients/alipay:sdk_sources"],
    deps = [
        "//libs/clients/alipay:bind_net_sdk",
        "//libs/clients/alipay:sdk_native_api",
    ],
)

cc_library(
    name = "socket_abi_probe",
    testonly = True,
    srcs = ["tests/test_socket_abi.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = ["//tools/bazel/platforms:target_esp32s3"],
    deps = ["//libs/clients/alipay:sdk_native_api"],
)

cc_test(
    name = "socket_test",
    srcs = [
        "src/h2_esp_alipay_socket.c",
        "tests/test_socket.c",
        "//libs/clients/alipay:sdk_fd_sources",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    tags = ["manual"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/clients/alipay:sdk_native_api"],
)
