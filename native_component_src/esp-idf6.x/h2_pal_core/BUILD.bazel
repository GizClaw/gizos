[
    cc_test(
        name = name,
        srcs = [
            "include/h2_esp_platform_core.h",
            "src/h2_esp_platform_task.c",
            "src/h2_esp_resource_stats.c",
            "src/h2_esp_resource_stats_internal.h",
            "tests/test_h2_esp_platform_task_policy.c",
        ] + glob(["tests/sdk/**/*.h"]),
        conlyopts = H2_C11_OPTS + ["-DH2_TASK_POLICY_TEST=1"],
        copts = H2_WARNING_COPTS,
        includes = [
            "include",
            "tests/sdk",
        ],
        local_defines = local_defines,
        target_compatible_with = select({
            "//tools/bazel/platforms:host_linux_target_linux": [],
            "//tools/bazel/platforms:host_macos_target_macos": [],
            "//tools/bazel/platforms:host_windows_target_windows": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//libs/sync/atomic/providers/c11",
            "//pal",
            "//pal:test_allocator",
        ],
    )
    for name, local_defines in [
        ("task_policy_test", []),
        (
            "task_policy_no_psram_test",
            ["CONFIG_SPIRAM=0"],
        ),
        (
            "task_policy_no_ext_mem_test",
            ["CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=0"],
        ),
    ]
]

