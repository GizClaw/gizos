load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files([
    "src/cp_main.c",
    "src/fixed_boot.c",
    "src/flash_access.c",
])

firmware_native_component(
    name = "h2_startup",
    srcs = [
        "src/fixed_boot.c",
        "src/flash_access.c",
        ":src/cp_main.c",
    ],
    hdrs = [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access.h",
        "//native_component_src/bk7258/shared/fixed_flash:layout.h",
        "//native_component_src/bk7258/shared/fixed_flash:layout_check.h",
    ],
    component_name = "cp",
    data = [
        "CMakeLists.txt",
        "Kconfig",
    ],
    execution_unit = "cp",
)

[
    cc_test(
        name = "startup_480m_test" if enabled else "startup_sdk_default_test",
        srcs = [
            "src/cp_main.c",
            "tests/startup_test_sdk.h",
            "tests/test_startup.c",
        ],
        includes = ["tests"],
        local_defines = [
            "H2_BK_CP_STARTUP_HOST_TEST=1",
            "CONFIG_H2_AP_CPU_FREQ_480M={}".format(1 if enabled else 0),
        ],
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
    )
    for enabled in [
        False,
        True,
    ]
]

cc_test(
    name = "fixed_boot_test",
    srcs = [
        "src/fixed_boot.c",
        "tests/fixed_boot_test_sdk.h",
        "tests/test_fixed_boot.c",
    ],
    includes = ["tests"],
    local_defines = ["H2_BK_CP_FIXED_BOOT_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access",
        "//native_component_src/bk7258/shared/fixed_flash:layout",
    ],
)

cc_test(
    name = "flash_access_test",
    srcs = [
        "src/flash_access.c",
        "tests/flash_access_test_sdk.h",
        "tests/test_flash_access.c",
    ],
    includes = ["tests"],
    local_defines = ["H2_BK_CP_FLASH_ACCESS_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access",
        "//pal",
    ],
)
