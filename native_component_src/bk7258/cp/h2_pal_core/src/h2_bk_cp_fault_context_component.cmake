if(CONFIG_H2_BK_PLATFORM_CP_FAULT_TRACE AND CONFIG_ARCH_CM33 AND NOT CONFIG_SOC_SMP)
  set(H2_BK_CP_TRAP_INPUT "${H2_BK_CP_SDK_ROOT}/middleware/arch/cm33/trap_base.c")
  set(H2_BK_CP_STARTUP_INPUT "${H2_BK_CP_SDK_ROOT}/components/cmsis/CMSIS_5/Device/Beken/bk7236xx/Source/startup_bk7236.c")
  set(H2_BK_CP_TRAP_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h2_bk_cp_trap_base.c")
  set(H2_BK_CP_STARTUP_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h2_bk_cp_startup.c")
  include("${CMAKE_CURRENT_LIST_DIR}/h2_bk_cp_fault_context_overlay.cmake")

  foreach(h2_pair "cm33|${H2_BK_CP_TRAP_INPUT}|${H2_BK_CP_TRAP_OUTPUT}" "cmsis|${H2_BK_CP_STARTUP_INPUT}|${H2_BK_CP_STARTUP_OUTPUT}")
    string(REPLACE "|" ";" h2_fields "${h2_pair}")
    list(GET h2_fields 0 h2_component)
    list(GET h2_fields 1 h2_input)
    list(GET h2_fields 2 h2_output)
    armino_component_get_property(h2_library ${h2_component} COMPONENT_LIB)
    get_target_property(h2_sources ${h2_library} SOURCES)
    get_filename_component(h2_filename "${h2_input}" NAME)
    string(REPLACE "." "\\." h2_pattern "${h2_filename}")
    set(h2_originals ${h2_sources})
    list(FILTER h2_originals INCLUDE REGEX "(^|/)${h2_pattern}$")
    list(LENGTH h2_originals h2_count)
    if(NOT h2_count EQUAL 1)
      message(FATAL_ERROR "Expected one CP SDK ${h2_filename}")
    endif()
    list(GET h2_originals 0 h2_original)
    foreach(h2_property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
      get_source_file_property(h2_value "${h2_original}"
        TARGET_DIRECTORY ${h2_library} ${h2_property})
      if(h2_value)
        set_source_files_properties("${h2_output}" TARGET_DIRECTORY ${h2_library}
          PROPERTIES ${h2_property} "${h2_value}")
      endif()
    endforeach()
    list(FILTER h2_sources EXCLUDE REGEX "(^|/)${h2_pattern}$")
    list(APPEND h2_sources "${h2_output}")
    set_property(TARGET ${h2_library} PROPERTY SOURCES ${h2_sources})
  endforeach()
  target_link_options(${COMPONENT_LIB} INTERFACE "-Wl,-u,h2_bk_cp_fault_context_enter")
endif()
