menu "H2 BK CP platform core"

config H2_BK_PLATFORM_CP_FAULT_TRACE
    bool "Emit CP fault context before exception coordination"
    depends on ARCH_CM33 && !SOC_SMP
    default n
    help
        Diagnostic images only. Emit bounded integer context on the configured
        CP dump UART before SDK peer-dump and reboot-tag checks. Use a CP UART
        independent of AP diagnostics. Normal SDK exception handling continues.

config H2_BK_PLATFORM_CP_COREDUMP
    bool "Persist native CP exceptions to a reserved Flash partition"
    depends on ARCH_CM33 && !SOC_SMP && FLASH_CP_AP_DIRECT_ACCESS
    select H2_BK_PLATFORM_CP_FAULT_TRACE
    select DUMP_ENABLE
    default n
    help
        The private launcher supplies the existing partition after Flash init.
        Capture runs after native exception coordination, including NMI WDT.

endmenu
