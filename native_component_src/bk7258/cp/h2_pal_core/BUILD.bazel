load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

exports_files([
    "src/h2_bk_dhcp_ring.c",
    "src/h2_bk_wifi_lease.c",
    "src/h2_bk_wifi_ipv6.c",
])

firmware_native_component(
    name = "h2_pal_core",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
        "//native_component_src/bk7258/shared:h2_bk_cp_lease.cmake",
        "//native_component_src/bk7258/shared:h2_bk_cp_psram.cmake",
        "//native_component_src/bk7258/shared:h2_bk_dhcp_ring.h",
        "//native_component_src/bk7258/shared:h2_bk_dhcp_trace.cmake",
        "//native_component_src/bk7258/shared:h2_bk_dhcp_trace.h",
        "//native_component_src/bk7258/shared:h2_bk_wifi_ipv6.cmake",
        "//native_component_src/bk7258/shared:h2_bk_wifi_ipv6.h",
        "//native_component_src/bk7258/shared:h2_bk_wifi_lease.h",
        "//native_component_src/bk7258/shared:h2_bk_wifi_rpc.h",
    ],
    execution_unit = "cp",
    tags = [
        "manual",
    ],
    deps = [
        "//libs/pal",
    ],
)

py_test(
    name = "wifi_ipv6_timeout_test",
    srcs = ["tests/test_wifi_ipv6_timeout.py"],
    args = [
        "--locator",
        "$(location @gizos_bk7258_sdk//:locator.json)",
    ],
    data = [
        "//native_component_src/bk7258/shared:h2_bk_wifi_ipv6.cmake",
        "//tools/bazel:native_versions/bk7258_sdk_commit.txt",
        "@gizos_bk7258_sdk//:locator.json",
    ],
    legacy_create_init = False,
    local = True,
    main = "tests/test_wifi_ipv6_timeout.py",
    tags = [
        "manual",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "task_policy_test",
    srcs = [
        "include/h2_bk_platform_core.h",
        "src/h2_bk_platform_task.c",
        "tests/test_h2_bk_platform_task_policy.c",
    ] + glob(["tests/sdk/**/*.h"]),
    conlyopts = H2_C11_OPTS + ["-DH2_TASK_POLICY_TEST=1"],
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/sdk",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//libs/pal"],
)

cc_test(
    name = "wifi_lease_test",
    srcs = [
        "src/h2_bk_wifi_lease.c",
        "tests/test_h2_bk_wifi_lease.c",
        "//native_component_src/bk7258/shared:h2_bk_wifi_lease.h",
    ],
    conlyopts = H2_C11_OPTS + ["-DH2_BK_WIFI_LEASE_TEST=1"],
    copts = H2_WARNING_COPTS,
    includes = ["../../shared"],
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
