load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_nfc_fm175xx",
    srcs = [
        "src/h2_bk_nfc_fm175xx.c",
    ],
    hdrs = [
        "include/h2_bk_nfc_fm175xx.h",
    ],
    data = [
        "CMakeLists.txt",
    ],
    execution_unit = "ap",
    tags = [
        "manual",
    ],
    deps = [
        "//libs/drivers/nfc/fm175xx",
        "//pal",
    ],
)

cc_test(
    name = "scan_recovery_test",
    srcs = [
        "include/h2_bk_nfc_fm175xx.h",
        "src/h2_bk_nfc_fm175xx.c",
        "tests/sdk/common/bk_err.h",
        "tests/sdk/driver/i2c.h",
        "tests/sdk/driver/i2c_types.h",
        "tests/sdk/os/os.h",
        "tests/test_scan_recovery.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/sdk",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [
        "//libs/drivers/nfc/fm175xx",
        "//pal",
    ],
)
