load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_pal_storage",
    srcs = glob(["src/*.c"]),
    hdrs = glob(["include/*.h"]),
    data = ["CMakeLists.txt"],
    execution_unit = "ap",
    deps = ["//pal:unsupported"],
)

cc_test(
    name = "disk_test",
    srcs = [
        "include/h2_bk_platform_storage.h",
        "src/h2_bk_platform_disk.c",
        "tests/h2_bk_disk_test_sdk.h",
        "tests/test_h2_bk_platform_disk.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests",
    ],
    local_defines = ["H2_BK_DISK_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//pal"],
)

cc_test(
    name = "sd_fs_test",
    srcs = [
        "include/h2_bk_platform_storage.h",
        "src/h2_bk_platform_sd_fs.c",
        "tests/h2_bk_sd_fs_test_sdk.h",
        "tests/test_h2_bk_platform_sd_fs.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests",
    ],
    local_defines = ["H2_BK_SD_FS_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//pal"],
)

cc_test(
    name = "sd_fs_disabled_test",
    srcs = [
        "include/h2_bk_platform_storage.h",
        "src/h2_bk_platform_sd_fs.c",
        "tests/test_h2_bk_platform_sd_fs_disabled.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    local_defines = ["H2_BK_SD_FS_ENABLED=0"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//pal:unsupported"],
)
