# Compiles the pinned actual SDK engine, not tests/pref_sdk's in-memory shim.
# Explicit only: requires BK7258_PATH and a native host C compiler, no devices.
py_test(
    name = "pref_flashdb_real_nor_test",
    timeout = "long",
    srcs = ["tests/run_pref_flashdb_nor.py"],
    args = [
        "--locator",
        "$(rootpath @gizos_bk7258_sdk//:locator.json)",
    ],
    data = [
        "include/h2_bk_platform_core.h",
        "src/flashdb/fal_cfg.h",
        "src/flashdb/h2_fdb_do_gc.inc",
        "src/flashdb/h2_fdb_gc_overlay.py",
        "src/flashdb/h2_fdb_move_kv.inc",
        "src/h2_bk_platform_pref_flashdb.c",
        "src/h2_bk_platform_pref_flashdb_port.c",
        "src/h2_bk_pref_large.h",
        "tests/test_h2_bk_pref_real_nor.c",
        "//libs/pal:pal_header_files",
        "//tools/bazel:native_versions/bk7258_sdk_commit.txt",
        "@gizos_bk7258_sdk//:locator.json",
    ] + glob(["tests/pref_nor_sdk/**/*.h"]),
    legacy_create_init = False,
    main = "tests/run_pref_flashdb_nor.py",
    tags = [
        "local",
        "manual",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

