load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_pal_core",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
    ],
    execution_unit = "ap",
    tags = [
        "manual",
    ],
    deps = [
        "//libs/pal:unsupported",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/coremqtt",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
    ],
)

cc_test(
    name = "task_policy_test",
    srcs = [
        "include/h2_bk_platform_core.h",
        "src/h2_bk_platform_task.c",
        "tests/test_h2_bk_platform_task_policy.c",
    ] + glob(["tests/sdk/**/*.h"]),
    conlyopts = H2_C11_OPTS + [
        "-DH2_TASK_POLICY_TEST=1",
        "-DCONFIG_SOC_SMP=1",
        "-DCONFIG_CPU_CNT=2",
    ],
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/sdk",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//libs/pal"],
)

cc_test(
    name = "ble_indication_test",
    srcs = [
        "src/h2_bk_ble_gatts_tx_tracker.h",
        "tests/test_h2_bk_ble_indication.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//libs/pal"],
)

cc_test(
    name = "uart_control_tracker_test",
    srcs = [
        "src/h2_bk_uart_control_tracker.c",
        "src/h2_bk_uart_control_tracker.h",
        "tests/test_h2_bk_uart_control_tracker.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
