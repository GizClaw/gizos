firmware_native_component(
    name = "h2_pal_core",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
        "//native_component_src/bk7258/shared:h2_bk_wifi_rpc.h",
        "//native_component_src/bk7258/shared:h2_bk_wifi_lease.h",
        "//native_component_src/bk7258/shared:h2_bk_dhcp_ring.h",
    ],
    execution_unit = "ap",
    tags = [
        "manual",
    ],
    deps = [
        "//libs/atomic:locked_template",
        "//libs/pal:unsupported",
        "//libs/wifi_sta",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/coremqtt",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/pal/providers/libco",
    ],
)

