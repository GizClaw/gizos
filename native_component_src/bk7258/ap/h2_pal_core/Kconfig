menu "GizOS BK AP diagnostics"
    config H2_BK_PLATFORM_COREDUMP
        bool "Persist fatal AP registers and internal-memory stack to flash"
        depends on SOC_SMP && SHELL_ASYNCLOG && FLASH_CP_AP_DIRECT_ACCESS
        select H2_BK_PLATFORM_FAULT_TRACE
        default n
        help
            Requires the board to configure its reserved coredump partition
            after flash initialization. Uses the SDK IRQ-disabled dump writer;
            never erases a previous dump. Captures real exception registers and
            up to one internal-memory stack window, not the entire heap.

    config H2_BK_PLATFORM_FAULT_TRACE
        bool "Record native fault context before peer-core coordination"
        depends on SOC_SMP && SHELL_ASYNCLOG
        default n
        help
            Emit raw AP UART diagnostics before the SDK fatal path coordinates
            with peer cores. Also record log flush callers with interrupts
            masked. Enable only for a diagnostic image; normal power-management
            flushes can produce these records too.
endmenu
