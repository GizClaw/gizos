if(CONFIG_AUDIO_PLAY)
  armino_component_get_property(H2_BK_SPEAKER_LIB audio_play COMPONENT_LIB)
  set(H2_BK_SPEAKER_INPUT "${BK_ARMINO_PATH}/components/audio_play/src/onboard_speaker_play.c")
  set(H2_BK_AUDIO_RING_INPUT "${BK_ARMINO_PATH}/middleware/driver/audio/audio_ring_buff.c")
  set(H2_BK_SPEAKER_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h2_bk_sdk_speaker_play.c")
  include("${CMAKE_CURRENT_LIST_DIR}/h2_bk_audio_speaker.cmake")
  get_target_property(H2_BK_SPEAKER_SOURCES ${H2_BK_SPEAKER_LIB} SOURCES)
  set(H2_BK_SPEAKER_ORIGINALS ${H2_BK_SPEAKER_SOURCES})
  list(FILTER H2_BK_SPEAKER_ORIGINALS INCLUDE REGEX "(^|/)onboard_speaker_play\\.c$")
  list(LENGTH H2_BK_SPEAKER_ORIGINALS H2_BK_SPEAKER_COUNT)
  if(NOT H2_BK_SPEAKER_COUNT EQUAL 1)
    message(FATAL_ERROR "Expected one SDK speaker source")
  endif()
  get_source_file_property(H2_BK_SPEAKER_OPTIONS "${H2_BK_SPEAKER_INPUT}"
    TARGET_DIRECTORY ${H2_BK_SPEAKER_LIB} COMPILE_OPTIONS)
  if(H2_BK_SPEAKER_OPTIONS)
    set_source_files_properties("${H2_BK_SPEAKER_OUTPUT}"
      TARGET_DIRECTORY ${H2_BK_SPEAKER_LIB}
      PROPERTIES COMPILE_OPTIONS "${H2_BK_SPEAKER_OPTIONS}")
  endif()
  list(FILTER H2_BK_SPEAKER_SOURCES EXCLUDE REGEX "(^|/)onboard_speaker_play\\.c$")
  list(APPEND H2_BK_SPEAKER_SOURCES "${H2_BK_SPEAKER_OUTPUT}")
  set_property(TARGET ${H2_BK_SPEAKER_LIB} PROPERTY SOURCES ${H2_BK_SPEAKER_SOURCES})
endif()
