if(CONFIG_SPI)
  armino_component_get_property(H2_BK_SPI_LIB driver COMPONENT_LIB)
  set(H2_BK_SPI_INPUT "${BK_ARMINO_PATH}/middleware/driver/spi/spi_driver.c")
  set(H2_BK_SPI_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h2_bk_sdk_spi_driver.c")
  include("${CMAKE_CURRENT_LIST_DIR}/h2_bk_spi_dma_completion.cmake")
  get_target_property(H2_BK_SPI_SOURCES ${H2_BK_SPI_LIB} SOURCES)
  set(H2_BK_SPI_ORIGINALS ${H2_BK_SPI_SOURCES})
  list(FILTER H2_BK_SPI_ORIGINALS INCLUDE REGEX "(^|/)spi_driver\\.c$")
  list(LENGTH H2_BK_SPI_ORIGINALS H2_BK_SPI_SOURCE_COUNT)
  if(NOT H2_BK_SPI_SOURCE_COUNT EQUAL 1)
    message(FATAL_ERROR "Expected one SDK SPI driver source")
  endif()
  list(FILTER H2_BK_SPI_SOURCES EXCLUDE REGEX "(^|/)spi_driver\\.c$")
  list(APPEND H2_BK_SPI_SOURCES "${H2_BK_SPI_OUTPUT}")
  set_property(TARGET ${H2_BK_SPI_LIB} PROPERTY SOURCES ${H2_BK_SPI_SOURCES})
  target_include_directories(${H2_BK_SPI_LIB} PRIVATE
    "${BK_ARMINO_PATH}/middleware/driver/spi")
endif()
