# Both the write path and the per-block read path must acquire shared ownership
# before the AP-local spinlock. Keep the pinned SDK checkout read-only.
if(CONFIG_FLASH AND CONFIG_FLASH_CP_AP_DIRECT_ACCESS AND CONFIG_FREERTOS_SMP)
  armino_component_get_property(H2_BK_FLASH_DRIVER_LIB driver COMPONENT_LIB)
  set(H2_BK_FLASH_LOCK_INPUT "${BK_ARMINO_PATH}/middleware/driver/flash/flash_shared_lock.c")
  set(H2_BK_FLASH_LOCK_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h2_bk_sdk_flash_shared_lock.c")
  include("${CMAKE_CURRENT_LIST_DIR}/h2_bk_flash_lock_order.cmake")
  get_target_property(H2_BK_FLASH_DRIVER_SOURCES ${H2_BK_FLASH_DRIVER_LIB} SOURCES)
  set(H2_BK_FLASH_DRIVER_ORIGINALS ${H2_BK_FLASH_DRIVER_SOURCES})
  list(FILTER H2_BK_FLASH_DRIVER_ORIGINALS INCLUDE REGEX "(^|/)flash_shared_lock\\.c$")
  list(LENGTH H2_BK_FLASH_DRIVER_ORIGINALS H2_BK_FLASH_DRIVER_ORIGINAL_COUNT)
  if(NOT H2_BK_FLASH_DRIVER_ORIGINAL_COUNT EQUAL 1)
    message(FATAL_ERROR "Pinned BK Flash shared-lock source selection changed")
  endif()
  list(FILTER H2_BK_FLASH_DRIVER_SOURCES EXCLUDE REGEX "(^|/)flash_shared_lock\\.c$")
  list(APPEND H2_BK_FLASH_DRIVER_SOURCES "${H2_BK_FLASH_LOCK_OUTPUT}")
  set_property(TARGET ${H2_BK_FLASH_DRIVER_LIB} PROPERTY SOURCES ${H2_BK_FLASH_DRIVER_SOURCES})
  target_include_directories(${H2_BK_FLASH_DRIVER_LIB} PRIVATE
    "${BK_ARMINO_PATH}/middleware/driver/flash")
endif()
