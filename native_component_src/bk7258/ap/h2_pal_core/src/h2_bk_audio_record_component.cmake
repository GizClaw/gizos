if(CONFIG_AUDIO_RECORD)
  armino_component_get_property(H2_BK_AUDIO_RECORD_LIB audio_record COMPONENT_LIB)
  set(H2_BK_AUDIO_RECORD_INPUT "${BK_ARMINO_PATH}/components/audio_record/src/audio_record.c")
  set(H2_BK_AUDIO_MIC_INPUT "${BK_ARMINO_PATH}/components/audio_record/src/onboard_mic_record.c")
  set(H2_BK_AUDIO_RECORD_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h2_bk_sdk_audio_record.c")
  include("${CMAKE_CURRENT_LIST_DIR}/h2_bk_audio_record.cmake")
  get_target_property(H2_BK_AUDIO_RECORD_SOURCES ${H2_BK_AUDIO_RECORD_LIB} SOURCES)
  set(H2_BK_AUDIO_RECORD_ORIGINALS ${H2_BK_AUDIO_RECORD_SOURCES})
  list(FILTER H2_BK_AUDIO_RECORD_ORIGINALS INCLUDE REGEX "(^|/)audio_record\\.c$")
  list(LENGTH H2_BK_AUDIO_RECORD_ORIGINALS H2_BK_AUDIO_RECORD_COUNT)
  if(NOT H2_BK_AUDIO_RECORD_COUNT EQUAL 1)
    message(FATAL_ERROR "Expected one SDK audio record source")
  endif()
  get_source_file_property(H2_BK_AUDIO_RECORD_OPTIONS "${H2_BK_AUDIO_RECORD_INPUT}"
    TARGET_DIRECTORY ${H2_BK_AUDIO_RECORD_LIB} COMPILE_OPTIONS)
  if(H2_BK_AUDIO_RECORD_OPTIONS)
    set_source_files_properties("${H2_BK_AUDIO_RECORD_OUTPUT}"
      TARGET_DIRECTORY ${H2_BK_AUDIO_RECORD_LIB}
      PROPERTIES COMPILE_OPTIONS "${H2_BK_AUDIO_RECORD_OPTIONS}")
  endif()
  list(FILTER H2_BK_AUDIO_RECORD_SOURCES EXCLUDE REGEX "(^|/)audio_record\\.c$")
  list(APPEND H2_BK_AUDIO_RECORD_SOURCES "${H2_BK_AUDIO_RECORD_OUTPUT}")
  set_property(TARGET ${H2_BK_AUDIO_RECORD_LIB} PROPERTY SOURCES ${H2_BK_AUDIO_RECORD_SOURCES})
endif()
