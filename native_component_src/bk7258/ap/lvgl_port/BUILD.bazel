load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "lvgl_port",
    srcs = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
            "**/*.s",
            "**/*.S",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    hdrs = [
        "//third_party/lvgl_patch:config/bk7258/h2_lvgl_bk_dma2d.h",
        "//third_party/lvgl_patch:config/bk7258/lv_conf.h",
    ] + glob(
        [
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
        ],
        allow_empty = True,
        exclude = [
            "examples/**",
            "test/**",
            "tests/**",
        ],
    ),
    data = [
        "CMakeLists.txt",
    ],
    execution_unit = "ap",
    tags = [
        "manual",
    ],
    deps = [
        "//libs/lvgl:firmware",
        "//libs/pal",
        "//native_component_src/bk7258/ap/h2_pal_core",
    ],
)

cc_test(
    name = "dma2d_test",
    srcs = [
        "h2_lvgl_bk_dma2d.c",
        "h2_lvgl_bk_lifecycle.c",
        "h2_lvgl_bk_power.h",
        "tests/test_h2_lvgl_bk_dma2d.c",
    ] + glob(["tests/sdk/**/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    defines = ["CONFIG_DMA2D=1"],
    includes = [
        ".",
        "tests/sdk",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["@h2_vendor_lvgl//:bk7258_config"],
)

cc_test(
    name = "dma2d_disabled_test",
    srcs = [
        "h2_lvgl_bk_dma2d.c",
        "h2_lvgl_bk_lifecycle.c",
        "h2_lvgl_bk_power.h",
        "tests/sdk/common/bk_include.h",
        "tests/test_h2_lvgl_bk_dma2d_disabled.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    defines = ["CONFIG_DMA2D=0"],
    includes = [
        ".",
        "tests/sdk",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["@h2_vendor_lvgl//:bk7258_config"],
)
