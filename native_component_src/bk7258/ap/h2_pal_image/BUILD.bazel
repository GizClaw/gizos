load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS")

package(default_visibility = ["//visibility:public"])

firmware_native_component(
    name = "h2_pal_image",
    srcs = glob(["src/*.c"]),
    hdrs = glob([
        "include/*.h",
        "src/*.h",
    ]) + [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access.h",
        "//native_component_src/bk7258/shared/fixed_flash:layout.h",
        "//native_component_src/bk7258/shared/fixed_flash:layout_check.h",
    ],
    data = ["CMakeLists.txt"],
    execution_unit = "ap",
    deps = [
        "//native_component_src/bk7258/ap/h2_pal_storage",
        "//pal",
    ],
)

cc_test(
    name = "power_test",
    srcs = [
        "include/h2_bk_platform_image.h",
        "src/h2_bk_image_internal.h",
        "src/h2_bk_platform_power.c",
        "tests/h2_bk_h2loader_power_test_sdk.h",
        "tests/test_h2_bk_h2loader_power.c",
    ],
    includes = [
        "include",
        "src",
        "tests",
    ],
    local_defines = ["H2_BK_H2LOADER_POWER_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//native_component_src/bk7258/shared/fixed_flash:layout",
        "//pal",
    ],
)

cc_test(
    name = "fixed_boot_test",
    srcs = [
        "src/h2_bk_fixed_boot.c",
        "tests/h2_bk_fixed_boot_test_sdk.h",
        "tests/test_h2_bk_fixed_boot.c",
    ],
    includes = ["tests"],
    local_defines = ["H2_BK_FIXED_BOOT_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access",
        "//native_component_src/bk7258/shared/fixed_flash:layout",
        "//pal",
    ],
)

cc_test(
    name = "flash_access_test",
    srcs = [
        "src/h2_bk_flash_access.c",
        "src/h2_bk_flash_access.h",
        "tests/h2_bk_flash_access_test_sdk.h",
        "tests/test_h2_bk_flash_access.c",
    ],
    includes = [
        "src",
        "tests",
    ],
    local_defines = ["H2_BK_FLASH_ACCESS_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access",
        "//pal",
    ],
)

cc_test(
    name = "ota_writer_test",
    srcs = [
        "include/h2_bk_platform_image.h",
        "src/h2_bk_fixed_boot.h",
        "src/h2_bk_flash_access.h",
        "src/h2_bk_image_internal.h",
        "src/h2_bk_platform_image.c",
        "tests/h2_bk_h2loader_ota_writer_test_sdk.h",
        "tests/test_h2_bk_h2loader_ota_writer.c",
    ],
    conlyopts = H2_C11_OPTS,
    includes = [
        "include",
        "src",
        "tests",
    ],
    local_defines = ["H2_BK_OTA_WRITER_HOST_TEST=1"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        "//native_component_src/bk7258/shared/fixed_flash:flash_access",
        "//native_component_src/bk7258/shared/fixed_flash:layout",
        "//pal",
    ],
)
