load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

exports_files([
    "flash_access.h",
    "layout.h",
    "layout_check.h",
])

cc_library(
    name = "layout",
    hdrs = ["layout.h"],
    includes = ["."],
)

cc_test(
    name = "layout_test",
    srcs = [
        "layout.h",
        "tests/test_layout.c",
    ],
    includes = ["."],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

cc_library(
    name = "flash_access",
    hdrs = ["flash_access.h"],
    includes = ["."],
)
