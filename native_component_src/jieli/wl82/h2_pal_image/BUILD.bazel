load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

# These complete SDK replacements are direct native objects. In particular,
# every dev_upgrade_api symbol must precede update.a extraction under LTO.
firmware_native_component(
    name = "h2_pal_image",
    srcs = glob(
        ["src/*.c"],
        exclude = ["src/jieli_warm_boot_early.c"],
    ),
    hdrs = glob(["include/*.h"]),
    component_name = "h2_jieli_wl82_image",
    include_roots = ["native_component_src/jieli/wl82/h2_pal_image/include"],
    tags = ["manual"],
    deps = [
        "//libs/sync/atomic",
        "//native_component_src/jieli/wl82/h2_pal_core",
        "//pal:pal_header_files",
    ],
)

[
    cc_test(
        name = "io_stream" + suffix + "_test",
        srcs = [
            "include/h2_jieli_wl82_console.h",
            "src/h2_jieli_wl82_platform_io_stream.c",
            "tests/h2_jieli_console_test_sdk.h",
            "tests/test_h2_jieli_io_stream.c",
            "//native_component_src/jieli/wl82/h2_pal_core:include/h2_jieli_wl82_atomic.h",
        ],
        additional_compiler_inputs = ["src/h2_jieli_wl82_console.c"],
        conlyopts = H2_C11_OPTS,
        copts = H2_WARNING_COPTS + ["-Inative_component_src/jieli/wl82/h2_pal_core/include"],
        includes = [
            "include",
            "src",
            "tests",
        ],
        local_defines = defines,
        target_compatible_with = HOST_TOOL_COMPATIBILITY,
        deps = ["//pal"],
    )
    for suffix, defines in [
        ("", []),
        (
            "_uart",
            ["CONFIG_H2_UART1_DEBUG_ENABLE=1"],
        ),
    ]
]

filegroup(
    name = "native_fixture_sources",
    testonly = True,
    srcs = glob([
        "include/*.h",
        "src/*.c",
    ]),
)

# Only the recovery/Loader graph consumes a retained warm request before the
# architecture and second core initialize. All images share the publisher ABI.
firmware_native_component(
    name = "warm_boot",
    srcs = ["src/jieli_warm_boot_early.c"],
    hdrs = glob(["include/*.h"]),
    component_name = "h2_jieli_wl82_warm_boot",
    include_roots = ["native_component_src/jieli/wl82/h2_pal_image/include"],
    tags = ["manual"],
    deps = [":h2_pal_image"],
)

