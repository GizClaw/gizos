load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

# PAL core providers for the JieLi AC791N (wl82) SDK. The providers only
# depend on h2_jieli_wl82_sdk_port.h; the SDK binding
# (src/h2_jieli_wl82_sdk_port.c) is compiled by the native SDK build, while
# host tests link the deterministic fake below.
PROVIDER_SRCS = [
    "src/h2_jieli_wl82_platform_firmware_info.c",
    "src/h2_jieli_wl82_platform_log.c",
    "src/h2_jieli_wl82_platform_mem.c",
    "src/h2_jieli_wl82_platform_queue.c",
    "src/h2_jieli_wl82_platform_sync.c",
    "src/h2_jieli_wl82_platform_system_event.c",
    "src/h2_jieli_wl82_platform_task.c",
    "src/h2_jieli_wl82_platform_time.c",
    "src/h2_jieli_wl82_platform_timer.c",
]

firmware_native_component(
    name = "h2_pal_core",
    srcs = PROVIDER_SRCS + [
        "src/h2_jieli_wl82_atomic_provider.c",
        "src/h2_jieli_wl82_pthread_once.c",
        "src/h2_jieli_wl82_sdk_port.c",
    ],
    hdrs = [
        "include/h2_jieli_wl82_allocator.h",
        "include/h2_jieli_wl82_atomic.h",
        "include/h2_jieli_wl82_platform_core.h",
        "include/h2_jieli_wl82_sdk_port.h",
    ],
    component_name = "h2_pal_core",
    include_roots = [
        "pal/include",
        "libs/sync/atomic/include",
        "libs/sync/atomic/providers/locked",
        "native_component_src/jieli/wl82/h2_pal_core/include",
    ],
    tags = ["manual"],
    deps = [
        "//libs/sync/atomic:locked_template",
        "//pal:pal_header_files",
    ],
)

cc_test(
    name = "pthread_once_test",
    srcs = [
        "include/h2_jieli_wl82_sdk_port.h",
        "src/h2_jieli_wl82_pthread_once.c",
        "tests/once_sdk/system/os/pthread.h",
        "tests/src/test_jieli_wl82_pthread_once.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + ["-UNDEBUG"],
    includes = [
        "include",
        "tests/once_sdk",
    ],
    linkopts = ["-pthread"],
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
)

# Run the public Atomic contract against the provider compiled into firmware,
# rather than substituting the host C11 provider as the other PAL tests do.
cc_test(
    name = "atomic_provider_test",
    srcs = [
        "include/h2_jieli_wl82_sdk_port.h",
        "src/h2_jieli_wl82_atomic_provider.c",
        "tests/src/h2_jieli_wl82_atomic_test_sdk.c",
        "//libs/sync/atomic/providers/c11:tests/test_h2_atomic_c11.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + ["-UNDEBUG"],
    includes = ["include"],
    linkopts = ["-pthread"],
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
    deps = [
        "//libs/sync/atomic:locked_template",
    ],
)

cc_library(
    name = "h2_pal_core_host",
    testonly = True,
    srcs = PROVIDER_SRCS + [
        "tests/include/h2_jieli_wl82_sdk_port_fake.h",
        "tests/src/h2_jieli_wl82_sdk_port_fake.c",
    ],
    hdrs = glob(["include/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
        "tests/include",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    visibility = ["//visibility:private"],
    deps = ["//pal"],
)

