load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "bazel_graph_options_test",
    srcs = [
        "scripts/common/bazel.py",
        "scripts/common/test_bazel.py",
    ],
    data = [
        "scripts/bazel/bazel-build.py",
        "scripts/bazel/bazel-test.py",
    ],
    legacy_create_init = False,
    main = "scripts/common/test_bazel.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

exports_files([".github/workflows/release.yml"])

exports_files(
    ["MODULE.bazel"],
    visibility = ["//projects/testing:__subpackages__"],
)

filegroup(
    name = "live_e2e_command_files",
    srcs = [
        ".github/workflows/e2e.yml",
        "Makefile",
        ":make_command_files",
    ],
)

filegroup(
    name = "repository_docs",
    srcs = [
        "LICENSE",
        "README.md",
    ],
)

filegroup(
    name = "make_command_files",
    srcs = glob([
        "scripts/**/*.py",
        "scripts/**/*.sh",
    ]),
)
