package(default_visibility = ["//visibility:public"])

filegroup(
    name = "repository_docs",
    srcs = [
        "LICENSE",
        "README.md",
    ],
)

filegroup(
    name = "make_command_files",
    srcs = glob([
        "scripts/**/*.py",
        "scripts/**/*.sh",
    ]),
)

filegroup(
    name = "public_command_surface_inputs",
    srcs = glob(
        [
            "**/*.md",
            ".github/workflows/*.yml",
            "scripts/**/*.py",
            "scripts/**/*.sh",
        ],
        exclude = [
            "build/**",
            "third_party/**",
            "x/**",
        ],
    ) + ["Makefile"],
)
