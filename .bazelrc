startup --windows_enable_symlinks

common --enable_bzlmod
common --noenable_workspace
common --enable_platform_specific_config
common --announce_rc
common --repository_cache=~/.cache/bazel/repository

common:ci-graph --enable_bzlmod
common:ci-graph --noenable_platform_specific_config
common:ci-graph --define=h2_ci_graph=true
common:ci-graph --define=h2_host_os=linux
build:ci-graph --platforms=//tools/bazel/platforms:linux_x86_64
build:ci-graph --extra_execution_platforms=//tools/bazel/platforms:linux_x86_64

build:linux --define=h2_host_os=linux
build:linux --dynamic_mode=off
build:macos --define=h2_host_os=macos
build:windows --define=h2_host_os=windows

build --strip=never
build --disk_cache=~/.cache/bazel/disk
build --experimental_disk_cache_gc_max_age=14d
build --experimental_disk_cache_gc_max_size=4G
build --experimental_remote_scrubbing_config=tools/bazel/remote_scrubbing_config.textproto

build:linux_x86_64 --platforms=//tools/bazel/platforms:linux_x86_64
build:linux_x86_64 --extra_toolchains=//tools/bazel/platforms:linux_x86_64_test_toolchain

build:test_coverage --platforms=//tools/bazel/platforms:linux_x86_64
build:test_coverage --extra_toolchains=@gizos_coverage_llvm_toolchain//:cc-toolchain-x86_64-linux
build:test_coverage --extra_toolchains=//tools/bazel/platforms:linux_x86_64_test_toolchain
build:test_coverage --copt=-D_GNU_SOURCE
build:test_coverage --cxxopt=-Wno-error=unused-command-line-argument
coverage:test_coverage --experimental_use_llvm_covmap
coverage:test_coverage --experimental_generate_llvm_lcov
coverage:test_coverage --instrumentation_filter=^//

build:kickpi_k4b --platforms=//tools/bazel/platforms:linux_armv7_gnueabihf
build:kickpi_k4b --extra_toolchains=@k4b_arm_gnu_toolchain//:toolchain
build:kickpi_k4b --extra_toolchains=//tools/bazel/platforms:linux_x86_64_test_toolchain
build:kickpi_k4b -c opt
build:kickpi_k4b --repo_env=K4B_CEDARX_INCLUDE_DIR
build:kickpi_k4b --repo_env=K4B_CEDARX_LIB_DIR

build:macos_arm64 --platforms=//tools/bazel/platforms:macos_arm64
build:macos_arm64 --extra_toolchains=//tools/bazel/platforms:macos_arm64_test_toolchain
build:macos_arm64 --action_env=MACOSX_DEPLOYMENT_TARGET=13.0
build:macos_arm64 --macos_minimum_os=13.0

build:ios_sim_arm64 --platforms=//tools/bazel/platforms:ios_sim_arm64
build:ios_sim_arm64 --define=h2_mobile_target=ios_sim_arm64
build:ios_sim_arm64 --ios_multi_cpus=sim_arm64
build:ios_sim_arm64 --apple_generate_dsym
build:ios_sim_arm64 --extra_toolchains=//tools/bazel/platforms:macos_arm64_test_toolchain
test:ios_sim_arm64 --ios_simulator_device="iPhone 16 Pro"

build:android_arm64 --android_platforms=//tools/bazel/platforms:arm64-v8a
build:android_arm64 --platforms=//tools/bazel/platforms:arm64-v8a
build:android_arm64 --define=h2_mobile_target=android_arm64
build:android_arm64 --extra_toolchains=@androidndk//:all
build:android_arm64 --extra_toolchains=//tools/bazel/platforms:linux_x86_64_test_toolchain
build:android_arm64 --extra_toolchains=//tools/bazel/platforms:macos_arm64_test_toolchain
build:android_arm64 --java_language_version=17
build:android_arm64 --java_runtime_version=17
build:android_arm64 --tool_java_language_version=17
build:android_arm64 --tool_java_runtime_version=17

build:windows_x86_64 --platforms=//tools/bazel/platforms:windows_x86_64
build:windows_x86_64 --extra_execution_platforms=//tools/bazel/platforms:windows_x86_64
build:windows_x86_64 --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows
build:windows_x86_64 --extra_toolchains=//tools/bazel/platforms:windows_x86_64_test_toolchain
build:windows_x86_64 --features=compiler_param_file
build:windows_x86_64 --enable_runfiles

test --build_tests_only
test --test_output=errors
test --remote_download_outputs=minimal

build:esp --repo_env=IDF_PATH
build:esp --repo_env=IDF_TOOLS_PATH
build:esp --repo_env=H2_NATIVE_CCACHE_RUNTIME_ROOT
build:esp --action_env=H2LOADER_WIFI_CREDENTIALS
build:esp32s3 --config=esp
build:esp32s3 --define=h2_firmware_target=esp32s3
build:esp32s3 --platforms=//tools/bazel/platforms:esp32s3
build:esp32p4 --config=esp
build:esp32p4 --define=h2_firmware_target=esp32p4
build:esp32p4 --platforms=//tools/bazel/platforms:esp32p4
build:esp32c5 --config=esp
build:esp32c5 --define=h2_firmware_target=esp32c5
build:esp32c5 --platforms=//tools/bazel/platforms:esp32c5
build:bk7258 --define=h2_firmware_target=bk7258
build:bk7258 --platforms=//tools/bazel/platforms:bk7258
build:bk7258 --repo_env=BK7258_PATH
build:bk7258 --repo_env=H2_NATIVE_CCACHE_RUNTIME_ROOT

build:bk3633 --define=h2_firmware_target=bk3633
build:bk3633 --platforms=//tools/bazel/platforms:bk3633
build:bk3633 --repo_env=BK3633_PATH
build:bk3633 --repo_env=H2_NATIVE_CCACHE_RUNTIME_ROOT

build:jieli --repo_env=JIELI_TOOLCHAIN_ROOT
build:jieli --repo_env=JIELI_POSTBUILD_ROOT
build:ac695n --config=jieli
build:ac695n --define=h2_firmware_target=ac695n
build:ac695n --platforms=//tools/bazel/platforms:ac695n
build:ac695n --repo_env=JIELI_AC695N_SDK_PATH
build:ac791n --config=jieli
build:ac791n --define=h2_firmware_target=ac791n
build:ac791n --platforms=//tools/bazel/platforms:ac791n
build:ac791n --repo_env=JIELI_AC791N_SDK_PATH
