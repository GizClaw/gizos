load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "LINUX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//pal:provider_assembly"])

cc_library(
    name = "serial_host",
    srcs = ["src/h2_linux_serial_host.c"],
    hdrs = ["include/h2_linux_serial_host.h"],
    conlyopts = H2_C11_OPTS,
    copts = [
        "-D_DEFAULT_SOURCE",
    ] + H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = LINUX_HOST_TOOL_COMPATIBILITY,
    deps = [
        "//pal",
        "//pal/providers/platforms/posix/serial_host:serial_host_internal",
    ],
)

cc_test(
    name = "serial_host_test",
    srcs = ["tests/test_linux_serial_host.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    env_inherit = ["H2_DESKTOP_SERIAL_PRINT"],
    target_compatible_with = LINUX_HOST_TOOL_COMPATIBILITY,
    deps = [
        ":serial_host",
        "//pal/providers/platforms/posix/serial_host:serial_host_test_support",
    ],
)
