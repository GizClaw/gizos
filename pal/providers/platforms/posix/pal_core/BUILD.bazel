# Public CA signatures may use P-384 even when the TLS leaf key uses P-256.
cc_test(
    name = "net_tls_p384_test",
    srcs = ["tests/test_posix_net_tls.c"],
    args = [
        "$(location tests/fixtures/p384_ca.pem)",
        "$(location tests/fixtures/wrong_ca.pem)",
        "$(location tests/fixtures/p384_signed_localhost.pem)",
        "$(location tests/fixtures/p384_signed_localhost_key.pem)",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = glob(["tests/fixtures/*.pem"]),
    linkopts = ["-lpthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":entropy",
        ":net",
        "//pal",
        "//pal/providers/backends/wolfssl",
    ],
)

