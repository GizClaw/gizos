load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("//tools/bazel/mobile:mobile_package.bzl", "h2_android_aar", "h2_mobile_archive_import")
load("//tools/bazel/platforms:compatibility.bzl", "ANDROID_ARM64_ARTIFACT_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//pal:provider_assembly"])

cc_library(
    name = "audio_contract",
    srcs = ["src/h2_android_audio_contract.c"],
    hdrs = ["src/h2_android_audio_internal.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = ["//pal"],
)

cc_library(
    name = "contracts",
    target_compatible_with = select({
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":audio_contract",
        ":video_contract",
    ],
)

cc_library(
    name = "pal_core",
    srcs = [
        "src/h2_android_audio_decoder.c",
        "src/h2_android_core.c",
        "src/h2_android_crypto.c",
        "src/h2_android_http.c",
        "src/h2_android_json.c",
        "src/h2_android_mqtt.c",
        "src/h2_android_net.c",
        "src/h2_android_platform.c",
        "src/h2_android_storage.c",
        "src/h2_android_tls_internal.h",
        "src/h2_android_video_decoder.c",
        "src/h2_android_webrtc.c",
    ],
    hdrs = [
        "include/h2_android_mqtt.h",
        "include/h2_android_net.h",
        "include/h2_android_platform.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + [
        "-Wno-deprecated-declarations",
        "-Wno-shorten-64-to-32",
    ],
    includes = ["include"],
    linkopts = [
        "-laaudio",
        "-landroid",
        "-ljnigraphics",
        "-llog",
        "-lm",
        "-lmediandk",
    ],
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        ":contracts",
        "//pal",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/coremqtt",
        "//pal/providers/backends/h2peer",
        "//pal/providers/backends/h2sctp",
        "//pal/providers/backends/sqlite",
        "//pal/providers/backends/wolfssl",
        "//pal/providers/backends/yyjson",
        "//pal/providers/platforms/posix/atomic",
        "//pal/providers/platforms/posix/pal_core:host_fs",
        "//pal/providers/platforms/posix/pal_core:mobile_core",
        "//pal/providers/platforms/posix/pal_core:net",
    ],
)

cc_library(
    name = "video_contract",
    srcs = ["src/h2_android_video_contract.c"],
    hdrs = ["src/h2_android_video_internal.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = ["//pal"],
)

cc_test(
    name = "audio_contract_test",
    srcs = ["tests/test_android_audio_contract.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":audio_contract"],
)

cc_test(
    name = "video_contract_test",
    srcs = ["tests/test_android_video_contract.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":video_contract"],
)

# Exercise the actual mobile HTTP/crypto owner without Android UI/JNI calls.
cc_test(
    name = "http_owner_lifecycle_test",
    srcs = [
        "include/h2_android_platform.h",
        "src/h2_android_crypto.c",
        "src/h2_android_http.c",
        "src/h2_android_tls_internal.h",
        "tests/host_include/android/bitmap.h",
        "tests/host_include/jni.h",
        "tests/test_android_http_owner_lifecycle.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + select({
        "@platforms//os:linux": ["-D_DEFAULT_SOURCE"],
        "//conditions:default": [],
    }),
    includes = [
        "include",
        "tests/host_include",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//pal",
        "//pal:unsupported",
        "//pal/providers/backends/corehttp",
        "//pal/providers/backends/wolfssl",
        "//pal/providers/platforms/posix/pal_core:net",
    ],
)

cc_shared_library(
    name = "sdk_binary",
    shared_lib_name = "libh2_pal_core.so",
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [":pal_core"],
)

h2_android_aar(
    name = "aar",
    headers = [
        "include/h2_android_platform.h",
        "include/h2_android_net.h",
        "include/h2_android_mqtt.h",
        "//pal:pal_header_files",
        "//pal/providers/backends/yyjson:include/h2_yyjson_json.h",
    ],
    module_name = "h2-pal-core",
    shared_library = ":sdk_binary",
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    version = "2.0.0",
)

filegroup(
    name = "aar_archive",
    srcs = [":aar"],
    output_group = "artifact",
)

h2_mobile_archive_import(
    name = "packaged",
    archive = ":aar_archive",
    binary_name = "libh2_pal_core.so",
    header_prefix = "prefab/modules/h2_pal_core/include/",
    member = "jni/arm64-v8a/libh2_pal_core.so",
    shared = True,
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
)
