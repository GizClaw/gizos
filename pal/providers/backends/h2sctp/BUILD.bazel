load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//pal:provider_assembly"])

# Tests inspect private state; declare their private header inputs explicitly.
filegroup(
    name = "test_internal_headers",
    testonly = True,
    srcs = glob(["src/*.h"]),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "h2sctp",
    srcs = [
        "src/h2_sctp.c",
        "src/h2_sctp_association.c",
        "src/h2_sctp_association.h",
        "src/h2_sctp_crc32c.c",
        "src/h2_sctp_crc32c.h",
        "src/h2_sctp_internal.h",
        "src/h2_sctp_reliability.c",
        "src/h2_sctp_reliability.h",
        "src/h2_sctp_stream.c",
        "src/h2_sctp_stream.h",
        "src/h2_sctp_timer.c",
        "src/h2_sctp_timer.h",
        "src/h2_sctp_wire.c",
        "src/h2_sctp_wire.h",
    ],
    hdrs = ["include/h2_sctp.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    data = [
        "CMakeLists.txt",
        "LICENSE.usrsctp",
    ],
    includes = [
        "include",
        "src",
    ],
    deps = [
        "//libs/sync/atomic",
        "//pal",
    ],
)

# Production assemblies select their atomic implementation. Standalone source
# tests link the portable C11 implementation through this test-only facade.
cc_library(
    name = "h2sctp_host_test",
    testonly = True,
    visibility = ["//visibility:private"],
    deps = [
        ":h2sctp",
        "//libs/sync/atomic/providers/c11",
    ],
)

# Reuse the public two-endpoint transport fixture at the H2Peer event boundary.
cc_library(
    name = "test_peer",
    testonly = True,
    srcs = ["tests/h2_sctp_test_peer.c"],
    hdrs = [
        "src/h2_sctp_internal.h",
        "tests/h2_sctp_test_peer.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests"],
    visibility = ["//pal/providers/backends/h2peer:__pkg__"],
    deps = [":h2sctp"],
)

