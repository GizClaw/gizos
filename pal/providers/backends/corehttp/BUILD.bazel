load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")

package(default_visibility = ["//pal:provider_assembly"])

cc_library(
    name = "llhttp",
    srcs = [
        "src/h2_corehttp_no_standard_stream.h",
        "@h2_vendor_corehttp//:llhttp_sources",
    ],
    conlyopts = H2_C11_OPTS + select({
        "//tools/bazel/platforms:is_windows_x86_64": [
            "/FIpal/providers/backends/corehttp/src/h2_corehttp_no_standard_stream.h",
        ],
        "//conditions:default": [
            "-include",
            "pal/providers/backends/corehttp/src/h2_corehttp_no_standard_stream.h",
        ],
    }),
    copts = H2_WARNING_COPTS + h2_gnu_only_copts([
        "-Wno-sign-conversion",
        "-Wno-unused-parameter",
    ]) + select({
        "//tools/bazel/platforms:is_bk7258": ["-Wno-type-limits"],
        "//tools/bazel/platforms:is_windows_x86_64": [
            "/wd4100",
            "/wd4152",
            "/wd4244",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = ["//third_party:vendor_third_party_corehttp"],
)

cc_library(
    name = "corehttp",
    srcs = [
        "src/h2_corehttp.c",
        "src/h2_corehttp_internal.h",
        "src/h2_corehttp_response.c",
        "src/h2_corehttp_transport.c",
        "src/h2_corehttp_url.c",
        "@h2_vendor_corehttp//:corehttp_sources",
    ],
    hdrs = [
        "include/core_http_config.h",
        "include/h2_corehttp.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + h2_gnu_only_copts([
        "-Wno-sign-conversion",
        "-Wno-unused-parameter",
    ]) + select({
        "//tools/bazel/platforms:is_bk7258": ["-Wno-type-limits"],
        "//tools/bazel/platforms:is_windows_x86_64": [
            "/wd4100",
            "/wd4152",
            "/wd4244",
        ],
        "//conditions:default": [],
    }),
    includes = ["include"],
    deps = [
        ":llhttp",
        "//pal",
        "//third_party:vendor_third_party_corehttp",
    ],
)

cc_library(
    name = "fake_net_test_support",
    testonly = True,
    srcs = ["tests/fake_net.c"],
    hdrs = ["tests/fake_net.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = [
        "//pal/providers/platforms/posix/pal_core:__pkg__",
        "//pal/providers/platforms/windows/pal_core:__pkg__",
    ],
    deps = [":corehttp"],
)

cc_test(
    name = "corehttp_test",
    srcs = [
        "tests/test_corehttp.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":corehttp",
        ":fake_net_test_support",
        "//libs/sync/atomic/providers/c11",
        "//pal:test_allocator",
    ],
)

cc_library(
    name = "corehttp_test_support",
    testonly = True,
    visibility = ["//libs:__subpackages__"],
    deps = [":corehttp"],
)
