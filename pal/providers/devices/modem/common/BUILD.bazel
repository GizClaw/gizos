load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//pal:provider_assembly"])

h2_tasks(
    name = "tasks",
    tasks = ["$modem/urc"],
)

cc_library(
    name = "urc",
    srcs = [
        "src/h2_modem_rx.c",
        "src/h2_modem_urc.c",
    ],
    hdrs = [
        "include/h2_modem_rx.h",
        "include/h2_modem_urc.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/sync/atomic",
        "//pal",
    ],
)

cc_test(
    name = "rx_test",
    srcs = ["tests/test_modem_rx.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":urc",
        "//libs/sync/atomic/providers/c11",
    ],
)

cc_test(
    name = "urc_test",
    srcs = ["tests/test_modem_urc.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":urc",
        "//libs/sync/atomic/providers/c11",
        "//pal/providers/devices/modem/quectel:quectel_modem",
        "//pal/providers/devices/modem/simcom:simcom_modem",
    ],
)
