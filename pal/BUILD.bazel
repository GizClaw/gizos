load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_GNU_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")

package(default_visibility = ["//visibility:public"])

# Concrete providers are selected by assembly code, not portable libraries.
# Test-only provider facades allow library tests to use real implementations.
package_group(
    name = "provider_assembly",
    packages = [
        "-//libs/...",
        "public",
    ],
)

# Source-only native SDK components consume the PAL contract headers without
# asking Bazel to resolve a C++ toolchain for the vendor-owned final link.
filegroup(
    name = "pal_header_files",
    srcs = glob(["include/**/*.h"]),
)

