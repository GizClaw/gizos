load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "task_names",
    srcs = ["src/h2_h2loader_host_task_names.c"],
    hdrs = ["include/h2_h2loader_host_task_names.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
)

cc_library(
    name = "h2loader_host",
    srcs = [
        "src/h2_h2loader_host_ble.c",
        "src/h2_h2loader_host_catalog.c",
        "src/h2_h2loader_host_command.c",
        "src/h2_h2loader_host_discovery.c",
        "src/h2_h2loader_host_factory.c",
        "src/h2_h2loader_host_flash.c",
        "src/h2_h2loader_host_flash_bk7258.c",
        "src/h2_h2loader_host_flash_esp.c",
        "src/h2_h2loader_host_internal.h",
        "src/h2_h2loader_host_operation.c",
        "src/h2_h2loader_host_package.c",
        "src/h2_h2loader_host_package_writer.c",
        "src/h2_h2loader_host_scheduler.c",
        "src/h2_h2loader_host_serial.c",
        "src/h2_h2loader_host_sha256.c",
        "src/h2_h2loader_host_status.c",
    ],
    hdrs = [
        "include/h2_h2loader_host.h",
        "include/h2_h2loader_host_catalog.h",
        "include/h2_h2loader_host_factory.h",
        "include/h2_h2loader_host_flash.h",
        "include/h2_h2loader_host_package.h",
        "include/h2_h2loader_host_scheduler.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_bk3633": ["@platforms//:incompatible"],
        "//tools/bazel/platforms:is_bk7258": ["@platforms//:incompatible"],
        "//tools/bazel/platforms:is_esp32p4": ["@platforms//:incompatible"],
        "//tools/bazel/platforms:is_esp32s3": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":task_names",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/iostreamikcp",
        "//libs/pal",
        "//tools/bazel:vendor_third_party_esp_serial_flasher",
        "//tools/bazel:vendor_third_party_zlib",
    ],
)

