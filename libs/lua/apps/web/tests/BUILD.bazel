load("//libs/app_host:web_app.bzl", "h2_web_app")
load("//libs/lua:lua_app.bzl", "lua_app", "lua_app_index")
load("//libs/lua/apps/web:browser_test.bzl", "web_lua_apps_browser_test")
load("//tools/bazel:firmware.bzl", "firmware_version")

package(default_visibility = ["//visibility:public"])

exports_files(["persistence_test.py"])

firmware_version(
    name = "v1",
    value = "0.1.0",
)

firmware_version(
    name = "v2",
    value = "0.2.0",
)

lua_app(
    name = "preinstalled",
    entry = "demo.lua",
    version = ":v1",
)

lua_app(
    name = "update",
    entry = "demo.lua",
    version = ":v2",
)

lua_app_index(
    name = "preinstalled_index",
    apps = [":preinstalled"],
    root = "/data/lua",
)

filegroup(
    name = "update_archive",
    srcs = [":update"],
    output_group = "archive",
)

h2_web_app(
    name = "catalog",
    srcs = ["main.c"],
    app_name = "web-lua-apps",
    clicks = [[
        "H2_WEB_LUA_APPS ready",
        "#stop",
    ]],
    preload = {
        ":demo.lua": "/data/lua/demo.lua",
        ":preinstalled_index": "/data/lua/preinstalled.json",
    },
    deps = ["//libs/lua/apps/web"],
)

web_lua_apps_browser_test(
    name = "persistence_test",
    app_id = "demo",
    app_package = ":update_archive",
    archive = ":catalog",
    expected_count = 1,
    preinstalled_version = "0.1.0",
    version = "0.2.0",
)
