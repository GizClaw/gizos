load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "apps",
    srcs = [
        "src/h2_lua_app_install.c",
        "src/h2_lua_apps.c",
        "src/h2_lua_apps_internal.h",
    ],
    hdrs = ["include/h2_lua_apps.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/bundle",
        "//libs/encoding",
        "//libs/pal",
        "//libs/semver",
        "//libs/sha256",
        "//tools/bazel:vendor_third_party_yyjson",
        "//tools/bazel:vendor_third_party_zlib",
    ],
)

py_binary(
    name = "fixtures",
    srcs = ["tests/fixtures.py"],
    main = "tests/fixtures.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

genrule(
    name = "test_fixtures",
    outs = ["fixtures.h"],
    cmd = "$(execpath :fixtures) --output $@",
    tools = [":fixtures"],
)

cc_test(
    name = "apps_test",
    srcs = [
        "tests/test_apps.c",
        ":test_fixtures",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":apps",
        "//libs/app_test:testing_pal",
        "//libs/atomic/providers/c11",
        "//libs/pal/providers/desktop/pal_core",
    ],
)

cc_test(
    name = "close_failure_test",
    srcs = [
        "tests/test_close_failure.c",
        ":test_fixtures",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["."],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":apps",
        "//libs/app_test:testing_pal",
        "//libs/pal/providers/desktop/pal_core",
    ],
)
