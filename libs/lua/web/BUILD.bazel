load("@rules_cc//cc:defs.bzl", "cc_library")
load(":lua_web_app_test.bzl", "lua_web_app_argument_test")

package(default_visibility = ["//visibility:public"])

# Generic Lua App entry compiled by every h2_lua_web_app() page.
exports_files(["src/h2_web_lua_app.c"])

# Hook contract for h2_lua_web_app(extension = ...) libraries.
cc_library(
    name = "lua_app_extension",
    hdrs = ["include/h2_web_lua_app.h"],
    includes = ["include"],
    deps = [
        "//libs/lua",
        "//libs/runtime",
    ],
)

# Loading validates bounded budgets and app arguments; board input name
# collisions and an unknown exit Button fail analysis of the page.
lua_web_app_argument_test(
    name = "lua_web_app_argument_test",
    # Embedded platforms have no test execution toolchain.
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
