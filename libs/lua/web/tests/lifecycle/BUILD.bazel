load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:web_archive.bzl", "web_archive_browser_test")
load("//tools/bazel/web:web_app.bzl", "h2_web_app")
load("//tools/bazel/web:web_board.bzl", "h2_web_board")

cc_library(
    name = "entry_source",
    hdrs = ["h2_web_lua_app_config.h"],
    includes = ["."],
    textual_hdrs = ["//libs/lua/web:src/h2_web_lua_app.c"],
    deps = ["//libs/lua"],
)

h2_web_board(
    name = "fixture_board",
    buttons = {"lifecycle": "x"},
    display_height = 64,
    display_width = 64,
)

h2_web_app(
    name = "lifecycle",
    srcs = ["lifecycle.c"],
    app_name = "lifecycle-normal",
    board = ":fixture_board",
    passes = ["LIFECYCLE checks=PASS"],
    deps = [
        ":entry_source",
        "//libs/lua",
    ],
)

[web_archive_browser_test(
    name = name,
    archive = ":lifecycle",
    passes = ["LIFECYCLE checks=PASS"],
    query = "mode=%d" % mode,
    timeout_s = 60,
) for name, mode in [
    ("ordinary_error_test", 1),
    ("transport_fault_test", 2),
    ("display_join_fault_test", 3),
    ("managed_stop_test", 4),
    ("input_join_fault_test", 5),
    ("input_exit_fault_test", 6),
    ("filesystem_busy_test", 7),
]]

# Historical labels now cover the remaining Runtime input worker.
alias(
    name = "entry_join_fault_test",
    actual = ":input_join_fault_test",
)

alias(
    name = "entry_exit_fault_test",
    actual = ":input_exit_fault_test",
)
