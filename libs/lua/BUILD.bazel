load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:firmware_components.bzl", "firmware_lib_component")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

exports_files(["lua_resource.bzl"])

h2_tasks(
    name = "tasks",
    tasks = [
        "$lua/worker",
    ],
)

py_binary(
    name = "embed_resource",
    srcs = ["embed_resource.py"],
    legacy_create_init = 0,
    main = "embed_resource.py",
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "lua_core",
    srcs = [
        "src/core/h2_lua_internal.h",
        "src/core/h2_lua_load.c",
        "src/core/h2_lua_vm.c",
    ],
    hdrs = ["include/h2_lua_vm.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = ["//tools/bazel:vendor_third_party_lua"],
)

cc_library(
    name = "lua_runtime",
    srcs = [
        "src/core/h2_lua_internal.h",
        "src/modules/h2_lua_esp_claw.c",
        "src/modules/h2_lua_modules.c",
        "src/runtime/h2_lua.c",
        "src/runtime/h2_lua_event.c",
        "src/runtime/h2_lua_internal.h",
        "src/runtime/h2_lua_job.c",
        "src/runtime/h2_lua_task_names.c",
    ],
    hdrs = [
        "include/h2_lua.h",
        "include/h2_lua_capability.h",
        "include/h2_lua_esp_claw.h",
        "include/h2_lua_event.h",
        "include/h2_lua_job.h",
        "include/h2_lua_module.h",
        "include/h2_lua_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    deps = [
        ":tasks",
        ":lua_core",
        "//libs/runtime",
        "//tools/bazel:vendor_third_party_lua",
        "//tools/bazel:vendor_third_party_yyjson",
    ] + select({
        "@platforms//os:none": ["//third_party/lua_patch"],
        "//conditions:default": [],
    }),
)

h2_tasks(
    name = "link_tasks",
    tasks = [
        "$lua/link",
    ],
)

# BLE KCP provider behind the Lua `link` module. Separate from lua_runtime so
# images that never call h2_lua_link_enable() do not link BLE iKCP.
cc_library(
    name = "lua_link",
    srcs = [
        "src/core/h2_lua_internal.h",
        "src/link/h2_lua_link.c",
        "src/runtime/h2_lua_internal.h",
    ],
    hdrs = [
        "include/h2_lua_link.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = [
        ":link_tasks",
        ":lua_runtime",
        "//libs/bleikcp",
        "//libs/pal:unsupported",
        "//tools/bazel:vendor_third_party_lua",
    ],
)

cc_library(
    name = "lua",
    tags = ["h2-ci-native-package"],
    deps = [":lua_runtime"],
)

# Embedded builds of //... run the firmware archive ABI check over the whole
# Lua archive closure, so a newlib standard-stream dependency fails in GizOS.
firmware_lib_component(
    name = "lua_firmware_abi",
    component_name = "h2_lua",
    deps = [":lua"],
)

cc_test(
    name = "lua_core_test",
    srcs = ["tests/test_h2_lua_vm.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":lua_core"],
)

cc_test(
    name = "lua_test",
    srcs = ["tests/test_h2_lua.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":lua_runtime",
        "//libs/pal:unsupported",
        "//libs/pal/providers/desktop/pal_core",
    ],
)

# Test-only two-device BLE air shared by the link tests and the Lua link E2E
# App test.
cc_library(
    name = "link_fake_ble",
    testonly = True,
    srcs = ["tests/h2_lua_link_fake_ble.c"],
    hdrs = ["tests/h2_lua_link_fake_ble.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["tests"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal:unsupported",
        "//libs/pal/providers/desktop/pal_core",
        "//libs/runtime",
    ],
)

cc_test(
    name = "lua_link_test",
    srcs = ["tests/test_h2_lua_link.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":link_fake_ble",
        ":lua_link",
        "//libs/pal:unsupported",
        "//libs/pal/providers/desktop/pal_core",
    ],
)
