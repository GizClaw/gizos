# Prepared arithmetic retains the extraction source's optimization contract.
# Keep these flags local; the source-package aspect exports this unit verbatim.
cc_library(
    name = "numeric_prepared",
    srcs = [
        "src/modules/h2_lua_geometry_batches.c",
        "src/modules/h2_lua_geometry_batches_internal.h",
        "src/modules/h2_lua_geometry_prepared.c",
        "src/modules/h2_lua_numeric_compensated_internal.h",
        "src/modules/h2_lua_numeric_internal.h",
        "src/modules/h2_lua_numeric_prepared.c",
    ],
    hdrs = ["include/h2_lua_numeric.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + h2_gnu_only_copts([
        "-O3",
        "-fno-fast-math",
    ]),
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        "//libs/utils",
        "//tools/bazel:vendor_third_party_lua",
    ],
)

# Portable lower layer: platform access depends only on PAL interfaces.
# Providers and optional transports belong to the caller's assembly.
# Preserve source arithmetic optimization only in public numeric/Display units.
# Core, Runtime and the remaining modules keep their existing compile contract.
cc_library(
    name = "display_numeric",
    srcs = [
        "src/core/h2_lua_internal.h",
        "src/modules/h2_lua_display.c",
        "src/modules/h2_lua_display_internal.h",
        "src/modules/h2_lua_geometry.c",
        "src/modules/h2_lua_geometry_batches_internal.h",
        "src/modules/h2_lua_geometry_kernels.h",
        "src/modules/h2_lua_numeric_internal.h",
        "src/modules/h2_lua_numeric_typed.h",
        "src/modules/h2_lua_vmath.c",
        "src/modules/h2_lua_vmath_kernels.h",
        "src/runtime/h2_lua_internal.h",
    ],
    hdrs = [
        "include/h2_lua.h",
        "include/h2_lua_capability.h",
        "include/h2_lua_display.h",
        "include/h2_lua_esp_claw.h",
        "include/h2_lua_event.h",
        "include/h2_lua_job.h",
        "include/h2_lua_module.h",
        "include/h2_lua_numeric.h",
        "include/h2_lua_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + h2_gnu_only_copts([
        "-O3",
        "-fno-fast-math",
    ]),
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":lua_core",
        ":numeric_prepared",
        "//libs/encoding",
        "//libs/raster2d",
        "//libs/raster2d:span_internal",
        "//libs/runtime",
        "//libs/utils",
        "//tools/bazel:vendor_third_party_lua",
    ],
)

cc_library(
    name = "lua_runtime",
    srcs = [
        "src/core/h2_lua_internal.h",
        "src/modules/h2_lua_esp_claw.c",
        "src/modules/h2_lua_geometry_batches_internal.h",
        "src/modules/h2_lua_kv.c",
        "src/modules/h2_lua_modules.c",
        "src/modules/h2_lua_display_internal.h",
        "src/modules/h2_lua_numeric_internal.h",
        "src/modules/h2_lua_storage.c",
        "src/modules/h2_lua_storage_internal.h",
        "src/runtime/h2_lua.c",
        "src/runtime/h2_lua_heap.c",
        "src/runtime/h2_lua_event.c",
        "src/runtime/h2_lua_internal.h",
        "src/runtime/h2_lua_job.c",
        "src/runtime/h2_lua_task_names.c",
    ],
    hdrs = [
        "include/h2_lua.h",
        "include/h2_lua_capability.h",
        "include/h2_lua_display.h",
        "include/h2_lua_esp_claw.h",
        "include/h2_lua_event.h",
        "include/h2_lua_job.h",
        "include/h2_lua_module.h",
        "include/h2_lua_numeric.h",
        "include/h2_lua_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    deps = [
        ":display_numeric",
        ":lua_core",
        ":numeric_prepared",
        ":tasks",
        "//libs/raster2d",
        "//libs/raster2d:span_internal",
        "//libs/runtime",
        "//libs/utils",
        "//tools/bazel:vendor_third_party_lua",
        "//tools/bazel:vendor_third_party_tlsf",
        "//tools/bazel:vendor_third_party_yyjson",
    ] + select({
        "@platforms//os:none": ["//third_party/lua_patch"],
        "//conditions:default": [],
    }),
)

h2_tasks(
    name = "link_tasks",
    tasks = [
        "$lua/link",
    ],
)

# BLE KCP provider behind the Lua `link` module. Separate from lua_runtime so
# images that never call h2_lua_link_enable() do not link BLE iKCP.
cc_library(
    name = "lua_link",
    srcs = [
        "src/core/h2_lua_internal.h",
        "src/link/h2_lua_link.c",
        "src/runtime/h2_lua_internal.h",
    ],
    hdrs = [
        "include/h2_lua_link.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = [
        ":link_tasks",
        ":lua_runtime",
        "//libs/bleikcp",
        "//libs/pal:unsupported",
        "//tools/bazel:vendor_third_party_lua",
    ],
)

cc_library(
    name = "lua",
    tags = ["h2-ci-native-package"],
    deps = [":lua_runtime"],
)

# Embedded builds of //... run the firmware archive ABI check over the whole
# Lua archive closure, so a newlib standard-stream dependency fails in GizOS.
firmware_lib_component(
    name = "lua_firmware_abi",
    component_name = "h2_lua",
    deps = [":lua"],
)

