def format(target):
    target_providers = providers(target)
    if "IncompatiblePlatformProvider" in target_providers:
        return ""
    matches = [value for key, value in target_providers.items() if str(key).endswith("%LuaAppInfo")]
    if len(matches) != 1:
        fail("target must expose exactly one LuaAppInfo: " + str(target.label))
    info = matches[0]
    label = str(target.label)
    if label.startswith("@@"):
        label = label[2:]
    return json.encode({
        "label": label,
        "app_id": info.app_id,
        "version": info.version,
        "entry": info.entry,
        "data_dir": info.data_dir,
        "compact": info.compact,
    })
