load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/bazel:npm_release.bzl", "npm_release_tarball")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load(":package.bzl", "lua_docs_package")

package(default_visibility = ["//visibility:public"])

SOURCES = [
    "README.md",
    "catalog.json",
    "package.json",
    "package.py",
    "runtime-pin.json",
    "//:LICENSE",
    "//guides:lua_docs_sources",
    "//libs/lua:docs_runtime_sources",
]

py_binary(
    name = "assembler",
    srcs = ["package.py"],
    legacy_create_init = 0,
    main = "package.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

lua_docs_package(
    name = "lua_docs",
    srcs = SOURCES,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

filegroup(
    name = "package_json",
    srcs = [":lua_docs"],
    output_group = "package_json",
)

npm_release_tarball(
    name = "release_tarball",
    manifest = ":package_json",
    package = ":lua_docs",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "package_test",
    srcs = [
        "package.py",
        "package_test.py",
    ],
    args = [
        "$(location :lua_docs)",
        "$(location :release_tarball)",
    ],
    data = SOURCES + [
        ":lua_docs",
        ":release_tarball",
    ],
    imports = ["."],
    legacy_create_init = 0,
    main = "package_test.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)
