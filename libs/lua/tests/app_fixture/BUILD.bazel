load("//libs/lua:lua_app.bzl", "lua_app", "lua_app_index")
load("//tools/bazel:firmware.bzl", "firmware_version")

package(default_visibility = ["//libs/lua:__pkg__"])

firmware_version(
    name = "abc_version",
    value = "1.2.3",
)

lua_app(
    name = "abc",
    description = "Preinstalled Lua fixture",
    display_name = "ABC",
    entry = "abc.lua",
    version = ":abc_version",
)

lua_app_index(
    name = "preinstalled_index",
    apps = [
        ":abc",
        ":xyz",
    ],
    root = "/preinstalled",
)

filegroup(
    name = "abc_installed",
    srcs = [":abc"],
    output_group = "installed_files",
)

filegroup(
    name = "xyz_installed_entry",
    srcs = [":xyz"],
    output_group = "installed_entry",
)

filegroup(
    name = "xyz_installed_resource",
    srcs = ["xyz/tone.pcm"],
)

firmware_version(
    name = "xyz_version",
    value = "2.0.0-rc.1",
)

lua_app(
    name = "xyz",
    data = ["xyz/tone.pcm"],
    entry = "xyz.lua",
    version = ":xyz_version",
)

filegroup(
    name = "abc_archive",
    srcs = [":abc"],
    output_group = "archive",
)

filegroup(
    name = "xyz_archive",
    srcs = [":xyz"],
    output_group = "archive",
)

filegroup(
    name = "abc_manifest",
    srcs = [":abc"],
    output_group = "manifest",
)

filegroup(
    name = "abc_metadata",
    srcs = [":abc"],
    output_group = "metadata",
)

filegroup(
    name = "xyz_manifest",
    srcs = [":xyz"],
    output_group = "manifest",
)

filegroup(
    name = "xyz_metadata",
    srcs = [":xyz"],
    output_group = "metadata",
)
