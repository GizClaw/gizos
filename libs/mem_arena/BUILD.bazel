load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mem_arena",
    srcs = ["src/h2_mem_arena.c"],
    hdrs = ["include/h2_mem_arena.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = [
        "//libs/pal",
        "//tools/bazel:vendor_third_party_tlsf",
    ],
)

cc_library(
    name = "census",
    srcs = ["src/h2_mem_arena_census.c"],
    hdrs = ["include/h2_mem_arena_census.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":mem_arena",
        "//libs/pal",
    ],
)

cc_test(
    name = "census_test",
    srcs = [
        "include/h2_mem_arena_census.h",
        "src/h2_mem_arena_census.c",
        "tests/test_mem_arena_census.c",
    ],
    conlyopts = H2_C11_OPTS + ["-DH2_MEM_ARENA_CENSUS_TESTING"],
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":mem_arena",
        "//libs/pal",
    ],
)

cc_test(
    name = "mem_arena_test",
    srcs = ["tests/test_mem_arena.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":mem_arena"],
)
