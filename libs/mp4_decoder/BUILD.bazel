load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mp4_decoder",
    srcs = [
        "src/h2_mp4_decoder.c",
        "src/h2_mp4_decoder_sizing.h",
    ],
    hdrs = [
        "include/h2_mp4_decoder.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    deps = [
        "//libs/pal",
    ],
)

cc_test(
    name = "mp4_decoder_test",
    srcs = [
        "src/h2_mp4_decoder_sizing.h",
        "tests/test_mp4_decoder.c",
    ],
    args = ["$(location tests/fixtures/high_bframes_aac.mp4)"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    data = [
        "tests/fixtures/README.md",
        "tests/fixtures/SHA256SUMS",
        "tests/fixtures/high_bframes_aac.mp4",
    ],
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":mp4_decoder"],
)

cc_test(
    name = "public_headers_test",
    srcs = [
        "src/h2_mp4_decoder_sizing.h",
        "tests/test_public_headers.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":mp4_decoder"],
)
