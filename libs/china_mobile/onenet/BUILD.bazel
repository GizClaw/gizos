load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "onenet",
    srcs = [
        "src/h2_onenet.c",
        "src/h2_onenet_auth.c",
        "src/h2_onenet_internal.h",
    ],
    hdrs = ["include/h2_onenet.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/encoding",
        "//libs/pal",
    ],
)

cc_test(
    name = "client_test",
    srcs = ["tests/test_onenet.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":onenet",
        "//libs/pal/providers/yyjson",
    ],
)

cc_test(
    name = "auth_test",
    srcs = ["tests/test_auth.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":onenet",
        "//libs/pal/providers/wolfssl:wolfcrypt",
    ],
)

cc_test(
    name = "public_headers_test",
    srcs = ["tests/test_public_headers.cc"],
    copts = H2_CXX17_OPTS + H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":onenet"],
)
