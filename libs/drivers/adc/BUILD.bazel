load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "adc",
    srcs = [
        "src/h2_adc_radio_button.c",
        "src/h2_adc_stabilizer.c",
    ],
    hdrs = [
        "include/h2_adc_stabilizer.h",
        "include/h2_esp_adc_stabilizer.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + h2_gnu_only_copts(["-Werror=type-limits"]),
    includes = ["include"],
)

cc_test(
    name = "stabilizer_test",
    srcs = ["tests/test_h2_adc_stabilizer.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":adc"],
)

cc_test(
    name = "stabilizer_short_enum_test",
    srcs = [
        "include/h2_adc_stabilizer.h",
        "include/h2_esp_adc_stabilizer.h",
        "src/h2_adc_radio_button.c",
        "src/h2_adc_stabilizer.c",
        "tests/test_h2_adc_stabilizer.c",
    ],
    conlyopts = H2_C11_OPTS + h2_gnu_only_copts(["-fshort-enums"]),
    copts = H2_WARNING_COPTS + h2_gnu_only_copts(["-Werror=type-limits"]),
    includes = ["include"],
    # MSVC has no short-enum mode; stabilizer_test still covers Windows.
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
