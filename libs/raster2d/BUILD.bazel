load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "raster2d",
    srcs = ["src/h2_raster2d.c"],
    hdrs = ["include/h2_raster2d.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = [
        ":span_internal",
        "//libs/pal",
    ],
)

cc_test(
    name = "raster2d_test",
    srcs = ["tests/test_raster2d.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":raster2d"],
)

cc_test(
    name = "public_headers_test",
    srcs = ["tests/test_public_headers.cc"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":raster2d"],
)

# Header-only implementation detail shared with the Display adapter. This is not
# a public include root or a supported application API.
cc_library(
    name = "span_internal",
    hdrs = ["src/h2_raster2d_internal.h"],
    visibility = ["//libs/lua:__pkg__"],
)

cc_binary(
    name = "benchmark_raster2d",
    srcs = ["tests/benchmark_raster2d.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":raster2d"],
)
