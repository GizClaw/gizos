load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "audio_mixer",
    srcs = [
        "src/h2_audio_mixer.c",
        "src/h2_audio_mixer_ring.c",
        "src/h2_audio_mixer_track.c",
    ],
    hdrs = [
        "include/h2_audio_mixer.h",
        "include/h2_audio_mixer_types.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    deps = [
        "//libs/pal",
    ],
)

cc_test(
    name = "audio_mixer_test",
    srcs = [
        "tests/test_audio_mixer.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":audio_mixer"],
)

cc_test(
    name = "audio_mixer_concurrency_test",
    srcs = ["tests/test_audio_mixer_concurrency.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    linkopts = ["-pthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":audio_mixer",
        "//libs/pal/providers/desktop/pal_core",
    ],
)

cc_test(
    name = "public_headers_test",
    srcs = [
        "tests/test_public_headers.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":audio_mixer"],
)
