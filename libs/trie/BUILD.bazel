load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "trie",
    srcs = ["src/h2_trie.c"],
    hdrs = ["include/h2_trie.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = ["//libs/pal"],
)

firmware_native_component(
    name = "esp_native_component",
    srcs = ["src/h2_trie.c"],
    hdrs = ["include/h2_trie.h"],
    component_name = "h2_trie",
    data = ["CMakeLists.txt"],
    deps = ["//native_component_src/esp-idf6.x/h2_pal_core"],
)

firmware_native_component(
    name = "bk7258_ap_native_component",
    srcs = ["src/h2_trie.c"],
    hdrs = ["include/h2_trie.h"],
    component_name = "h2_trie",
    data = ["CMakeLists.txt"],
    execution_unit = "ap",
    deps = ["//native_component_src/bk7258/ap/h2_pal_core"],
)

cc_test(
    name = "trie_test",
    srcs = ["tests/test_trie.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":trie"],
)

cc_test(
    name = "public_headers_test",
    srcs = ["tests/test_public_headers.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":trie"],
)
