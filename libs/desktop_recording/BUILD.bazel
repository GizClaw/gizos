load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "desktop_recording",
    srcs = [
        "src/h2_desktop_recording.cpp",
        "src/h2_desktop_recording_encoder.cpp",
        "src/h2_desktop_recording_internal.h",
    ],
    hdrs = ["include/h2_desktop_recording.h"],
    copts = H2_WARNING_COPTS + ["-Wno-thread-safety-analysis"],
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    linkopts = ["-lpthread"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal/providers/desktop/app_support:capture",
        "@h2_vendor_ffmpeg//:ffmpeg",
    ],
)

cc_test(
    name = "encoder_test",
    srcs = ["tests/test_h2_desktop_recording_encoder.cpp"],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["src"],
    deps = [
        ":desktop_recording",
        "@h2_vendor_ffmpeg//:ffmpeg",
    ],
)
