load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "$h2loader-host/ble",
    ],
)

# The portable BLE command client is also usable by a factory peer board.
# Serial-host discovery and host filesystem operations stay in the full host
# target below.
cc_library(
    name = "ble_client",
    srcs = [
        "src/h2_h2loader_host_ble.c",
        "src/h2_h2loader_host_catalog.c",
        "src/h2_h2loader_host_command.c",
        "src/h2_h2loader_host_internal.h",
        "src/h2_h2loader_host_status.c",
        "src/h2_h2loader_host_task_names.c",
    ],
    hdrs = [
        "include/h2_h2loader_host.h",
        "include/h2_h2loader_host_catalog.h",
        "include/h2_h2loader_host_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":tasks",
        "//libs/crypto/sha256",
        "//libs/net/bleikcp",
        "//libs/sync/atomic",
        "//pal",
    ],
)

cc_library(
    name = "host",
    srcs = [
        "src/h2_h2loader_host_ble.c",
        "src/h2_h2loader_host_catalog.c",
        "src/h2_h2loader_host_command.c",
        "src/h2_h2loader_host_discovery.c",
        "src/h2_h2loader_host_internal.h",
        "src/h2_h2loader_host_operation.c",
        "src/h2_h2loader_host_package.c",
        "src/h2_h2loader_host_package_writer.c",
        "src/h2_h2loader_host_scheduler.c",
        "src/h2_h2loader_host_serial.c",
        "src/h2_h2loader_host_status.c",
        "src/h2_h2loader_host_task_names.c",
    ],
    hdrs = [
        "include/h2_h2loader_host.h",
        "include/h2_h2loader_host_catalog.h",
        "include/h2_h2loader_host_package.h",
        "include/h2_h2loader_host_scheduler.h",
        "include/h2_h2loader_host_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:target_bk7258": ["@platforms//:incompatible"],
        "//tools/bazel/platforms:target_esp32p4": ["@platforms//:incompatible"],
        "//tools/bazel/platforms:target_esp32s3": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":tasks",
        "//libs/archive/bundle",
        "//libs/crypto/sha256",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/sync/atomic/providers/c11",
        "//pal",
        "//third_party:vendor_third_party_zlib",
    ],
)

cc_test(
    name = "h2loader_host_package_writer_test",
    srcs = [
        "src/h2_h2loader_host_internal.h",
        "tests/test_h2loader_host_package_writer.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":host",
        "//libs/crypto/sha256",
    ],
)

cc_test(
    name = "h2loader_host_package_test",
    srcs = [
        "src/h2_h2loader_host_internal.h",
        "tests/test_h2loader_host_package.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":host",
        "//libs/crypto/sha256",
        "//third_party:vendor_third_party_zlib",
    ],
)

cc_test(
    name = "h2loader_host_test",
    srcs = [
        "src/h2_h2loader_host_internal.h",
        "tests/test_h2loader_host.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":host"],
)

cc_test(
    name = "h2loader_host_ble_diagnostics_test",
    srcs = ["tests/test_h2loader_host_ble_diagnostics.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    # The test defines the BLE-iKCP client functions used by the Host; link
    # statically so its definitions win over the unreferenced archive members.
    linkstatic = True,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":host",
        "//libs/net/bleikcp",
    ],
)

cc_test(
    name = "h2loader_host_discovery_test",
    srcs = ["tests/test_h2loader_host_discovery.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":host"],
)

py_test(
    name = "h2loader_stage_diagnostics_test",
    srcs = ["tests/test_h2loader_stage_diagnostics.py"],
    data = ["//libs/h2loader/host:src/h2_h2loader_host_serial.c"],
    legacy_create_init = 0,
    main = "tests/test_h2loader_stage_diagnostics.py",
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "h2loader_monitor_text_loss_test",
    srcs = ["tests/test_h2loader_monitor_text_loss.py"],
    data = [
        "tests/fixtures/h2loader_monitor_text_loss.c",
        "//libs/h2loader/host:include/h2_h2loader_host.h",
        "//libs/h2loader/host:include/h2_h2loader_host_catalog.h",
        "//libs/h2loader/host:src/h2_h2loader_host_serial.c",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp.h",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp_types.h",
        "//libs/net/iostreamikcp:src/h2_iostreamikcp_frame.c",
        "//pal:pal_header_files",
    ],
    legacy_create_init = 0,
    main = "tests/test_h2loader_monitor_text_loss.py",
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
)

py_test(
    name = "h2loader_decoded_monitor_test",
    srcs = ["tests/test_h2loader_decoded_monitor.py"],
    data = [
        "tests/fixtures/h2loader_decoded_monitor.c",
        "//libs/h2loader/host:include/h2_h2loader_host.h",
        "//libs/h2loader/host:include/h2_h2loader_host_catalog.h",
        "//libs/h2loader/host:src/h2_h2loader_host_serial.c",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp.h",
        "//libs/net/iostreamikcp:include/h2_iostreamikcp_types.h",
        "//libs/net/iostreamikcp:src/h2_iostreamikcp_frame.c",
        "//pal:pal_header_files",
    ],
    legacy_create_init = 0,
    main = "tests/test_h2loader_decoded_monitor.py",
    target_compatible_with = POSIX_HOST_TOOL_COMPATIBILITY,
)
