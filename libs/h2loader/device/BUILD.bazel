load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

_SERVICE_SOURCES = [
    "src/h2_device_app.c",
    "src/h2_device_app_preflight.c",
    "src/h2_device_loader.c",
]

_SERVICE_HEADERS = [
    "include/h2_device_service.h",
    "include/h2_device_app_preflight.h",
]

_CORE_SOURCES = glob(
    ["src/*.c"],
    exclude = _SERVICE_SOURCES,
)

exports_files(glob([
    "include/*.h",
    "src/*.c",
]))

filegroup(
    name = "h2loader_headers",
    srcs = glob(
        ["include/*.h"],
        exclude = _SERVICE_HEADERS,
    ),
)

filegroup(
    name = "device_sources",
    srcs = _CORE_SOURCES,
)

filegroup(
    name = "service_sources",
    srcs = _SERVICE_SOURCES,
)

filegroup(
    name = "service_headers",
    srcs = _SERVICE_HEADERS,
)

filegroup(
    name = "service_fixture_sources",
    testonly = True,
    srcs = glob([
        "src/*.c",
        "include/*.h",
    ]),
)

# Public API for callers that compile the implementation with the SDK ABI.
cc_library(
    name = "api",
    hdrs = [":h2loader_headers"],
    includes = ["include"],
    deps = [
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/iostreamikcp",
        "//libs/pal",
    ],
)

h2_tasks(
    name = "tasks",
    tasks = [
        "$h2loader/return",
        "$h2loader/blelink",
        "$h2loader/uartcmd",
    ],
)

cc_library(
    name = "device",
    srcs = [":device_sources"],
    hdrs = [":h2loader_headers"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    local_defines = select({
        "//tools/bazel/platforms:is_ac707n": ["H2_LOADER_REQUIRE_OUTPUT_CALLBACK=1"],
        "//conditions:default": [],
    }),
    deps = [
        ":tasks",
        "//libs/atomic",
        "//libs/bleikcp",
        "//libs/bundle",
        "//libs/command",
        "//libs/crypto/sha256",
        "//libs/iostreamikcp",
        "//libs/pal",
        "//tools/bazel:vendor_third_party_zlib",
    ],
)

