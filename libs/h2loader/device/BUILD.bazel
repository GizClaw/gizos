# One portable source/API inventory for every firmware SDK. The generic
# firmware_lib_component compiles these sources alongside validated archives.
filegroup(
    name = "firmware_sources",
    srcs = [
        ":device_sources",
        ":service_sources",
        "//libs/crypto/sha256:src/h2_sha256.c",
        "//projects/h2loader/apps/loader/app:app.c",
        "//projects/h2loader/apps/loader/app:task_names.c",
    ],
)

cc_library(
    name = "firmware_api",
    hdrs = [":service_headers"],
    includes = ["include"],
    deps = [
        ":api",
        ":tasks",
        "//libs/crypto/sha256",
        "//libs/runtime",
        "//projects/h2loader/apps/loader/app:loader",
    ],
)

# Optional Runtime composition. The portable Loader app depends only on :device.
# Native SDK builds compile these same declared C sources with their vendor ABI.
cc_library(
    name = "service",
    srcs = [":service_sources"],
    hdrs = [":service_headers"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        ":device",
        "//libs/runtime",
        "//projects/h2loader/apps/loader/app:loader",
    ],
)

