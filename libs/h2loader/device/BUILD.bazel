load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel/firmware:tasks.bzl", "h2_tasks")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY", "POSIX_HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

_CORE_SOURCES = glob(["src/*.c"])

exports_files(glob([
    "include/*.h",
    "src/*.c",
]))

filegroup(
    name = "h2loader_headers",
    srcs = glob(["include/*.h"]),
)

filegroup(
    name = "device_sources",
    srcs = _CORE_SOURCES,
)

# Public API for callers that compile the implementation with the SDK ABI.
cc_library(
    name = "api",
    hdrs = [":h2loader_headers"],
    includes = ["include"],
    deps = [
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/sync/atomic",
        "//pal",
    ],
)

h2_tasks(
    name = "tasks",
    tasks = [
        "$h2loader/return",
        "$h2loader/blelink",
        "$h2loader/uartcmd",
    ],
)

cc_library(
    name = "device",
    srcs = [":device_sources"],
    hdrs = [":h2loader_headers"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    local_defines = select({
        "//tools/bazel/platforms:is_ac707n": ["H2_LOADER_REQUIRE_OUTPUT_CALLBACK=1"],
        "//conditions:default": [],
    }),
    deps = [
        ":tasks",
        "//libs/archive/bundle",
        "//libs/command",
        "//libs/crypto/sha256",
        "//libs/net/bleikcp",
        "//libs/net/iostreamikcp",
        "//libs/sync/atomic",
        "//pal",
        "//third_party:vendor_third_party_zlib",
    ],
)

