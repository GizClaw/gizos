load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "task_names",
    srcs = ["src/h2_ble_wifi_config_task_names.c"],
    hdrs = ["include/h2_ble_wifi_config_task_names.h"],
    includes = ["include"],
)

cc_library(
    name = "ble_wifi_config",
    srcs = [
        "src/h2_ble_wifi_config_internal.h",
        "src/h2_ble_wifi_config_protocol.c",
        "src/h2_ble_wifi_config_service.c",
