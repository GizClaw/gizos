    hdrs = [
        "include/h2_ble_wifi_config.h",
        "include/h2_ble_wifi_config_protocol.h",
        "include/h2_ble_wifi_config_types.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = ["include"],
    deps = [
        ":task_names",
        "//libs/pal",
    ],
)

