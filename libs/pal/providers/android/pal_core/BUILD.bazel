load("//tools/bazel:mobile_package.bzl", "h2_android_aar", "h2_mobile_archive_import")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "cc_shared_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "ANDROID_ARM64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "audio_contract",
    srcs = ["src/h2_android_audio_contract.c"],
    hdrs = ["src/h2_android_audio_internal.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = ["//libs/pal"],
)

cc_library(
    name = "contracts",
    target_compatible_with = select({
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":audio_contract",
        ":video_contract",
    ],
)

cc_library(
    name = "pal_core",
    srcs = [
        "src/h2_android_audio_decoder.c",
        "src/h2_android_platform.c",
        "src/h2_android_core.c",
        "src/h2_android_crypto.c",
        "src/h2_android_json.c",
        "src/h2_android_http.c",
        "src/h2_android_webrtc.c",
        "src/h2_android_tls_internal.h",
        "src/h2_android_storage.c",
        "src/h2_android_video_decoder.c",
    ],
    hdrs = ["include/h2_android_platform.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + [
        "-Wno-deprecated-declarations",
        "-Wno-shorten-64-to-32",
    ],
    includes = ["include"],
    linkopts = [
        "-laaudio",
        "-landroid",
        "-ljnigraphics",
        "-llog",
        "-lm",
        "-lmediandk",
    ],
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        ":contracts",
        "//libs/pal:unsupported",
        "//libs/pal/providers/wolfssl",
        "//libs/pal/providers/yyjson:yyjson",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/atomic/providers/pthread",
        "//libs/pal/providers/posix/pal_core:net",
        "//libs/pal",
        "//libs/pal/providers/posix/pal_core:mobile_core", "//libs/pal/providers/posix/pal_core:host_fs", "//libs/pal/providers/sqlite",
    ],
)

cc_library(
    name = "video_contract",
    srcs = ["src/h2_android_video_contract.c"],
    hdrs = ["src/h2_android_video_internal.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = select({
        "//tools/bazel/platforms:is_android_arm64": ["@platforms//os:android"],
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = ["//libs/pal"],
)

cc_test(
    name = "audio_contract_test",
    srcs = ["tests/test_android_audio_contract.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":audio_contract"],
)

cc_test(
    name = "video_contract_test",
    srcs = ["tests/test_android_video_contract.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":video_contract"],
)


cc_shared_library(
    name = "sdk_binary",
    shared_lib_name = "libh2_pal_core.so",
    deps = [":pal_core"],
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
)
h2_android_aar(
    name = "aar",
    shared_library = ":sdk_binary",
    headers = ["include/h2_android_platform.h", "//libs/pal:pal_header_files", "//libs/pal/providers/yyjson:include/h2_yyjson_json.h"],
    module_name = "h2-pal-core",
    version = "2.0.0",
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
)
filegroup(name = "aar_archive", srcs = [":aar"], output_group = "artifact")
h2_mobile_archive_import(
    name = "packaged",
    archive = ":aar_archive",
    member = "jni/arm64-v8a/libh2_pal_core.so",
    header_prefix = "prefab/modules/h2_pal_core/include/",
    binary_name = "libh2_pal_core.so",
    shared = True,
    target_compatible_with = ANDROID_ARM64_ARTIFACT_COMPATIBILITY,
)
