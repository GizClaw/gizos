    copts = H2_WARNING_COPTS,
    includes = ["src"],
)

cc_library(
    name = "portable_protocol_providers",
    srcs = [
        "src/providers/portable/address.c",
        "src/providers/portable/agent.c",
        "src/providers/portable/base64.c",
        "src/providers/portable/dtls_srtp.c",
        "src/providers/portable/ice.c",
        "src/providers/portable/ice_transport.c",
        "src/providers/portable/peer.c",
        "src/providers/portable/peer_connection.c",
        "src/providers/portable/ports.c",
        "src/providers/portable/rtcp.c",
        "src/providers/portable/rtp.c",
        "src/providers/portable/sctp.c",
        "src/providers/portable/sdp.c",
        "src/providers/portable/socket.c",
        "src/providers/portable/stun.c",
        "src/providers/portable/utils.c",
    ],
    hdrs = glob(["src/providers/portable/*.h"]),
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS_NO_ERROR + h2_gnu_only_copts([
        "-Wno-ignored-qualifiers",
        "-Wno-incompatible-pointer-types",
        "-Wno-sign-compare",
        "-Wno-unused-but-set-variable",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ]),
    defines = ["CONFIG_SDP_BUFFER_SIZE=12000"] + select({
        "//tools/bazel/platforms:is_esp32p4": ["LOG_LEVEL=-1"],
        "//tools/bazel/platforms:is_esp32s3": ["LOG_LEVEL=-1"],
        "//conditions:default": [],
    }),
    includes = ["src/providers/portable"],
    deps = [
        ":turn_refresh",
        "//libs/pal",
        "//libs/pal/providers/h2peer/internal/libsrtp",
    ],
)

