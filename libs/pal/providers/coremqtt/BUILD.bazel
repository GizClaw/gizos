load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "coremqtt",
    srcs = [
        "src/h2_coremqtt.c",
        "src/h2_coremqtt_client.c",
        "src/h2_coremqtt_internal.h",
        "src/h2_coremqtt_transport.c",
    ],
    hdrs = [
        "include/core_mqtt_config.h",
        "include/h2_coremqtt.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "include",
    ],
    deps = [
        "//libs/pal",
        "//tools/bazel:vendor_third_party_coremqtt",
    ],
)

cc_test(
    name = "mqtt_api_test",
    srcs = [
        "src/h2_coremqtt_internal.h",
        "tests/fake_mqtt_platform.c",
        "tests/fake_mqtt_platform.h",
        "tests/test_mqtt_api.c",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    includes = [
        "src",
        "tests",
    ],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":coremqtt"],
)

