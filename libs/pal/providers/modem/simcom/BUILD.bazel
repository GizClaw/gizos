load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "$net/modem_ppp_rx",
        "$modem/call_in",
        "$modem/gnss_fix",
    ],
)

cc_library(
    name = "simcom_modem",
    srcs = [
        "src/h2_simcom_at.c",
        "src/h2_simcom_call.c",
        "src/h2_simcom_gnss.c",
        "src/h2_simcom_internal.h",
        "src/h2_simcom_modem.c",
        "src/h2_simcom_ppp.c",
        "src/h2_simcom_status.c",
        "src/h2_simcom_task_names.c",
        "src/h2_simcom_urc.c",
    ],
    hdrs = [
        "include/h2_simcom_modem.h",
        "include/h2_simcom_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    deps = [
        ":tasks",
        "//libs/pal",
        "//libs/pal/providers/modem/common:urc",
    ],
)
