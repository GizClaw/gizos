load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel:tasks.bzl", "h2_tasks")

package(default_visibility = ["//visibility:public"])

h2_tasks(
    name = "tasks",
    tasks = [
        "$net/modem_ppp_rx",
        "$modem/call_in",
        "$modem/gnss_fix",
    ],
)

cc_library(
    name = "simcom_modem",
    srcs = [
        "src/h2_simcom_at.c",
        "src/h2_simcom_call.c",
        "src/h2_simcom_gnss.c",
        "src/h2_simcom_internal.h",
        "src/h2_simcom_modem.c",
        "src/h2_simcom_ppp.c",
        "src/h2_simcom_status.c",
        "src/h2_simcom_task_names.c",
        "src/h2_simcom_urc.c",
    ],
    hdrs = [
        "include/h2_simcom_modem.h",
        "include/h2_simcom_task_names.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = [
        "include",
    ],
    deps = [
        ":tasks",
        "//libs/pal",
        "//libs/pal/providers/modem/common:urc",
    ],
)

cc_test(
    name = "simcom_signal_test",
    srcs = ["tests/test_simcom_signal.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//tools/bazel/platforms:host_windows_target_windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":simcom_modem", "//libs/atomic/providers/c11"],
)
