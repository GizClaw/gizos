cc_test(
    name = "corehttp_integration_test",
    srcs = ["tests/test_h2_desktop_corehttp.c"],
    args = ["$(location %s)" % fixture for fixture in _TLS_FIXTURES],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    data = _TLS_FIXTURES,
    linkopts = ["-lpthread"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":app_support",
        "//libs/pal",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/wolfssl",
    ],
)

cc_test(
    name = "display_lvgl_integration_test",
    srcs = ["tests/test_h2_desktop_display_lvgl.cpp"],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
