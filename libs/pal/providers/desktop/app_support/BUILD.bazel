load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "bundle_rpath",
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-rpath,@loader_path/../../Frameworks"],
        "//conditions:default": [],
    }),
)

_TLS_FIXTURES = [
    "//libs/pal/providers/posix/pal_core:tests/fixtures/localhost_ca.pem",
    "//libs/pal/providers/posix/pal_core:tests/fixtures/wrong_ca.pem",
    "//libs/pal/providers/posix/pal_core:tests/fixtures/localhost_cert.pem",
    "//libs/pal/providers/posix/pal_core:tests/fixtures/localhost_key.pem",
]

cc_test(
    name = "app_support_test",
    srcs = ["tests/test_h2_desktop_app_support.cpp"],
    copts = H2_WARNING_COPTS,
    cxxopts = H2_CXX17_OPTS,
    data = ["tests/resource.txt"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":app_support"],
)

