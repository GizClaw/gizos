load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ffmpeg",
    srcs = [
        "src/h2_ffmpeg_audio_decoder.c",
        "src/h2_ffmpeg_video_decoder.c",
    ],
    hdrs = ["include/h2_ffmpeg.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + h2_gnu_only_copts([
        "-Wno-deprecated-declarations",
    ]),
    includes = ["include"],
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/pal",
        "@h2_vendor_ffmpeg//:ffmpeg",
    ],
)

cc_test(
    name = "audio_decoder_test",
    srcs = ["tests/test_h2_ffmpeg_audio_decoder.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":ffmpeg"],
)

cc_test(
    name = "video_decoder_test",
    srcs = ["tests/test_h2_ffmpeg_video_decoder.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = select({
        "//tools/bazel/platforms:host_linux_target_linux": [],
        "//tools/bazel/platforms:host_macos_target_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":ffmpeg"],
)
