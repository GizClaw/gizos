load("@rules_apple//apple:apple.bzl", "apple_static_xcframework")
load("//tools/bazel:mobile_package.bzl", "h2_swift_package", "h2_mobile_archive_import")
load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("//tools/bazel/platforms:compatibility.bzl", "IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY")

package(default_visibility = ["//visibility:public"])

objc_library(
    name = "platform",
    srcs = ["src/h2_ios_platform.m", "src/h2_ios_core.m", "src/h2_ios_audio.m"],
    hdrs = ["include/h2_ios_platform.h"],
    copts = [
        "-fobjc-arc",
    ] + H2_WARNING_COPTS + [
        "-Wno-deprecated-declarations",
        "-Wno-shorten-64-to-32",
    ],
    includes = ["include"],
    sdk_frameworks = [
        "AudioToolbox",
        "AVFoundation",
        "CoreGraphics",
        "Foundation",
        "UIKit",
    ],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [":crypto", "//libs/pal", "//libs/pal/providers/posix/pal_core:mobile_core"],
)

cc_library(
    name = "system_event",
    srcs = ["src/h2_ios_system_event.c"],
    hdrs = ["include/h2_ios_platform.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [":platform"],
)

cc_library(
    name = "corebluetooth_uuid",
    srcs = ["src/h2_ios_corebluetooth_uuid.c"],
    hdrs = ["src/h2_ios_corebluetooth_internal.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = ["@platforms//os:ios"],
    visibility = ["//visibility:private"],
    deps = ["//libs/pal"],
)

objc_library(
    name = "corebluetooth",
    srcs = ["src/h2_ios_corebluetooth.m"],
    hdrs = ["include/h2_ios_platform.h"],
    copts = [
        "-fobjc-arc",
    ] + H2_WARNING_COPTS + [
        "-Wno-deprecated-declarations",
    ],
    includes = ["include"],
    sdk_frameworks = [
        "CoreBluetooth",
        "Foundation",
    ],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":corebluetooth_uuid",
        ":system_event",
        "//libs/pal",
    ],
)

cc_library(
    name = "pal_core",
    hdrs = ["include/h2_ios_platform.h"],
    includes = ["include"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":corebluetooth",
        ":http",
        ":webrtc",
        ":platform",
        ":storage",
        ":system_event",
    ],
)

objc_library(
    name = "pal_tests_lib",
    testonly = True,
    srcs = [
        "tests/test_h2_ios_platform.m",
        "tests/test_ios_corebluetooth.c",
        "tests/test_ios_corebluetooth_uuid.c",
        "tests/test_ios_system_event.c",
    ],
    copts = [
        "-fobjc-arc",
    ] + H2_WARNING_COPTS,
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [
        ":corebluetooth_uuid",
        ":pal_core",
        "//libs/atomic/providers/pthread",
    ],
)

ios_unit_test(
    name = "pal_tests",
    minimum_os_version = "16.0",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    deps = [":pal_tests_lib"],
)


apple_static_xcframework(
    name = "xcframework",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
    bundle_name = "H2PALCore",
    ios = {"device": ["arm64"], "simulator": ["arm64"]},
    minimum_os_versions = {"ios": "16.0"},
    deps = [":pal_core"],
)
h2_swift_package(
    name = "swift_package",
    xcframework = ":xcframework",
    headers = ["include/h2_ios_platform.h", "//libs/pal:pal_header_files"],
    module_name = "H2PALCore",
    version = "2.0.0",
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
)
filegroup(name = "swift_archive", srcs = [":swift_package"], output_group = "artifact")
h2_mobile_archive_import(
    name = "packaged",
    archive = ":swift_archive",
    member = "H2PALCore.xcframework/ios-arm64-simulator/H2PALCore.framework/H2PALCore",
    header_prefix = "H2PALCore.xcframework/ios-arm64-simulator/H2PALCore.framework/Headers/",
    binary_name = "libH2PALCore.a",
    linkopts = ["-framework", "UIKit", "-framework", "Foundation", "-framework", "CoreGraphics", "-framework", "CoreBluetooth", "-framework", "Security", "-framework", "AudioToolbox", "-framework", "AVFoundation", "-lc++"],
    target_compatible_with = IOS_SIM_ARM64_ARTIFACT_COMPATIBILITY,
)

cc_library(
    name = "storage",
    srcs = ["src/h2_ios_storage.c"],
    hdrs = ["include/h2_ios_platform.h"],
    includes = ["include"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = ["@platforms//os:ios"],
    deps = ["//libs/pal", "//libs/pal/providers/posix/pal_core:host_fs", "//libs/pal/providers/sqlite"],
)

cc_library(
    name = "crypto",
    srcs = ["src/h2_ios_crypto.c", "src/h2_ios_tls_internal.h"],
    hdrs = ["include/h2_ios_platform.h"],
    includes = ["include"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    linkopts = ["-framework", "Security"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = ["//libs/pal", "//libs/pal:unsupported", "//libs/pal/providers/wolfssl"],
)

cc_library(
    name = "http",
    srcs = [
        "src/h2_ios_http.c",
        "src/h2_ios_tls_internal.h",
    ],
    hdrs = ["include/h2_ios_platform.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":crypto",
        "//libs/pal/providers/corehttp",
        "//libs/pal/providers/posix/pal_core:net",
    ],
)

cc_library(
    name = "webrtc",
    srcs = ["src/h2_ios_webrtc.c", "src/h2_ios_tls_internal.h"],
    hdrs = ["include/h2_ios_platform.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":crypto",
        "//libs/pal/providers/posix/pal_core:net",
        "//libs/pal/providers/h2peer",
        "//libs/pal/providers/h2sctp",
        "//libs/atomic/providers/pthread",
    ],
)
