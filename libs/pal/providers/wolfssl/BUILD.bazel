load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel:cc_options.bzl", "H2_C11_OPTS", "H2_CXX17_OPTS", "H2_GNU_C11_OPTS", "H2_WARNING_COPTS", "h2_gnu_only_copts")

package(default_visibility = ["//visibility:public"])

_WOLFCRYPT_COMPATIBILITY = select({
    "//tools/bazel/platforms:host_linux_target_linux": [],
    "//tools/bazel/platforms:host_macos_target_macos": [],
    "//tools/bazel/platforms:host_windows_target_windows": [],
    "@platforms//cpu:wasm32": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "wolfcrypt_upstream",
    srcs = [
        "src/wolfcrypt/user_settings.h",
        "@h2_vendor_wolfssl//:sources",
    ],
    conlyopts = H2_GNU_C11_OPTS,
    copts = h2_gnu_only_copts([
        "-Wno-sign-conversion",
        "-Wno-unused-parameter",
        "-fno-sanitize=undefined",
    ]),
    includes = ["src/wolfcrypt"],
    local_defines = ["WOLFSSL_USER_SETTINGS"],
    target_compatible_with = _WOLFCRYPT_COMPATIBILITY,
    deps = ["@h2_vendor_wolfssl//:wolfcrypt_header_group"],
)

cc_library(
    name = "wolfcrypt",
    srcs = [
        "src/h2_wolfcrypt_crypto.c",
        "src/h2_wolfcrypt_crypto_internal.h",
        "src/h2_wolfcrypt_rng_bridge.c",
        "src/wolfcrypt/user_settings.h",
    ],
    hdrs = ["include/h2_wolfcrypt_crypto.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + h2_gnu_only_copts([
        "-Wno-error=cpp",
    ]),
    includes = [
        "include",
        "src/wolfcrypt",
    ],
    local_defines = ["WOLFSSL_USER_SETTINGS"],
    target_compatible_with = _WOLFCRYPT_COMPATIBILITY,
    deps = [
        ":wolfcrypt_upstream",
        "//libs/pal",
        "//libs/pal:unsupported",
    ],
    alwayslink = True,
)

_BK3633_WOLFCRYPT_COPTS = [
    "-Wno-sign-conversion",
    "-Wno-unused-parameter",
    "-Wno-error=cpp",
    "-fno-sanitize=undefined",
    "-fstack-usage",
    "-Werror",
]

_BK3633_WOLFCRYPT_DEFINES = [
    "GCM_SMALL",
    "WOLFSSL_AES_NO_UNROLL",
    "WOLFSSL_AES_SMALL_TABLES",
    "WOLFSSL_NO_MALLOC",
    "WOLFSSL_USER_SETTINGS",
]

_BK3633_COMPATIBILITY = select({
    "//tools/bazel/platforms:is_bk3633": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "wolfcrypt_bk3633_arm_lto",
