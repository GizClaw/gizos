        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":wolfssl_upstream",
        "//libs/pal",
        "//libs/pal:unsupported",
    ],
    alwayslink = True,
)

