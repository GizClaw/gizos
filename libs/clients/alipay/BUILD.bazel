load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "alipay",
    srcs = [
        "src/h2_alipay_once.c",
        "src/h2_alipay_storage.c",
        "src/h2_alipay_trace.c",
    ],
    hdrs = [
        "include/h2_alipay.h",
        "include/h2_alipay_storage.h",
        "include/h2_alipay_trace.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["include"],
    deps = [
        "//libs/crypto/sha256",
        "//pal",
    ],
)

# Only bind_net is exposed. bind_ble must never enter the same link closure.
cc_library(
    name = "bind_net_sdk",
    target_compatible_with = ["//tools/bazel/platforms:target_esp32s3"],
    deps = ["@alipay_sdk//:bind_net"],
)

cc_test(
    name = "trace_test",
    size = "small",
    srcs = ["tests/test_trace.c"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":alipay"],
)

cc_test(
    name = "trace_cpp_test",
    size = "small",
    srcs = ["tests/test_trace_cpp.cc"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":alipay"],
)

cc_test(
    name = "storage_test",
    size = "small",
    srcs = ["tests/test_storage.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":alipay",
        "//libs/testing:testing_pal",
    ],
)

# Explicit input preflight; the cc_library import above has no own compilation.
filegroup(
    name = "bind_net_sdk_archives",
    srcs = ["@alipay_sdk//:archives"],
    target_compatible_with = ["//tools/bazel/platforms:target_esp32s3"],
)

# Public PAL-only configuration, independent of the delivered SDK headers.
cc_library(
    name = "sdk_api",
    hdrs = ["include/h2_alipay_sdk.h"],
    includes = ["include"],
    deps = [":alipay"],
)

# The private ABI is shared only with the concrete socket bridge.
cc_library(
    name = "sdk_native_api",
    hdrs = [
        "src/h2_alipay_sdk_internal.h",
        "src/h2_alipay_sdk_socket_abi.h",
    ],
    includes = ["src"],
    visibility = ["//native_component_src/esp-idf6.x/h2_alipay:__pkg__"],
    deps = [
        ":sdk_api",
        "@alipay_sdk//:headers",
    ],
)

# Source ownership stays here when a native SDK supplies the C runtime ABI.
filegroup(
    name = "sdk_sources",
    srcs = [
        "src/h2_alipay_sdk.c",
        "src/h2_alipay_sdk_os.c",
        "src/h2_alipay_sdk_random.c",
        ":sdk_fd_sources",
    ],
)

cc_test(
    name = "sdk_test",
    srcs = [
        "src/h2_alipay_sdk_internal.h",
        "src/h2_alipay_sdk_socket_abi.h",
        "tests/test_sdk.c",
        ":sdk_sources",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    tags = ["manual"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [
        ":sdk_api",
        "//libs/testing:testing_pal",
        "@alipay_sdk//:headers",
    ],
)

filegroup(
    name = "sdk_fd_sources",
    srcs = ["src/h2_alipay_sdk_fd.c"],
)
