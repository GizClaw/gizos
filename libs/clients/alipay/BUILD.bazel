py_test(
    name = "binding_compatibility_test",
    size = "medium",
    srcs = ["tests/test_compatibility.py"],
    args = [
        "--case=binding",
        "--runner=$(location :api_candidate_runner)",
        "--manifest=$(location tests/fixtures/compatibility.json)",
        "--fixture=$(location tests/fixtures/binding.jsonl.gz)",
    ],
    data = [
        "tests/fixtures/binding.jsonl.gz",
        "tests/fixtures/compatibility.json",
        ":api_candidate_runner",
    ],
    legacy_create_init = 0,
    main = "tests/test_compatibility.py",
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
)

