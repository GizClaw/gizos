#include "libs/gizclaw/web/src/h2_web_gizclaw_internal.h"
#include "h2_web_main_thread.h"
#include <emscripten.h>

/* clang-format off */
EM_JS(void, h2_web_gizclaw_bind_impl,
      (void *context, h2_web_main_result_t *result, h2_web_main_completion_t *completion), {
  h2WebMain(context, result, completion, ['pointer','pointer','u32','u32','u32'], 'i32',
    (address, buffer, limit, defaultTimeout, capacity) => {
      if (Module.h2WebGizClawState?.attached) return -18;
      const state = {address, attached: true, closed: false, serial: 0, pending: new Map()};
      const error = (code, details = {}) => Object.assign(new Error(
          details.rpcMessage || `Local GizClaw call failed (${code})`,
          details.cause ? {cause: details.cause} : undefined),
          {name: 'GizClawError', code, ...details});
      const assertOpen = () => {
        if (state.closed || Module.h2WebGizClawState !== state) throw error(-10);
      };
      const call = (method, bytes, options = {}, decode) => {
        try {
          assertOpen();
          if (!Number.isInteger(method) || method < -2147483648 || method > 2147483647 ||
              !(bytes instanceof Uint8Array) || !options || typeof options !== 'object')
            throw error(-1);
          if (bytes.byteLength > limit) throw error(-13);
          const timeout = options.timeout_ms ?? defaultTimeout;
          if (!Number.isInteger(timeout) || timeout < 1 || timeout > 120000) throw error(-1);
          const signal = options.signal;
          if (signal && (typeof signal.addEventListener !== 'function' ||
                         typeof signal.removeEventListener !== 'function')) throw error(-1);
          if (signal?.aborted) throw error(-10);
          // Copy at API admission, so mutation by the caller cannot change a queued request.
          if (state.pending.size >= capacity) throw error(-18);
          bytes = bytes.slice();
          const id = state.serial = state.serial % 0x7fffffff + 1;
          return new Promise((resolve, reject) => {
            let timer, abort;
            const cleanup = () => { clearTimeout(timer); if (signal) signal.removeEventListener('abort', abort); };
            const cancel = code => {
              const pending = state.pending.get(id);
              if (!pending) return;
              state.pending.delete(id);
              cleanup();
              Module._h2_web_gizclaw_cancel(id);
              reject(error(code));
            };
            abort = () => cancel(-10);
            state.pending.set(id, {resolve, reject, decode, cleanup});
            if (signal) signal.addEventListener('abort', abort, {once: true});
            timer = setTimeout(() => cancel(-6), timeout);
            const deadline = performance.now() + timeout;
            const submit = () => {
              if (!state.pending.has(id)) return;
              if (state.closed) { cancel(-10); return; }
              HEAPU8.set(bytes, buffer);
              const rc = Module._h2_web_gizclaw_request(id, method, bytes.length, timeout);
              if ((rc === -9 || rc === -18) && performance.now() < deadline) { setTimeout(submit, 1); return; }
              if (rc !== 0) {
                const pending = state.pending.get(id);
                state.pending.delete(id);
                cleanup();
                pending.reject(error(rc === -9 ? -6 : rc));
              }
            };
            try { submit(); } catch (cause) { cancel(-4); }
          });
        } catch (cause) {
          return Promise.reject(cause?.code === undefined ? error(-1, {cause}) : cause);
        }
      };
      /* CANONICAL_SDK_AND_ADAPTER */
      try {
        const api = createGizClawSDK(codec, {call, error, assertOpen});
        Module.h2WebGizClawState = state;
        globalThis.h2WebGizClaw = api;
        Module._h2_web_gizclaw_set_current(address);
        return 0;
      } catch (_) {
        state.closed = true;
        state.attached = false;
        return -4;
      }
    });
});
EM_JS(void, h2_web_gizclaw_finish_impl,
      (void *context, h2_web_main_result_t *result, h2_web_main_completion_t *completion), {
  h2WebMain(context, result, completion,
    ['pointer','u32','i32','i32','i32','pointer','u32','pointer','u32','pointer','i32'], 'i32',
    (address, id, code, hasError, rpcCode, payload, length, message, messageLength, toolIds, nativeCount) => {
      const state = Module.h2WebGizClawState;
      if (!state || state.address !== address || state.closed) return -10;
      const pending = state.pending.get(id);
      if (!pending) return -10;
      state.pending.delete(id);
      pending.cleanup();
      try {
        if (code !== 0 || hasError) {
          const rpcMessage = new TextDecoder().decode(HEAPU8.slice(message, message + messageLength));
          pending.reject(Object.assign(new Error(rpcMessage || 'Local GizClaw request rejected'),
            {name: 'GizClawError', code: code || -1000, rpcCode: hasError ? rpcCode : undefined, rpcMessage}));
          return -10;
        }
        // Decode before acknowledging delivery, including product handoff completion.
        const bytes = HEAPU8.slice(payload, payload + length);
        const native = nativeCount < 0 ? undefined : {tools: Array.from(HEAPU32.subarray(toolIds >>> 2, (toolIds >>> 2) + nativeCount))};
        const decoded = pending.decode(bytes, native);
        pending.resolve(decoded);
        return 0;
      } catch (cause) {
        pending.reject(Object.assign(new Error('Local GizClaw response decode failed', {cause}),
          {name: 'GizClawError', code: -15}));
        return -15;
      }
    });
});
EM_JS(void, h2_web_gizclaw_detach_impl,
      (void *context, h2_web_main_result_t *result, h2_web_main_completion_t *completion), {
  h2WebMain(context, result, completion, ['pointer'], 'i32', address => {
    const state = Module.h2WebGizClawState;
    if (state?.address !== address) return 0;
    state.closed = true;
    state.attached = false;
    Module._h2_web_gizclaw_set_current(0);
    for (const pending of state.pending.values()) {
      pending.cleanup();
      pending.reject(Object.assign(new Error('Local GizClaw bridge closed'), {name: 'GizClawError', code: -10}));
    }
    state.pending.clear();
    return 0;
  });
});
/* clang-format on */

// Real C references extract this TU and its EM_JS metadata from the archive.
void h2_web_gizclaw_bind_js(void *context, h2_web_main_result_t *result,
                            h2_web_main_completion_t *completion) {
  h2_web_gizclaw_bind_impl(context, result, completion);
}
void h2_web_gizclaw_finish_js(void *context, h2_web_main_result_t *result,
                              h2_web_main_completion_t *completion) {
  h2_web_gizclaw_finish_impl(context, result, completion);
}
void h2_web_gizclaw_detach_js(void *context, h2_web_main_result_t *result,
                              h2_web_main_completion_t *completion) {
  h2_web_gizclaw_detach_impl(context, result, completion);
}
