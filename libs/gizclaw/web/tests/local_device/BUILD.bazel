load("//libs/lua:lua_app.bzl", "lua_app", "lua_app_index")
load("//tools/bazel:firmware.bzl", "firmware_version")
load("//tools/bazel:tasks.bzl", "h2_tasks")
load("//tools/bazel/web:web_app.bzl", "h2_web_app")

package(default_visibility = ["//visibility:public"])

firmware_version(
    name = "v1",
    value = "0.1.0",
)

firmware_version(
    name = "v2",
    value = "0.2.0",
)

lua_app(
    name = "preinstalled",
    entry = "demo.lua",
    version = ":v1",
)

lua_app(
    name = "update",
    entry = "demo.lua",
    version = ":v2",
)

lua_app_index(
    name = "preinstalled_index",
    apps = [":preinstalled"],
    root = "/data/lua",
)

filegroup(
    name = "update_archive",
    srcs = [":update"],
    output_group = "archive",
)

h2_tasks(
    name = "fixture_tasks",
    tasks = ["web-local-device/lua"],
)

h2_web_app(
    name = "local_device",
    srcs = [
        "assertions.c",
        "main.c",
    ],
    app_name = "local-device",
    passes = [
        "LOCAL_DEVICE sdk=PASS",
        "LOCAL_DEVICE lua_natural=PASS",
        "LOCAL_DEVICE lua_stop_retry=PASS",
        "LOCAL_DEVICE close_retry=PASS",
        "H2_WEB_APP name=local-device result=PASS rc=0 fs=0 destroy=0",
    ],
    preload = {
        ":demo.lua": "/data/lua/demo.lua",
        ":preinstalled_index": "/data/lua/preinstalled.json",
        ":update_archive": "/fixtures/update.tar.zlib",
    },
    test_timeout_s = 120,
    deps = [
        ":fixture_tasks",
        "//libs/gizclaw/web",
        "//libs/lua",
        "//libs/pal:unsupported",
    ],
)
