    "src/h2_gizclaw_speech.c",
    "src/h2_gizclaw_telemetry.c",
    "src/h2_gizclaw_workflow.c",
    "src/h2_gizclaw_workspace.c",
]

cc_library(
    name = "gizclaw",
    srcs = _FIRMWARE_COMPATIBLE_SRCS + select({
