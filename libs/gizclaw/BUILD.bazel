        "include/h2_gizclaw_speech.h",
        "include/h2_gizclaw_telemetry.h",
        "include/h2_gizclaw_types.h",
        "include/h2_gizclaw_workflow.h",
        "include/h2_gizclaw_workspace.h",
    ],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS + select({
        "//tools/bazel/platforms:is_bk3633": ["-Wno-error=type-limits"],
