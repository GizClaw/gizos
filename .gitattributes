* text=auto eol=lf

*.bzl text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Unified-diff blank context lines intentionally contain one space.
third_party/gizclaw_c_sdk_lua_app_uninstall.patch whitespace=-trailing-space
